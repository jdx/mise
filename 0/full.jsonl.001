rs/6m/23f_80p95q79kmhpm8_w50340000gn/T/test_dotfiles_sync_encrypted.ej9xjW/home/workdir/c doctor 2>&1 || true] 'machine backups are not being uploaded' is in output\\ncli/test_dotfiles_sync_encrypted: 33s\\nWARNING: Test cli/test_dotfiles_sync_encrypted took 33s (>20s) but is not marked as slow. Consider renaming to cli/test_dotfiles_sync_encrypted_slow\\n\\n[xtask:e2e] Running test: cli/test_dotfiles_sync_files_encrypted\\n>>> E2E cli/test_dotfiles_sync_files_encrypted\\nDEBUG: $ mise bootstrap dotfiles origin set file:///private/var/folders/6m/23f_80p95q79kmhpm8_w50340000gn/T/test_dotfiles_sync_files_encrypted.hAVBh4/home/workdir/origin.git --name laptop --include-existing --yes\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"e905cb\",\"wall_time_seconds\":5.002769125,\"session_id\":78487,\"original_token_count\":0,\"output\":\"\"}"},{"type":"input_text","text":"{\"chunk_id\":\"15cee0\",\"wall_time_seconds\":5.002502583,\"session_id\":9393,\"original_token_count\":51,\"output\":\"   Compiling mise v2026.9.1 (/Users/jdx/.codex/worktrees/dotfiles-encryption/mise)\\nmbx[warning]: prediction was not restored: absolute path has no stable cache mapping: /opt/homebrew/opt/openssl@3/lib\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a078ac-bf7f-7050-adcc-4d223220149d","create_time":1788732837.069011}}}
