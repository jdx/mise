1:        let ids = [(anchor.clone(), file_id::get_file_id(&anchor).unwrap())]\\n1904:        std::fs::write(anchor.join(\\\"unrelated\\\"), \\\"activity\\\").unwrap();\\n1905:        assert!(!anchor_replaced(&ids, &anchor));\\n1906:        std::fs::rename(&anchor, dir.path().join(\\\"old\\\")).unwrap();\\n1907:        assert!(anchor_replaced(&ids, &anchor));\\n1908:        std::fs::create_dir(&anchor).unwrap();\\n1909:        assert!(anchor_replaced(&ids, &anchor));\\n2039:    fn fetch_only_drops_the_pending_publication() {\\n2065:    fn a_shorter_publish_delay_brings_a_pending_publication_forward() {\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"ea964d\",\"wall_time_seconds\":0.983673583,\"exit_code\":0,\"original_token_count\":14,\"output\":\"{\\\"conclusion\\\":\\\"\\\",\\\"failures\\\":[],\\\"status\\\":\\\"in_progress\\\"}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a078d9-c0cd-7843-901a-b76dfa554ca0","create_time":1788734539.954403}}}
