        if origin.encrypt_backups {\n@@ -855,3 +846,2 @@\n             }\n->>>>>>> 4febbceee (feat(dotfiles): encrypted machine backups)\n             if let Some(error) = &status.validation_error {\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/jdx/.codex/worktrees/dotfiles-encryption/mise/src/cli/doctor/mod.rs\n","stderr":""},"started_at_ms":1788732406695,"completed_at_ms":1788732406696}}
