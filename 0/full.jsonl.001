-yes\" 'sync paused'\nassert \"cat $B/.config/journey/bindings\" 'desktop edit'\nassert_succeed \"$b bootstrap dotfiles pull --take-remote $B/.config/journey/bindings --yes\"\nassert \"cat $B/.config/journey/bindings\" 'laptop edit'\n\n# Stop a real pull at its first Git operation after the live file changes,\n# before it records the outcome checkpoint. The shim affects only this child.\npidfile=\"$PWD/pull.pid\"\nreal_git=$(command -v git)\nmkdir \"$PWD/crash-bin\"\ncat <<WRAPPER >\"$PWD/crash-bin/git\"\n#!/usr/bin/env bash\nif [[ \\$(cat \"$B/.config/journey/bindings\") == 'incoming edit' ]]; then\n  kill -KILL \"\\$(cat \"$pidfile\")\"\n  exit 1\nfi\nexec \"$real_git\" \"\\$@\"\nWRAPPER\nchmod +x \"$PWD/crash-bin/git\"\ncat <<WRAPPER >\"$PWD/interrupted-pull\"\n#!/usr/bin/env bash\necho \\$\\$ >\"$pidfile\"\nexport PATH=\"$PWD/crash-bin:\\$PATH\"\nexec \"$b\" bootstrap dotfiles pull --yes\nWRAPPER\nchmod +x \"$PWD/interrupted-pull\"\nprintf 'incoming edit\\n' >~/.config/journey/bindings\nassert_succeed 'mise bootstrap dotfiles sync'\nassert_succeed \"$b bootstrap dotfiles sync\"\nassert_fail \"$PWD/interrupted-pull\"\nassert \"cat $B/.config/journey/bindings\" 'incoming edit'\nassert \"$b bootstrap dotfiles history --pending --json | jq length\" '1'\nassert_succeed \"$b bootstrap dotfiles save\"\nassert_succeed \"$b bootstrap dotfiles undo --yes\"\nassert \"cat $B/.config/journey/bindings\" 'laptop edit'\n\n# Fresh-machine bootstrap restores shared state, but not private machine files.\nassert_succeed \"$c bootstrap --from-git file://$origin --yes --only dotfiles\"\nassert \"cat $C/.config/journey/bindings\" 'incoming edit'\nassert_fail \"test -e $C/.config/journey/monitor\"\nassert_contains \"$c bootstrap dotfiles machines\" 'laptop'\nassert_fail \"$c bootstrap dotfiles rollback $C/.config/journey/monitor --to laptop/latest --yes\" 'identity'\n# Recover with the independent key, not the lost machine's original identity.\nassert_succeed \"MISE_AGE_KEY=$RECOVERY_KEY $c bootstrap dotfiles rollback $C/.config/journey/monitor --to laptop/latest --yes\"\nassert \"cat $C/.config/journey/monitor\" 'machine-specific'\nmode=$(stat -c %a \"$C/.config/journey/monitor\" 2>/dev/null || stat -f %Lp \"$C/.config/journey/monitor\")\nassert \"echo $mode\" '600'\nassert_fail \"test -e $C/.config/mise/age.txt\"\n# The recovery-only file never appeared on the shared setup branch.\nassert_fail \"git --git-dir=$origin cat-file -e main:tracked/home/.config/journey/monitor\"\n522:## Test recovery before you need it\n523-\n524-Keep an independent recovery identity outside the machine being backed up and\n525-include its public recipient when enabling encrypted backups. A private Git\n526-repository's authentication and an age decryption identity serve different\n527-purposes: a replacement machine needs both repository access and a matching\n528-identity to restore encrypted content.\n529-\n530-After bootstrapping a spare machine from your setup repository, fetch the latest\n531-recovery refs and inspect a machine-specific file that was backed up but not shared:\n532-\n533-```sh\n534-mise bootstrap dotfiles sync\n535-mise bootstrap dotfiles machines\n536-mise bootstrap dotfiles rollback ~/.config/hypr/monitors.lua --to laptop/latest --dry-run\n537-mise bootstrap dotfiles rollback ~/.config/hypr/monitors.lua --to laptop/latest\n538-```\n539-\n540-Configure the recovery identity locally before restoring. Verify the recovered\n541-file and its permissions; `mise bootstrap dotfiles undo` reverses the restore.\n542-Try this while the original machine is still available. Successful publication\n543-alone does not demonstrate that a replacement machine can decrypt a backup.\n544-\n545-## What is tracked\n546-\n547-`mise bootstrap dotfiles paths` lists every entry with its mode, policies, the file that\n548-declared it, and how many files it covers, followed by exclusions, derived\n549-symlink targets, private files, and any declaration history could not h