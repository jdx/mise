 1\\n    steps:\\n      - name: Check selected workflow result\\n        env:\\n          TRUSTED_RESULT: ${{ needs.trusted.result }}\\n          UNTRUSTED_RESULT: ${{ needs.untrusted.result }}\\n        run: |\\n          if [[ \\\"$TRUSTED_RESULT\\\" == success && \\\"$UNTRUSTED_RESULT\\\" == skipped ]] ||\\n             [[ \\\"$TRUSTED_RESULT\\\" == skipped && \\\"$UNTRUSTED_RESULT\\\" == success ]]; then\\n            exit 0\\n          fi\\n          echo \\\"trusted=$TRUSTED_RESULT untrusted=$UNTRUSTED_RESULT\\\"\\n          exit 1\\n0d658e3a7 fix(dotfiles): preserve submodules during envelope detection\\nd87696e94 fix(dotfiles): keep blob reader open until git exits\\n839e230a1 fix(dotfiles): address encrypted sync review findings\\ncc94d5d28 feat(dotfiles): encrypt shared files and support hardware identities\\ne22f69756 feat(dotfiles): encrypted machine backups\\n4281da00d fix(bootstrap): reuse purge lock when disconnecting origin\\n22:[history.encryption]\\n33:assert_contains \\\"git --git-dir=$origin show main:.mise-history/format.toml\\\" 'format = 2'\\n108:assert_fail \\\"mise bootstrap dotfiles sync 2>&1\\\" '[history.encryption].recipients'\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"8874bc\",\"wall_time_seconds\":5.001308333,\"session_id\":81612,\"original_token_count\":0,\"output\":\"\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a078ac-bf7f-7050-adcc-4d223220149d","create_time":1788732609.406927}}}
