s --encrypt-backups\");\nsrc/system/history/sync/origin.rs:141:    let status_before = run::read_status(state_dir);\nsrc/system/history/sync/origin.rs:145:    let backups = if opts.encrypt_backups {\nsrc/system/history/sync/origin.rs:276:            policy.backup && (!policy.encrypt || !matches!(backups, BackupPlan::Plain))\nsrc/system/history/sync/origin.rs:281:            \"Machine backups: {backed_up} of {} captured file(s) are backed up in plain form under refs/mise-history/{}/ — anyone who can read this repository can read every file in these snapshots. Setup configuration stays plaintext; selected dotfiles can be encrypted. Use a private repository.\",\nsrc/system/history/sync/origin.rs:292:                        \"Machine backups: {backed_up} of {} captured file(s) are backed up encrypted (age) under refs/mise-history/{}/ for {} recipient(s):\",\nsrc/system/history/sync/origin.rs:302:                    \"Machine backups: {backed_up} of {} captured file(s) are backed up encrypted (age) under refs/mise-history/{}/. No age identity or SSH public key was found here: an age identity will be generated at {} (mode 0600) and used as the only recipient. Keep it: without it these backups cannot be restored; copy it to every machine that should read them.\",\nsrc/system/history/sync/origin.rs:309:                \"File names, descriptions, and content are readable only with one of these identities; the machine name, checkpoint time, and count stay visible. Setup configuration stays plaintext; selected dotfiles can be encrypted. Use a private repository.\"\nsrc/system/history/sync/origin.rs:359:                    \"previously encrypted\"\nsrc/system/history/sync/origin.rs:364:                    \"encrypted\"\nsrc/system/history/sync/origin.rs:403:    let mut status = run::read_status(state_dir)?;\nsrc/system/history/sync/origin.rs:419:            encrypt: false,\nsrc/system/history/sync/origin.rs:435:                encrypt: true,\nsrc/system/history/sync/origin.rs:577:/// Writes `[history.origin]`. `backups` `None` leaves any `encrypt_backups`\nsrc/system/history/sync/origin.rs:611:            encrypt: true,\nsrc/system/history/sync/origin.rs:614:            origin.insert(\"encrypt_backups\", Item::Value(Value::from(true)));\nsrc/system/history/sync/origin.rs:621:        Some(BackupConfig { encrypt: false, .. }) => {\nsrc/system/history/sync/origin.rs:622:            origin.remove(\"encrypt_backups\");\nsrc/system/history/sync/origin.rs:681:    let mut status = run::read_status(state_dir)?;\nsrc/system/history/sync/origin.rs:729:    let mut status = run::read_status(state_dir)?;\nsrc/system/history/sync/apply.rs:98:    let mut status = run::read_status(state_dir)?;\nsrc/system/history/sync/backup.rs:8://! With `[history.origin] encrypt_backups = true` the wrapper is the\nsrc/system/history/sync/backup.rs:9://! encrypted layout (`encrypted`): one age payload per checkpoint for the\nsrc/system/history/sync/backup.rs:19:use super::encrypted::{self, BackupHeader};\nsrc/system/history/sync/backup.rs:32:/// The recipients this machine's backups are encrypted for.\nsrc/system/history/sync/backup.rs:48:    /// `None` for a plaintext connection. An error when encryption is on\nsrc/system/history/sync/backup.rs:52:        if !origin.encrypt_backups {\nsrc/system/history/sync/backup.rs:57:                \"encrypted backups are on but [history.origin] names no recipients; `mise bootstrap dotfiles origin set {} --encrypt-backups [--recipient …]` adds them (nothing is uploaded until then)\",\nsrc/system/history/sync/backup.rs:83:pub(crate) fn scheme(encryption: Option<&BackupEncryption>) -> String {\nsrc/system/history/sync/backup.rs:84:    match encryption {\nsrc/system/history/sync/backup.rs:86:        Some(encryption) => {\nsrc/system/history/sync/backup.rs:87:            let mut recipients: Vec<&str> = encryption.strings.iter().map(String::as_str).collect();\nsrc/system/history/sync/backup.rs:148:/// layout, or the encrypted one for `encryption`.\nsrc/system/history/sync/backup.rs:152:    encryption: Option<&BackupEncryption>,\nsrc/system/history/sync/backup.rs:153:    encrypted_paths: &BTreeSet<String>,\nsrc/system/history/sync/backup.rs:156:    if encryption.is_none() {\nsrc/system/history/sync/backup.rs:157:        excluded.extend(encrypted_paths.iter().cloned());\nsrc/system/history/sync/backup.rs:165:                .filter(|c| c.encrypt)\nsrc/system/history/sync/backup.rs:185:    if encryption.is_none()\nsrc/system/history/sync/backup.rs:186:        && (!encrypted_paths.is_empty()\nsrc/system/history/sync/backup.rs:193:                .any(|coverage| coverage.encrypt))\nsrc/system/history/sync/backup.rs:197:        masked.description = \"checkpoint (encrypted files omitted)\".into();\nsrc/system/history/sync/backup.rs:203:    match encryption {\nsrc/system/history/sync/backup.rs:207:        Some(encryption) => {\nsrc/system/history/sync/backup.rs:209:                encrypted::build(repo, snapshot.as_deref(), &masked, &encryption.recipients)?;\nsrc/system/history/sync/backup.rs:210:            encrypted::write_commit(\nsrc/system/history/sync/backup.rs:212:                &BackupHeader::new(&masked, encryption.recipients.len()),\nsrc/system/history/sync/backup.rs:242:    encryption: Option<&BackupEncryption>,\nsrc/system/history/sync/backup.rs:243:    encrypted_paths: &BTreeSet<String>,\nsrc/system/history/sync/backup.rs:255:        let commit = wrapper_commit(repo, entry, encryption, encrypted_paths)?;\nsrc/system/history/sync/backup.rs:286:    encryption: Option<&BackupEncryption>,\nsrc/system/history/sync/backup.rs:287:    encrypted_paths: &BTreeSet<String>,\nsrc/system/history/sync/backup.rs:304:        let commit = wrapper_commit(repo, entry, encryption, encrypted_paths)?;\nsrc/system/history/sync/backup.rs:316:    status.backup_scheme = Some(scheme(encryption));\nsrc/system/history/sync/backup.rs:527:    fn encryption(recipients: &[&str]) -> BackupEncryption {\nsrc/system/history/sync/backup.rs:534:    fn origin(encrypt: bool, recipients: &[&str]) -> OriginTomlConfig {\nsrc/system/history/sync/backup.rs:538:            encrypt_backups: encrypt,\nsrc/system/history/sync/backup.rs:546:        let a = scheme(Some(&encryption(&[\"age1a\", \"age1b\"])));\nsrc/system/history/sync/backup.rs:547:        let b = scheme(Some(&encryption(&[\"age1b\", \"age1a\", \"age1a\"])));\nsrc/system/history/sync/backup.rs:550:        assert_ne!(a, scheme(Some(&encryption(&[\"age1a\"]))));\nsrc/system/history/sync/backup.rs:562:        let age = scheme(Some(&encryption(&[\"age1a\"])));\n","exit_code":0,"duration":{"secs":0,"nanos":2917},"formatted_output":"//! Machine recovery refs: this machine's checkpoints pushed as\n//! parentless wrapper commits to `refs/mise-history/<machine-id>/<uuid>`\n//! on the origin, rebuilt with every policy-excluded and private path\n//! removed and the record masked. Journal blobs never travel: journals\n//! are data on another machine, never executed. Retention removes only\n//! this machine's remote refs for checkpoints it pruned.\n//!\n//! With `[history.origin] encrypt_backups = true` the wrapper is the\n//! encrypted layout (`encrypted`): one age payload per checkpoint for the\n//! declared recipients. The scheme in use (plaintext, or which recipients)\n//! is recorded in `sync.json`; when it changes, this machine's refs on the\n//! origin are deleted and the eligible checkpoints uploaded again under the\n//! new one, so a repository never holds a mix by accident.\n\nuse std::collections::{BTreeMap, BTreeSet};\n\nuse eyre::{Result, bail};\n\nuse super::encrypted::{self, BackupHeader};\nuse super::network::{MACHINES_PREFIX, PushOutcome, REMOTE_MACHINES_PREFIX, Remote};\nuse super::privacy::mask_checkpoint;\nuse super::run::SyncStatus;\nuse crate::system::history::config::OriginTomlConfig;\nuse crate::system::history::shadow::{HistoryRepo, Overlay};\nuse crate::system::history::store::{Entry, OperationStatus};\nuse crate::system::history::tracked::display_to_tree_path;\n\n/// The recorded scheme of a plaintext connection (and of every connection\n/// recorded before schemes existed).\npub(crate) const PLAIN_SCHEME: &str = \"plain\";\n\n/// The recipients this machine's backups are encrypted for.\npub(crate) struct BackupEncryption {\n    pub recipients: Vec<Box<dyn age::Recipient + Send>>,\n    /// The same recipients as declared, for the scheme fingerprint.\n    pub strings: Vec<String>,\n}\n\nimpl std::fmt::Debug for BackupEncryption {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.debug_struct(\"BackupEncryption\")\n            .field(\"recipients\", &self.strings)\n            .finish()\n    }\n}\n\nimpl BackupEncryption {\n    /// `None` for a plaintext connection. An error when encryption is on\n    /// but cannot be done (no recipients, or one that does not parse):\n    /// the caller skips uploads rather than falling back to plaintext.\n    pub(crate) fn resolve(origin: &OriginTomlConfig) -> Result<Option<Self>> {\n        if !origin.encrypt_backups {\n            return Ok(None);\n        }\n        if origin.recipients.is_empty() {\n            bail!(\n                \"encrypted backups are on but [history.origin] names no recipients; `mise bootstrap dotfiles origin set {} --encrypt-backups [--recipient …]` adds them (nothing is uploaded until then)\",\n                origin.url\n            );\n        }\n        let mut recipients = vec![];\n        let mut strings = vec![];\n        for declared in &origin.recipients {\n            match crate::agecrypt::parse_recipient(declared)? {\n                Some(recipient) => {\n                    recipients.push(recipient);\n                    strings.push(declared.trim().to_string());\n                }\n                None => bail!(\n                    \"[history.origin] recipient {declared:?} is neither an age public key (age1…) nor an SSH public key (ssh-…)\"\n                ),\n            }\n        }\n        Ok(Some(Self {\n            recipients,\n            strings,\n        }))\n    }\n}\n\n/// A fingerprint of how backups are written: `plain`, or `age:` plus a\n/// hash of the recipient set (order and repeats do not matter).\npub(crate) fn scheme(encryption: Option<&BackupEncryption>) -> String {\n    match encryption {\n        None => PLAIN_SCHEME.to_string(),\n        Some(encryption) => {\n            let mut recipients: Vec<&str> = encryption.strings.iter().map(String::as_str).collect();\n            recipients.sort_unstable();\n            recipients.dedup();\n            format!(\n                \"age:{}\",\n                crate::hash::hash_sha256_to_str(&recipients.join(\"\\n\"))\n            )\n        }\n    }\n}\n\n/// Whether `scheme` differs from the one the refs on the origin were\n/// written under (a status without one is plaintext: the only scheme\n/// there was).\npub(crate) fn scheme_changes(status: &SyncStatus, scheme: &str) -> bool {\n    status.backup_scheme.as_deref().unwrap_or(PLAIN_SCHEME) != scheme\n}\n\n/// Records `scheme`; when it changed, forgets what was uploaded so every\n/// eligible checkpoint is uploaded again. Returns whether it changed.\n#[cfg(test)]\npub(crate) fn reconcile_scheme(status: &mut SyncStatus, scheme: &str) -> bool {\n    if !scheme_changes(status, scheme) {\n        status\n            .backup_scheme\n            .get_or_insert_with(|| scheme.to_string());\n        return false;\n    }\n    status.uploaded.clear();\n    status.backup_scheme = Some(scheme.to_string());\n    true\n}\n\n/// Whether a checkpoint may leave the machine at all: it has content and\n/// at least one entry with `backup = true`.\npub(crate) fn eligible(entry: &Entry) -> bool {\n    entry.checkpoint.tree.available\n        && entry.checkpoint.status() != Some(OperationStatus::Pending)\n        && entry\n            .checkpoint\n            .tree\n            .coverage\n            .entries\n            .iter()\n            .any(|coverage| coverage.backup && coverage.mode != \"private\")\n}\n\n/// The paths a backup must not carry.\nfn excluded_paths(entry: &Entry) -> BTreeSet<String> {\n    entry\n        .checkpoint\n        .tree\n        .coverage\n        .entries\n        .iter()\n        .filter(|coverage| !coverage.backup || coverage.mode == \"private\")\n        .map(|coverage| coverage.path.clone())\n        .collect()\n}\n\n/// A wrapper commit holding only what may be backed up: the plaintext\n/// layout, or the encrypted one for `encryption`.\npub(crate) fn wrapper_commit(\n    repo: &HistoryRepo,\n    entry: &Entry,\n    encryption: Option<&BackupEncryption>,\n    encrypted_paths: &BTreeSet<String>,\n) -> Result<String> {\n    let mut excluded = excluded_paths(entry);\n    if encryption.is_none() {\n        excluded.extend(encrypted_paths.iter().cloned());\n        excluded.extend(\n            entry\n                .checkpoint\n                .tree\n                .coverage\n                .entries\n                .iter()\n                .filter(|c| c.encrypt)\n                .map(|c| c.path.clone()),\n        );\n    }\n    let snapshot = match &entry.checkpoint.tree.snapshot {\n        Some(snapshot) if excluded.is_empty() => Some(snapshot.clone()),\n        Some(snapshot) => {\n            let overlays: Vec<Overlay> = excluded\n                .iter()\n                .map(|path| Overlay {\n                    path: display_to_tree_path(path),\n                    object: None,\n                })\n                .collect();\n            Some(repo.compose(snapshot, &overlays)?)\n        }\n        None => None,\n    };\n    let mut masked = mask_checkpoint(&entry.checkpoint, &excluded);\n    masked.tree.snapshot = snapshot.clone();\n    if encryption.is_none()\n        && (!encrypted_paths.is_empty()\n            || entry\n                .checkpoint\n                .tree\n                .coverage\n                .entries\n                .iter()\n                .any(|coverage| coverage.encrypt))\n    {\n        // Descriptions, labels, and operation notes can contain text derived\n        // from protected files. Plaintext backups must not disclose it.\n        masked.description = \"checkpoint (encrypted files omitted)\".into();\n        masked.summary = masked.description.clone();\n        masked.labels.clear();\n        masked.task = None;\n        masked.operation = None;\n    }\n    match encryption {\n        // a commit of its own: the local checkpoint ref keeps naming the\n        // full wrapper, private and unbacked files included\n        None => repo.write_checkpoint_commit(snapshot.as_deref(), &masked, &BTreeMap::new()),\n        Some(encryption) => {\n            let ciphertext =\n                encrypted::build(repo, snapshot.as_deref(), &masked, &encryption.recipients)?;\n            encrypted::write_commit(\n                repo,\n                &BackupHeader::new(&masked, encryption.recipients.len()),\n                &ciphertext,\n            )\n        }\n    }\n}\n\npub(crate) fn remote_ref(machine_id: &str, uuid: &str) -> String {\n    format!(\"{REMOTE_MACHINES_PREFIX}{machine_id}/{uuid}\")\n}\n\n/// The mirrored remote ref of one of this machine's checkpoints, as the\n/// sync's fetch left it: present means the origin holds the backup, whatever\n/// the local record remembers.\nfn mirrored(repo: &HistoryRepo, machine_id: &str, uuid: &str) -> Result<Option<String>> {\n    repo.ref_oid(&format!(\"{MACHINES_PREFIX}{machine_id}/{uuid}\"))\n}\n\n/// Uploads every eligible checkpoint the origin does not hold yet. Returns\n/// how many were pushed. The origin's refs decide, not only the local record\n/// (a lost `sync.json` must not re-push, and a backup already there is never\n/// replaced): a checkpoint mirrored by the fetch is recorded as uploaded, and\n/// one the origin refuses (a differing backup under the same name) is left as\n/// it is on the origin and reported, while the others go on.\npub(crate) fn upload(\n    remote: &Remote<'_>,\n    repo: &HistoryRepo,\n    entries: &[Entry],\n    machine_id: &str,\n    uploaded: &mut BTreeSet<String>,\n    encryption: Option<&BackupEncryption>,\n    encrypted_paths: &BTreeSet<String>,\n) -> Result<usize> {\n    let mut count = 0;\n    for entry in entries {\n        let uuid = &entry.checkpoint.uuid;\n        if uploaded.contains(uuid) || !eligible(entry) {\n            continue;\n        }\n        if mirrored(repo, machine_id, uuid)?.is_some() {\n            uploaded.insert(uuid.clone());\n            continue;\n        }\n        let commit = wrapper_commit(repo, entry, encryption, encrypted_paths)?;\n        // forced: the ref is this machine's alone, and a checkpoint\n        // uploaded again after a scheme change is a parentless rewrite of\n        // the same content, not a fast-forward\n        let refspec = format!(\n            \"+{commit}:{}\",\n            remote_ref(machine_id, &entry.checkpoint.uuid)\n        );\n        match remote.push(&[refspec], None)? {\n            PushOutcome::Done => {\n                uploaded.insert(uuid.clone());\n                count += 1;\n            }\n            PushOutcome::Rejected(reason) => {\n                warn!(\n                    \"history sync: the origin already holds a different backup of checkpoint {uuid}; keeping the origin's ({reason})\"\n                );\n            }\n        }\n    }\n    Ok(count)\n}\n\n/// Prepare every replacement before touching the remote. Status is committed\n/// only after the atomic push, so a crash can safely repeat the transaction.\npub(crate) fn replace(\n    remote: &Remote<'_>,\n    repo: &HistoryRepo,\n    entries: &[Entry],\n    machine_id: &str,\n    status: &mut SyncStatus,\n    encryption: Option<&BackupEncryption>,\n    encrypted_paths: &BTreeSet<String>,\n) -> Result<(usize, usize)> {\n    let old_refs = remote_refs(remote, machine_id)?;\n    let old: BTreeSet<&str> = old_refs.iter().map(String::as_str).collect();\n    let mut refs = BTreeSet::new();\n    let mut uploaded = BTreeSet::new();\n    let mut refspecs = Vec::new();\n    for entry in entries.iter().filter(|entry| eligible(entry)) {\n        let uuid = &entry.checkpoint.uuid;\n        let name = remote_ref(machine_id, uuid);\n        let newly_eligible = status\n            .upload_since\n            .as_deref()\n            .is_none_or(|since| entry.checkpoint.created_at.as_str() >= since);\nsrc/system/files.rs:107:    pub encrypt: bool,\nsrc/system/files.rs:122:    pub encrypt: bool,\nsrc/system/files.rs:134:            encrypt: false,\nsrc/system/files.rs:212:        encrypt: Option<bool>,\nsrc/system/files.rs:242:        if explicit.encrypt {\nsrc/system/files.rs:243:            self.policy.encrypt = later.policy.encrypt;\nsrc/system/files.rs:255:            encrypt: mine.encrypt || explicit.encrypt,\nsrc/system/files.rs:552:                t.contains_key(\"encrypt\")\nsrc/system/files.rs:553:                    && t.get(\"encrypt\").and_then(toml::Value::as_bool).is_none()\nsrc/system/files.rs:555:                bail!(\"dotfile {target}: encrypt must be a boolean\");\nsrc/system/files.rs:558:                t.get(\"encrypt\").and_then(toml::Value::as_bool) == Some(true)\nsrc/system/files.rs:564:                    \"encrypted dotfile {target} requires an external source, not inline content or edits\"\nsrc/system/files.rs:595:                            \"unknown dotfile key {key:?} for {target} in {}\",\nsrc/system/files.rs:677:                t.get(\"encrypt\").and_then(toml::Value::as_bool) == Some(true)\nsrc/system/files.rs:685:                    \"encrypted dotfiles require an external source, not inline content or edits\",\nsrc/system/files.rs:689:            let encryption_declared = value\nsrc/system/files.rs:691:                .is_some_and(|table| table.contains_key(\"encrypt\"));\nsrc/system/files.rs:693:                if encryption_declared {\nsrc/system/files.rs:697:                        \"invalid encryption declaration; encrypt must be a boolean on a whole-file entry\",\nsrc/system/files.rs:719:                || table.contains_key(\"encrypt\")\nsrc/system/files.rs:758:        encrypt,\nsrc/system/files.rs:784:            encrypt,\nsrc/system/files.rs:788:            source, content, mode, exclude, manifest, autosave, share, backup, encrypt, variants,\nsrc/system/files.rs:792:    if encrypt == Some(true) && content.is_some() {\nsrc/system/files.rs:796:            \"encrypted dotfiles require an external source; inline content is shared in configuration\",\nsrc/system/files.rs:804:        encrypt: encrypt.is_some(),\nsrc/system/files.rs:816:            encrypt: encrypt.unwrap_or(false),\nsrc/system/history/sync/network.rs:18:/// Local only, never pushed or fetched: the decrypted form of an encrypted\nsrc/system/history/sync/share.rs:23:    pub encrypt: bool,\nsrc/system/history/sync/share.rs:24:    pub encrypt_explicit: bool,\nsrc/system/history/sync/share.rs:64:    // that behavior while refusing malformed encryption or mixed policies.\nsrc/system/history/sync/share.rs:68:        .any(|entry| entry.reason.contains(\"encrypt\"))\nsrc/system/history/sync/share.rs:91:            if entry.policy.encrypt != other.policy.encrypt\nsrc/system/history/sync/share.rs:95:                    \"overlapping dotfile declarations disagree about encryption: {}\",\nsrc/system/history/sync/share.rs:163:                encrypt: policy.encrypt,\nsrc/system/history/sync/share.rs:164:                encrypt_explicit: policy.explicit.encrypt,\nsrc/system/history/sync/origin.rs:33:    pub encrypt_backups: bool,\nsrc/system/history/sync/origin.rs:41:    pub encrypt: bool,\nsrc/system/history/sync/origin.rs:110:    if !opts.recipients.is_empty() && !opts.encrypt_backups {\nsrc/system/history/sync/origin.rs:111:        bail!(\"--recipient needs --encrypt-backups\");\nsrc/system/history/sync/origin.rs:141:    let status_before = run::read_status(state_dir);\nsrc/system/history/sync/origin.rs:145:    let backups = if opts.encrypt_backups {\nsrc/system/history/sync/origin.rs:276:            policy.backup && (!policy.encrypt || !matches!(backups, BackupPlan::Plain))\nsrc/system/history/sync/origin.rs:281:            \"Machine backups: {backed_up} of {} captured file(s) are backed up in plain form under refs/mise-history/{}/ — anyone who can read this repository can read every file in these snapshots. Setup configuration stays plaintext; selected dotfiles can be encrypted. Use a private repository.\",\nsrc/system/history/sync/origin.rs:292:                        \"Machine backups: {backed_up} of {} captured file(s) are backed up encrypted (age) under refs/mise-history/{}/ for {} recipient(s):\",\nsrc/system/history/sync/origin.rs:302:                    \"Machine backups: {backed_up} of {} captured file(s) are backed up encrypted (age) under refs/mise-history/{}/. No age identity or SSH public key was found here: an age identity will be generated at {} (mode 0600) and used as the only recipient. Keep it: without it these backups cannot be restored; copy it to every machine that should read them.\",\nsrc/system/history/sync/origin.rs:309:                \"File names, descriptions, and content are readable only with one of these identities; the machine name, checkpoint time, and count stay visible. Setup configuration stays plaintext; selected dotfiles can be encrypted. Use a private repository.\"\nsrc/system/history/sync/origin.rs:359:                    \"previously encrypted\"\nsrc/system/history/sync/origin.rs:364:                    \"encrypted\"\nsrc/system/history/sync/origin.rs:403:    let mut status = run::read_status(state_dir)?;\nsrc/system/history/sync/origin.rs:419:            encrypt: false,\nsrc/system/history/sync/origin.rs:435:                encrypt: true,\nsrc/system/history/sync/origin.rs:577:/// Writes `[history.origin]`. `backups` `None` leaves any `encrypt_backups`\nsrc/system/history/sync/origin.rs:611:            encrypt: true,\nsrc/system/history/sync/origin.rs:614:            origin.insert(\"encrypt_backups\", Item::Value(Value::from(true)));\nsrc/system/history/sync/origin.rs:621:        Some(BackupConfig { encrypt: false, .. }) => {\nsrc/system/history/sync/origin.rs:622:            origin.remove(\"encrypt_backups\");\nsrc/system/history/sync/origin.rs:681:    let mut status = run::read_status(state_dir)?;\nsrc/system/history/sync/origin.rs:729:    let mut status = run::read_status(state_dir)?;\nsrc/system/history/sync/apply.rs:98:    let mut status = run::read_status(state_dir)?;\nsrc/system/history/sync/backup.rs:8://! With `[history.origin] encrypt_backups = true` the wrapper is the\nsrc/system/history/sync/backup.rs:9://! encrypted layout (`encrypted`): one age payload per checkpoint for the\nsrc/system/history/sync/backup.rs:19:use super::encrypted::{self, BackupHeader};\nsrc/system/history/sync/backup.rs:32:/// The recipients this machine's backups are encrypted for.\nsrc/system/history/sync/backup.rs:48:    /// `None` for a plaintext connection. An error when encryption is on\nsrc/system/history/sync/backup.rs:52:        if !origin.encrypt_backups {\nsrc/system/history/sync/backup.rs:57:                \"encrypted backups are on but [history.origin] names no recipients; `mise bootstrap dotfiles origin set {} --encrypt-backups [--recipient …]` adds them (nothing is uploaded until then)\",\nsrc/system/history/sync/backup.rs:83:pub(crate) fn scheme(encryption: Option<&BackupEncryption>) -> String {\nsrc/system/history/sync/backup.rs:84:    match encryption {\nsrc/system/history/sync/backup.rs:86:        Some(encryption) => {\nsrc/system/history/sync/backup.rs:87:            let mut recipients: Vec<&str> = encryption.strings.iter().map(String::as_str).collect();\nsrc/system/history/sync/backup.rs:148:/// layout, or the encrypted one for `encryption`.\nsrc/system/history/sync/backup.rs:152:    encryption: Option<&BackupEncryption>,\nsrc/system/history/sync/back