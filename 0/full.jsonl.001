e on Windows\\\"},{\\\"baseRefName\\\":\\\"bootstrap/9-origin\\\",\\\"headRefName\\\":\\\"bootstrap/10-auto-sync\\\",\\\"headRefOid\\\":\\\"4281da00d537de7fd9751ed7133277f5acbead39\\\",\\\"number\\\":12882,\\\"title\\\":\\\"feat(dotfiles): automatic synchronization and fresh-machine bootstrap from a setup repository\\\"},{\\\"baseRefName\\\":\\\"bootstrap/8-watch\\\",\\\"headRefName\\\":\\\"bootstrap/9-origin\\\",\\\"headRefOid\\\":\\\"996764d5f2fd87e95278395570c69d2fac2418b5\\\",\\\"number\\\":12865,\\\"title\\\":\\\"feat(dotfiles): origin, sync, pull, and machines\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"fix-nix-aube-node-gyp-bootstrap-test\\\",\\\"headRefOid\\\":\\\"7858f2943f036dbff5fc3aad8e42c8ca2a56bfb4\\\",\\\"number\\\":12858,\\\"title\\\":\\\"fix(nix): skip aube node-gyp bootstrap test in checkPhase\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"bootstrap/5-track\\\",\\\"headRefOid\\\":\\\"3f967b8809e2d12163c31e0237adabc299532b68\\\",\\\"number\\\":12849,\\\"title\\\":\\\"feat(dotfiles): file history with tracking, checkpoints, and a browser\\\"},{\\\"baseRefName\\\":\\\"bootstrap/7-user-services\\\",\\\"headRefName\\\":\\\"bootstrap/8-watch\\\",\\\"headRefOid\\\":\\\"7e0e5584b36ee6bfaa3bd65b37399e64c29497b1\\\",\\\"number\\\":12843,\\\"title\\\":\\\"feat(dotfiles): watch with adaptive autosave and doctor health\\\"},{\\\"baseRefName\\\":\\\"bootstrap/6-rollback\\\",\\\"headRefName\\\":\\\"bootstrap/7-user-services\\\",\\\"headRefOid\\\":\\\"384a89a2fdb45a970f653550f43a9e8450a76340\\\",\\\"number\\\":12838,\\\"title\\\":\\\"feat(bootstrap): user services\\\"},{\\\"baseRefName\\\":\\\"bootstrap/5-track\\\",\\\"headRefName\\\":\\\"bootstrap/6-rollback\\\",\\\"headRefOid\\\":\\\"19b1756b5d7bdf16b0e7310f170111a46ae43de6\\\",\\\"number\\\":12835,\\\"title\\\":\\\"feat(dotfiles): rollback and undo\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"http-flush-failed-partial\\\",\\\"headRefOid\\\":\\\"494a1b1f7cd0bc0742211c8af59427d2ce496818\\\",\\\"number\\\":12823,\\\"title\\\":\\\"fix(http): flush a failed download's partial file before giving up\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"fix/rust-complete-profile-components\\\",\\\"headRefOid\\\":\\\"cb4922b5a0a2b2648ae9bb0d35f655e78a1737e7\\\",\\\"number\\\":12817,\\\"title\\\":\\\"fix(rust): reconcile complete profile components\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"fix/rust-required-profile-components\\\",\\\"headRefOid\\\":\\\"377cd587e01cdf8dc1ceabf6597a4853789f2317\\\",\\\"number\\\":12816,\\\"title\\\":\\\"fix(rust): reconcile required profile components\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"fix/schema-package-absent-managers\\\",\\\"headRefOid\\\":\\\"8db54963dba2c3889d02868cf0a95fba7ef690a7\\\",\\\"number\\\":12815,\\\"title\\\":\\\"fix(schema): restrict absent packages to pacman\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"fix/rust-profile-aliases\\\",\\\"headRefOid\\\":\\\"e0faf4eba8e2247be904b75c926874b485674346\\\",\\\"number\\\":12814,\\\"title\\\":\\\"fix(rust): normalize rustup profile aliases\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"brew-cask-stale-tap-advice\\\",\\\"headRefOid\\\":\\\"4185f1f51e1727cc157389559e09d72f69e77964\\\",\\\"number\\\":12800,\\\"title\\\":\\\"fix(brew-cask): drop stale brew advice from the cask metadata error\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"schema/task-outputs-auto\\\",\\\"headRefOid\\\":\\\"1b2e75b5d3a0fa53ac64c2268df772edaeb4847a\\\",\\\"number\\\":12797,\\\"title\\\":\\\"fix(schema): allow disabling automatic task outputs\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"schema/task-run-entries\\\",\\\"headRefOid\\\":\\\"dc493fb2bd0f98d55dea4f61da92dd0c5acece9a\\\",\\\"number\\\":12796,\\\"title\\\":\\\"fix(schema): allow structured task array entries\\\"},{\\\"baseRefName\\\":\\\"main\\\",\\\"headRefName\\\":\\\"schema/rust-c