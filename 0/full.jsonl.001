\n101-+    // the connection as it was: another repository or branch starts from a\n102-+    // clean slate, and a scheme change on the same one replaces its refs\n103:+    let status_before = run::read_status(state_dir)?;\n104:+    let connected_before = status_before.origin_url.is_some();\n105:+    let same_origin = status_before.origin_url.as_deref() == Some(opts.url.as_str())\n106:+        && status_before.origin_branch.as_deref() == Some(opts.branch.as_str());\n107-+    let backups = if opts.encrypt_backups {\n108-+        let mut recipients: Vec<String> = vec![];\n109-+        for arg in &opts.recipients {\n110-+            recipients.extend(crate::agecrypt::resolve_recipient_arg(arg).await?);\n--\n126-+    };\n127- \n128-     // committed private content in the branch's history\n129-     if let Some(head) = &upstream {\n130:@@ -216,13 +272,100 @@ async fn set_inner(\n131-     let backed_up = walk\n132-         .files\n133-         .iter()\n134--        .filter(|(_, (_, policy))| policy.backup)\n--\n195-+                }\n196-+            }\n197-+        }\n198-+    }\n199:+    if same_origin && !status_before.uploaded.is_empty() {\n200:+        let previous_plain = status_before\n201-+            .backup_scheme\n202-+            .as_deref()\n203-+            .is_none_or(|scheme| scheme == backup::PLAIN_SCHEME);\n204-+        let changes = match &backups {\n205:+            BackupPlan::Plain => backup::scheme_changes(&status_before, backup::PLAIN_SCHEME),\n206-+            BackupPlan::Encrypted {\n207-+                generate: Some(_), ..\n208-+            } => true,\n209-+            BackupPlan::Encrypted { recipients, .. } => {\n210-+                let planned = backup::BackupEncryption {\n211-+                    recipients: vec![],\n212-+                    strings: recipients.clone(),\n213-+                };\n214:+                backup::scheme_changes(&status_before, &backup::scheme(Some(&planned)))\n215-+            }\n216-+        };\n217-+        if changes {\n218-+            miseprintln!(\n219-+                \"This machine's {} existing recovery ref(s) on the repository are replaced: the {} ones are deleted and eligible checkpoints are uploaded again {}.\",\n220:+                status_before.uploaded.len(),\n221-+                if previous_plain {\n222-+                    \"plaintext\"\n223-+                } else {\n224-+                    \"previously encrypted\"\n--\n233-+    }\n234-     miseprintln!(\n235-         \"Existing checkpoints: {}\",\n236-         if opts.include_existing {\n237:@@ -271,13 +414,33 @@ async fn set_inner(\n238-     // say, so `mise settings set history.sync …` keeps working afterwards\n239-     let mode =\n240-         (opts.mode.as_str() != crate::config::Settings::get().history.sync).then_some(opts.mode);\n241--    write_config(&opts.url, &opts.branch, mode)?;\n--\n271--        && status.origin_branch.as_deref() == Some(opts.branch.as_str());\n272-     if connected_before && !same_origin {\n273-         reset_sync_state(repo, &previous_machine_refs)?;\n274-         status = run::SyncStatus::default();\n275:@@ -293,6 +456,8 @@ async fn set_inner(\n276-     // is included, not only what changes later\n277-     status.upload_since = if opts.include_existing {\n278-         None\n279-+    } else if same_origin {\nsrc/cli/dotfiles/history/mod.rs:15:/// Browse the checkpoints of your dotfiles (experimental)\nsrc/cli/dotfiles/history/mod.rs:42:        crate::system::history::ensure_experimental()?;\ndocs/bootstrap/setup.md:4:> This guide uses experimental dotfile tracking and synchronization. Enable\ndocs/bootstrap/setup.md:5:> them on each machine with `mise settings experimental=true`. Interfaces\ndocs/bootstrap/setup.md:7:> require experimental mode.\ndocs/bootstrap/setup.md:40:$ mise settings experimental=true\ndocs/bootstrap/setup.md:174:mise settings experimental=true\ndocs/history.md:4:> Dotfile tracking and history are experimental. Enable them with\ndocs/history.md:5: