h's history\\n129-     if let Some(head) = &upstream {\\n130:@@ -216,13 +272,100 @@ async fn set_inner(\\n131-     let backed_up = walk\\n132-         .files\\n133-         .iter()\\n134--        .filter(|(_, (_, policy))| policy.backup)\\n--\\n195-+                }\\n196-+            }\\n197-+        }\\n198-+    }\\n199:+    if same_origin && !status_before.uploaded.is_empty() {\\n200:+        let previous_plain = status_before\\n201-+            .backup_scheme\\n202-+            .as_deref()\\n203-+            .is_none_or(|scheme| scheme == backup::PLAIN_SCHEME);\\n204-+        let changes = match &backups {\\n205:+            BackupPlan::Plain => backup::scheme_changes(&status_before, backup::PLAIN_SCHEME),\\n206-+            BackupPlan::Encrypted {\\n207-+                generate: Some(_), ..\\n208-+            } => true,\\n209-+            BackupPlan::Encrypted { recipients, .. } => {\\n210-+                let planned = backup::BackupEncryption {\\n211-+                    recipients: vec![],\\n212-+                    strings: recipients.clone(),\\n213-+                };\\n214:+                backup::scheme_changes(&status_before, &backup::scheme(Some(&planned)))\\n215-+            }\\n216-+        };\\n217-+        if changes {\\n218-+            miseprintln!(\\n219-+                \\\"This machine's {} existing recovery ref(s) on the repository are replaced: the {} ones are deleted and eligible checkpoints are uploaded again {}.\\\",\\n220:+                status_before.uploaded.len(),\\n221-+                if previous_plain {\\n222-+                    \\\"plaintext\\\"\\n223-+                } else {\\n224-+                    \\\"previously encrypted\\\"\\n--\\n233-+    }\\n234-     miseprintln!(\\n235-         \\\"Existing checkpoints: {}\\\",\\n236-         if opts.include_existing {\\n237:@@ -271,13 +414,33 @@ async fn set_inner(\\n238-     // say, so `mise settings set history.sync …` keeps working afterwards\\n239-     let mode =\\n240-         (opts.mode.as_str() != crate::config::Settings::get().history.sync).then_some(opts.mode);\\n241--    write_config(&opts.url, &opts.branch, mode)?;\\n--\\n271--        && status.origin_branch.as_deref() == Some(opts.branch.as_str());\\n272-     if connected_before && !same_origin {\\n273-         reset_sync_state(repo, &previous_machine_refs)?;\\n274-         status = run::SyncStatus::default();\\n275:@@ -293,6 +456,8 @@ async fn set_inner(\\n276-     // is included, not only what changes later\\n277-     status.upload_since = if opts.include_existing {\\n278-         None\\n279-+    } else if same_origin {\\nsrc/cli/dotfiles/history/mod.rs:15:/// Browse the checkpoints of your dotfiles (experimental)\\nsrc/cli/dotfiles/history/mod.rs:42:        crate::system::history::ensure_experimental()?;\\ndocs/bootstrap/setup.md:4:> This guide uses experimental dotfile tracking and synchronization. Enable\\ndocs/bootstrap/setup.md:5:> them on each machine with `mise settings experimental=true`. Interfaces\\ndocs/bootstrap/setup.md:7:> require experimental mode.\\ndocs/bootstrap/setup.md:40:$ mise settings experimental=true\\ndocs/bootstrap/setup.md:174:mise settings experimental=true\\ndocs/history.md:4:> Dotfile tracking and history are experimental. Enable them with\\ndocs/history.md:5:> `mise settings experimental=true`. Interfaces and storage formats may change.\\ndocs/history.md:348:and `[history.encryption].recipients`. The `[env]` age directives remain experimental.\\ndocs/dotfiles.md:8:Tracking files in place and their recovery history are **experimental**. Run\\ndocs/dotfiles.md:9:`mise settings experimental=true` to opt in. Existing symlink, copy,\\ndocs/dotfiles.md:10:template, and managed-edit workflows do not require experimental mode.\\ndiff --git a/src/system/history/tracked.rs b/src/system/history/tracked.rs\\nindex f2ce5fb5d..a3d0e72da 100644\\n--- a/src/system/history/tracked.rs\\n+++ b/src/system/history/tracked.rs\\n@@ -233,7 +233,13 @@ impl TrackedSet {\\n                         normalize(&request.source),\\n                         EntryKind::Source,\\n                         \\\"source\\\",\\n-                        Policy::for_mode(FileMode::Track),\\n+                        Policy {\\n+                            encrypt: request.policy.encrypt,\\n+                            share: request.policy.share,\\n+                            overridden: request.policy.overridden,\\n+                            explicit: request.policy.explicit,\\n+                            ..Policy::for_mode(FileMode::Track)\\n+                        },\\n                     );\\n                     source.declared_in = declared_in;\\n                     set.push(source);\\n@@ -268,7 +274,13 @@ impl TrackedSet {\\n                         normalize(&request.source),\\n                         EntryKind::Source,\\n                         \\\"source\\\",\\n-                        Policy::for_mode(FileMode::Track),\\n+                        Policy {\\n+                            encrypt: request.policy.encrypt,\\n+                            share: request.policy.share,\\n+                            overridden: request.policy.overridden,\\n+                            explicit: request.policy.explicit,\\n+                            ..Policy::for_mode(FileMode::Track)\\n+                        },\\n                     );\\n                     source.declared_in = declared_in;\\n                     set.push(source);\\n@@ -285,6 +297,15 @@ impl TrackedSet {\\n             .iter_mut()\\n             .find(|existing| existing.path == entry.path)\\n         {\\n+            if existing.kind != EntryKind::Implicit\\n+                && entry.kind != EntryKind::Implicit\\n+                && existing.policy.encrypt != entry.policy.encrypt\\n+            {\\n+                self.invalid.push(PathReason {\\n+                    path: display_path(&entry.path),\\n+                    reason: \\\"overlapping declarations disagree about encryption\\\".into(),\\n+                });\\n+            }\\n             if rank(entry.kind) > rank(existing.kind) {\\n                 *existing = entry;\\n             }\\n@@ -381,11 +402,14 @@ impl TrackedSet {\\n                 let Some(target) = resolve_link(&link) else {\\n                     continue;\\n                 };\\n-                if set\\n-                    .entries\\n-                    .iter()\\n-                    .any(|entry| target.starts_with(&entry.path))\\n-                {\\n+                if let Some(existing) = set.entry_for(&target) {\\n+                    if set.entries[owner].policy.encrypt && !existing.policy.encrypt {\\n+                        eyre::bail!(\\n+                            \\\"encrypted symlink {} points to a captured plaintext target {}; mark the target encrypted too\\\",\\n+                            display_path(&link),\\n+                            display_path(&target)\\n+                        );\\n+                    }\\n                     continue; // already covered\\n                 }\\n                 if !target.starts_with(&home) || target == home {\\n@@ -501,6 +525,7 @@ impl TrackedSet {\\n                 autosave: entry.policy.autosave,\\n                 share: entry.policy.share,\\n                 backup: entry.policy.backup,\\n+                encrypt: entry.policy.encrypt,\\n                 state: \\\"live\\\".into(),\\n                 promotion: None,\\n                 private: entry.note.clone(),\\n@@ -516,6 +541,7 @@ impl TrackedSet {\\n                 autosave: private.policy.autosave,\\n                 share: private.policy.share,\\n                 backup: private.policy.backup,\\n+                encrypt: private.policy.encrypt,\\n                 state: \\\"live\\\".into(),\\n                 promotion: None,\\n                 private: Some(private.reason.clone()),\\n@@ -841,6 +867,11 @@ pub(crate) fn hard_exclusions() -> Vec<PathBuf> {\\n     for reserved in [\\\"tracked\\\", \\\"sources\\\", \\\".mise-history\\\"] {\\n         dirs.push(config_dir.join(reserved));\\n     }\\n+    dirs.extend(\\n+        crate::agecrypt::identity_paths()\\n+            .iter()\\n+            .map(|path| normalize(path)),\\n+    );\\n     dirs.sort();\\n     dirs.dedup();\\n     dirs\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a078ac-bf7f-7050-adcc-4d223220149d","create_time":1788732528.689002}}}
