{"timestamp":"2026-09-07T05:31:58.777Z","ordinal":18974,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07177-9855-71a2-89cd-4a9a37cdbfcb","turn_id":"01a079e2-ddee-7920-adc1-13c441666749","item":{"type":"CommandExecution","id":"exec-8e7568ea-69ef-482f-907a-d2e5dda3fb9e","process_id":"16552","command":["/bin/zsh","-lc","sed -n '1,110p' e2e/cli/test_dotfiles_history_bootstrap\nrg -n 'kill|interrupt|post-dotfiles' e2e/cli/test_dotfiles_recovery_journey e2e/cli/test_dotfiles_history_bootstrap e2e/cli/test_dotfiles_rollback_review"],"cwd":"file:///Users/jdx/.codex/worktrees/dotfiles-one-history/mise","parsed_cmd":[{"type":"read","cmd":"sed -n '1,110p' e2e/cli/test_dotfiles_history_bootstrap","name":"test_dotfiles_history_bootstrap","path":"e2e/cli/test_dotfiles_history_bootstrap"},{"type":"search","cmd":"rg -n 'kill|interrupt|post-dotfiles' e2e/cli/test_dotfiles_recovery_journey e2e/cli/test_dotfiles_history_bootstrap e2e/cli/test_dotfiles_rollback_review","query":"kill|interrupt|post-dotfiles","path":"test_dotfiles_recovery_journey"}],"source":"unified_exec_startup","status":"completed","stdout":"#!/usr/bin/env bash\n# Every mutating bootstrap command records a pair of file checkpoints (before\n# and after the run) with a journal of the files the run changed and their\n# prior contents, so its file changes can be recovered. Nothing else about\n# the run is journaled: package and service state are not part of a\n# checkpoint.\n\nrequire_cmd git\n\ncount=\"mise bootstrap dotfiles history --json -n 0 | jq length\"\n\nmkdir -p \"$MISE_CONFIG_DIR/dotfiles\"\necho \"alias ll='ls -l'\" >\"$MISE_CONFIG_DIR/dotfiles/zshrc\"\necho one >\"$MISE_CONFIG_DIR/dotfiles/copied\"\ncat <<'EOF2' >\"$MISE_CONFIG_DIR/config.toml\"\n[dotfiles]\n\"~/.zshrc\" = \"dotfiles/zshrc\"\n\"~/.copied\" = { source = \"dotfiles/copied\", mode = \"copy\" }\nEOF2\n\n# dry runs record nothing\nassert_succeed \"mise bootstrap dotfiles apply --dry-run\"\nassert_contains \"mise bootstrap dotfiles history 2>&1\" \"no history checkpoints recorded\"\n\n# the first apply records a before/outcome pair\nassert_succeed \"mise bootstrap dotfiles apply --yes\"\nassert \"readlink ~/.zshrc\" \"$MISE_CONFIG_DIR/dotfiles/zshrc\"\nassert \"$count\" \"2\"\nassert \"mise bootstrap dotfiles history --json | jq -r '.[0] | \\\"\\\\(.id) \\\\(.operation.status) \\\\(.operation.command) \\\\(.tree.available)\\\"'\" \\\n  \"2 completed bootstrap dotfiles apply --yes true\"\nassert \"mise bootstrap dotfiles history --json | jq -r '.[1].trigger'\" \"bootstrap-before\"\n# the journal records every path the run touched: prior state before, resulting state after\nassert \"mise bootstrap dotfiles history --json | jq -r '[.[0].operation.journal[] | select(.kind == \\\"path_changed\\\") | .path] | join(\\\" \\\")'\" \"$HOME/.zshrc $HOME/.copied\"\nassert \"mise bootstrap dotfiles history --json | jq -r '.[0].operation.journal[0].prior.state, .[0].operation.journal[1].after.state, .[0].operation.journal[3].after.state'\" $'missing\\nsymlink\\nfile'\nassert_contains \"mise bootstrap dotfiles history show 2\" \"dotfiles: ~/.zshrc: ~/.zshrc missing -> a symlink to\"\nassert \"mise bootstrap dotfiles history show latest | grep -c 'Before: *checkpoint 1'\" \"1\"\nassert_contains \"mise bootstrap dotfiles history show latest --files\" \"~/.config/mise/dotfiles/copied\"\nassert_fail \"mise bootstrap dotfiles history show 99\" \"no history checkpoint 99\"\nassert_contains \"mise bootstrap dotfiles history show 1\" \"before bootstrap\"\n\n# a run that changes nothing leaves nothing behind\nassert_succeed \"mise bootstrap dotfiles apply --yes\"\nassert \"$count\" \"2\"\n\n# a change to a source is a new pair; the edit happened before the run, so it\n# shows between the pairs rather than within the run\necho two >\"$MISE_CONFIG_DIR/dotfiles/copied\"\necho added >\"$MISE_CONFIG_DIR/dotfiles/added\"\nassert_succeed \"mise bootstrap dotfiles apply --yes\"\nassert \"cat ~/.copied\" \"two\"\nassert \"$count\" \"4\"\n# ids reserved by the no-op run are never reused\nassert \"mise bootstrap dotfiles history --json | jq -r '[.[].id] | join(\\\",\\\")'\" \"6,5,2,1\"\nassert \"mise bootstrap dotfiles history show latest~1 --json | jq -r .id\" \"5\"\nassert_contains \"mise bootstrap dotfiles history diff 2 6\" \"dotfiles/copied\"\nassert_contains \"mise bootstrap dotfiles history diff 2 6 --patch\" \"+two\"\nassert_contains \"mise bootstrap dotfiles history diff 2 6 --path ~/.config/mise/dotfiles/copied --patch\" \"-one\"\nassert_contains \"mise bootstrap dotfiles history show 6\" \"dotfiles: ~/.copied: ~/.copied a file (4 bytes) -> a file\"\n# within the run only the copied output changed\nassert_contains \"mise bootstrap dotfiles history diff 5 6\" \"home/.copied\"\nassert_fail \"mise bootstrap dotfiles history diff 2 6 --exit-code\"\nassert_fail \"mise bootstrap dotfiles history diff 99\" \"no history checkpoint 99\"\nassert_contains \"mise bootstrap dotfiles history diff 2 6 --path ~/.config/mise/dotfiles/added --patch\" \"+added\"\n\n# a full bootstrap run records one pair, not one per part\nassert_succeed \"mise bootstrap --yes --only dotfiles\"\nassert \"$count\" \"4\"\necho three >\"$MISE_CONFIG_DIR/dotfiles/copied\"\nassert_succeed \"mise bootstrap --yes --only dotfiles\"\nassert \"$count\" \"6\"\nassert \"mise bootstrap dotfiles history --json | jq -r '.[0].operation.command'\" \"bootstrap --yes --only dotfiles\"\n# provenance is the command, not a list of machine effects\nassert \"mise bootstrap dotfiles history --json | jq -r '.[0].operation | has(\\\"parts\\\"), has(\\\"lockfile\\\")'\" $'false\\nfalse'\n\n# edits, unapply, and add journal the files they touch, with the prior content kept\ncat <<'EOF2' >>\"$MISE_CONFIG_DIR/config.toml\"\n\"~/.bashrc/activate\" = { block = 'eval \"$(mise activate bash)\"' }\nEOF2\necho 'export PS1=x' >~/.bashrc\nassert_succeed \"mise bootstrap dotfiles apply --yes\"\nassert \"mise bootstrap dotfiles history --json | jq -r '[.[0].operation.journal[] | select(.kind == \\\"path_changed\\\") | .path] | join(\\\" \\\")'\" \"$HOME/.bashrc\"\nassert \"mise bootstrap dotfiles history --json | jq -r '.[0].operation.journal[0].prior.state, .[0].operation.journal[0].prior.content.size, .[0].operation.journal[1].after.state'\" $'file\\n13\\nfile'\nassert \"mise bootstrap dotfiles history --json | jq -r '.[0].operation.journal[0].prior.content.inline' | base64 -d\" \"export PS1=x\"\nassert_contains \"mise bootstrap dotfiles history show latest\" \"dotfiles: ~/.bashrc: ~/.bashrc a file (13 bytes) -> a file\"\n\nassert_succeed \"mise bootstrap dotfiles unapply --yes ~/.bashrc\"\nassert \"cat ~/.bashrc\" \"export PS1=x\"\nassert \"mise bootstrap dotfiles history --json | jq -r '.[0].operation.journal[0].kind, .[0].operation.journal[0].path, .[0].operation.journal[1].after.state'\" $'path_changed\\n'\"$HOME/.bashrc\"$'\\nfile'\n\necho 'real file' >~/.newrc\nassert_succeed \"mise bootstrap dotfiles add --yes ~/.newrc\"\nassert \"readlink ~/.newrc\" \"$HOME/.dotfiles/.newrc\"\n# the outcome covers what the run declared: the new source is in its snapshot\nassert_contains \"mise bootstrap dotfiles history show latest --files\" \"~/.dotfiles/.newrc\"\nassert_contains \"mise bootstrap dotfiles history diff 2 latest --patch\" \"+real file\"\nassert \"mise bootstrap dotfiles history --json | jq -r '[.[0].operation.journal[] | select(.kind == \\\"path_changed\\\") | .prior.state] | .[0:2] | join(\\\" \\\")'\" \"file missing\"\nassert \"mise bootstrap dotfiles history --json | jq -r '.[0].operation.journal[0].prior.content.inline' | base64 -d\" \"real file\"\n\n# a symlink-each entry journals every link and its ownership state file\nmkdir -p \"$MISE_CONFIG_DIR/dotfiles/bin\"\necho one >\"$MISE_CONFIG_DIR/dotfiles/bin/one\"\ncat <<'EOF2' >>\"$MISE_CONFIG_DIR/config.toml\"\n\"~/.local/mybin\" = { source = \"dotfiles/bin\", mode = \"symlink-each\" }\nEOF2\nassert_succeed \"mise bootstrap dotfiles apply --yes\"\nassert \"readlink ~/.local/mybin/one\" \"$MISE_CONFIG_DIR/dotfiles/bin/one\"\nassert \"mise bootstrap dotfiles history --json | jq -r '[.[0].operation.journal[] | select(.kind == \\\"path_changed\\\") | .path | select(endswith(\\\"/one\\\") or endswith(\\\".toml\\\") or endswith(\\\"/mybin\\\"))] | length'\" \"3\"\ne2e/cli/test_dotfiles_recovery_journey:2:# One recovery journey: independent/offline edits, conflicts, an interrupted\ne2e/cli/test_dotfiles_recovery_journey:68:  kill -KILL \"\\$(cat \"$pidfile\")\"\ne2e/cli/test_dotfiles_recovery_journey:74:cat <<WRAPPER >\"$PWD/interrupted-pull\"\ne2e/cli/test_dotfiles_recovery_journey:80:chmod +x \"$PWD/interrupted-pull\"\ne2e/cli/test_dotfiles_recovery_journey:84:assert_fail \"$PWD/interrupted-pull\"\n","stderr":"","aggregated_output":"#!/usr/bin/env bash\n# Every mutating bootstrap command records a pair of file checkpoints (before\n# and after the run) with a journal of the files the run changed and their\n# prior contents, so its file changes can be recovered. Nothing else about\n# the run is journaled: package and service state are not part of a\n# checkpoint.\n\nrequire_cmd git\n\ncount=\"mise bootstrap dotfiles history --json -n 0 | jq length\"\n\nmkdir -p \"$MISE_CONFIG_DIR/dotfiles\"\necho \"alias ll='ls -l'\" >\"$MISE_CONFIG_DIR/dotfiles/zshrc\"\necho one >\"$MISE_CONFIG_DIR/dotfiles/copied\"\ncat <<'EOF2' >\"$MISE_CONFIG_DIR/config.toml\"\n[dotfiles]\n\"~/.zshrc\" = \"dotfiles/zshrc\"\n\"~/.copied\" = { source = \"dotfiles/copied\", mode = \"copy\" }\nEOF2\n\n# dry runs record nothing\nassert_succeed \"mise bootstrap dotfiles apply --dry-run\"\nassert_contains \"mise bootstrap dotfiles history 2>&1\" \"no history checkpoints recorded\"\n\n# the first apply records a before/outcome pair\nassert_succeed \"mise bootstrap dotfiles apply --yes\"\nassert \"readlink ~/.zshrc\" \"$MISE_CONFIG_DIR/dotfiles/zshrc\"\nassert \"$count\" \"2\"\nassert \"mise bootstrap dotfiles history --json | jq -r '.[0] | \\\"\\\\