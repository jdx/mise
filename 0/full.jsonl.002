ed(path));\n                        for (path, bits) in self.saved_modes(&index, std::slice::from_ref(&entry)) {\n                            if !is_named(&path) {\n                                modes.entry(path).or_insert(bits);\n                            }\n                        }\n                    }\n                    let composed = self.hold_paths(\n                        repo,\n                        &composed,\n                        &draft,\n                        previous_tree.as_ref().map(|(_, tree)| tree.as_str()),\n                    )?;\n                    (Some(composed), result.roots, true, None)\n                }\n                Err(err) => {\n                    warn!(\"history: snapshot failed: {err:#}\");\n                    (None, vec![], false, Some(format!(\"{err:#}\")))\n                }\n            },\n            (None, None) => (None, vec![], false, self.unavailable.clone()),\n        };\n        for (index, entry) in walk.entries.iter().enumerate() {\n            if entry.policy.autosave {\n                continue;\n            }\n            let Some(record) = coverage\n                .entries\n                .iter_mut()\n                .find(|record| record.path == entry.display())\n            else {\n//! Portable paths depend on location, never on deployment ownership.\nuse std::path::{Path, PathBuf};\n\nuse crate::system::history::tracked::{EntryKind, global_config_dir, normalize};\n\npub(crate) const MARKER_PATH: &str = \".mise-history/format.toml\";\n\n#[derive(Clone, Debug)]\npub(crate) struct Roots {\n    pub home: PathBuf,\n    pub config_dir: PathBuf,\n}\n\nimpl Roots {\n    pub(crate) fn current() -> Self {\n        Self {\n            home: normalize(&crate::dirs::HOME),\n            config_dir: normalize(&global_config_dir()),\n        }\n    }\n\n    pub(crate) fn branch_path(\n        &self,\n        _kind: EntryKind,\n        local: &Path,\n        variant: Option<&str>,\n    ) -> Option<String> {\n        local.to_str()?;\n        if variant.is_some_and(|name| {\n            name.contains('@') || !is_safe_branch_path(name) || name.contains('/')\n        }) {\n            return None;\n        }\n        let (root, relative) = if let Ok(relative) = local.strip_prefix(&self.config_dir) {\n            (\"config\", relative)\n        } else {\n            (\"home\", local.strip_prefix(&self.home).ok()?)\n        };\n        let stem = variant.map_or_else(|| root.to_string(), |variant| format!(\"{root}@{variant}\"));\n        let path = if relative.as_os_str().is_empty() {\n            stem\n        } else {\n            format!(\"{stem}/{}\", slash(relative))\n        };\n        is_safe_branch_path(&path).then_some(path)\n    }\n\n    pub(crate) fn locate(&self, branch_path: &str) -> Located {\n        if !is_safe_branch_path(branch_path) {\n            return Located::Unmapped;\n        }\n        if branch_path.starts_with(\".mise-history/\") {\n            return Located::Marker;\n        }\n        let (stem, relative) = branch_path.split_once('/').unwrap_or((branch_path, \"\"));\n        let (root, variant) = stem\n            .split_once('@')\n            .map_or((stem, None), |(root, variant)| (root, Some(variant)));\n        if variant.is_some_and(|variant| variant.is_empty() || variant.contains('@')) {\n            return Located::Unmapped;\n        }\n        let base = match root {\n            \"home\" => &self.home,\n            \"config\" => &self.config_dir,\n            _ => return Located::Unmapped,\n        };\n        if root == \"config\" && variant.is_none() {\n            return Located::Config(base.join(relative));\n        }\n        Located::Tracked {\n            path: base.join(relative),\n            variant: variant.map(str::to_owned),\n        }\n    }\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub(crate) enum Located {\n    Config(PathBuf),\n    Tracked {\n        path: PathBuf,\n        variant: Option<String>,\n    },\n    Marker,\n    Unmapped,\n}\n\nimpl Located {\n    pub(crate) fn path(&self) -> Option<&Path> {\n        match self {\n            Self::Config(path) | Self::Tracked { path, .. } => Some(path),\n            Self::Marker | Self::Unmapped => None,\n        }\n    }\n}\n\npub(crate) fn is_repository_metadata(path: &str) -> bool {\n    !matches!(\n        path.split('/').next().unwrap_or_default().split('@').next(),\n        Some(\"home\" | \"config\")\n    )\n}\n\npub(crate) fn is_safe_branch_path(path: &str) -> bool {\n    !path.is_empty()\n        && path.split('/').all(|component| {\n            !component.is_empty()\n                && component != \".\"\n                && component != \"..\"\n                && !component.eq_ignore_ascii_case(\".git\")\n                && !component.contains(['\\\\', ':'])\n                && !component.chars().any(char::is_control)\n        })\n}\n\nfn slash(path: &Path) -> String {\n    path.components()\n        .map(|component| component.as_os_str().to_string_lossy().into_owned())\n        .collect::<Vec<_>>()\n        .join(\"/\")\n}\n\npub(crate) fn is_configuration(path: &str) -> bool {\n    path == \"config\" || path.starts_with(\"config/\") || path.starts_with(\"config@\")\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    fn roots() -> Roots {\n        Roots {\n            home: \"/home/u\".into(),\n            config_dir: \"/config/mise\".into(),\n        }\n    }\n\n    #[test]\n    fn mapping_is_independent_of_deployment_ownership() {\n        let roots = roots();\n        for kind in [\n            EntryKind::Track,\n            EntryKind::Source,\n            EntryKind::Output,\n            EntryKind::Implicit,\n        ] {\n            assert_eq!(\n                roots.branch_path(kind, Path::new(\"/home/u/templates/gitconfig.tera\"), None),\n                Some(\"home/templates/gitconfig.tera\".into())\n            );\n            assert_eq!(\n                roots.branch_path(kind, Path::new(\"/config/mise/config.toml\"), None),\n                Some(\"config/config.toml\".into())\n            );\n        }\n        assert_eq!(\n            roots.branch_path(EntryKind::Track, Path::new(\"/etc/passwd\"), None),\n            None\n        );\n    }\n\n36:    pub path: PathBuf,\n54:    pub path: String,\n66:    pub paths: Option<(String, String)>,\n79:    pub path: String,\n90:    pub path: String,\n111:    pub(crate) fn path_in(state_dir: &Path) -> PathBuf {\n117:    pub(crate) fn open_or_init_in(state_dir: &Path) -> Result<Option<Self>> {\n137:    pub(crate) fn dir(&self) -> &Path {\n141:    pub(crate) fn capture_tracked(\n164:    fn capture_tracked_files(\n304:    pub(crate) fn capture(&self, roots: &[CaptureRoot]) -> Result<CaptureResult> {\n339:    fn tree_for_root(&self, root: &CaptureRoot, warnings: &mut Vec<String>) -> Result<String> {\n376:    pub(crate) fn mktree(&self, listing: &str) -> Result<String> {\n384:    pub(crate) fn write_tree(&self, entries: &[(String, String, String)]) -> Result<String> {\n413:    pub(crate) fn write_checkpoint(\n426:    pub(crate) fn write_checkpoint_commit(\n450:    fn advance_head(&self, commit: &str) -> Result<()> {\n464:    pub(crate) fn checkpoint_refs(&self) -> Result<Vec<(String, String)>> {\n477:    pub(crate) fn read_meta(&self, commit: &str) -> Result<Checkpoint> {\n549:    pub(crate) fn ls_tree(&self, spec: &str) -> Result<Vec<TreeEntry>> {\n581:    pub(crate) fn object_type(&self, spec: &str) -> Result<Option<String>> {\n596:    pub(crate) fn empty_object(&self, kind: &str) -> Result<String> {\n603:    pub(crate) fn cat_object(&self, oid: &str) -> Result<Vec<u8>> {\n609:    pub(crate) fn blob_starts_with(&self, oid: &str, prefix: &[u8]) -> Result<bool> {\n613:    pub(crate) fn cat_object_bounded(&self, oid: &str, limit: u64) -> Result<Vec<u8>> {\n624:    pub(crate) fn hash_blob(&self, bytes: &[u8]) -> Result<String> {\n631:    pub(crate) fn diff(&self, a: &str, b: &str, opts: &DiffOpts) -> Result<DiffResult> {\n698:    p