{"timestamp":"2026-09-07T04:25:58.340Z","ordinal":17481,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07177-9855-71a2-89cd-4a9a37cdbfcb","turn_id":"01a079e2-ddee-7920-adc1-13c441666749","item":{"type":"CommandExecution","id":"exec-3f8fb7d4-fc74-43b6-af84-e473ff047e17","process_id":"17836","command":["/bin/zsh","-lc","sed -n '1,260p' src/system/history/sync/graph.rs\nsed -n '480,640p' src/system/history/shadow.rs\nsed -n '1,180p' src/system/history/manifest.rs"],"cwd":"file:///Users/jdx/.codex/worktrees/dotfiles-one-history/mise","parsed_cmd":[{"type":"read","cmd":"sed -n '1,260p' src/system/history/sync/graph.rs","name":"graph.rs","path":"src/system/history/sync/graph.rs"},{"type":"read","cmd":"sed -n '480,640p' src/system/history/shadow.rs","name":"shadow.rs","path":"src/system/history/shadow.rs"},{"type":"read","cmd":"sed -n '1,180p' src/system/history/manifest.rs","name":"manifest.rs","path":"src/system/history/manifest.rs"}],"source":"unified_exec_startup","status":"completed","stdout":"//! Ordinary branch ancestry. Reconciliation supplies a fully validated tree;\n//! this layer preserves commit identities and never constructs another history.\n\nuse eyre::{Result, bail};\n\nuse super::network::UPSTREAM_REF;\nuse crate::system::history::shadow::HistoryRepo;\n\n#[derive(Debug)]\npub(crate) struct Heads {\n    pub local: Option<String>,\n    pub remote: Option<String>,\n    pub base: Option<String>,\n}\n\n#[derive(Debug)]\npub(crate) struct Candidate {\n    pub commit: String,\n    expected_local: Option<String>,\n    expected_remote: Option<String>,\n}\n\nimpl Heads {\n    pub(crate) fn read(repo: &HistoryRepo) -> Result<Self> {\n        let local = repo.ref_oid(HistoryRepo::HISTORY_REF)?;\n        let remote = repo.ref_oid(UPSTREAM_REF)?;\n        let base = match (&local, &remote) {\n            (Some(local), Some(remote)) => {\n                let bases = repo.merge_bases(local, remote)?;\n                if bases.is_empty() {\n                    bail!(\n                        \"local and origin histories are unrelated; use a fresh setup store to adopt origin, or reconcile the repositories explicitly with Git. Neither history was replaced\"\n                    );\n                }\n                // A criss-cross merge has shared ancestry but no unique base.\n                // It needs a merge commit, never an arbitrary fast-forward.\n                (bases.len() == 1).then(|| bases[0].clone())\n            }\n            _ => None,\n        };\n        Ok(Self {\n            local,\n            remote,\n            base,\n        })\n    }\n\n    /// Preparing a candidate does not advance a branch or write live files.\n    /// The caller must finish its complete application before adopting it.\n    pub(crate) fn candidate(&self, repo: &HistoryRepo, tree: &str) -> Result<Option<Candidate>> {\n        let commit = match (&self.local, &self.remote) {\n            (None, None) => return Ok(None),\n            (Some(local), None) => {\n                if repo.output_tree_of(local)? != tree {\n                    bail!(\"saved files changed while preparing publication; plan again\");\n                }\n                local.clone()\n            }\n            (None, Some(remote)) => {\n                if repo.output_tree_of(remote)? != tree {\n                    bail!(\"incoming files changed while preparing adoption; plan again\");\n                }\n                remote.clone()\n            }\n            (Some(local), Some(remote)) => {\n                if self.base.as_ref() == Some(remote) {\n                    if repo.output_tree_of(local)? != tree {\n                        bail!(\"saved files changed while preparing publication; plan again\");\n                    }\n                    local.clone()\n                } else if self.base.as_ref() == Some(local) && repo.output_tree_of(remote)? == tree\n                {\n                    remote.clone()\n                } else {\n                    repo.commit_tree(tree, vec![local, remote], \"merge origin dotfiles\")?\n                }\n            }\n        };\n        Ok(Some(Candidate {\n            commit,\n            expected_local: self.local.clone(),\n            expected_remote: self.remote.clone(),\n        }))\n    }\n}\n\nimpl Candidate {\n    pub(crate) fn adopt(&self, repo: &HistoryRepo) -> Result<()> {\n        if repo.ref_oid(UPSTREAM_REF)? != self.expected_remote {\n            bail!(\"origin changed while applying this setup; reconcile again before publication\");\n        }\n        // Compare-and-swap also verifies no local boundary/save was inserted\n        // during application. The caller must recompute instead of dropping it.\n        repo.update_history_head(\n            &self.commit,\n            self.expected_local.as_deref(),\n        )\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn tree(repo: &HistoryRepo, bytes: &[u8]) -> String {\n        repo.compose(\n            &repo.empty_object(\"tree\").unwrap(),\n            &[crate::system::history::shadow::Overlay {\n                path: \"home/.zshrc\".into(),\n                object: Some((\"100644\".into(), repo.hash_blob(bytes).unwrap())),\n            }],\n        )\n        .unwrap()\n    }\n\n    #[test]\n    fn delayed_publication_reuses_all_local_commits() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let first_tree = tree(&repo, b\"one\");\n        let first = repo.commit_tree(&first_tree, vec![], \"first save\").unwrap();\n        let second_tree = tree(&repo, b\"two\");\n        let second = repo\n            .commit_tree(&second_tree, vec![&first], \"second save\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &second, None)\n            .unwrap();\n        let candidate = Heads::read(&repo)\n            .unwrap()\n            .candidate(&repo, &second_tree)\n            .unwrap()\n            .unwrap();\n        assert_eq!(candidate.commit, second);\n        candidate.adopt(&repo).unwrap();\n        assert_eq!(\n            repo.rev_list(&candidate.commit, usize::MAX).unwrap(),\n            vec![second, first]\n        );\n        assert!(repo.list_refs(\"refs/setup/\").unwrap().is_empty());\n    }\n\n    #[test]\n    fn fast_forward_keeps_remote_commit_and_stale_candidates_preserve_edits() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let before_tree = tree(&repo, b\"before\");\n        let before = repo.commit_tree(&before_tree, vec![], \"before\").unwrap();\n        let incoming_tree = tree(&repo, b\"incoming\");\n        let incoming = repo\n            .commit_tree(&incoming_tree, vec![&before], \"incoming\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &before, None)\n            .unwrap();\n        repo.update_ref(UPSTREAM_REF, &incoming, None).unwrap();\n        let candidate = Heads::read(&repo)\n            .unwrap()\n            .candidate(&repo, &incoming_tree)\n            .unwrap()\n            .unwrap();\n        assert_eq!(candidate.commit, incoming);\n        let edit = repo\n            .commit_tree(&tree(&repo, b\"later edit\"), vec![&before], \"later edit\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &edit, Some(&before))\n            .unwrap();\n        assert!(candidate.adopt(&repo).is_err());\n        assert_eq!(repo.ref_oid(HistoryRepo::HISTORY_REF).unwrap(), Some(edit));\n    }\n\n    #[test]\n    fn divergent_merge_keeps_both_parent_histories() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let initial = tree(&repo, b\"initial\");\n        let base = repo.commit_tree(&initial, vec![], \"base\").unwrap();\n        let local = repo\n            .commit_tree(&tree(&repo, b\"local\"), vec![&base], \"local\")\n            .unwrap();\n        let remote = repo\n            .commit_tree(&tree(&repo, b\"remote\"), vec![&base], \"remote\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &local, None)\n            .unwrap();\n        repo.update_ref(UPSTREAM_REF, &remote, None).unwrap();\n        let merged = tree(&repo, b\"resolved\");\n        let candidate = Heads::read(&repo)\n            .unwrap()\n            .candidate(&repo, &merged)\n            .unwrap()\n            .unwrap();\n        candidate.adopt(&repo).unwrap();\n        let history = repo.rev_list(&candidate.commit, usize::MAX).unwrap();\n        assert_eq!(history.len(), 4);\n        assert!(history.contains(&local) && history.contains(&remote) && history.contains(&base));\n        assert_eq!(repo.output_tree_of(&candidate.commit).unwrap(), merged);\n    }\n\n    #[test]\n    fn unrelated_histories_are_never_adopted_over_local_commits() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let tree = tree(&repo, b\"same contents are not shared ancestry\");\n        let local = repo.commit_tree(&tree, vec![], \"local root\").unwrap();\n        let remote = repo.commit_tree(&tree, vec![], \"remote root\").unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &local, None)\n            .unwrap();\n        repo.update_ref(UPSTREAM_REF, &remote, None).unwrap();\n        assert!(\n            Heads::read(&repo)\n                .unwrap_err()\n                .to_string()\n                .contains(\"unrelated\")\n        );\n        assert_eq!(repo.ref_oid(HistoryRepo::HISTORY_REF).unwrap(), Some(local));\n        assert_eq!(repo.ref_oid(UPSTREAM_REF).unwrap(), Some(remote));\n    }\n}\n    pub(crate) fn update_history_head(&self, commit: &str, expected: Option<&str>) -> Result<()> {\n        self.update_ref(Self::HISTORY_REF, commit, expected)?;\n        self.git.run(PlumbingCall::new([\n            \"symbolic-ref\",\n            \"HEAD\",\n            Self::HISTORY_REF,\n        ]))\n    }\n\n    /// Ordinary ancestry is the source of truth, not per-checkpoint refs.\n    pub(crate) fn checkpoint_refs(&self) -> Result<Vec<(String, String)>> {\n        let Some(head) = self.ref_oid(Self::HISTORY_REF)? else {\n            return Ok(vec![]);\n        };\n        self.rev_list(&head, usize::MAX)?\n            .into_iter()\n            .map(|commit| {\n                let record = self.read_meta(&commit)?;\n                Ok((record.uuid, commit))\n            })\n            .collect()\n    }\n\n    pub(crate) fn read_meta(&self, commit: &str) -> Result<Checkpoint> {\n        let message = self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%B\", commit]))?;\n        let own_record = message\n            .lines()\n            .rev()\n            .find_map(|line| line.strip_prefix(Self::RECORD_TRAILER));\n        let mut record: Checkpoint = if let Some(record) = own_record {\n            serde_json::from_str(record)\n                .wrap_err_with(|| format!(\"reading history metadata for {commit}\"))?\n        } else {\n            // An ordinary Git commit needs no mise trailer. Inherit the\n            // enrollment inventory, but never its operation boundary or id.\n            let mut inherited = None;\n            for ancestor in self.rev_list(commit, usize::MAX)?.into_iter().skip(1) {\n                let message =\n                    self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%B\", &ancestor]))?;\n                if let Some(record) = message\n                    .lines()\n                    .rev()\n                    .find_map(|line| line.strip_prefix(Self::RECORD_TRAILER))\n                {\n                    inherited = Some(serde_json::from_str::<Checkpoint>(record)?);\n                    break;\n                }\n            }\n            let mut record = match inherited {\n                Some(record) => record,\n                None if super::manifest::Manifest::read(self, commit)?.is_some() => Checkpoint {\n                    schema_version: super::store::SCHEMA_VERSION,\n                    uuid: commit.into(),\n                    machine: super::store::Machine { id: \"git\".into(), name: \"git\".into() },\n                    created_at: String::new(),\n                    mise_version: String::new(),\n                    trigger: super::store::Trigger::Edit,\n                    description: String::new(),\n                    description_source: super::store::DescriptionSource::User,\n                    summary: String::new(),\n                    task: None,\n                    labels: vec![],\n                    pinned: false,\n                    tree: super::store::TreeInfo {\n                        snapshot: None, available: true, reason: None, roots: vec![],\n                        coverage: Default::default(), modes: Default::default(),\n                    },\n                    changes: Default::default(),\n                    operation: None,\n                },\n                None => bail!(\"repository has no tracked-file inventory; explicitly enroll files before using mise history\"),\n            };\n            record.uuid = commit.into();\n            record.created_at =\n                self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%cI\", commit]))?;\n            record.trigger = super::store::Trigger::Edit;\n            record.description = message\n                .lines()\n                .next()\n                .unwrap_or(\"edited tracked files\")\n                .into();\n            record.description_source = super::store::DescriptionSource::User;\n            record.summary = record.description.clone();\n            record.task = None;\n            record.labels.clear();\n            record.operation = None;\n            record.pinned = false;\n            record.tree.snapshot = Some(self.output_tree_of(commit)?);\n            record.changes = Default::default();\n            let parents =\n                self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%P\", commit]))?;\n            for change in self.changes(parents.split_whitespace().next(), commit)? {\n                let path = super::tracked::tree_path_to_display(&change.path);\n                match change.status {\n                    'A' => record.changes.added.push(path),\n                    'D' => record.changes.removed.push(path),\n                    _ => record.changes.modified.push(path),\n                }\n            }\n            record\n        };\n        record.uuid = commit.into();\n        // The commit tree is authoritative even if a normal Git operation\n        // reused a message containing metadata from an older commit.\n        record.tree.snapshot = Some(self.output_tree_of(commit)?);\n        record.tree.available = true;\n        if let Some(manifest) = super::manifest::Manifest::read(self, commit)? {\n            let tracked = manifest.tracking()?;\n            let mut coverage = tracked.coverage(&super::tracked::Walk {\n                entries: tracked.entries.clone(),\n                ..Default::default()\n            });\n            for entry in &mut coverage.entries {\n                entry.state = record.tree.coverage.entries.iter()\n                    .find(|prior| prior.path == entry.path && prior.variant == entry.variant)\n                    .map_or_else(|| \"saved\".into(), |prior| prior.state.clone());\n            }\n            record.tree.coverage = coverage;\n            let mut roots: BTreeMap<String, RootRecord> = BTreeMap::new();\n            for file in self.ls_tree(commit)? {\n                if super::sync::layout::Roots::current().locate(&file.path).path().is_none() {\n                    continue;\n                }\n                let label = file.path.split('/').next().unwrap_or_default().to_string();\n                let root = roots.entry(label.clone()).or_insert_with(|| RootRecord {\n                    label,\n                    ..Default::default()\n                });\n                root.files += 1;\n                root.bytes += file.size.unwrap_or_default();\n            }\n            record.tree.roots = roots.into_values().collect();\n        }\n        for root in &mut record.tree.roots {\n            root.path = match root.label.split('@').next().unwrap_or_default() {\n                \"home\" => crate::dirs::HOME.to_path_buf(),\n                \"config\" => super::tracked::global_config_dir(),\n                \"fs\" => PathBuf::from(std::path::MAIN_SEPARATOR.to_string()),\n                other => bail!(\"unknown history path root: {other}\"),\n            };\n        }\n        Ok(record)\n    }\n\n    /// Recursive listing of a tree (or a path inside it).\n    pub(crate) fn ls_tree(&self, spec: &str) -> Result<Vec<TreeEntry>> {\n        let out = self\n            .git\n            .output(PlumbingCall::new([\"ls-tree\", \"-r\", \"-l\", \"-z\", spec]))?;\n        let mut entries = vec![];\n        for record in out.split(|byte| *byte == 0) {\n            if record.is_empty() {\n                continue;\n            }\n            let record = std::str::from_utf8(record).wrap_err(\n                \"history cannot represent a non-UTF-8 filename; refusing to change its bytes\",\n            )?;\n            let Some((meta, path)) = record.split_once('\\t') else {\n                continue;\n            };\n            let mut fields = meta.split_whitespace();\n//! Portable enrollment metadata stored in the ordinary tracked-file tree.\n//! This is configuration, not a second history or a machine recovery record.\n\nuse eyre::{Result, bail};\nuse serde::{Deserialize, Serialize};\n\nuse super::select::Variant;\nuse super::shadow::{HistoryRepo, Overlay};\n\npub(crate) const PATH: &str = \".mise-history/manifest.json\";\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Enrollment {\n    /// A portable repository path, rooted at `home/` or `config/`.\n    pub path: String,\n    pub autosave: bool,\n    pub encrypt: bool,\n    pub variants: Vec<Variant>,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Manifest {\n    pub format: u32,\n    pub enrollment: Vec<Enrollment>,\n    pub exclude: Vec<String>,\n    pub recipients: Vec<String>,\n}\n\nimpl Default for Manifest {\n    fn default() -> Self {\n        Self {\n            format: 1,\n            enrollment: vec![],\n            exclude: vec![],\n            recipients: vec![],\n        }\n    }\n}\n\nimpl Manifest {\n    /// Restore enrollment from Git without needing a captured mise config.\n    /// Deployment inputs are validated separately; none are inferred here.\n    pub(crate) fn tracking(&self) -> Result<super::tracked::TrackedSet> {\n        self.validate()?;\n        let roots = super::sync::layout::Roots::current();\n        let environments = super::select::active_environments();\n        let mut tracked = super::tracked::TrackedSet {\n            manifest: self.clone(),\n            exclude: self.exclude.clone(),\n            ..Default::default()\n        };\n        for enrollment in &self.enrollment {\n            let variant = match super::select::select(&enrollment.variants, &environments) {\n                super::select::Selection::Single => None,\n                super::select::Selection::Variant(variant) => Some(variant.name()),\n                super::select::Selection::NoMatch => continue,\n                super::select::Selection::Ambiguous(_) => bail!(\"ambiguous variants for {}\", enrollment.path),\n            };\n            let local = roots.locate(&enrollment.path).path()\n                .ok_or_else(|| eyre::eyre!(\"invalid enrollment path {}\", enrollment.path))?\n                .to_path_buf();\n            let mut policy = crate::system::files::FilePolicy::for_mode(crate::system::files::FileMode::Track);\n            policy.autosave = enrollment.autosave;\n            policy.encrypt = enrollment.encrypt;\n            let mut entry = super::tracked::TrackedEntry::new(local, super::tracked::EntryKind::Track, \"track\", policy);\n            entry.variant = variant;\n            tracked.entries.push(entry);\n        }\n        Ok(tracked)\n    }\n\n    /// Every declared encrypted stream, including platforms inactive here.\n    pub(crate) fn encrypted_paths(&self) -> std::collections::BTreeSet<String> {\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in self.enrollment.iter().filter(|entry| entry.encrypt) {\n            if entry.variants.is_empty() {\n                paths.insert(entry.path.clone());\n            } else {\n                let (root, relative) = entry.path.split_once('/').unwrap_or((&entry.path, \"\"));\n                for variant in &entry.variants {\n                    let stem = format!(\"{root}@{}\", variant.name());\n                    paths.insert(if relative.is_empty() {\n                        stem\n                    } else {\n                        format!(\"{stem}/{relative}\")\n                    });\n                }\n            }\n        }\n        paths\n    }\n\n    fn owner(&self, path: &str) -> Option<&Enrollment> {\n        self.enrollment\n            .iter()\n            .filter(|entry| {\n                path == entry.path\n                    || path\n                        .strip_prefix(&entry.path)\n                        .is_some_and(|rest| rest.starts_with('/'))\n            })\n            .max_by_key(|entry| entry.path.len())\n    }\n\n    /// Carry inactive streams and repository-owned files from the same parent\n    /// tree. Paths explicitly untracked since that parent are deliberately not\n    /// carried; no live file is removed by this tree construction.\n    pub(crate) fn preserve_other_files(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\n        let Some(parent) = repo.ref_oid(HistoryRepo::HISTORY_REF)? else {\n            return Ok(tree.into());\n        };\n        let previous = Self::read(repo, &parent)?.unwrap_or_default();\n        let environments = super::select::active_environments();\n        let mut overlays = vec![];\n        for file in repo.ls_tree(&parent)? {\n            if file.path.starts_with(\".mise-history/\") {\n                continue;\n            }\n            let (stem, relative) = file.path.split_once('/').unwrap_or((&file.path, \"\"));\n            let (root, variant) = stem\n                .split_once('@')\n                .map_or((stem, None), |(root, variant)| (root, Some(variant)));\n            let portable = if relative.is_empty() {\n                root.into()\n            } else {\n                format!(\"{root}/{relative}\")\n            };\n            let carry = match self.owner(&portable) {\n                None => previous.owner(&portable).is_none(),\n                Some(entry) => {\n                    let selected = match super::select::select(&entry.variants, &environments) {\n                        super::select::Selection::Single => None,\n                        super::select::Selection::Variant(variant) => Some(variant.name()),\n                        super::select::Selection::NoMatch => Some(String::new()),\n                        super::select::Selection::Ambiguous(_) => {\n                            bail!(\"ambiguous variants for {}\", entry.path)\n                        }\n                    };\n                    variant != selected.as_deref()\n                        && variant.is_some_and(|name| {\n                            entry.variants.iter().any(|variant| variant.name() == name)\n                        })\n                }\n            };\n            if carry {\n                overlays.push(Overlay {\n                    path: file.path,\n                    object: Some((file.mode, file.oid)),\n                });\n            }\n        }\n        repo.compose(tree, &overlays)\n    }\n\n    pub(crate) fn validate(&self) -> Result<()> {\n        if self.format != 1 {\n            bail!(\"unsupported dotfile repository format {}\", self.format);\n        }\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in &self.enrollment {\n            if !super::sync::layout::is_safe_branch_path(&entry.path)\n                || !(entry.path.starts_with(\"home/\")\n                    || entry.path == \"config\"\n                    || entry.path.starts_with(\"config/\"))\n                || !paths.insert(&entry.path)\n            {\n                bail!(\"invalid or repeated enrollment path {}\", entry.path);\n            }\n            let mut variants = std::collections::BTreeSet::new();\n            for variant in &entry.variants {\n                let name = variant.name();\n                if name.contains('@')\n                    || !super::sync::layout::is_safe_branch_path(&name)\n                    || !variants.insert(name)\n                {\n                    bail!(\"invalid or repeated variant for {}\", entry.path);\n                }\n            }\n","stderr":"","aggregated_output":"//! Ordinary branch ancestry. Reconciliation supplies a fully validated tree;\n//! this layer preserves commit identities and never constructs another history.\n\nuse eyre::{Result, bail};\n\nuse super::network::UPSTREAM_REF;\nuse crate::system::history::shadow::HistoryRepo;\n\n#[derive(Debug)]\npub(crate) struct Heads {\n    pub local: Option<String>,\n    pub remote: Option<String>,\n    pub base: Option<String>,\n}\n\n#[derive(Debug)]\npub(crate) struct Candidate {\n    pub commit: String,\n    expected_local: Option<String>,\n    expected_remote: Option<String>,\n}\n\nimpl Heads {\n    pub(crate) fn read(repo: &HistoryRepo) -> Result<Self> {\n        let local = repo.ref_oid(HistoryRepo::HISTORY_REF)?;\n        let remote = repo.ref_oid(UPSTREAM_REF)?;\n        let base = match (&local, &remote) {\n            (Some(local), Some(remote)) => {\n                let bases = repo.merge_bases(local, remote)?;\n                if bases.is_empty() {\n                    bail!(\n                        \"local and origin histories are unrelated; use a fresh setup store to adopt origin, or reconcile the repositories explicitly with Git. Neither history was replaced\"\n                    );\n                }\n                // A criss-cross merge has shared ancestry but no unique base.\n                // It needs a merge commit, never an arbitrary fast-forward.\n                (bases.len() == 1).then(|| bases[0].clone())\n            }\n            _ => None,\n        };\n        Ok(Self {\n            local,\n            remote,\n            base,\n        })\n    }\n\n    /// Preparing a candidate does not advance a branch or write live files.\n    /// The caller must finish its complete application before adopting it.\n    pub(crate) fn candidate(&self, repo: &HistoryRepo, tree: &str) -> Result<Option<Candidate>> {\n        let commit = match (&self.local, &self.remote) {\n            (None, None) => return Ok(None),\n            (Some(local), None) => {\n                if repo.output_tree_of(local)? != tree {\n                    bail!(\"saved files changed while preparing publication; plan again\");\n                }\n                local.clone()\n            }\n            (None, Some(remote)) => {\n                if repo.output_tree_of(remote)? != tree {\n                    bail!(\"incoming files changed while preparing adoption; plan again\");\n                }\n                remote.clone()\n            }\n            (Some(local), Some(remote)) => {\n                if self.base.as_ref() == Some(remote) {\n                    if repo.output_tree_of(local)? != tree {\n                        bail!(\"saved files changed while preparing publication; plan again\");\n                    }\n                    local.clone()\n                } else if self.base.as_ref() == Some(local) && repo.output_tree_of(remote)? == tree\n                {\n                    remote.clone()\n                } else {\n                    repo.commit_tree(tree, vec![local, remote], \"merge origin dotfiles\")?\n                }\n            }\n        };\n        Ok(Some(Candidate {\n            commit,\n            expected_local: self.local.clone(),\n            expected_remote: self.remote.clone(),\n        }))\n    }\n}\n\nimpl Candidate {\n    pub(crate) fn adopt(&self, repo: &HistoryRepo) -> Result<()> {\n        if repo.ref_oid(UPSTREAM_REF)? != self.expected_remote {\n            bail!(\"origin changed while applying this setup; reconcile again before publication\");\n        }\n        // Compare-and-swap also verifies no local boundary/save was inserted\n        // during application. The caller must recompute instead of dropping it.\n        repo.update_history_head(\n            &self.commit,\n            self.expected_local.as_deref(),\n        )\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn tree(repo: &HistoryRepo, bytes: &[u8]) -> String {\n        repo.compose(\n            &repo.empty_object(\"tree\").unwrap(),\n            &[crate::system::history::shadow::Overlay {\n                path: \"home/.zshrc\".into(),\n                object: Some((\"100644\".into(), repo.hash_blob(bytes).unwrap())),\n            }],\n        )\n        .unwrap()\n    }\n\n    #[test]\n    fn delayed_publication_reuses_all_local_commits() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let first_tree = tree(&repo, b\"one\");\n        let first = repo.commit_tree(&first_tree, vec![], \"first save\").unwrap();\n        let second_tree = tree(&repo, b\"two\");\n        let second = repo\n            .commit_tree(&second_tree, vec![&first], \"second save\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &second, None)\n            .unwrap();\n        let candidate = Heads::read(&repo)\n            .unwrap()\n            .candidate(&repo, &second_tree)\n            .unwrap()\n            .unwrap();\n        assert_eq!(candidate.commit, second);\n        candidate.adopt(&repo).unwrap();\n        assert_eq!(\n            repo.rev_list(&candidate.commit, usize::MAX).unwrap(),\n            vec![second, first]\n        );\n        assert!(repo.list_refs(\"refs/setup/\").unwrap().is_empty());\n    }\n\n    #[test]\n    fn fast_forward_keeps_remote_commit_and_stale_candidates_preserve_edits() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let before_tree = tree(&repo, b\"before\");\n        let before = repo.commit_tree(&before_tree, vec![], \"before\").unwrap();\n        let incoming_tree = tree(&repo, b\"incoming\");\n        let incoming = repo\n            .commit_tree(&incoming_tree, vec![&before], \"incoming\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &before, None)\n            .unwrap();\n        repo.update_ref(UPSTREAM_REF, &incoming, None).unwrap();\n        let candidate = Heads::read(&repo)\n            .unwrap()\n            .candidate(&repo, &incoming_tree)\n            .unwrap()\n            .unwrap();\n        assert_eq!(candidate.commit, incoming);\n        let edit = repo\n            .commit_tree(&tree(&repo, b\"later edit\"), vec![&before], \"later edit\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &edit, Some(&before))\n            .unwrap();\n        assert!(candidate.adopt(&repo).is_err());\n        assert_eq!(repo.ref_oid(HistoryRepo::HISTORY_REF).unwrap(), Some(edit));\n    }\n\n    #[test]\n    fn divergent_merge_keeps_both_parent_histories() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let initial = tree(&repo, b\"initial\");\n        let base = repo.commit_tree(&initial, vec![], \"base\").unwrap();\n        let local = repo\n            .commit_tree(&tree(&repo, b\"local\"), vec![&base], \"local\")\n            .unwrap();\n        let remote = repo\n            .commit_tree(&tree(&repo, b\"remote\"), vec![&base], \"remote\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &local, None)\n            .unwrap();\n        repo.update_ref(UPSTREAM_REF, &remote, None).unwrap();\n        let merged = tree(&repo, b\"resolved\");\n        let candidate = Heads::read(&repo)\n            .unwrap()\n            .candidate(&repo, &merged)\n            .unwrap()\n            .unwrap();\n        candidate.adopt(&repo).unwrap();\n        let history = repo.rev_list(&candidate.commit, usize::MAX).unwrap();\n        assert_eq!(history.len(), 4);\n        assert!(history.contains(&local) && history.contains(&remote) && history.contains(&base));\n        assert_eq!(repo.output_tree_of(&candidate.commit).unwrap(), merged);\n    }\n\n    #[test]\n    fn unrelated_histories_are_never_adopted_over_local_commits() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let tree = tree(&repo, b\"same contents are not shared ancestry\");\n        let local = repo.commit_tree(&tree, vec![], \"local root\").unwrap();\n        let remote = repo.commit_tree(&tree, vec![], \"remote root\").unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &local, None)\n            .unwrap();\n        repo.update_ref(UPSTREAM_REF, &remote, None).unwrap();\n        assert!(\n            Heads::read(&repo)\n                .unwrap_err()\n                .to_string()\n                .contains(\"unrelated\")\n        );\n        assert_eq!(repo.ref_oid(HistoryRepo::HISTORY_REF).unwrap(), Some(local));\n        assert_eq!(repo.ref_oid(UPSTREAM_REF).unwrap(), Some(remote));\n    }\n}\n    pub(crate) fn update_history_head(&self, commit: &str, expected: Option<&str>) -> Result<()> {\n        self.update_ref(Self::HISTORY_REF, commit, expected)?;\n        self.git.run(PlumbingCall::new([\n            \"symbolic-ref\",\n            \"HEAD\",\n            Self::HISTORY_REF,\n        ]))\n    }\n\n    /// Ordinary ancestry is the source of truth, not per-checkpoint refs.\n    pub(crate) fn checkpoint_refs(&self) -> Result<Vec<(String, String)>> {\n        let Some(head) = self.ref_oid(Self::HISTORY_REF)? else {\n            return Ok(vec![]);\n        };\n        self.rev_list(&head, usize::MAX)?\n            .into_iter()\n            .map(|commit| {\n                let record = self.read_meta(&commit)?;\n                Ok((record.uuid, commit))\n            })\n            .collect()\n    }\n\n    pub(crate) fn read_meta(&self, commit: &str) -> Result<Checkpoint> {\n        let message = self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%B\", commit]))?;\n        let own_record = message\n            .lines()\n            .rev()\n            .find_map(|line| line.strip_prefix(Self::RECORD_TRAILER));\n        let mut record: Checkpoint = if let Some(record) = own_record {\n            serde_json::from_str(record)\n                .wrap_err_with(|| format!(\"reading history metadata for {commit}\"))?\n        } else {\n            // An ordinary Git commit needs no mise trailer. Inherit the\n            // enrollment inventory, but never its operation boundary or id.\n            let mut inherited = None;\n            for ancestor in self.rev_list(commit, usize::MAX)?.into_iter().skip(1) {\n                let message =\n                    self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%B\", &ancestor]))?;\n                if let Some(record) = message\n                    .lines()\n                    .rev()\n                    .find_map(|line| line.strip_prefix(Self::RECORD_TRAILER))\n                {\n                    inherited = Some(serde_json::from_str::<Checkpoint>(record)?);\n                    break;\n                }\n            }\n            let mut record = match inherited {\n                Some(record) => record,\n                None if super::manifest::Manifest::read(self, commit)?.is_some() => Checkpoint {\n                    schema_version: super::store::SCHEMA_VERSION,\n                    uuid: commit.into(),\n                    machine: super::store::Machine { id: \"git\".into(), name: \"git\".into() },\n                    created_at: String::new(),\n                    mise_version: String::new(),\n                    trigger: super::store::Trigger::Edit,\n                    description: String::new(),\n                    description_source: super::store::DescriptionSource::User,\n                    summary: String::new(),\n                    task: None,\n                    labels: vec![],\n                    pinned: false,\n                    tree: super::store::TreeInfo {\n                        snapshot: None, available: true, reason: None, roots: vec![],\n                        coverage: Default::default(), modes: Default::default(),\n                    },\n                    changes: Default::default(),\n                    operation: None,\n                },\n                None => bail!(\"repository has no tracked-file inventory; explicitly enroll files before using mise history\"),\n            };\n            record.uuid = commit.into();\n            record.created_at =\n                self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%cI\", commit]))?;\n            record.trigger = super::store::Trigger::Edit;\n            record.description = message\n                .lines()\n                .next()\n                .unwrap_or(\"edited tracked files\")\n                .into();\n            record.description_source = super::store::DescriptionSource::User;\n            record.summary = record.description.clone();\n            record.task = None;\n            record.labels.clear();\n            record.operation = None;\n            record.pinned = false;\n            record.tree.snapshot = Some(self.output_tree_of(commit)?);\n            record.changes = Default::default();\n            let parents =\n                self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%P\", commit]))?;\n            for change in self.changes(parents.split_whitespace().next(), commit)? {\n                let path = super::tracked::tree_path_to_display(&change.path);\n                match change.status {\n                    'A' => record.changes.added.push(path),\n                    'D' => record.changes.removed.push(path),\n                    _ => record.changes.modified.push(path),\n                }\n            }\n            record\n        };\n        record.uuid = commit.into();\n        // The commit tree is authoritative even if a normal Git operation\n        // reused a message containing metadata from an older commit.\n        record.tree.snapshot = Some(self.output_tree_of(commit)?);\n        record.tree.available = true;\n        if let Some(manifest) = super::manifest::Manifest::read(self, commit)? {\n            let tracked = manifest.tracking()?;\n            let mut coverage = tracked.coverage(&super::tracked::Walk {\n                entries: tracked.entries.clone(),\n                ..Default::default()\n            });\n            for entry in &mut coverage.entries {\n                entry.state = record.tree.coverage.entries.iter()\n                    .find(|prior| prior.path == entry.path && prior.variant == entry.variant)\n                    .map_or_else(|| \"saved\".into(), |prior| prior.state.clone());\n            }\n            record.tree.coverage = coverage;\n            let mut roots: BTreeMap<String, RootRecord> = BTreeMap::new();\n            for file in self.ls_tree(commit)? {\n                if super::sync::layout::Roots::current().locate(&file.path).path().is_none() {\n                    continue;\n                }\n                let label = file.path.split('/').next().unwrap_or_default().to_string();\n                let root = roots.entry(label.clone()).or_insert_with(|| RootRecord {\n                    label,\n                    ..Default::default()\n                });\n                root.files += 1;\n                root.bytes += file.size.unwrap_or_default();\n            }\n            record.tree.roots = roots.into_values().collect();\n        }\n        for root in &mut record.tree.roots {\n            root.path = match root.label.split('@').next().unwrap_or_default() {\n                \"home\" => crate::dirs::HOME.to_path_buf(),\n                \"config\" => super::tracked::global_config_dir(),\n                \"fs\" => PathBuf::from(std::path::MAIN_SEPARATOR.to_string()),\n                other => bail!(\"unknown history path root: {other}\"),\n            };\n        }\n        Ok(record)\n    }\n\n    /// Recursive listing of a tree (or a path inside it).\n    pub(crate) fn ls_tree(&self, spec: &str) -> Result<Vec<TreeEntry>> {\n        let out = self\n            .git\n            .output(PlumbingCall::new([\"ls-tree\", \"-r\", \"-l\", \"-z\", spec]))?;\n        let mut entries = vec![];\n        for record in out.split(|byte| *byte == 0) {\n            if record.is_empty() {\n                continue;\n            }\n            let record = std::str::from_utf8(record).wrap_err(\n                \"history cannot represent a non-UTF-8 filename; refusing to change its bytes\",\n            )?;\n            let Some((meta, path)) = record.split_once('\\t') else {\n                continue;\n            };\n            let mut fields = meta.split_whitespace();\n//! Portable enrollment metadata stored in the ordinary tracked-file tree.\n//! This is configuration, not a second history or a machine recovery record.\n\nuse eyre::{Result, bail};\nuse serde::{Deserialize, Serialize};\n\nuse super::select::Variant;\nuse super::shadow::{HistoryRepo, Overlay};\n\npub(crate) const PATH: &str = \".mise-history/manifest.json\";\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Enrollment {\n    /// A portable repository path, rooted at `home/` or `config/`.\n    pub path: String,\n    pub autosave: bool,\n    pub encrypt: bool,\n    pub variants: Vec<Variant>,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Manifest {\n    pub format: u32,\n    pub enrollment: Vec<Enrollment>,\n    pub exclude: Vec<String>,\n    pub recipients: Vec<String>,\n}\n\nimpl Default for Manifest {\n    fn default() -> Self {\n        Self {\n            format: 1,\n            enrollment: vec![],\n            exclude: vec![],\n            recipients: vec![],\n        }\n    }\n}\n\nimpl Manifest {\n    /// Restore enrollment from Git without needing a captured mise config.\n    /// Deployment inputs are validated separately; none are inferred here.\n    pub(crate) fn tracking(&self) -> Result<super::tracked::TrackedSet> {\n        self.validate()?;\n        let roots = super::sync::layout::Roots::current();\n        let environments = super::select::active_environments();\n        let mut tracked = super::tracked::TrackedSet {\n            manifest: self.clone(),\n            exclude: self.exclude.clone(),\n            ..Default::default()\n        };\n        for enrollment in &self.enrollment {\n            let variant = match super::select::select(&enrollment.variants, &environments) {\n                super::select::Selection::Single => None,\n                super::select::Selection::Variant(variant) => Some(variant.name()),\n                super::select::Selection::NoMatch => continue,\n                super::select::Selection::Ambiguous(_) => bail!(\"ambiguous variants for {}\", enrollment.path),\n            };\n            let local = roots.locate(&enrollment.path).path()\n                .ok_or_else(|| eyre::eyre!(\"invalid enrollment path {}\", enrollment.path))?\n                .to_path_buf();\n            let mut policy = crate::system::files::FilePolicy::for_mode(crate::system::files::FileMode::Track);\n            policy.autosave = enrollment.autosave;\n            policy.encrypt = enrollment.encrypt;\n            let mut entry = super::tracked::TrackedEntry::new(local, super::tracked::EntryKind::Track, \"track\", policy);\n            entry.variant = variant;\n            tracked.entries.push(entry);\n        }\n        Ok(tracked)\n    }\n\n    /// Every declared encrypted stream, including platforms inactive here.\n    pub(crate) fn encrypted_paths(&self) -> std::collections::BTreeSet<String> {\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in self.enrollment.iter().filter(|entry| entry.encrypt) {\n            if entry.variants.is_empty() {\n                paths.insert(entry.path.clone());\n            } else {\n                let (root, relative) = entry.path.split_once('/').unwrap_or((&entry.path, \"\"));\n                for variant in &entry.variants {\n                    let stem = format!(\"{root}@{}\", variant.name());\n                    paths.insert(if relative.is_empty() {\n                        stem\n                    } else {\n                        format!(\"{stem}/{relative}\")\n                    });\n                }\n            }\n        }\n        paths\n    }\n\n    fn owner(&self, path: &str) -> Option<&Enrollment> {\n        self.enrollment\n            .iter()\n            .filter(|entry| {\n                path == entry.path\n                    || path\n                        .strip_prefix(&entry.path)\n                        .is_some_and(|rest| rest.starts_with('/'))\n            })\n            .max_by_key(|entry| entry.path.len())\n    }\n\n    /// Carry inactive streams and repository-owned files from the same parent\n    /// tree. Paths explicitly untracked since that parent are deliberately not\n    /// carried; no live file is removed by this tree construction.\n    pub(crate) fn preserve_other_files(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\n        let Some(parent) = repo.ref_oid(HistoryRepo::HISTORY_REF)? else {\n            return Ok(tree.into());\n        };\n        let previous = Self::read(repo, &parent)?.unwrap_or_default();\n        let environments = super::select::active_environments();\n        let mut overlays = vec![];\n        for file in repo.ls_tree(&parent)? {\n            if file.path.starts_with(\".mise-history/\") {\n                continue;\n            }\n            let (stem, relative) = file.path.split_once('/').unwrap_or((&file.path, \"\"));\n            let (root, variant) = stem\n                .split_once('@')\n                .map_or((stem, None), |(root, variant)| (root, Some(variant)));\n            let portable = if relative.is_empty() {\n                root.into()\n            } else {\n                format!(\"{root}/{relative}\")\n            };\n            let carry = match self.owner(&portable) {\n                None => previous.owner(&portable).is_none(),\n                Some(entry) => {\n                    let selected = match super::select::select(&entry.variants, &environments) {\n                        super::select::Selection::Single => None,\n                        super::select::Selection::Variant(variant) => Some(variant.name()),\n                        super::select::Selection::NoMatch => Some(String::new()),\n                        super::select::Selection::Ambiguous(_) => {\n                            bail!(\"ambiguous variants for {}\", entry.path)\n                        }\n                    };\n                    variant != selected.as_deref()\n                        && variant.is_some_and(|name| {\n                            entry.variants.iter().any(|variant| variant.name() == name)\n                        })\n                }\n            };\n            if carry {\n                overlays.push(Overlay {\n                    path: file.path,\n                    object: Some((file.mode, file.oid)),\n                });\n            }\n        }\n        repo.compose(tree, &overlays)\n    }\n\n    pub(crate) fn validate(&self) -> Result<()> {\n        if self.format != 1 {\n            bail!(\"unsupported dotfile repository format {}\", self.format);\n        }\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in &self.enrollment {\n            if !super::sync::layout::is_safe_branch_path(&entry.path)\n                || !(entry.path.starts_with(\"home/\")\n                    || entry.path == \"config\"\n                    || entry.path.starts_with(\"config/\"))\n                || !paths.insert(&entry.path)\n            {\n                bail!(\"invalid or repeated enrollment path {}\", entry.path);\n            }\n            let mut variants = std::collections::BTreeSet::new();\n            for variant in &entry.variants {\n                let name = variant.name();\n                if name.contains('@')\n                    || !super::sync::layout::is_safe_branch_path(&name)\n                    || !variants.insert(name)\n                {\n                    bail!(\"invalid or repeated variant for {}\", entry.path);\n                }\n            }\n","exit_code":0,"duration":{"secs":0,"nanos":11209},"formatted_output":"//! Ordinary branch ancestry. Reconciliation supplies a fully validated tree;\n//! this layer preserves commit identities and never constructs another history.\n\nuse eyre::{Result, bail};\n\nuse super::network::UPSTREAM_REF;\nuse crate::system::history::shadow::HistoryRepo;\n\n#[derive(Debug)]\npub(crate) struct Heads {\n    pub local: Option<String>,\n    pub remote: Option<String>,\n    pub base: Option<String>,\n}\n\n#[derive(Debug)]\npub(crate) struct Candidate {\n    pub commit: String,\n    expected_local: Option<String>,\n    expected_remote: Option<String>,\n}\n\nimpl Heads {\n    pub(crate) fn read(repo: &HistoryRepo) -> Result<Self> {\n        let local = repo.ref_oid(HistoryRepo::HISTORY_REF)?;\n        let remote = repo.ref_oid(UPSTREAM_REF)?;\n        let base = match (&local, &remote) {\n            (Some(local), Some(remote)) => {\n                let bases = repo.merge_bases(local, remote)?;\n                if bases.is_empty() {\n                    bail!(\n                        \"local and origin histories are unrelated; use a fresh setup store to adopt origin, or reconcile the repositories explicitly with Git. Neither history was replaced\"\n                    );\n                }\n                // A criss-cross merge has shared ancestry but no unique base.\n                // It needs a merge commit, never an arbitrary fast-forward.\n                (bases.len() == 1).then(|| bases[0].clone())\n            }\n            _ => None,\n        };\n        Ok(Self {\n            local,\n            remote,\n            base,\n        })\n    }\n\n    /// Preparing a candidate does not advance a branch or write live files.\n    /// The caller must finish its complete application before adopting it.\n    pub(crate) fn candidate(&self, repo: &HistoryRepo, tree: &str) -> Result<Option<Candidate>> {\n        let commit = match (&self.local, &self.remote) {\n            (None, None) => return Ok(None),\n            (Some(local), None) => {\n                if repo.output_tree_of(local)? != tree {\n                    bail!(\"saved files changed while preparing publication; plan again\");\n                }\n                local.clone()\n            }\n            (None, Some(remote)) => {\n                if repo.output_tree_of(remote)? != tree {\n                    bail!(\"incoming files changed while preparing adoption; plan again\");\n                }\n                remote.clone()\n            }\n            (Some(local), Some(remote)) => {\n                if self.base.as_ref() == Some(remote) {\n                    if repo.output_tree_of(local)? != tree {\n                        bail!(\"saved files changed while preparing publication; plan again\");\n                    }\n                    local.clone()\n                } else if self.base.as_ref() == Some(local) && repo.output_tree_of(remote)? == tree\n                {\n                    remote.clone()\n                } else {\n                    repo.commit_tree(tree, vec![local, remote], \"merge origin dotfiles\")?\n                }\n            }\n        };\n        Ok(Some(Candidate {\n            commit,\n            expected_local: self.local.clone(),\n            expected_remote: self.remote.clone(),\n        }))\n    }\n}\n\nimpl Candidate {\n    pub(crate) fn adopt(&self, repo: &HistoryRepo) -> Result<()> {\n        if repo.ref_oid(UPSTREAM_REF)? != self.expected_remote {\n            bail!(\"origin changed while applying this setup; reconcile again before publication\");\n        }\n        // Compare-and-swap also verifies no local boundary/save was inserted\n        // during application. The caller must recompute instead of dropping it.\n        repo.update_history_head(\n            &self.commit,\n            self.expected_local.as_deref(),\n        )\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn tree(repo: &HistoryRepo, bytes: &[u8]) -> String {\n        repo.compose(\n            &repo.empty_object(\"tree\").unwrap(),\n            &[crate::system::history::shadow::Overlay {\n                path: \"home/.zshrc\".into(),\n                object: Some((\"100644\".into(), repo.hash_blob(bytes).unwrap())),\n            }],\n        )\n        .unwrap()\n    }\n\n    #[test]\n    fn delayed_publication_reuses_all_local_commits() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let first_tree = tree(&repo, b\"one\");\n        let first = repo.commit_tree(&first_tree, vec![], \"first save\").unwrap();\n        let second_tree = tree(&repo, b\"two\");\n        let second = repo\n            .commit_tree(&second_tree, vec![&first], \"second save\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &second, None)\n            .unwrap();\n        let candidate = Heads::read(&repo)\n            .unwrap()\n            .candidate(&repo, &second_tree)\n            .unwrap()\n            .unwrap();\n        assert_eq!(candidate.commit, second);\n        candidate.adopt(&repo).unwrap();\n        assert_eq!(\n            repo.rev_list(&candidate.commit, usize::MAX).unwrap(),\n            vec![second, first]\n        );\n        assert!(repo.list_refs(\"refs/setup/\").unwrap().is_empty());\n    }\n\n    #[test]\n    fn fast_forward_keeps_remote_commit_and_stale_candidates_preserve_edits() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let before_tree = tree(&repo, b\"before\");\n        let before = repo.commit_tree(&before_tree, vec![], \"before\").unwrap();\n        let incoming_tree = tree(&repo, b\"incoming\");\n        let incoming = repo\n            .commit_tree(&incoming_tree, vec![&before], \"incoming\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &before, None)\n            .unwrap();\n        repo.update_ref(UPSTREAM_REF, &incoming, None).unwrap();\n        let candidate = Heads::read(&repo)\n            .unwrap()\n            .candidate(&repo, &incoming_tree)\n            .unwrap()\n            .unwrap();\n        assert_eq!(candidate.commit, incoming);\n        let edit = repo\n            .commit_tree(&tree(&repo, b\"later edit\"), vec![&before], \"later edit\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &edit, Some(&before))\n            .unwrap();\n        assert!(candidate.adopt(&repo).is_err());\n        assert_eq!(repo.ref_oid(HistoryRepo::HISTORY_REF).unwrap(), Some(edit));\n    }\n\n    #[test]\n    fn divergent_merge_keeps_both_parent_histories() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let initial = tree(&repo, b\"initial\");\n        let base = repo.commit_tree(&initial, vec![], \"base\").unwrap();\n        let local = repo\n            .commit_tree(&tree(&repo, b\"local\"), vec![&base], \"local\")\n            .unwrap();\n        let remote = repo\n            .commit_tree(&tree(&repo, b\"remote\"), vec![&base], \"remote\")\n            .unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &local, None)\n            .unwrap();\n        repo.update_ref(UPSTREAM_REF, &remote, None).unwrap();\n        let merged = tree(&repo, b\"resolved\");\n        let candidate = Heads::read(&repo)\n            .unwrap()\n            .candidate(&repo, &merged)\n            .unwrap()\n            .unwrap();\n        candidate.adopt(&repo).unwrap();\n        let history = repo.rev_list(&candidate.commit, usize::MAX).unwrap();\n        assert_eq!(history.len(), 4);\n        assert!(history.contains(&local) && history.contains(&remote) && history.contains(&base));\n        assert_eq!(repo.output_tree_of(&candidate.commit).unwrap(), merged);\n    }\n\n    #[test]\n    fn unrelated_histories_are_never_adopted_over_local_commits() {\n        let temporary = tempfile::tempdir().unwrap();\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\n            .unwrap()\n            .unwrap();\n        let tree = tree(&repo, b\"same contents are not shared ancestry\");\n        let local = repo.commit_tree(&tree, vec![], \"local root\").unwrap();\n        let remote = repo.commit_tree(&tree, vec![], \"remote root\").unwrap();\n        repo.update_ref(HistoryRepo::HISTORY_REF, &local, None)\n            .unwrap();\n        repo.update_ref(UPSTREAM_REF, &remote, None).unwrap();\n        assert!(\n            Heads::read(&repo)\n                .unwrap_err()\n                .to_string()\n                .contains(\"unrelated\")\n        );\n        assert_eq!(repo.ref_oid(HistoryRepo::HISTORY_REF).unwrap(), Some(local));\n        assert_eq!(repo.ref_oid(UPSTREAM_REF).unwrap(), Some(remote));\n    }\n}\n    pub(crate) fn update_history_head(&self, commit: &str, expected: Option<&str>) -> Result<()> {\n        self.update_ref(Self::HISTORY_REF, commit, expected)?;\n        self.git.run(PlumbingCall::new([\n            \"symbolic-ref\",\n            \"HEAD\",\n            Self::HISTORY_REF,\n        ]))\n    }\n\n    /// Ordinary ancestry is the source of truth, not per-checkpoint refs.\n    pub(crate) fn checkpoint_refs(&self) -> Result<Vec<(String, String)>> {\n        let Some(head) = self.ref_oid(Self::HISTORY_REF)? else {\n            return Ok(vec![]);\n        };\n        self.rev_list(&head, usize::MAX)?\n            .into_iter()\n            .map(|commit| {\n                let record = self.read_meta(&commit)?;\n                Ok((record.uuid, commit))\n            })\n            .collect()\n    }\n\n    pub(crate) fn read_meta(&self, commit: &str) -> Result<Checkpoint> {\n        let message = self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%B\", commit]))?;\n        let own_record = message\n            .lines()\n            .rev()\n            .find_map(|line| line.strip_prefix(Self::RECORD_TRAILER));\n        let mut record: Checkpoint = if let Some(record) = own_record {\n            serde_json::from_str(record)\n                .wrap_err_with(|| format!(\"reading history metadata for {commit}\"))?\n        } else {\n            // An ordinary Git commit needs no mise trailer. Inherit the\n            // enrollment inventory, but never its operation boundary or id.\n            let mut inherited = None;\n            for ancestor in self.rev_list(commit, usize::MAX)?.into_iter().skip(1) {\n                let message =\n                    self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%B\", &ancestor]))?;\n                if let Some(record) = message\n                    .lines()\n                    .rev()\n                    .find_map(|line| line.strip_prefix(Self::RECORD_TRAILER))\n                {\n                    inherited = Some(serde_json::from_str::<Checkpoint>(record)?);\n                    break;\n                }\n            }\n            let mut record = match inherited {\n                Some(record) => record,\n                None if super::manifest::Manifest::read(self, commit)?.is_some() => Checkpoint {\n                    schema_version: super::store::SCHEMA_VERSION,\n                    uuid: commit.into(),\n                    machine: super::store::Machine { id: \"git\".into(), name: \"git\".into() },\n                    created_at: String::new(),\n                    mise_version: String::new(),\n                    trigger: super::store::Trigger::Edit,\n                    description: String::new(),\n                    description_source: super::store::DescriptionSource::User,\n                    summary: String::new(),\n                    task: None,\n                    labels: vec![],\n                    pinned: false,\n                    tree: super::store::TreeInfo {\n                        snapshot: None, available: true, reason: None, roots: vec![],\n                        coverage: Default::default(), modes: Default::default(),\n                    },\n                    changes: Default::default(),\n                    operation: None,\n                },\n                None => bail!(\"repository has no tracked-file inventory; explicitly enroll files before using mise history\"),\n            };\n            record.uuid = commit.into();\n            record.created_at =\n                self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%cI\", commit]))?;\n            record.trigger = super::store::Trigger::Edit;\n            record.description = message\n                .lines()\n                .next()\n                .unwrap_or(\"edited tracked files\")\n                .into();\n            record.description_source = super::store::DescriptionSource::User;\n            record.summary = record.description.clone();\n            record.task = None;\n            record.labels.clear();\n            record.operation = None;\n            record.pinned = false;\n            record.tree.snapshot = Some(self.output_tree_of(commit)?);\n            record.changes = Default::default();\n            let parents =\n                self.output_str(PlumbingCall::new([\"show\", \"-s\", \"--format=%P\", commit]))?;\n            for change in self.changes(parents.split_whitespace().next(), commit)? {\n                let path = super::tracked::tree_path_to_display(&change.path);\n                match change.status {\n                    'A' => record.changes.added.push(path),\n                    'D' => record.changes.removed.push(path),\n                    _ => record.changes.modified.push(path),\n                }\n            }\n            record\n        };\n        record.uuid = commit.into();\n        // The commit tree is authoritative even if a normal Git operation\n        // reused a message containing metadata from an older commit.\n        record.tree.snapshot = Some(self.output_tree_of(commit)?);\n        record.tree.available = true;\n        if let Some(manifest) = super::manifest::Manifest::read(self, commit)? {\n            let tracked = manifest.tracking()?;\n            let mut coverage = tracked.coverage(&super::tracked::Walk {\n                entries: tracked.entries.clone(),\n                ..Default::default()\n            });\n            for entry in &mut coverage.entries {\n                entry.state = record.tree.coverage.entries.iter()\n                    .find(|prior| prior.path == entry.path && prior.variant == entry.variant)\n                    .map_or_else(|| \"saved\".into(), |prior| prior.state.clone());\n            }\n            record.tree.coverage = coverage;\n            let mut roots: BTreeMap<String, RootRecord> = BTreeMap::new();\n            for file in self.ls_tree(commit)? {\n                if super::sync::layout::Roots::current().locate(&file.path).path().is_none() {\n                    continue;\n                }\n                let label = file.path.split('/').next().unwrap_or_default().to_string();\n                let root = roots.entry(label.clone()).or_insert_with(|| RootRecord {\n                    label,\n                    ..Default::default()\n                });\n                root.files += 1;\n                root.bytes += file.size.unwrap_or_default();\n            }\n            record.tree.roots = roots.into_values().collect();\n        }\n        for root in &mut record.tree.roots {\n            root.path = match root.label.split('@').next().unwrap_or_default() {\n                \"home\" => crate::dirs::HOME.to_path_buf(),\n                \"config\" => super::tracked::global_config_dir(),\n                \"fs\" => PathBuf::from(std::path::MAIN_SEPARATOR.to_string()),\n                other => bail!(\"unknown history path root: {other}\"),\n            };\n        }\n        Ok(record)\n    }\n\n    /// Recursive listing of a tree (or a path inside it).\n    pub(crate) fn ls_tree(&self, spec: &str) -> Result<Vec<TreeEntry>> {\n        let out = self\n            .git\n            .output(PlumbingCall::new([\"ls-tree\", \"-r\", \"-l\", \"-z\", spec]))?;\n        let mut entries = vec![];\n        for record in out.split(|byte| *byte == 0) {\n            if record.is_empty() {\n                continue;\n            }\n            let record = std::str::from_utf8(record).wrap_err(\n                \"history cannot represent a non-UTF-8 filename; refusing to change its bytes\",\n            )?;\n            let Some((meta, path)) = record.split_once('\\t') else {\n                continue;\n            };\n            let mut fields = meta.split_whitespace();\n//! Portable enrollment metadata stored in the ordinary tracked-file tree.\n//! This is configuration, not a second history or a machine recovery record.\n\nuse eyre::{Result, bail};\nuse serde::{Deserialize, Serialize};\n\nuse super::select::Variant;\nuse super::shadow::{HistoryRepo, Overlay};\n\npub(crate) const PATH: &str = \".mise-history/manifest.json\";\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Enrollment {\n    /// A portable repository path, rooted at `home/` or `config/`.\n    pub path: String,\n    pub autosave: bool,\n    pub encrypt: bool,\n    pub variants: Vec<Variant>,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Manifest {\n    pub format: u32,\n    pub enrollment: Vec<Enrollment>,\n    pub exclude: Vec<String>,\n    pub recipients: Vec<String>,\n}\n\nimpl Default for Manifest {\n    fn default() -> Self {\n        Self {\n            format: 1,\n            enrollment: vec![],\n            exclude: vec![],\n            recipients: vec![],\n        }\n    }\n}\n\nimpl Manifest {\n    /// Restore enrollment from Git without needing a captured mise config.\n    /// Deployment inputs are validated separately; none are inferred here.\n    pub(crate) fn tracking(&self) -> Result<super::tracked::TrackedSet> {\n        self.validate()?;\n        let roots = super::sync::layout::Roots::current();\n        let environments = super::select::active_environments();\n        let mut tracked = super::tracked::TrackedSet {\n            manifest: self.clone(),\n            exclude: self.exclude.clone(),\n            ..Default::default()\n        };\n        for enrollment in &self.enrollment {\n            let variant = match super::select::select(&enrollment.variants, &environments) {\n                super::select::Selection::Single => None,\n                super::select::Selection::Variant(variant) => Some(variant.name()),\n                super::select::Selection::NoMatch => continue,\n                super::select::Selection::Ambiguous(_) => bail!(\"ambiguous variants for {}\", enrollment.path),\n            };\n            let local = roots.locate(&enrollment.path).path()\n                .ok_or_else(|| eyre::eyre!(\"invalid enrollment path {}\", enrollment.path))?\n                .to_path_buf();\n            let mut policy = crate::system::files::FilePolicy::for_mode(crate::system::files::FileMode::Track);\n            policy.autosave = enrollment.autosave;\n            policy.encrypt = enrollment.encrypt;\n            let mut entry = super::tracked::TrackedEntry::new(local, super::tracked::EntryKind::Track, \"track\", policy);\n            entry.variant = variant;\n            tracked.entries.push(entry);\n        }\n        Ok(tracked)\n    }\n\n    /// Every declared encrypted stream, including platforms inactive here.\n    pub(crate) fn encrypted_paths(&self) -> std::collections::BTreeSet<String> {\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in self.enrollment.iter().filter(|entry| entry.encrypt) {\n            if entry.variants.is_empty() {\n                paths.insert(entry.path.clone());\n            } else {\n                let (root, relative) = entry.path.split_once('/').unwrap_or((&entry.path, \"\"));\n                for variant in &entry.variants {\n                    let stem = format!(\"{root}@{}\", variant.name());\n                    paths.insert(if relative.is_empty() {\n                        stem\n                    } else {\n                        format!(\"{stem}/{relative}\")\n                    });\n                }\n            }\n        }\n        paths\n    }\n\n    fn owner(&self, path: &str) -> Option<&Enrollment> {\n        self.enrollment\n            .iter()\n            .filter(|entry| {\n                path == entry.path\n                    || path\n                        .strip_prefix(&entry.path)\n                        .is_some_and(|rest| rest.starts_with('/'))\n            })\n            .max_by_key(|entry| entry.path.len())\n    }\n\n    /// Carry inactive streams and repository-owned files from the same parent\n    /// tree. Paths explicitly untracked since that parent are deliberately not\n    /// carried; no live file is removed by this tree construction.\n    pub(crate) fn preserve_other_files(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\n        let Some(parent) = repo.ref_oid(HistoryRepo::HISTORY_REF)? else {\n            return Ok(tree.into());\n        };\n        let previous = Self::read(repo, &parent)?.unwrap_or_default();\n        let environments = super::select::active_environments();\n        let mut overlays = vec![];\n        for file in repo.ls_tree(&parent)? {\n            if file.path.starts_with(\".mise-history/\") {\n                continue;\n            }\n            let (stem, relative) = file.path.split_once('/').unwrap_or((&file.path, \"\"));\n            let (root, variant) = stem\n                .split_once('@')\n                .map_or((stem, None), |(root, variant)| (root, Some(variant)));\n            let portable = if relative.is_empty() {\n                root.into()\n            } else {\n                format!(\"{root}/{relative}\")\n            };\n            let carry = match self.owner(&portable) {\n                None => previous.owner(&portable).is_none(),\n                Some(entry) => {\n                    let selected = match super::select::select(&entry.variants, &environments) {\n                        super::select::Selection::Single => None,\n                        super::select::Selection::Variant(variant) => Some(variant.name()),\n                        super::select::Selection::NoMatch => Some(String::new()),\n                        super::select::Selection::Ambiguous(_) => {\n                            bail!(\"ambiguous variants for {}\", entry.path)\n                        }\n                    };\n                    variant != selected.as_deref()\n                        && variant.is_some_and(|name| {\n                            entry.variants.iter().any(|variant| variant.name() == name)\n                        })\n                }\n            };\n            if carry {\n                overlays.push(Overlay {\n                    path: file.path,\n                    object: Some((file.mode, file.oid)),\n                });\n            }\n        }\n        repo.compose(tree, &overlays)\n    }\n\n    pub(crate) fn validate(&self) -> Result<()> {\n        if self.format != 1 {\n            bail!(\"unsupported dotfile repository format {}\", self.format);\n        }\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in &self.enrollment {\n            if !super::sync::layout::is_safe_branch_path(&entry.path)\n                || !(entry.path.starts_with(\"home/\")\n                    || entry.path == \"config\"\n                    || entry.path.starts_with(\"config/\"))\n                || !paths.insert(&entry.path)\n            {\n                bail!(\"invalid or repeated enrollment path {}\", entry.path);\n            }\n            let mut variants = std::collections::BTreeSet::new();\n            for variant in &entry.variants {\n                let name = variant.name();\n                if name.contains('@')\n                    || !super::sync::layout::is_safe_branch_path(&name)\n                    || !variants.insert(name)\n                {\n                    bail!(\"invalid or repeated variant for {}\", entry.path);\n                }\n            }\n"},"started_at_ms":1788755158340,"completed_at_ms":1788755158340}}
{"timestamp":"2026-09-07T04:25:58.382Z","ordinal":17482,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a07a1d-a56e-7bf3-b746-4bc84839e621","call_id":"call_FuagJbKrC7tWl4I6QIYdC0eQ","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"80ec15\",\"wall_time_seconds\":0.000011209,\"exit_code\":0,\"original_token_count\":5926,\"output\":\"//! Ordinary branch ancestry. Reconciliation supplies a fully validated tree;\\n//! this layer preserves commit identities and never constructs another history.\\n\\nuse eyre::{Result, bail};\\n\\nuse super::network::UPSTREAM_REF;\\nuse crate::system::history::shadow::HistoryRepo;\\n\\n#[derive(Debug)]\\npub(crate) struct Heads {\\n    pub local: Option<String>,\\n    pub remote: Option<String>,\\n    pub base: Option<String>,\\n}\\n\\n#[derive(Debug)]\\npub(crate) struct Candidate {\\n    pub commit: String,\\n    expected_local: Option<String>,\\n    expected_remote: Option<String>,\\n}\\n\\nimpl Heads {\\n    pub(crate) fn read(repo: &HistoryRepo) -> Result<Self> {\\n        let local = repo.ref_oid(HistoryRepo::HISTORY_REF)?;\\n        let remote = repo.ref_oid(UPSTREAM_REF)?;\\n        let base = match (&local, &remote) {\\n            (Some(local), Some(remote)) => {\\n                let bases = repo.merge_bases(local, remote)?;\\n                if bases.is_empty() {\\n                    bail!(\\n                        \\\"local and origin histories are unrelated; use a fresh setup store to adopt origin, or reconcile the repositories explicitly with Git. Neither history was replaced\\\"\\n                    );\\n                }\\n                // A criss-cross merge has shared ancestry but no unique base.\\n                // It needs a merge commit, never an arbitrary fast-forward.\\n                (bases.len() == 1).then(|| bases[0].clone())\\n            }\\n            _ => None,\\n        };\\n        Ok(Self {\\n            local,\\n            remote,\\n            base,\\n        })\\n    }\\n\\n    /// Preparing a candidate does not advance a branch or write live files.\\n    /// The caller must finish its complete application before adopting it.\\n    pub(crate) fn candidate(&self, repo: &HistoryRepo, tree: &str) -> Result<Option<Candidate>> {\\n        let commit = match (&self.local, &self.remote) {\\n            (None, None) => return Ok(None),\\n            (Some(local), None) => {\\n                if repo.output_tree_of(local)? != tree {\\n                    bail!(\\\"saved files changed while preparing publication; plan again\\\");\\n                }\\n                local.clone()\\n            }\\n            (None, Some(remote)) => {\\n                if repo.output_tree_of(remote)? != tree {\\n                    bail!(\\\"incoming files changed while preparing adoption; plan again\\\");\\n                }\\n                remote.clone()\\n            }\\n            (Some(local), Some(remote)) => {\\n                if self.base.as_ref() == Some(remote) {\\n                    if repo.output_tree_of(local)? != tree {\\n                        bail!(\\\"saved files changed while preparing publication; plan again\\\");\\n                    }\\n                    local.clone()\\n                } else if self.base.as_ref() == Some(local) && repo.output_tree_of(remote)? == tree\\n                {\\n                    remote.clone()\\n                } else {\\n                    repo.commit_tree(tree, vec![local, remote], \\\"merge origin dotfiles\\\")?\\n                }\\n            }\\n        };\\n        Ok(Some(Candidate {\\n            commit,\\n            expected_local: self.local.clone(),\\n            expected_remote: self.remote.clone(),\\n        }))\\n    }\\n}\\n\\nimpl Candidate {\\n    pub(crate) fn adopt(&self, repo: &HistoryRepo) -> Result<()> {\\n        if repo.ref_oid(UPSTREAM_REF)? != self.expected_remote {\\n            bail!(\\\"origin changed while applying this setup; reconcile again before publication\\\");\\n        }\\n        // Compare-and-swap also verifies no local boundary/save was inserted\\n        // during application. The caller must recompute instead of dropping it.\\n        repo.update_history_head(\\n            &self.commit,\\n            self.expected_local.as_deref(),\\n        )\\n    }\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n\\n    fn tree(repo: &HistoryRepo, bytes: &[u8]) -> String {\\n        repo.compose(\\n            &repo.empty_object(\\\"tree\\\").unwrap(),\\n            &[crate::system::history::shadow::Overlay {\\n                path: \\\"home/.zshrc\\\".into(),\\n                object: Some((\\\"100644\\\".into(), repo.hash_blob(bytes).unwrap())),\\n            }],\\n        )\\n        .unwrap()\\n    }\\n\\n    #[test]\\n    fn delayed_publication_reuses_all_local_commits() {\\n        let temporary = tempfile::tempdir().unwrap();\\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\\n            .unwrap()\\n            .unwrap();\\n        let first_tree = tree(&repo, b\\\"one\\\");\\n        let first = repo.commit_tree(&first_tree, vec![], \\\"first save\\\").unwrap();\\n        let second_tree = tree(&repo, b\\\"two\\\");\\n        let second = repo\\n            .commit_tree(&second_tree, vec![&first], \\\"second save\\\")\\n            .unwrap();\\n        repo.update_ref(HistoryRepo::HISTORY_REF, &second, None)\\n            .unwrap();\\n        let candidate = Heads::read(&repo)\\n            .unwrap()\\n            .candidate(&repo, &second_tree)\\n            .unwrap()\\n            .unwrap();\\n        assert_eq!(candidate.commit, second);\\n        candidate.adopt(&repo).unwrap();\\n        assert_eq!(\\n            repo.rev_list(&candidate.commit, usize::MAX).unwrap(),\\n            vec![second, first]\\n        );\\n        assert!(repo.list_refs(\\\"refs/setup/\\\").unwrap().is_empty());\\n    }\\n\\n    #[test]\\n    fn fast_forward_keeps_remote_commit_and_stale_candidates_preserve_edits() {\\n        let temporary = tempfile::tempdir().unwrap();\\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\\n            .unwrap()\\n            .unwrap();\\n        let before_tree = tree(&repo, b\\\"before\\\");\\n        let before = repo.commit_tree(&before_tree, vec![], \\\"before\\\").unwrap();\\n        let incoming_tree = tree(&repo, b\\\"incoming\\\");\\n        let incoming = repo\\n            .commit_tree(&incoming_tree, vec![&before], \\\"incoming\\\")\\n            .unwrap();\\n        repo.update_ref(HistoryRepo::HISTORY_REF, &before, None)\\n            .unwrap();\\n        repo.update_ref(UPSTREAM_REF, &incoming, None).unwrap();\\n        let candidate = Heads::read(&repo)\\n            .unwrap()\\n            .candidate(&repo, &incoming_tree)\\n            .unwrap()\\n            .unwrap();\\n        assert_eq!(candidate.commit, incoming);\\n        let edit = repo\\n            .commit_tree(&tree(&repo, b\\\"later edit\\\"), vec![&before], \\\"later edit\\\")\\n            .unwrap();\\n        repo.update_ref(HistoryRepo::HISTORY_REF, &edit, Some(&before))\\n            .unwrap();\\n        assert!(candidate.adopt(&repo).is_err());\\n        assert_eq!(repo.ref_oid(HistoryRepo::HISTORY_REF).unwrap(), Some(edit));\\n    }\\n\\n    #[test]\\n    fn divergent_merge_keeps_both_parent_histories() {\\n        let temporary = tempfile::tempdir().unwrap();\\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\\n            .unwrap()\\n            .unwrap();\\n        let initial = tree(&repo, b\\\"initial\\\");\\n        let base = repo.commit_tree(&initial, vec![], \\\"base\\\").unwrap();\\n        let local = repo\\n            .commit_tree(&tree(&repo, b\\\"local\\\"), vec![&base], \\\"local\\\")\\n            .unwrap();\\n        let remote = repo\\n            .commit_tree(&tree(&repo, b\\\"remote\\\"), vec![&base], \\\"remote\\\")\\n            .unwrap();\\n        repo.update_ref(HistoryRepo::HISTORY_REF, &local, None)\\n            .unwrap();\\n        repo.update_ref(UPSTREAM_REF, &remote, None).unwrap();\\n        let merged = tree(&repo, b\\\"resolved\\\");\\n        let candidate = Heads::read(&repo)\\n            .unwrap()\\n            .candidate(&repo, &merged)\\n            .unwrap()\\n            .unwrap();\\n        candidate.adopt(&repo).unwrap();\\n        let history = repo.rev_list(&candidate.commit, usize::MAX).unwrap();\\n        assert_eq!(history.len(), 4);\\n        assert!(history.contains(&local) && history.contains(&remote) && history.contains(&base));\\n        assert_eq!(repo.output_tree_of(&candidate.commit).unwrap(), merged);\\n    }\\n\\n    #[test]\\n    fn unrelated_histories_are_never_adopted_over_local_commits() {\\n        let temporary = tempfile::tempdir().unwrap();\\n        let repo = HistoryRepo::open_or_init_in(temporary.path())\\n            .unwrap()\\n            .unwrap();\\n        let tree = tree(&repo, b\\\"same contents are not shared ancestry\\\");\\n        let local = repo.commit_tree(&tree, vec![], \\\"local root\\\").unwrap();\\n        let remote = repo.commit_tree(&tree, vec![], \\\"remote root\\\").unwrap();\\n        repo.update_ref(HistoryRepo::HISTORY_REF, &local, None)\\n            .unwrap();\\n        repo.update_ref(UPSTREAM_REF, &remote, None).unwrap();\\n        assert!(\\n            Heads::read(&repo)\\n                .unwrap_err()\\n                .to_string()\\n                .contains(\\\"unrelated\\\")\\n        );\\n        assert_eq!(repo.ref_oid(HistoryRepo::HISTORY_REF).unwrap(), Some(local));\\n        assert_eq!(repo.ref_oid(UPSTREAM_REF).unwrap(), Some(remote));\\n    }\\n}\\n    pub(crate) fn update_history_head(&self, commit: &str, expected: Option<&str>) -> Result<()> {\\n        self.update_ref(Self::HISTORY_REF, commit, expected)?;\\n        self.git.run(PlumbingCall::new([\\n            \\\"symbolic-ref\\\",\\n            \\\"HEAD\\\",\\n            Self::HISTORY_REF,\\n        ]))\\n    }\\n\\n    /// Ordinary ancestry is the source of truth, not per-checkpoint refs.\\n    pub(crate) fn checkpoint_refs(&self) -> Result<Vec<(String, String)>> {\\n        let Some(head) = self.ref_oid(Self::HISTORY_REF)? else {\\n            return Ok(vec![]);\\n        };\\n        self.rev_list(&head, usize::MAX)?\\n            .into_iter()\\n            .map(|commit| {\\n                let record = self.read_meta(&commit)?;\\n                Ok((record.uuid, commit))\\n            })\\n            .collect()\\n    }\\n\\n    pub(crate) fn read_meta(&self, commit: &str) -> Result<Checkpoint> {\\n        let message = self.output_str(PlumbingCall::new([\\\"show\\\", \\\"-s\\\", \\\"--format=%B\\\", commit]))?;\\n        let own_record = message\\n            .lines()\\n            .rev()\\n            .find_map(|line| line.strip_prefix(Self::RECORD_TRAILER));\\n        let mut record: Checkpoint = if let Some(record) = own_record {\\n            serde_json::from_str(record)\\n                .wrap_err_with(|| format!(\\\"reading history metadata for {commit}\\\"))?\\n        } else {\\n            // An ordinary Git commit needs no mise trailer. Inherit the\\n            // enrollment inventory, but never its operation boundary or id.\\n            let mut inherited = None;\\n            for ancestor in self.rev_list(commit, usize::MAX)?.into_iter().skip(1) {\\n                let message =\\n                    self.output_str(PlumbingCall::new([\\\"show\\\", \\\"-s\\\", \\\"--format=%B\\\", &ancestor]))?;\\n                if let Some(record) = message\\n                    .lines()\\n                    .rev()\\n                    .find_map(|line| line.strip_prefix(Self::RECORD_TRAILER))\\n                {\\n                    inherited = Some(serde_json::from_str::<Checkpoint>(record)?);\\n                    break;\\n                }\\n            }\\n            let mut record = match inherited {\\n                Some(record) => record,\\n                None if super::manifest::Manifest::read(self, commit)?.is_some() => Checkpoint {\\n                    schema_version: super::store::SCHEMA_VERSION,\\n                    uuid: commit.into(),\\n                    machine: super::store::Machine { id: \\\"git\\\".into(), name: \\\"git\\\".into() },\\n                    created_at: String::new(),\\n                    mise_version: String::new(),\\n                    trigger: super::store::Trigger::Edit,\\n                    description: String::new(),\\n                    description_source: super::store::DescriptionSource::User,\\n                    summary: String::new(),\\n                    task: None,\\n                    labels: vec![],\\n                    pinned: false,\\n                    tree: super::store::TreeInfo {\\n                        snapshot: None, available: true, reason: None, roots: vec![],\\n                        coverage: Default::default(), modes: Default::default(),\\n                    },\\n                    changes: Default::default(),\\n                    operation: None,\\n                },\\n                None => bail!(\\\"repository has no tracked-file inventory; explicitly enroll files before using mise history\\\"),\\n            };\\n            record.uuid = commit.into();\\n            record.created_at =\\n                self.output_str(PlumbingCall::new([\\\"show\\\", \\\"-s\\\", \\\"--format=%cI\\\", commit]))?;\\n            record.trigger = super::store::Trigger::Edit;\\n            record.description = message\\n                .lines()\\n                .next()\\n                .unwrap_or(\\\"edited tracked files\\\")\\n                .into();\\n            record.description_source = super::store::DescriptionSource::User;\\n            record.summary = record.description.clone();\\n            record.task = None;\\n            record.labels.clear();\\n            record.operation = None;\\n            record.pinned = false;\\n            record.tree.snapshot = Some(self.output_tree_of(commit)?);\\n            record.changes = Default::default();\\n            let parents =\\n                self.output_str(PlumbingCall::new([\\\"show\\\", \\\"-s\\\", \\\"--format=%P\\\", commit]))?;\\n            for change in self.changes(parents.split_whitespace().next(), commit)? {\\n                let path = super::tracked::tree_path_to_display(&change.path);\\n                match change.status {\\n                    'A' => record.changes.added.push(path),\\n                    'D' => record.changes.removed.push(path),\\n                    _ => record.changes.modified.push(path),\\n                }\\n            }\\n            record\\n        };\\n        record.uuid = commit.into();\\n        // The commit tree is authoritative even if a normal Git operation\\n        // reused a message containing metadata from an older commit.\\n        record.tree.snapshot = Some(self.output_tree_of(commit)?);\\n        record.tree.available = true;\\n        if let Some(manifest) = super::manifest::Manifest::read(self, commit)? {\\n            let tracked = manifest.tracking()?;\\n            let mut coverage = tracked.coverage(&super::tracked::Walk {\\n                entries: tracked.entries.clone(),\\n                ..Default::default()\\n            });\\n            for entry in &mut coverage.entries {\\n                entry.state = record.tree.coverage.entries.iter()\\n                    .find(|prior| prior.path == entry.path && prior.variant == entry.variant)\\n                    .map_or_else(|| \\\"saved\\\".into(), |prior| prior.state.clone());\\n            }\\n            record.tree.coverage = coverage;\\n            let mut roots: BTreeMap<String, RootRecord> = BTreeMap::new();\\n            for file in self.ls_tree(commit)? {\\n                if super::sync::layout::Roots::current().locate(&file.path).path().is_none() {\\n                    continue;\\n                }\\n                let label = file.path.split('/').next().unwrap_or_default().to_string();\\n                let root = roots.entry(label.clone()).or_insert_with(|| RootRecord {\\n                    label,\\n                    ..Default::default()\\n                });\\n                root.files += 1;\\n                root.bytes += file.size.unwrap_or_default();\\n            }\\n            record.tree.roots = roots.into_values().collect();\\n        }\\n        for root in &mut record.tree.roots {\\n            root.path = match root.label.split('@').next().unwrap_or_default() {\\n                \\\"home\\\" => crate::dirs::HOME.to_path_buf(),\\n                \\\"config\\\" => super::tracked::global_config_dir(),\\n                \\\"fs\\\" => PathBuf::from(std::path::MAIN_SEPARATOR.to_string()),\\n                other => bail!(\\\"unknown history path root: {other}\\\"),\\n            };\\n        }\\n        Ok(record)\\n    }\\n\\n    /// Recursive listing of a tree (or a path inside it).\\n    pub(crate) fn ls_tree(&self, spec: &str) -> Result<Vec<TreeEntry>> {\\n        let out = self\\n            .git\\n            .output(PlumbingCall::new([\\\"ls-tree\\\", \\\"-r\\\", \\\"-l\\\", \\\"-z\\\", spec]))?;\\n        let mut entries = vec![];\\n        for record in out.split(|byte| *byte == 0) {\\n            if record.is_empty() {\\n                continue;\\n            }\\n            let record = std::str::from_utf8(record).wrap_err(\\n                \\\"history cannot represent a non-UTF-8 filename; refusing to change its bytes\\\",\\n            )?;\\n            let Some((meta, path)) = record.split_once('\\\\t') else {\\n                continue;\\n            };\\n            let mut fields = meta.split_whitespace();\\n//! Portable enrollment metadata stored in the ordinary tracked-file tree.\\n//! This is configuration, not a second history or a machine recovery record.\\n\\nuse eyre::{Result, bail};\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::select::Variant;\\nuse super::shadow::{HistoryRepo, Overlay};\\n\\npub(crate) const PATH: &str = \\\".mise-history/manifest.json\\\";\\n\\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\\n#[serde(deny_unknown_fields)]\\npub(crate) struct Enrollment {\\n    /// A portable repository path, rooted at `home/` or `config/`.\\n    pub path: String,\\n    pub autosave: bool,\\n    pub encrypt: bool,\\n    pub variants: Vec<Variant>,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\\n#[serde(deny_unknown_fields)]\\npub(crate) struct Manifest {\\n    pub format: u32,\\n    pub enrollment: Vec<Enrollment>,\\n    pub exclude: Vec<String>,\\n    pub recipients: Vec<String>,\\n}\\n\\nimpl Default for Manifest {\\n    fn default() -> Self {\\n        Self {\\n            format: 1,\\n            enrollment: vec![],\\n            exclude: vec![],\\n            recipients: vec![],\\n        }\\n    }\\n}\\n\\nimpl Manifest {\\n    /// Restore enrollment from Git without needing a captured mise config.\\n    /// Deployment inputs are validated separately; none are inferred here.\\n    pub(crate) fn tracking(&self) -> Result<super::tracked::TrackedSet> {\\n        self.validate()?;\\n        let roots = super::sync::layout::Roots::current();\\n        let environments = super::select::active_environments();\\n        let mut tracked = super::tracked::TrackedSet {\\n            manifest: self.clone(),\\n            exclude: self.exclude.clone(),\\n            ..Default::default()\\n        };\\n        for enrollment in &self.enrollment {\\n            let variant = match super::select::select(&enrollment.variants, &environments) {\\n                super::select::Selection::Single => None,\\n                super::select::Selection::Variant(variant) => Some(variant.name()),\\n                super::select::Selection::NoMatch => continue,\\n                super::select::Selection::Ambiguous(_) => bail!(\\\"ambiguous variants for {}\\\", enrollment.path),\\n            };\\n            let local = roots.locate(&enrollment.path).path()\\n                .ok_or_else(|| eyre::eyre!(\\\"invalid enrollment path {}\\\", enrollment.path))?\\n                .to_path_buf();\\n            let mut policy = crate::system::files::FilePolicy::for_mode(crate::system::files::FileMode::Track);\\n            policy.autosave = enrollment.autosave;\\n            policy.encrypt = enrollment.encrypt;\\n            let mut entry = super::tracked::TrackedEntry::new(local, super::tracked::EntryKind::Track, \\\"track\\\", policy);\\n            entry.variant = variant;\\n            tracked.entries.push(entry);\\n        }\\n        Ok(tracked)\\n    }\\n\\n    /// Every declared encrypted stream, including platforms inactive here.\\n    pub(crate) fn encrypted_paths(&self) -> std::collections::BTreeSet<String> {\\n        let mut paths = std::collections::BTreeSet::new();\\n        for entry in self.enrollment.iter().filter(|entry| entry.encrypt) {\\n            if entry.variants.is_empty() {\\n                paths.insert(entry.path.clone());\\n            } else {\\n                let (root, relative) = entry.path.split_once('/').unwrap_or((&entry.path, \\\"\\\"));\\n                for variant in &entry.variants {\\n                    let stem = format!(\\\"{root}@{}\\\", variant.name());\\n                    paths.insert(if relative.is_empty() {\\n                        stem\\n                    } else {\\n                        format!(\\\"{stem}/{relative}\\\")\\n                    });\\n                }\\n            }\\n        }\\n        paths\\n    }\\n\\n    fn owner(&self, path: &str) -> Option<&Enrollment> {\\n        self.enrollment\\n            .iter()\\n            .filter(|entry| {\\n                path == entry.path\\n                    || path\\n                        .strip_prefix(&entry.path)\\n                        .is_some_and(|rest| rest.starts_with('/'))\\n            })\\n            .max_by_key(|entry| entry.path.len())\\n    }\\n\\n    /// Carry inactive streams and repository-owned files from the same parent\\n    /// tree. Paths explicitly untracked since that parent are deliberately not\\n    /// carried; no live file is removed by this tree construction.\\n    pub(crate) fn preserve_other_files(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\\n        let Some(parent) = repo.ref_oid(HistoryRepo::HISTORY_REF)? else {\\n            return Ok(tree.into());\\n        };\\n        let previous = Self::read(repo, &parent)?.unwrap_or_default();\\n        let environments = super::select::active_environments();\\n        let mut overlays = vec![];\\n        for file in repo.ls_tree(&parent)? {\\n            if file.path.starts_with(\\\".mise-history/\\\") {\\n                continue;\\n            }\\n            let (stem, relative) = file.path.split_once('/').unwrap_or((&file.path, \\\"\\\"));\\n            let (root, variant) = stem\\n                .split_once('@')\\n                .map_or((stem, None), |(root, variant)| (root, Some(variant)));\\n            let portable = if relative.is_empty() {\\n                root.into()\\n            } else {\\n                format!(\\\"{root}/{relative}\\\")\\n            };\\n            let carry = match self.owner(&portable) {\\n                None => previous.owner(&portable).is_none(),\\n                Some(entry) => {\\n                    let selected = match super::select::select(&entry.variants, &environments) {\\n                        super::select::Selection::Single => None,\\n                        super::select::Selection::Variant(variant) => Some(variant.name()),\\n                        super::select::Selection::NoMatch => Some(String::new()),\\n                        super::select::Selection::Ambiguous(_) => {\\n                            bail!(\\\"ambiguous variants for {}\\\", entry.path)\\n                        }\\n                    };\\n                    variant != selected.as_deref()\\n                        && variant.is_some_and(|name| {\\n                            entry.variants.iter().any(|variant| variant.name() == name)\\n                        })\\n                }\\n            };\\n            if carry {\\n                overlays.push(Overlay {\\n                    path: file.path,\\n                    object: Some((file.mode, file.oid)),\\n                });\\n            }\\n        }\\n        repo.compose(tree, &overlays)\\n    }\\n\\n    pub(crate) fn validate(&self) -> Result<()> {\\n        if self.format != 1 {\\n            bail!(\\\"unsupported dotfile repository format {}\\\", self.format);\\n        }\\n        let mut paths = std::collections::BTreeSet::new();\\n        for entry in &self.enrollment {\\n            if !super::sync::layout::is_safe_branch_path(&entry.path)\\n                || !(entry.path.starts_with(\\\"home/\\\")\\n                    || entry.path == \\\"config\\\"\\n                    || entry.path.starts_with(\\\"config/\\\"))\\n                || !paths.insert(&entry.path)\\n            {\\n                bail!(\\\"invalid or repeated enrollment path {}\\\", entry.path);\\n            }\\n            let mut variants = std::collections::BTreeSet::new();\\n            for variant in &entry.variants {\\n                let name = variant.name();\\n                if name.contains('@')\\n                    || !super::sync::layout::is_safe_branch_path(&name)\\n                    || !variants.insert(name)\\n                {\\n                    bail!(\\\"invalid or repeated variant for {}\\\", entry.path);\\n                }\\n            }\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a079e2-ddee-7920-adc1-13c441666749","create_time":1788755158.382234}}}
