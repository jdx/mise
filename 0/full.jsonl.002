rt `part`.\\n    PathChanged {\\n        part: String,\\n        item: String,\\n        path: PathBuf,\\n        prior: PathSnapshot,\\n    },\\n    /// The mutation recorded at index `seq` finished; `after` is what the\\n    /// path looks like now.\\n    Committed { seq: u32, after: PathState },\\n    /// Written by a newer mise than this one.\\n    #[serde(other)]\\n    Unknown,\\n}\\n\\nimpl JournalEntry {\\n    /// One-line rendering for tables and `show`.\\n    pub(crate) fn describe(&self) -> String {\\n        match self {\\n            Self::Note { message } => message.clone(),\\n            Self::PathChanged {\\n                part,\\n                item,\\n                path,\\n                prior,\\n            } => format!(\\n                \\\"{part}: {item}: {} was {}\\\",\\n                display_path(path),\\n                prior.describe()\\n            ),\\n            Self::Committed { seq, after } => format!(\\\"#{seq} now {}\\\", after.describe()),\\n            Self::Unknown => \\\"recorded by a newer mise\\\".to_string(),\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"aaf5d5\",\"wall_time_seconds\":4.419249,\"exit_code\":0,\"original_token_count\":588,\"output\":\"warning: function `default_identity_file` is never used\\n   --> src/agecrypt.rs:221:15\\n    |\\n221 | pub(crate) fn default_identity_file() -> PathBuf {\\n    |               ^^^^^^^^^^^^^^^^^^^^^\\n    |\\n    = note: `#[warn(dead_code)]` (part of `#[warn(unused)]`) on by default\\n\\nwarning: method `changed_names` is never used\\n    --> src/system/history/shadow.rs:1143:19\\n     |\\n 127 | impl HistoryRepo {\\n     | ---------------- method in this implementation\\n...\\n1143 |     pub(crate) fn changed_names(&self, commit: &str) -> Result<Vec<String>> {\\n     |                   ^^^^^^^^^^^^^\\n\\nwarning: function `is_repository_metadata` is never used\\n  --> src/system/history/sync/layout.rs:97:15\\n   |\\n97 | pub(crate) fn is_repository_metadata(path: &str) -> bool {\\n   |               ^^^^^^^^^^^^^^^^^^^^^^\\n\\nwarning: constant `MAX_LINK_DEPTH` is never used\\n  --> src/system/history/tracked.rs:30:7\\n   |\\n30 | const MAX_LINK_DEPTH: usize = 8;\\n   |       ^^^^^^^^^^^^^^\\n\\nwarning: function `is_credential_name` is never used\\n   --> src/system/history/tracked.rs:652:15\\n    |\\n652 | pub(crate) fn is_credential_name(name: &str) -> bool {\\n    |               ^^^^^^^^^^^^^^^^^^\\n\\nwarning: function `normalize_missing` is never used\\n   --> src/system/history/tracked.rs:802:15\\n    |\\n802 | pub(crate) fn normalize_missing(path: &Path) -> PathBuf {\\n    |               ^^^^^^^^^^^^^^^^^\\n\\nwarning: function `link_target` is never used\\n   --> src/system/history/tracked.rs:823:15\\n    |\\n823 | pub(crate) fn link_target(link: &Path) -> Option<PathBuf> {\\n    |               ^^^^^^^^^^^\\n\\nwarning: `mise` (bin \\\"mise\\\" test) generated 7 warnings\\n    Finished `test` profile [unoptimized + debuginfo] target(s) in 1m 16s\\n     Running unittests src/main.rs (target/debug/deps/mise-8c08b81259f8c9d2)\\n\\nrunning 4 tests\\ntest system::history::recovery::tests::concurrent_edit_and_missing_completion_are_preserved ... ok\\ntest system::history::recovery::tests::corrupt_preimage_does_not_replace_current_file ... ok\\ntest system::history::recovery::tests::replaced_directory_recovers_empty_descendants_and_contents ... ok\\ntest system::history::recovery::tests::restore_private_preimage_and_discard_completed_sidecar ... ok\\n\\ntest result: ok. 4 passed; 0 failed; 0 ignored; 0 measured; 3670 filtered out; finished in 0.05s\\n\\nmbx[savings]: the sweep found 212.0 GiB nobody would miss. nobody has.\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a079e2-ddee-7920-adc1-13c441666749","create_time":1788759134.3729}}}
