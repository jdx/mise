_object(&object.1).unwrap(), b\"private contents\");\n             assert!(decrypt(&repo, \"tracked/home/other\", &encrypted, false).is_err());\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/jdx/.codex/worktrees/dotfiles-one-history/mise/src/system/history/sync/files.rs\n","stderr":""},"started_at_ms":1788753568891,"completed_at_ms":1788753568893}}
