uper::tracked::EntryKind::Track, \"track\", policy);\n+            entry.variant = variant;\n+            tracked.entries.push(entry);\n+        }\n+        Ok(tracked)\n+    }\n+\n     /// Every declared encrypted stream, including platforms inactive here.\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/jdx/.codex/worktrees/dotfiles-one-history/mise/src/system/history/manifest.rs\n","stderr":""},"started_at_ms":1788754903788,"completed_at_ms":1788754903788}}
