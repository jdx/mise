mode: u32,\\n}\\n\\n/// How much of a path to capture before it is touched.\\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\\npub(crate) enum Capture {\\n\"}"},{"type":"input_text","text":"{}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a079e2-ddee-7920-adc1-13c441666749","create_time":1788758984.509318}}}
