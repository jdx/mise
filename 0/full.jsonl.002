achine_refs {\n-        if repo.ref_oid(name)?.is_some() {\n-            repo.delete_ref(name)?;\n-        }\n-    }\n-    // and the decrypted copies of the previous repository's refs\n-    for (name, _) in repo.list_refs(PLAIN_PREFIX)? {\n-        repo.delete_ref(&name)?;\n+    if repo.ref_oid(PUBLISH_REF)?.is_some() {\n+        repo.delete_ref(PUBLISH_REF)?;\n     }\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/jdx/.codex/worktrees/dotfiles-one-history/mise/src/system/history/sync/origin.rs\nM /Users/jdx/.codex/worktrees/dotfiles-one-history/mise/src/system/history/sync/network.rs\nM /Users/jdx/.codex/worktrees/dotfiles-one-history/mise/src/system/history/config.rs\n","stderr":""},"started_at_ms":1788753086530,"completed_at_ms":1788753086532}}
