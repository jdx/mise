      .iter()\\n                        .any(|bytes| bytes.contains(&0));\\n                    Merged::Conflict(if binary {\\n                        ConflictKind::Binary\\n                    } else {\\n                        ConflictKind::SameHunk\\n                    })\\n                }\\n            }\\n        }\\n    })\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a079e2-ddee-7920-adc1-13c441666749","create_time":1788754747.953158}}}
