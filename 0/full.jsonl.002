d_names(&self, commit: &str) -> Result<Vec<String>> {\n        let out = self.git.output(PlumbingCall::new([\n            \"diff-tree\",\n            \"-r\",\n            \"--root\",\n            \"--name-only\",\n            \"--no-commit-id\",\n            \"-z\",\n            commit,\n        ]))?;\n        Ok(out\n            .split(|byte| *byte == 0)\n"},"started_at_ms":1788753035708,"completed_at_ms":1788753035708}}
