 +++++------------------\n src/system/history/sync/machines.rs    | 317 ------------------\n src/system/history/sync/mod.rs         |   3 -\n src/system/history/sync/onboard.rs     |  47 +--\n src/system/history/sync/origin.rs      | 377 +---------------------\n src/system/history/sync/preflight.rs   |  19 +-\n src/system/history/sync/run.rs         |  39 +--\n src/system/history/sync/share.rs       |  26 --\n src/system/history/sync/state.rs       |  75 ++---\n src/system/history/tracked.rs          | 138 +++++---\n src/system/history/watch/runtime.rs    |  47 +--\n 33 files changed, 330 insertions(+), 2730 deletions(-)\n444:    fn encrypted_tip_does_not_hide_plaintext_in_ancestry_or_merge_parents() {\n523:    fn plaintext_magic_is_not_an_encryption_declaration() {\n537:    fn plaintext_bypasses_envelope_limit_but_ciphertext_does_not() {\n                    path: \"home/.zshrc\".into()\n                },\n            ]\n        );\n        let initial = repo.changes(None, &a.tree).unwrap();\n        assert_eq!(initial.len(), 2);\n        assert!(initial.iter().all(|change| change.status == 'A'));\n        let same = repo.diff(&a.tree, &a.tree, &DiffOpts::default()).unwrap();\n        assert!(!same.changed);\n        let patch = repo\n            .diff(\n                &a.tree,\n                &b.tree,\n                &DiffOpts {\n                    patch: true,\n                    paths: Some((\"home/.zshrc\".into(), \"home/.zshrc\".into())),\n                    ..Default::default()\n                },\n            )\n            .unwrap();\n        let text = String::from_utf8_lossy(&patch.output);\n        assert!(text.contains(\"-one\") && text.contains(\"+two\"), \"{text}\");\n        let added = repo\n            .diff(\n                &a.tree,\n                &b.tree,\n                &DiffOpts {\n                    patch: true,\n                    paths: Some((\"home/.new\".into(), \"home/.new\".into())),\n                    ..Default::default()