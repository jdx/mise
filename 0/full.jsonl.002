{"timestamp":"2026-09-07T05:14:46.681Z","ordinal":18500,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_02be90ffdd5dff4a016a9e48408b2487d09a946a8cb33926c8","status":"completed","call_id":"call_iKigfemZETTjVUvgImPdWrac","name":"exec","input":"text(await tools.exec_command({cmd:\"sed -n '1,240p' src/system/history/tracked.rs\\nsed -n '1,220p' src/system/history/manifest.rs\\nsed -n '1285,1318p' src/cli/bootstrap.rs\\nsed -n '1848,1892p' src/cli/bootstrap.rs\",workdir:\"/Users/jdx/.codex/worktrees/dotfiles-one-history/mise\",max_output_tokens:6500}));\ntext(await tools.exec_command({cmd:\"MISE_TRUSTED_CONFIG_PATHS=/Users/jdx/.codex/worktrees/dotfiles-one-history/mise RUSTUP_TOOLCHAIN=1.95.0 mise exec -- cargo test --bin mise cli::dotfiles::track::declaration_tests\",workdir:\"/Users/jdx/.codex/worktrees/dotfiles-one-history/mise\",yield_time_ms:1000,max_output_tokens:1000}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a079e2-ddee-7920-adc1-13c441666749","create_time":1788758076.670297}}}
{"timestamp":"2026-09-07T05:14:46.764Z","ordinal":18501,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07177-9855-71a2-89cd-4a9a37cdbfcb","turn_id":"01a079e2-ddee-7920-adc1-13c441666749","item":{"type":"CommandExecution","id":"exec-b598aede-0def-4a69-967b-ad30e601a7de","process_id":"82359","command":["/bin/zsh","-lc","sed -n '1,240p' src/system/history/tracked.rs\nsed -n '1,220p' src/system/history/manifest.rs\nsed -n '1285,1318p' src/cli/bootstrap.rs\nsed -n '1848,1892p' src/cli/bootstrap.rs"],"cwd":"file:///Users/jdx/.codex/worktrees/dotfiles-one-history/mise","parsed_cmd":[{"type":"read","cmd":"sed -n '1,240p' src/system/history/tracked.rs","name":"tracked.rs","path":"src/system/history/tracked.rs"},{"type":"read","cmd":"sed -n '1,220p' src/system/history/manifest.rs","name":"manifest.rs","path":"src/system/history/manifest.rs"},{"type":"read","cmd":"sed -n '1285,1318p' src/cli/bootstrap.rs","name":"bootstrap.rs","path":"src/cli/bootstrap.rs"},{"type":"read","cmd":"sed -n '1848,1892p' src/cli/bootstrap.rs","name":"bootstrap.rs","path":"src/cli/bootstrap.rs"}],"source":"unified_exec_startup","status":"completed","stdout":"//! The effective tracked set: which paths a capture covers, under which\n//! policies, and how they map onto the snapshot tree.\n//!\n//! mise's own walker decides what is captured — never git's ignore rules —\n//! and hands the repository literal file pathspecs. Every file belongs to\n//! exactly one entry, the most specific one covering it, whose policies\n//! apply. Hard exclusions are only mise's internals: the history store, the\n//! mise state/cache/data/installs/downloads/plugins directories, and `.git`\n//! directories (a nested repository is captured as a gitlink).\n//!\n//! Only explicit `mode = \"track\"` declarations enroll paths. Deployment\n//! declarations and symlink targets never enroll files implicitly.\n\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::path::{Component, Path, PathBuf};\n\nuse eyre::Result;\nuse globset::{Glob, GlobSet, GlobSetBuilder};\nuse walkdir::WalkDir;\n\nuse super::select::{self, Selection};\nuse super::shadow::{CaptureRoot, MAX_BYTES, MAX_FILE_BYTES, MAX_FILES};\nuse super::store::{Coverage, CoverageEntry, DerivedRecord, PathReason};\nuse crate::config::Config;\nuse crate::dirs;\nuse crate::file::{self, display_path};\nuse crate::system::files::{FileMode, FilePolicy};\n\n/// How far a chain of symlinks is followed for derived targets.\nconst MAX_LINK_DEPTH: usize = 8;\n\n/// Names under the global config directory that hold credentials: private\n/// by default, in every outgoing representation.\nconst CREDENTIAL_NAMES: &[&str] = &[\"github_tokens.toml\", \"hosts.yml\", \"age.txt\"];\nconst CREDENTIAL_GLOBS: &[&str] = &[\n    \".netrc\",\n    \"*.age\",\n    \"*.key\",\n    \"*.pem\",\n    \"*.gpg\",\n    \"*.kdbx\",\n    \"id_*\",\n    \"*token*\",\n    \"*secret*\",\n    \"credentials*\",\n    \"oauth*\",\n];\n\npub(crate) type Policy = FilePolicy;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]\npub(crate) enum EntryKind {\n    /// The global config directory and `dotfiles.root`: always tracked.\n    Implicit,\n    /// A `[dotfiles]` entry with `mode = \"track\"`.\n    Track,\n    /// The destination of a source-managed `[dotfiles]` entry.\n    Output,\n    /// The source a source-managed entry references.\n    Source,\n    /// The target of a tracked symlink inside `$HOME`.\n    Derived,\n}\n\n#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]\npub(crate) struct TrackedEntry {\n    /// Absolute, `~` expanded, lexically normalized.\n    pub path: PathBuf,\n    pub kind: EntryKind,\n    /// The declaring mode (`track`, `template`, `copy`, …) or the kind.\n    pub mode: String,\n    pub policy: Policy,\n    /// The shared stream of a tracked file with variants.\n    pub variant: Option<String>,\n    /// For outputs: the source that generates them.\n    pub source: Option<PathBuf>,\n    /// Why the entry is not shared although sharing was not switched off.\n    pub note: Option<String>,\n    pub declared_in: Option<PathBuf>,\n}\n\nimpl TrackedEntry {\n    pub(crate) fn tree_path(&self, path: &Path) -> Result<String> {\n        super::sync::layout::Roots::current()\n            .branch_path(self.kind, path, self.variant.as_deref())\n            .ok_or_else(|| {\n                eyre::eyre!(\n                    \"cannot represent tracked path {} portably\",\n                    display_path(path)\n                )\n            })\n    }\n\n    pub(crate) fn display(&self) -> String {\n        display_path(&self.path)\n    }\n\n    pub(crate) fn new(path: PathBuf, kind: EntryKind, mode: &str, policy: Policy) -> Self {\n        Self {\n            path,\n            kind,\n            mode: mode.to_string(),\n            policy,\n            variant: None,\n            source: None,\n            note: None,\n            declared_in: None,\n        }\n    }\n}\n\n/// The resolved tracked set for one capture.\n#[derive(Clone, Debug, Default)]\npub(crate) struct TrackedSet {\n    pub entries: Vec<TrackedEntry>,\n    pub manifest: super::manifest::Manifest,\n    /// Deployment inputs to validate, not paths enrolled for observation.\n    pub required_sources: Vec<PathBuf>,\n    /// `[history] exclude` globs as written (with `~`).\n    pub exclude: Vec<String>,\n    /// Declarations that could not be honoured, so they are never mistaken\n    /// for protection.\n    pub invalid: Vec<PathReason>,\n}\n\n/// One private file found during a walk.\n#[derive(Clone, Debug)]\npub(crate) struct PrivateFile {\n    pub path: PathBuf,\n    pub reason: String,\n    pub policy: Policy,\n}\n\n/// What a walk of the tracked set found.\n#[derive(Debug, Default)]\npub(crate) struct Walk {\n    pub manifest: super::manifest::Manifest,\n    /// The entries as walked: the set's entries plus derived ones.\n    pub entries: Vec<TrackedEntry>,\n    pub roots: Vec<CaptureRoot>,\n    /// Every captured file with the entry that owns it and its policy.\n    pub files: BTreeMap<PathBuf, (usize, Policy)>,\n    pub private: Vec<PrivateFile>,\n    pub derived: Vec<DerivedRecord>,\n    pub omitted: Vec<PathReason>,\n    pub incomplete: Vec<PathReason>,\n    pub warnings: Vec<String>,\n}\n\nimpl TrackedSet {\n    /// The effective tracked set for the loaded configuration.\n    pub(crate) async fn effective() -> Result<Self> {\n        let config = Config::get().await?;\n        Self::from_config(&config)\n    }\n\n    /// Explicit tracking from the system and global configuration layers.\n    pub(crate) fn from_config(config: &Config) -> Result<Self> {\n        let mut set = Self::default();\n        set.exclude = super::config::exclude_globs()?;\n        let requests = crate::system::files::files_from_config(config)?\n            .into_iter()\n            .filter(|request| crate::system::files::declaration_is_global(config, request));\n        set.add_requests(requests);\n        for invalid in crate::system::files::invalid_declarations() {\n            set.invalid.push(PathReason {\n                path: invalid.target,\n                reason: format!(\"{} ({})\", invalid.reason, display_path(&invalid.config)),\n            });\n        }\n        Ok(set)\n    }\n\n    /// Add already composed, global declarations. Shared by live discovery\n    /// and the read-only incoming-configuration preflight.\n    pub(crate) fn add_requests(\n        &mut self,\n        requests: impl IntoIterator<Item = crate::system::files::FileRequest>,\n    ) {\n        let set = self;\n        let environments = select::active_environments();\n        for request in requests {\n            if request.enabled\n                && matches!(\n                    request.mode,\n                    FileMode::Symlink | FileMode::SymlinkEach | FileMode::Copy | FileMode::Template\n                )\n            {\n                let source = normalize_target(&request.source);\n                if !set.required_sources.contains(&source) {\n                    set.required_sources.push(source);\n                }\n            }\n            if !request.enabled || request.mode != FileMode::Track {\n                continue;\n            }\n            let target = normalize_target(&request.target);\n            let portable =\n                if let Ok(relative) = target.strip_prefix(normalize(&global_config_dir())) {\n                    Some(\n                        format!(\"config/{}\", relative.to_string_lossy().replace('\\\\', \"/\"))\n                            .trim_end_matches('/')\n                            .to_owned(),\n                    )\n                } else if let Ok(relative) = target.strip_prefix(normalize(&dirs::HOME)) {\n                    Some(format!(\n                        \"home/{}\",\n                        relative.to_string_lossy().replace('\\\\', \"/\")\n                    ))\n                } else {\n                    None\n                };\n            let Some(path) = portable.filter(|path| super::sync::layout::is_safe_branch_path(path))\n            else {\n                set.invalid.push(PathReason { path: display_path(&target), reason: \"tracking requires a portable path under home or the mise configuration directory\".into() });\n                continue;\n            };\n            set.manifest.enrollment.retain(|entry| entry.path != path);\n            set.manifest.enrollment.push(super::manifest::Enrollment {\n                path,\n                autosave: request.policy.autosave,\n                encrypt: request.policy.encrypt,\n                variants: request.variants.clone(),\n            });\n            set.manifest.enrollment.sort_by(|a, b| a.path.cmp(&b.path));\n            let declared_in = Some(request.origin.config.clone());\n            match request.mode {\n                FileMode::Track => {\n                    let mut entry = TrackedEntry::new(\n                        normalize_target(&request.target),\n                        EntryKind::Track,\n                        \"track\",\n                        request.policy,\n                    );\n                    entry.declared_in = declared_in;\n                    match select::select(&request.variants, &environments) {\n                        Selection::Single => {}\n                        Selection::Variant(variant) => {\n                            entry.variant = Some(variant.name());\n                        }\n//! Portable enrollment metadata stored in the ordinary tracked-file tree.\n//! This is configuration, not a second history or a machine recovery record.\n\nuse eyre::{Result, bail};\nuse serde::{Deserialize, Serialize};\n\nuse super::select::Variant;\nuse super::shadow::{HistoryRepo, Overlay};\n\npub(crate) const PATH: &str = \".mise-history/manifest.json\";\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Enrollment {\n    /// A portable repository path, rooted at `home/` or `config/`.\n    pub path: String,\n    pub autosave: bool,\n    pub encrypt: bool,\n    pub variants: Vec<Variant>,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Manifest {\n    pub format: u32,\n    pub enrollment: Vec<Enrollment>,\n    pub exclude: Vec<String>,\n    pub recipients: Vec<String>,\n}\n\nimpl Default for Manifest {\n    fn default() -> Self {\n        Self {\n            format: 1,\n            enrollment: vec![],\n            exclude: vec![],\n            recipients: vec![],\n        }\n    }\n}\n\nimpl Manifest {\n    /// Restore enrollment from Git without needing a captured mise config.\n    /// Deployment inputs are validated separately; none are inferred here.\n    pub(crate) fn tracking(&self) -> Result<super::tracked::TrackedSet> {\n        self.validate()?;\n        let roots = super::sync::layout::Roots::current();\n        let environments = super::select::active_environments();\n        let mut tracked = super::tracked::TrackedSet {\n            manifest: self.clone(),\n            exclude: self.exclude.clone(),\n            ..Default::default()\n        };\n        for enrollment in &self.enrollment {\n            let variant = match super::select::select(&enrollment.variants, &environments) {\n                super::select::Selection::Single => None,\n                super::select::Selection::Variant(variant) => Some(variant.name()),\n                super::select::Selection::NoMatch => continue,\n                super::select::Selection::Ambiguous(_) => {\n                    bail!(\"ambiguous variants for {}\", enrollment.path)\n                }\n            };\n            let local = roots\n                .locate(&enrollment.path)\n                .path()\n                .ok_or_else(|| eyre::eyre!(\"invalid enrollment path {}\", enrollment.path))?\n                .to_path_buf();\n            let mut policy =\n                crate::system::files::FilePolicy::for_mode(crate::system::files::FileMode::Track);\n            policy.autosave = enrollment.autosave;\n            policy.encrypt = enrollment.encrypt;\n            let mut entry = super::tracked::TrackedEntry::new(\n                local,\n                super::tracked::EntryKind::Track,\n                \"track\",\n                policy,\n            );\n            entry.variant = variant;\n            tracked.entries.push(entry);\n        }\n        Ok(tracked)\n    }\n\n    /// Every declared encrypted stream, including platforms inactive here.\n    pub(crate) fn encrypted_paths(&self) -> std::collections::BTreeSet<String> {\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in self.enrollment.iter().filter(|entry| entry.encrypt) {\n            if entry.variants.is_empty() {\n                paths.insert(entry.path.clone());\n            } else {\n                let (root, relative) = entry.path.split_once('/').unwrap_or((&entry.path, \"\"));\n                for variant in &entry.variants {\n                    let stem = format!(\"{root}@{}\", variant.name());\n                    paths.insert(if relative.is_empty() {\n                        stem\n                    } else {\n                        format!(\"{stem}/{relative}\")\n                    });\n                }\n            }\n        }\n        paths\n    }\n\n    fn owner(&self, path: &str) -> Option<&Enrollment> {\n        self.enrollment\n            .iter()\n            .filter(|entry| {\n                path == entry.path\n                    || path\n                        .strip_prefix(&entry.path)\n                        .is_some_and(|rest| rest.starts_with('/'))\n            })\n            .max_by_key(|entry| entry.path.len())\n    }\n\n    /// Carry inactive streams and repository-owned files from the same parent\n    /// tree. Paths explicitly untracked since that parent are deliberately not\n    /// carried; no live file is removed by this tree construction.\n    pub(crate) fn preserve_other_files(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\n        let Some(parent) = repo.ref_oid(HistoryRepo::HISTORY_REF)? else {\n            return Ok(tree.into());\n        };\n        let previous = Self::read(repo, &parent)?.unwrap_or_default();\n        let environments = super::select::active_environments();\n        let mut overlays = vec![];\n        for file in repo.ls_tree(&parent)? {\n            if file.path.starts_with(\".mise-history/\") {\n                continue;\n            }\n            let (stem, relative) = file.path.split_once('/').unwrap_or((&file.path, \"\"));\n            let (root, variant) = stem\n                .split_once('@')\n                .map_or((stem, None), |(root, variant)| (root, Some(variant)));\n            let portable = if relative.is_empty() {\n                root.into()\n            } else {\n                format!(\"{root}/{relative}\")\n            };\n            let carry = match self.owner(&portable) {\n                None => previous.owner(&portable).is_none(),\n                Some(entry) => {\n                    let selected = match super::select::select(&entry.variants, &environments) {\n                        super::select::Selection::Single => None,\n                        super::select::Selection::Variant(variant) => Some(variant.name()),\n                        super::select::Selection::NoMatch => Some(String::new()),\n                        super::select::Selection::Ambiguous(_) => {\n                            bail!(\"ambiguous variants for {}\", entry.path)\n                        }\n                    };\n                    variant != selected.as_deref()\n                        && variant.is_some_and(|name| {\n                            entry.variants.iter().any(|variant| variant.name() == name)\n                        })\n                }\n            };\n            if carry {\n                overlays.push(Overlay {\n                    path: file.path,\n                    object: Some((file.mode, file.oid)),\n                });\n            }\n        }\n        repo.compose(tree, &overlays)\n    }\n\n    pub(crate) fn validate(&self) -> Result<()> {\n        if self.format != 1 {\n            bail!(\"unsupported dotfile repository format {}\", self.format);\n        }\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in &self.enrollment {\n            if !super::sync::layout::is_safe_branch_path(&entry.path)\n                || !(entry.path.starts_with(\"home/\")\n                    || entry.path == \"config\"\n                    || entry.path.starts_with(\"config/\"))\n                || !paths.insert(&entry.path)\n            {\n                bail!(\"invalid or repeated enrollment path {}\", entry.path);\n            }\n            let mut variants = std::collections::BTreeSet::new();\n            for variant in &entry.variants {\n                let name = variant.name();\n                if name.contains('@')\n                    || !super::sync::layout::is_safe_branch_path(&name)\n                    || !variants.insert(name)\n                {\n                    bail!(\"invalid or repeated variant for {}\", entry.path);\n                }\n            }\n        }\n        Ok(())\n    }\n\n    pub(crate) fn read(repo: &HistoryRepo, tree: &str) -> Result<Option<Self>> {\n        let Some((mode, oid)) = repo.object_at(tree, PATH)? else {\n            return Ok(None);\n        };\n        if mode != \"100644\" {\n            bail!(\"dotfile enrollment metadata must be a regular file\");\n        }\n        let manifest: Self =\n            serde_json::from_slice(&repo.cat_object_bounded(&oid, 4 * 1024 * 1024)?)?;\n        manifest.validate()?;\n        Ok(Some(manifest))\n    }\n\n    pub(crate) fn write(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\n        self.validate()?;\n        let oid = repo.hash_blob(&serde_json::to_vec_pretty(self)?)?;\n        let marker = repo.hash_blob(super::sync::format::marker_content().as_bytes())?;\n        repo.compose(\n            tree,\n            &[\n                Overlay {\n                    path: PATH.into(),\n                    object: Some((\"100644\".into(), oid)),\n                },\n                Overlay {\n                    path: super::sync::layout::MARKER_PATH.into(),\n        self.dry_run\n    }\n\n    pub(super) fn inherit_root_flags(&mut self, dry_run: bool, yes: bool) {\n        self.dry_run |= dry_run;\n        self.yes |= yes;\n    }\n\n    #[cfg(test)]\n    pub(super) fn inherited_root_flags(&self) -> (bool, bool) {\n        (self.dry_run, self.yes)\n    }\n\n    pub(crate) async fn run(mut self) -> Result<()> {\n        if self.from.is_some() || self.from_git.is_some() {\n            if self.command.is_some() {\n                let flag = if self.from_git.is_some() {\n                    \"--from-git\"\n                } else {\n                    \"--from\"\n                };\n                bail!(\"{flag} cannot be used with a bootstrap subcommand\");\n            }\n            return self.run_from().await;\n        }\n        if let Some(command) = self.command.take() {\n            return command.run().await;\n        }\n        let generation = OperationScope::begin(\"bootstrap\", self.dry_run).await?;\n        let result = self.run_phases().await;\n        generation.refresh_tracked().await;\n        let error = result.as_ref().err().map(|err| format!(\"{err:#}\"));\n        generation.finish(error, result.as_ref().ok().cloned());\n        // a complete run applied the declarations that arrived through\n                .await?;\n        }\n        follow_up.print()?;\n        Ok(summary)\n    }\n\n    async fn run_from(&self) -> Result<()> {\n        let expanded = self\n            .from_git\n            .as_deref()\n            .map(crate::github_relay::expand_repository)\n            .transpose()?;\n        // a history-managed setup repository is not cloned into the\n        // configuration directory: its branch goes into mise's own store and\n        // its files are written by the same recoverable pull as any other\n        // incoming change; the ordinary bootstrap then runs from them\n        if let Some(url) = expanded.as_deref()\n            && let Some(outcome) =\n                system::history::sync::onboard::from_git(url, self.yes, self.dry_run).await?\n        {\n            if self.dry_run {\n                if let Some(preview) = outcome.preview_config.as_ref() {\n                    self.run_child_bootstrap(preview.path().to_path_buf())\n                        .await?;\n                }\n                return Ok(());\n            }\n            // the configuration that arrived is what to bootstrap from; one\n            // held for a decision leaves the existing one, whose tasks and\n            // installations are not what was asked for\n            if outcome.configuration_held {\n                bail!(\n                    \"the configuration from {url} waits for a decision (a differing one is here already); nothing was bootstrapped. `mise bootstrap dotfiles status` lists it, `mise bootstrap dotfiles pull --take-remote|--keep-local <path>` decides, then run `mise bootstrap`\"\n                );\n            }\n            let config_dir = system::history::tracked::global_config_dir();\n            self.run_child_bootstrap(config_dir).await?;\n            if !outcome.durable_access {\n                warn!(\"ongoing synchronization still needs credentials on this host (see above)\");\n            }\n            return Ok(());\n        }\n        let (url, checkout) = if let Some(url) = expanded.as_deref() {\n            let checkout = crate::env::MISE_GLOBAL_CONFIG_FILE\n                .as_deref()\n","stderr":"","aggregated_output":"//! The effective tracked set: which paths a capture covers, under which\n//! policies, and how they map onto the snapshot tree.\n//!\n//! mise's own walker decides what is captured — never git's ignore rules —\n//! and hands the repository literal file pathspecs. Every file belongs to\n//! exactly one entry, the most specific one covering it, whose policies\n//! apply. Hard exclusions are only mise's internals: the history store, the\n//! mise state/cache/data/installs/downloads/plugins directories, and `.git`\n//! directories (a nested repository is captured as a gitlink).\n//!\n//! Only explicit `mode = \"track\"` declarations enroll paths. Deployment\n//! declarations and symlink targets never enroll files implicitly.\n\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::path::{Component, Path, PathBuf};\n\nuse eyre::Result;\nuse globset::{Glob, GlobSet, GlobSetBuilder};\nuse walkdir::WalkDir;\n\nuse super::select::{self, Selection};\nuse super::shadow::{CaptureRoot, MAX_BYTES, MAX_FILE_BYTES, MAX_FILES};\nuse super::store::{Coverage, CoverageEntry, DerivedRecord, PathReason};\nuse crate::config::Config;\nuse crate::dirs;\nuse crate::file::{self, display_path};\nuse crate::system::files::{FileMode, FilePolicy};\n\n/// How far a chain of symlinks is followed for derived targets.\nconst MAX_LINK_DEPTH: usize = 8;\n\n/// Names under the global config directory that hold credentials: private\n/// by default, in every outgoing representation.\nconst CREDENTIAL_NAMES: &[&str] = &[\"github_tokens.toml\", \"hosts.yml\", \"age.txt\"];\nconst CREDENTIAL_GLOBS: &[&str] = &[\n    \".netrc\",\n    \"*.age\",\n    \"*.key\",\n    \"*.pem\",\n    \"*.gpg\",\n    \"*.kdbx\",\n    \"id_*\",\n    \"*token*\",\n    \"*secret*\",\n    \"credentials*\",\n    \"oauth*\",\n];\n\npub(crate) type Policy = FilePolicy;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]\npub(crate) enum EntryKind {\n    /// The global config directory and `dotfiles.root`: always tracked.\n    Implicit,\n    /// A `[dotfiles]` entry with `mode = \"track\"`.\n    Track,\n    /// The destination of a source-managed `[dotfiles]` entry.\n    Output,\n    /// The source a source-managed entry references.\n    Source,\n    /// The target of a tracked symlink inside `$HOME`.\n    Derived,\n}\n\n#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]\npub(crate) struct TrackedEntry {\n    /// Absolute, `~` expanded, lexically normalized.\n    pub path: PathBuf,\n    pub kind: EntryKind,\n    /// The declaring mode (`track`, `template`, `copy`, …) or the kind.\n    pub mode: String,\n    pub policy: Policy,\n    /// The shared stream of a tracked file with variants.\n    pub variant: Option<String>,\n    /// For outputs: the source that generates them.\n    pub source: Option<PathBuf>,\n    /// Why the entry is not shared although sharing was not switched off.\n    pub note: Option<String>,\n    pub declared_in: Option<PathBuf>,\n}\n\nimpl TrackedEntry {\n    pub(crate) fn tree_path(&self, path: &Path) -> Result<String> {\n        super::sync::layout::Roots::current()\n            .branch_path(self.kind, path, self.variant.as_deref())\n            .ok_or_else(|| {\n                eyre::eyre!(\n                    \"cannot represent tracked path {} portably\",\n                    display_path(path)\n                )\n            })\n    }\n\n    pub(crate) fn display(&self) -> String {\n        display_path(&self.path)\n    }\n\n    pub(crate) fn new(path: PathBuf, kind: EntryKind, mode: &str, policy: Policy) -> Self {\n        Self {\n            path,\n            kind,\n            mode: mode.to_string(),\n            policy,\n            variant: None,\n            source: None,\n            note: None,\n            declared_in: None,\n        }\n    }\n}\n\n/// The resolved tracked set for one capture.\n#[derive(Clone, Debug, Default)]\npub(crate) struct TrackedSet {\n    pub entries: Vec<TrackedEntry>,\n    pub manifest: super::manifest::Manifest,\n    /// Deployment inputs to validate, not paths enrolled for observation.\n    pub required_sources: Vec<PathBuf>,\n    /// `[history] exclude` globs as written (with `~`).\n    pub exclude: Vec<String>,\n    /// Declarations that could not be honoured, so they are never mistaken\n    /// for protection.\n    pub invalid: Vec<PathReason>,\n}\n\n/// One private file found during a walk.\n#[derive(Clone, Debug)]\npub(crate) struct PrivateFile {\n    pub path: PathBuf,\n    pub reason: String,\n    pub policy: Policy,\n}\n\n/// What a walk of the tracked set found.\n#[derive(Debug, Default)]\npub(crate) struct Walk {\n    pub manifest: super::manifest::Manifest,\n    /// The entries as walked: the set's entries plus derived ones.\n    pub entries: Vec<TrackedEntry>,\n    pub roots: Vec<CaptureRoot>,\n    /// Every captured file with the entry that owns it and its policy.\n    pub files: BTreeMap<PathBuf, (usize, Policy)>,\n    pub private: Vec<PrivateFile>,\n    pub derived: Vec<DerivedRecord>,\n    pub omitted: Vec<PathReason>,\n    pub incomplete: Vec<PathReason>,\n    pub warnings: Vec<String>,\n}\n\nimpl TrackedSet {\n    /// The effective tracked set for the loaded configuration.\n    pub(crate) async fn effective() -> Result<Self> {\n        let config = Config::get().await?;\n        Self::from_config(&config)\n    }\n\n    /// Explicit tracking from the system and global configuration layers.\n    pub(crate) fn from_config(config: &Config) -> Result<Self> {\n        let mut set = Self::default();\n        set.exclude = super::config::exclude_globs()?;\n        let requests = crate::system::files::files_from_config(config)?\n            .into_iter()\n            .filter(|request| crate::system::files::declaration_is_global(config, request));\n        set.add_requests(requests);\n        for invalid in crate::system::files::invalid_declarations() {\n            set.invalid.push(PathReason {\n                path: invalid.target,\n                reason: format!(\"{} ({})\", invalid.reason, display_path(&invalid.config)),\n            });\n        }\n        Ok(set)\n    }\n\n    /// Add already composed, global declarations. Shared by live discovery\n    /// and the read-only incoming-configuration preflight.\n    pub(crate) fn add_requests(\n        &mut self,\n        requests: impl IntoIterator<Item = crate::system::files::FileRequest>,\n    ) {\n        let set = self;\n        let environments = select::active_environments();\n        for request in requests {\n            if request.enabled\n                && matches!(\n                    request.mode,\n                    FileMode::Symlink | FileMode::SymlinkEach | FileMode::Copy | FileMode::Template\n                )\n            {\n                let source = normalize_target(&request.source);\n                if !set.required_sources.contains(&source) {\n                    set.required_sources.push(source);\n                }\n            }\n            if !request.enabled || request.mode != FileMode::Track {\n                continue;\n            }\n            let target = normalize_target(&request.target);\n            let portable =\n                if let Ok(relative) = target.strip_prefix(normalize(&global_config_dir())) {\n                    Some(\n                        format!(\"config/{}\", relative.to_string_lossy().replace('\\\\', \"/\"))\n                            .trim_end_matches('/')\n                            .to_owned(),\n                    )\n                } else if let Ok(relative) = target.strip_prefix(normalize(&dirs::HOME)) {\n                    Some(format!(\n                        \"home/{}\",\n                        relative.to_string_lossy().replace('\\\\', \"/\")\n                    ))\n                } else {\n                    None\n                };\n            let Some(path) = portable.filter(|path| super::sync::layout::is_safe_branch_path(path))\n            else {\n                set.invalid.push(PathReason { path: display_path(&target), reason: \"tracking requires a portable path under home or the mise configuration directory\".into() });\n                continue;\n            };\n            set.manifest.enrollment.retain(|entry| entry.path != path);\n            set.manifest.enrollment.push(super::manifest::Enrollment {\n                path,\n                autosave: request.policy.autosave,\n                encrypt: request.policy.encrypt,\n                variants: request.variants.clone(),\n            });\n            set.manifest.enrollment.sort_by(|a, b| a.path.cmp(&b.path));\n            let declared_in = Some(request.origin.config.clone());\n            match request.mode {\n                FileMode::Track => {\n                    let mut entry = TrackedEntry::new(\n                        normalize_target(&request.target),\n                        EntryKind::Track,\n                        \"track\",\n                        request.policy,\n                    );\n                    entry.declared_in = declared_in;\n                    match select::select(&request.variants, &environments) {\n                        Selection::Single => {}\n                        Selection::Variant(variant) => {\n                            entry.variant = Some(variant.name());\n                        }\n//! Portable enrollment metadata stored in the ordinary tracked-file tree.\n//! This is configuration, not a second history or a machine recovery record.\n\nuse eyre::{Result, bail};\nuse serde::{Deserialize, Serialize};\n\nuse super::select::Variant;\nuse super::shadow::{HistoryRepo, Overlay};\n\npub(crate) const PATH: &str = \".mise-history/manifest.json\";\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Enrollment {\n    /// A portable repository path, rooted at `home/` or `config/`.\n    pub path: String,\n    pub autosave: bool,\n    pub encrypt: bool,\n    pub variants: Vec<Variant>,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Manifest {\n    pub format: u32,\n    pub enrollment: Vec<Enrollment>,\n    pub exclude: Vec<String>,\n    pub recipients: Vec<String>,\n}\n\nimpl Default for Manifest {\n    fn default() -> Self {\n        Self {\n            format: 1,\n            enrollment: vec![],\n            exclude: vec![],\n            recipients: vec![],\n        }\n    }\n}\n\nimpl Manifest {\n    /// Restore enrollment from Git without needing a captured mise config.\n    /// Deployment inputs are validated separately; none are inferred here.\n    pub(crate) fn tracking(&self) -> Result<super::tracked::TrackedSet> {\n        self.validate()?;\n        let roots = super::sync::layout::Roots::current();\n        let environments = super::select::active_environments();\n        let mut tracked = super::tracked::TrackedSet {\n            manifest: self.clone(),\n            exclude: self.exclude.clone(),\n            ..Default::default()\n        };\n        for enrollment in &self.enrollment {\n            let variant = match super::select::select(&enrollment.variants, &environments) {\n                super::select::Selection::Single => None,\n                super::select::Selection::Variant(variant) => Some(variant.name()),\n                super::select::Selection::NoMatch => continue,\n                super::select::Selection::Ambiguous(_) => {\n                    bail!(\"ambiguous variants for {}\", enrollment.path)\n                }\n            };\n            let local = roots\n                .locate(&enrollment.path)\n                .path()\n                .ok_or_else(|| eyre::eyre!(\"invalid enrollment path {}\", enrollment.path))?\n                .to_path_buf();\n            let mut policy =\n                crate::system::files::FilePolicy::for_mode(crate::system::files::FileMode::Track);\n            policy.autosave = enrollment.autosave;\n            policy.encrypt = enrollment.encrypt;\n            let mut entry = super::tracked::TrackedEntry::new(\n                local,\n                super::tracked::EntryKind::Track,\n                \"track\",\n                policy,\n            );\n            entry.variant = variant;\n            tracked.entries.push(entry);\n        }\n        Ok(tracked)\n    }\n\n    /// Every declared encrypted stream, including platforms inactive here.\n    pub(crate) fn encrypted_paths(&self) -> std::collections::BTreeSet<String> {\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in self.enrollment.iter().filter(|entry| entry.encrypt) {\n            if entry.variants.is_empty() {\n                paths.insert(entry.path.clone());\n            } else {\n                let (root, relative) = entry.path.split_once('/').unwrap_or((&entry.path, \"\"));\n                for variant in &entry.variants {\n                    let stem = format!(\"{root}@{}\", variant.name());\n                    paths.insert(if relative.is_empty() {\n                        stem\n                    } else {\n                        format!(\"{stem}/{relative}\")\n                    });\n                }\n            }\n        }\n        paths\n    }\n\n    fn owner(&self, path: &str) -> Option<&Enrollment> {\n        self.enrollment\n            .iter()\n            .filter(|entry| {\n                path == entry.path\n                    || path\n                        .strip_prefix(&entry.path)\n                        .is_some_and(|rest| rest.starts_with('/'))\n            })\n            .max_by_key(|entry| entry.path.len())\n    }\n\n    /// Carry inactive streams and repository-owned files from the same parent\n    /// tree. Paths explicitly untracked since that parent are deliberately not\n    /// carried; no live file is removed by this tree construction.\n    pub(crate) fn preserve_other_files(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\n        let Some(parent) = repo.ref_oid(HistoryRepo::HISTORY_REF)? else {\n            return Ok(tree.into());\n        };\n        let previous = Self::read(repo, &parent)?.unwrap_or_default();\n        let environments = super::select::active_environments();\n        let mut overlays = vec![];\n        for file in repo.ls_tree(&parent)? {\n            if file.path.starts_with(\".mise-history/\") {\n                continue;\n            }\n            let (stem, relative) = file.path.split_once('/').unwrap_or((&file.path, \"\"));\n            let (root, variant) = stem\n                .split_once('@')\n                .map_or((stem, None), |(root, variant)| (root, Some(variant)));\n            let portable = if relative.is_empty() {\n                root.into()\n            } else {\n                format!(\"{root}/{relative}\")\n            };\n            let carry = match self.owner(&portable) {\n                None => previous.owner(&portable).is_none(),\n                Some(entry) => {\n                    let selected = match super::select::select(&entry.variants, &environments) {\n                        super::select::Selection::Single => None,\n                        super::select::Selection::Variant(variant) => Some(variant.name()),\n                        super::select::Selection::NoMatch => Some(String::new()),\n                        super::select::Selection::Ambiguous(_) => {\n                            bail!(\"ambiguous variants for {}\", entry.path)\n                        }\n                    };\n                    variant != selected.as_deref()\n                        && variant.is_some_and(|name| {\n                            entry.variants.iter().any(|variant| variant.name() == name)\n                        })\n                }\n            };\n            if carry {\n                overlays.push(Overlay {\n                    path: file.path,\n                    object: Some((file.mode, file.oid)),\n                });\n            }\n        }\n        repo.compose(tree, &overlays)\n    }\n\n    pub(crate) fn validate(&self) -> Result<()> {\n        if self.format != 1 {\n            bail!(\"unsupported dotfile repository format {}\", self.format);\n        }\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in &self.enrollment {\n            if !super::sync::layout::is_safe_branch_path(&entry.path)\n                || !(entry.path.starts_with(\"home/\")\n                    || entry.path == \"config\"\n                    || entry.path.starts_with(\"config/\"))\n                || !paths.insert(&entry.path)\n            {\n                bail!(\"invalid or repeated enrollment path {}\", entry.path);\n            }\n            let mut variants = std::collections::BTreeSet::new();\n            for variant in &entry.variants {\n                let name = variant.name();\n                if name.contains('@')\n                    || !super::sync::layout::is_safe_branch_path(&name)\n                    || !variants.insert(name)\n                {\n                    bail!(\"invalid or repeated variant for {}\", entry.path);\n                }\n            }\n        }\n        Ok(())\n    }\n\n    pub(crate) fn read(repo: &HistoryRepo, tree: &str) -> Result<Option<Self>> {\n        let Some((mode, oid)) = repo.object_at(tree, PATH)? else {\n            return Ok(None);\n        };\n        if mode != \"100644\" {\n            bail!(\"dotfile enrollment metadata must be a regular file\");\n        }\n        let manifest: Self =\n            serde_json::from_slice(&repo.cat_object_bounded(&oid, 4 * 1024 * 1024)?)?;\n        manifest.validate()?;\n        Ok(Some(manifest))\n    }\n\n    pub(crate) fn write(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\n        self.validate()?;\n        let oid = repo.hash_blob(&serde_json::to_vec_pretty(self)?)?;\n        let marker = repo.hash_blob(super::sync::format::marker_content().as_bytes())?;\n        repo.compose(\n            tree,\n            &[\n                Overlay {\n                    path: PATH.into(),\n                    object: Some((\"100644\".into(), oid)),\n                },\n                Overlay {\n                    path: super::sync::layout::MARKER_PATH.into(),\n        self.dry_run\n    }\n\n    pub(super) fn inherit_root_flags(&mut self, dry_run: bool, yes: bool) {\n        self.dry_run |= dry_run;\n        self.yes |= yes;\n    }\n\n    #[cfg(test)]\n    pub(super) fn inherited_root_flags(&self) -> (bool, bool) {\n        (self.dry_run, self.yes)\n    }\n\n    pub(crate) async fn run(mut self) -> Result<()> {\n        if self.from.is_some() || self.from_git.is_some() {\n            if self.command.is_some() {\n                let flag = if self.from_git.is_some() {\n                    \"--from-git\"\n                } else {\n                    \"--from\"\n                };\n                bail!(\"{flag} cannot be used with a bootstrap subcommand\");\n            }\n            return self.run_from().await;\n        }\n        if let Some(command) = self.command.take() {\n            return command.run().await;\n        }\n        let generation = OperationScope::begin(\"bootstrap\", self.dry_run).await?;\n        let result = self.run_phases().await;\n        generation.refresh_tracked().await;\n        let error = result.as_ref().err().map(|err| format!(\"{err:#}\"));\n        generation.finish(error, result.as_ref().ok().cloned());\n        // a complete run applied the declarations that arrived through\n                .await?;\n        }\n        follow_up.print()?;\n        Ok(summary)\n    }\n\n    async fn run_from(&self) -> Result<()> {\n        let expanded = self\n            .from_git\n            .as_deref()\n            .map(crate::github_relay::expand_repository)\n            .transpose()?;\n        // a history-managed setup repository is not cloned into the\n        // configuration directory: its branch goes into mise's own store and\n        // its files are written by the same recoverable pull as any other\n        // incoming change; the ordinary bootstrap then runs from them\n        if let Some(url) = expanded.as_deref()\n            && let Some(outcome) =\n                system::history::sync::onboard::from_git(url, self.yes, self.dry_run).await?\n        {\n            if self.dry_run {\n                if let Some(preview) = outcome.preview_config.as_ref() {\n                    self.run_child_bootstrap(preview.path().to_path_buf())\n                        .await?;\n                }\n                return Ok(());\n            }\n            // the configuration that arrived is what to bootstrap from; one\n            // held for a decision leaves the existing one, whose tasks and\n            // installations are not what was asked for\n            if outcome.configuration_held {\n                bail!(\n                    \"the configuration from {url} waits for a decision (a differing one is here already); nothing was bootstrapped. `mise bootstrap dotfiles status` lists it, `mise bootstrap dotfiles pull --take-remote|--keep-local <path>` decides, then run `mise bootstrap`\"\n                );\n            }\n            let config_dir = system::history::tracked::global_config_dir();\n            self.run_child_bootstrap(config_dir).await?;\n            if !outcome.durable_access {\n                warn!(\"ongoing synchronization still needs credentials on this host (see above)\");\n            }\n            return Ok(());\n        }\n        let (url, checkout) = if let Some(url) = expanded.as_deref() {\n            let checkout = crate::env::MISE_GLOBAL_CONFIG_FILE\n                .as_deref()\n","exit_code":0,"duration":{"secs":0,"nanos":6708},"formatted_output":"//! The effective tracked set: which paths a capture covers, under which\n//! policies, and how they map onto the snapshot tree.\n//!\n//! mise's own walker decides what is captured — never git's ignore rules —\n//! and hands the repository literal file pathspecs. Every file belongs to\n//! exactly one entry, the most specific one covering it, whose policies\n//! apply. Hard exclusions are only mise's internals: the history store, the\n//! mise state/cache/data/installs/downloads/plugins directories, and `.git`\n//! directories (a nested repository is captured as a gitlink).\n//!\n//! Only explicit `mode = \"track\"` declarations enroll paths. Deployment\n//! declarations and symlink targets never enroll files implicitly.\n\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::path::{Component, Path, PathBuf};\n\nuse eyre::Result;\nuse globset::{Glob, GlobSet, GlobSetBuilder};\nuse walkdir::WalkDir;\n\nuse super::select::{self, Selection};\nuse super::shadow::{CaptureRoot, MAX_BYTES, MAX_FILE_BYTES, MAX_FILES};\nuse super::store::{Coverage, CoverageEntry, DerivedRecord, PathReason};\nuse crate::config::Config;\nuse crate::dirs;\nuse crate::file::{self, display_path};\nuse crate::system::files::{FileMode, FilePolicy};\n\n/// How far a chain of symlinks is followed for derived targets.\nconst MAX_LINK_DEPTH: usize = 8;\n\n/// Names under the global config directory that hold credentials: private\n/// by default, in every outgoing representation.\nconst CREDENTIAL_NAMES: &[&str] = &[\"github_tokens.toml\", \"hosts.yml\", \"age.txt\"];\nconst CREDENTIAL_GLOBS: &[&str] = &[\n    \".netrc\",\n    \"*.age\",\n    \"*.key\",\n    \"*.pem\",\n    \"*.gpg\",\n    \"*.kdbx\",\n    \"id_*\",\n    \"*token*\",\n    \"*secret*\",\n    \"credentials*\",\n    \"oauth*\",\n];\n\npub(crate) type Policy = FilePolicy;\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]\npub(crate) enum EntryKind {\n    /// The global config directory and `dotfiles.root`: always tracked.\n    Implicit,\n    /// A `[dotfiles]` entry with `mode = \"track\"`.\n    Track,\n    /// The destination of a source-managed `[dotfiles]` entry.\n    Output,\n    /// The source a source-managed entry references.\n    Source,\n    /// The target of a tracked symlink inside `$HOME`.\n    Derived,\n}\n\n#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]\npub(crate) struct TrackedEntry {\n    /// Absolute, `~` expanded, lexically normalized.\n    pub path: PathBuf,\n    pub kind: EntryKind,\n    /// The declaring mode (`track`, `template`, `copy`, …) or the kind.\n    pub mode: String,\n    pub policy: Policy,\n    /// The shared stream of a tracked file with variants.\n    pub variant: Option<String>,\n    /// For outputs: the source that generates them.\n    pub source: Option<PathBuf>,\n    /// Why the entry is not shared although sharing was not switched off.\n    pub note: Option<String>,\n    pub declared_in: Option<PathBuf>,\n}\n\nimpl TrackedEntry {\n    pub(crate) fn tree_path(&self, path: &Path) -> Result<String> {\n        super::sync::layout::Roots::current()\n            .branch_path(self.kind, path, self.variant.as_deref())\n            .ok_or_else(|| {\n                eyre::eyre!(\n                    \"cannot represent tracked path {} portably\",\n                    display_path(path)\n                )\n            })\n    }\n\n    pub(crate) fn display(&self) -> String {\n        display_path(&self.path)\n    }\n\n    pub(crate) fn new(path: PathBuf, kind: EntryKind, mode: &str, policy: Policy) -> Self {\n        Self {\n            path,\n            kind,\n            mode: mode.to_string(),\n            policy,\n            variant: None,\n            source: None,\n            note: None,\n            declared_in: None,\n        }\n    }\n}\n\n/// The resolved tracked set for one capture.\n#[derive(Clone, Debug, Default)]\npub(crate) struct TrackedSet {\n    pub entries: Vec<TrackedEntry>,\n    pub manifest: super::manifest::Manifest,\n    /// Deployment inputs to validate, not paths enrolled for observation.\n    pub required_sources: Vec<PathBuf>,\n    /// `[history] exclude` globs as written (with `~`).\n    pub exclude: Vec<String>,\n    /// Declarations that could not be honoured, so they are never mistaken\n    /// for protection.\n    pub invalid: Vec<PathReason>,\n}\n\n/// One private file found during a walk.\n#[derive(Clone, Debug)]\npub(crate) struct PrivateFile {\n    pub path: PathBuf,\n    pub reason: String,\n    pub policy: Policy,\n}\n\n/// What a walk of the tracked set found.\n#[derive(Debug, Default)]\npub(crate) struct Walk {\n    pub manifest: super::manifest::Manifest,\n    /// The entries as walked: the set's entries plus derived ones.\n    pub entries: Vec<TrackedEntry>,\n    pub roots: Vec<CaptureRoot>,\n    /// Every captured file with the entry that owns it and its policy.\n    pub files: BTreeMap<PathBuf, (usize, Policy)>,\n    pub private: Vec<PrivateFile>,\n    pub derived: Vec<DerivedRecord>,\n    pub omitted: Vec<PathReason>,\n    pub incomplete: Vec<PathReason>,\n    pub warnings: Vec<String>,\n}\n\nimpl TrackedSet {\n    /// The effective tracked set for the loaded configuration.\n    pub(crate) async fn effective() -> Result<Self> {\n        let config = Config::get().await?;\n        Self::from_config(&config)\n    }\n\n    /// Explicit tracking from the system and global configuration layers.\n    pub(crate) fn from_config(config: &Config) -> Result<Self> {\n        let mut set = Self::default();\n        set.exclude = super::config::exclude_globs()?;\n        let requests = crate::system::files::files_from_config(config)?\n            .into_iter()\n            .filter(|request| crate::system::files::declaration_is_global(config, request));\n        set.add_requests(requests);\n        for invalid in crate::system::files::invalid_declarations() {\n            set.invalid.push(PathReason {\n                path: invalid.target,\n                reason: format!(\"{} ({})\", invalid.reason, display_path(&invalid.config)),\n            });\n        }\n        Ok(set)\n    }\n\n    /// Add already composed, global declarations. Shared by live discovery\n    /// and the read-only incoming-configuration preflight.\n    pub(crate) fn add_requests(\n        &mut self,\n        requests: impl IntoIterator<Item = crate::system::files::FileRequest>,\n    ) {\n        let set = self;\n        let environments = select::active_environments();\n        for request in requests {\n            if request.enabled\n                && matches!(\n                    request.mode,\n                    FileMode::Symlink | FileMode::SymlinkEach | FileMode::Copy | FileMode::Template\n                )\n            {\n                let source = normalize_target(&request.source);\n                if !set.required_sources.contains(&source) {\n                    set.required_sources.push(source);\n                }\n            }\n            if !request.enabled || request.mode != FileMode::Track {\n                continue;\n            }\n            let target = normalize_target(&request.target);\n            let portable =\n                if let Ok(relative) = target.strip_prefix(normalize(&global_config_dir())) {\n                    Some(\n                        format!(\"config/{}\", relative.to_string_lossy().replace('\\\\', \"/\"))\n                            .trim_end_matches('/')\n                            .to_owned(),\n                    )\n                } else if let Ok(relative) = target.strip_prefix(normalize(&dirs::HOME)) {\n                    Some(format!(\n                        \"home/{}\",\n                        relative.to_string_lossy().replace('\\\\', \"/\")\n                    ))\n                } else {\n                    None\n                };\n            let Some(path) = portable.filter(|path| super::sync::layout::is_safe_branch_path(path))\n            else {\n                set.invalid.push(PathReason { path: display_path(&target), reason: \"tracking requires a portable path under home or the mise configuration directory\".into() });\n                continue;\n            };\n            set.manifest.enrollment.retain(|entry| entry.path != path);\n            set.manifest.enrollment.push(super::manifest::Enrollment {\n                path,\n                autosave: request.policy.autosave,\n                encrypt: request.policy.encrypt,\n                variants: request.variants.clone(),\n            });\n            set.manifest.enrollment.sort_by(|a, b| a.path.cmp(&b.path));\n            let declared_in = Some(request.origin.config.clone());\n            match request.mode {\n                FileMode::Track => {\n                    let mut entry = TrackedEntry::new(\n                        normalize_target(&request.target),\n                        EntryKind::Track,\n                        \"track\",\n                        request.policy,\n                    );\n                    entry.declared_in = declared_in;\n                    match select::select(&request.variants, &environments) {\n                        Selection::Single => {}\n                        Selection::Variant(variant) => {\n                            entry.variant = Some(variant.name());\n                        }\n//! Portable enrollment metadata stored in the ordinary tracked-file tree.\n//! This is configuration, not a second history or a machine recovery record.\n\nuse eyre::{Result, bail};\nuse serde::{Deserialize, Serialize};\n\nuse super::select::Variant;\nuse super::shadow::{HistoryRepo, Overlay};\n\npub(crate) const PATH: &str = \".mise-history/manifest.json\";\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Enrollment {\n    /// A portable repository path, rooted at `home/` or `config/`.\n    pub path: String,\n    pub autosave: bool,\n    pub encrypt: bool,\n    pub variants: Vec<Variant>,\n}\n\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\n#[serde(deny_unknown_fields)]\npub(crate) struct Manifest {\n    pub format: u32,\n    pub enrollment: Vec<Enrollment>,\n    pub exclude: Vec<String>,\n    pub recipients: Vec<String>,\n}\n\nimpl Default for Manifest {\n    fn default() -> Self {\n        Self {\n            format: 1,\n            enrollment: vec![],\n            exclude: vec![],\n            recipients: vec![],\n        }\n    }\n}\n\nimpl Manifest {\n    /// Restore enrollment from Git without needing a captured mise config.\n    /// Deployment inputs are validated separately; none are inferred here.\n    pub(crate) fn tracking(&self) -> Result<super::tracked::TrackedSet> {\n        self.validate()?;\n        let roots = super::sync::layout::Roots::current();\n        let environments = super::select::active_environments();\n        let mut tracked = super::tracked::TrackedSet {\n            manifest: self.clone(),\n            exclude: self.exclude.clone(),\n            ..Default::default()\n        };\n        for enrollment in &self.enrollment {\n            let variant = match super::select::select(&enrollment.variants, &environments) {\n                super::select::Selection::Single => None,\n                super::select::Selection::Variant(variant) => Some(variant.name()),\n                super::select::Selection::NoMatch => continue,\n                super::select::Selection::Ambiguous(_) => {\n                    bail!(\"ambiguous variants for {}\", enrollment.path)\n                }\n            };\n            let local = roots\n                .locate(&enrollment.path)\n                .path()\n                .ok_or_else(|| eyre::eyre!(\"invalid enrollment path {}\", enrollment.path))?\n                .to_path_buf();\n            let mut policy =\n                crate::system::files::FilePolicy::for_mode(crate::system::files::FileMode::Track);\n            policy.autosave = enrollment.autosave;\n            policy.encrypt = enrollment.encrypt;\n            let mut entry = super::tracked::TrackedEntry::new(\n                local,\n                super::tracked::EntryKind::Track,\n                \"track\",\n                policy,\n            );\n            entry.variant = variant;\n            tracked.entries.push(entry);\n        }\n        Ok(tracked)\n    }\n\n    /// Every declared encrypted stream, including platforms inactive here.\n    pub(crate) fn encrypted_paths(&self) -> std::collections::BTreeSet<String> {\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in self.enrollment.iter().filter(|entry| entry.encrypt) {\n            if entry.variants.is_empty() {\n                paths.insert(entry.path.clone());\n            } else {\n                let (root, relative) = entry.path.split_once('/').unwrap_or((&entry.path, \"\"));\n                for variant in &entry.variants {\n                    let stem = format!(\"{root}@{}\", variant.name());\n                    paths.insert(if relative.is_empty() {\n                        stem\n                    } else {\n                        format!(\"{stem}/{relative}\")\n                    });\n                }\n            }\n        }\n        paths\n    }\n\n    fn owner(&self, path: &str) -> Option<&Enrollment> {\n        self.enrollment\n            .iter()\n            .filter(|entry| {\n                path == entry.path\n                    || path\n                        .strip_prefix(&entry.path)\n                        .is_some_and(|rest| rest.starts_with('/'))\n            })\n            .max_by_key(|entry| entry.path.len())\n    }\n\n    /// Carry inactive streams and repository-owned files from the same parent\n    /// tree. Paths explicitly untracked since that parent are deliberately not\n    /// carried; no live file is removed by this tree construction.\n    pub(crate) fn preserve_other_files(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\n        let Some(parent) = repo.ref_oid(HistoryRepo::HISTORY_REF)? else {\n            return Ok(tree.into());\n        };\n        let previous = Self::read(repo, &parent)?.unwrap_or_default();\n        let environments = super::select::active_environments();\n        let mut overlays = vec![];\n        for file in repo.ls_tree(&parent)? {\n            if file.path.starts_with(\".mise-history/\") {\n                continue;\n            }\n            let (stem, relative) = file.path.split_once('/').unwrap_or((&file.path, \"\"));\n            let (root, variant) = stem\n                .split_once('@')\n                .map_or((stem, None), |(root, variant)| (root, Some(variant)));\n            let portable = if relative.is_empty() {\n                root.into()\n            } else {\n                format!(\"{root}/{relative}\")\n            };\n            let carry = match self.owner(&portable) {\n                None => previous.owner(&portable).is_none(),\n                Some(entry) => {\n                    let selected = match super::select::select(&entry.variants, &environments) {\n                        super::select::Selection::Single => None,\n                        super::select::Selection::Variant(variant) => Some(variant.name()),\n                        super::select::Selection::NoMatch => Some(String::new()),\n                        super::select::Selection::Ambiguous(_) => {\n                            bail!(\"ambiguous variants for {}\", entry.path)\n                        }\n                    };\n                    variant != selected.as_deref()\n                        && variant.is_some_and(|name| {\n                            entry.variants.iter().any(|variant| variant.name() == name)\n                        })\n                }\n            };\n            if carry {\n                overlays.push(Overlay {\n                    path: file.path,\n                    object: Some((file.mode, file.oid)),\n                });\n            }\n        }\n        repo.compose(tree, &overlays)\n    }\n\n    pub(crate) fn validate(&self) -> Result<()> {\n        if self.format != 1 {\n            bail!(\"unsupported dotfile repository format {}\", self.format);\n        }\n        let mut paths = std::collections::BTreeSet::new();\n        for entry in &self.enrollment {\n            if !super::sync::layout::is_safe_branch_path(&entry.path)\n                || !(entry.path.starts_with(\"home/\")\n                    || entry.path == \"config\"\n                    || entry.path.starts_with(\"config/\"))\n                || !paths.insert(&entry.path)\n            {\n                bail!(\"invalid or repeated enrollment path {}\", entry.path);\n            }\n            let mut variants = std::collections::BTreeSet::new();\n            for variant in &entry.variants {\n                let name = variant.name();\n                if name.contains('@')\n                    || !super::sync::layout::is_safe_branch_path(&name)\n                    || !variants.insert(name)\n                {\n                    bail!(\"invalid or repeated variant for {}\", entry.path);\n                }\n            }\n        }\n        Ok(())\n    }\n\n    pub(crate) fn read(repo: &HistoryRepo, tree: &str) -> Result<Option<Self>> {\n        let Some((mode, oid)) = repo.object_at(tree, PATH)? else {\n            return Ok(None);\n        };\n        if mode != \"100644\" {\n            bail!(\"dotfile enrollment metadata must be a regular file\");\n        }\n        let manifest: Self =\n            serde_json::from_slice(&repo.cat_object_bounded(&oid, 4 * 1024 * 1024)?)?;\n        manifest.validate()?;\n        Ok(Some(manifest))\n    }\n\n    pub(crate) fn write(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\n        self.validate()?;\n        let oid = repo.hash_blob(&serde_json::to_vec_pretty(self)?)?;\n        let marker = repo.hash_blob(super::sync::format::marker_content().as_bytes())?;\n        repo.compose(\n            tree,\n            &[\n                Overlay {\n                    path: PATH.into(),\n                    object: Some((\"100644\".into(), oid)),\n                },\n                Overlay {\n                    path: super::sync::layout::MARKER_PATH.into(),\n        self.dry_run\n    }\n\n    pub(super) fn inherit_root_flags(&mut self, dry_run: bool, yes: bool) {\n        self.dry_run |= dry_run;\n        self.yes |= yes;\n    }\n\n    #[cfg(test)]\n    pub(super) fn inherited_root_flags(&self) -> (bool, bool) {\n        (self.dry_run, self.yes)\n    }\n\n    pub(crate) async fn run(mut self) -> Result<()> {\n        if self.from.is_some() || self.from_git.is_some() {\n            if self.command.is_some() {\n                let flag = if self.from_git.is_some() {\n                    \"--from-git\"\n                } else {\n                    \"--from\"\n                };\n                bail!(\"{flag} cannot be used with a bootstrap subcommand\");\n            }\n            return self.run_from().await;\n        }\n        if let Some(command) = self.command.take() {\n            return command.run().await;\n        }\n        let generation = OperationScope::begin(\"bootstrap\", self.dry_run).await?;\n        let result = self.run_phases().await;\n        generation.refresh_tracked().await;\n        let error = result.as_ref().err().map(|err| format!(\"{err:#}\"));\n        generation.finish(error, result.as_ref().ok().cloned());\n        // a complete run applied the declarations that arrived through\n                .await?;\n        }\n        follow_up.print()?;\n        Ok(summary)\n    }\n\n    async fn run_from(&self) -> Result<()> {\n        let expanded = self\n            .from_git\n            .as_deref()\n            .map(crate::github_relay::expand_repository)\n            .transpose()?;\n        // a history-managed setup repository is not cloned into the\n        // configuration directory: its branch goes into mise's own store and\n        // its files are written by the same recoverable pull as any other\n        // incoming change; the ordinary bootstrap then runs from them\n        if let Some(url) = expanded.as_deref()\n            && let Some(outcome) =\n                system::history::sync::onboard::from_git(url, self.yes, self.dry_run).await?\n        {\n            if self.dry_run {\n                if let Some(preview) = outcome.preview_config.as_ref() {\n                    self.run_child_bootstrap(preview.path().to_path_buf())\n                        .await?;\n                }\n                return Ok(());\n            }\n            // the configuration that arrived is what to bootstrap from; one\n            // held for a decision leaves the existing one, whose tasks and\n            // installations are not what was asked for\n            if outcome.configuration_held {\n                bail!(\n                    \"the configuration from {url} waits for a decision (a differing one is here already); nothing was bootstrapped. `mise bootstrap dotfiles status` lists it, `mise bootstrap dotfiles pull --take-remote|--keep-local <path>` decides, then run `mise bootstrap`\"\n                );\n            }\n            let config_dir = system::history::tracked::global_config_dir();\n            self.run_child_bootstrap(config_dir).await?;\n            if !outcome.durable_access {\n                warn!(\"ongoing synchronization still needs credentials on this host (see above)\");\n            }\n            return Ok(());\n        }\n        let (url, checkout) = if let Some(url) = expanded.as_deref() {\n            let checkout = crate::env::MISE_GLOBAL_CONFIG_FILE\n                .as_deref()\n"},"started_at_ms":1788758086764,"completed_at_ms":1788758086764}}
{"timestamp":"2026-09-07T05:14:46.882Z","ordinal":18502,"type":"token_usage_record","payload":{"thread_id":"01a07177-9855-71a2-89cd-4a9a37cdbfcb","turn_id":"01a079e2-ddee-7920-adc1-13c441666749","session_id":"01a07177-9855-71a2-89cd-4a9a37cdbfcb","root_turn_id":"01a079e2-ddee-7920-adc1-13c441666749","response_id":"resp_02be90ffdd5dff4a016a9e483c736487d0abb7239ab2e8405e","usage":{"input_tokens":49819,"cached_input_tokens":48000,"cache_write_input_tokens":0,"output_tokens":274,"reasoning_output_tokens":17,"total_tokens":50093},"turn_token_usage":{"input_tokens":44940894,"cached_input_tokens":44169728,"cache_write_input_tokens":0,"output_tokens":157824,"reasoning_output_tokens":63809,"total_tokens":45098718},"thread_token_usage":{"input_tokens":326963214,"cached_input_tokens":319642112,"cache_write_input_tokens":0,"output_tokens":932838,"reasoning_output_tokens":243965,"total_tokens":327896052}}}
{"timestamp":"2026-09-07T05:14:47.969Z","ordinal":18503,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a07a4a-5921-7b83-a238-bacadbf54bc4","call_id":"call_iKigfemZETTjVUvgImPdWrac","output":[{"type":"input_text","text":"Script completed\nWall time 1.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"1ddaeb\",\"wall_time_seconds\":0.000006708,\"exit_code\":0,\"original_token_count\":5277,\"output\":\"//! The effective tracked set: which paths a capture covers, under which\\n//! policies, and how they map onto the snapshot tree.\\n//!\\n//! mise's own walker decides what is captured — never git's ignore rules —\\n//! and hands the repository literal file pathspecs. Every file belongs to\\n//! exactly one entry, the most specific one covering it, whose policies\\n//! apply. Hard exclusions are only mise's internals: the history store, the\\n//! mise state/cache/data/installs/downloads/plugins directories, and `.git`\\n//! directories (a nested repository is captured as a gitlink).\\n//!\\n//! Only explicit `mode = \\\"track\\\"` declarations enroll paths. Deployment\\n//! declarations and symlink targets never enroll files implicitly.\\n\\nuse std::collections::{BTreeMap, BTreeSet};\\nuse std::path::{Component, Path, PathBuf};\\n\\nuse eyre::Result;\\nuse globset::{Glob, GlobSet, GlobSetBuilder};\\nuse walkdir::WalkDir;\\n\\nuse super::select::{self, Selection};\\nuse super::shadow::{CaptureRoot, MAX_BYTES, MAX_FILE_BYTES, MAX_FILES};\\nuse super::store::{Coverage, CoverageEntry, DerivedRecord, PathReason};\\nuse crate::config::Config;\\nuse crate::dirs;\\nuse crate::file::{self, display_path};\\nuse crate::system::files::{FileMode, FilePolicy};\\n\\n/// How far a chain of symlinks is followed for derived targets.\\nconst MAX_LINK_DEPTH: usize = 8;\\n\\n/// Names under the global config directory that hold credentials: private\\n/// by default, in every outgoing representation.\\nconst CREDENTIAL_NAMES: &[&str] = &[\\\"github_tokens.toml\\\", \\\"hosts.yml\\\", \\\"age.txt\\\"];\\nconst CREDENTIAL_GLOBS: &[&str] = &[\\n    \\\".netrc\\\",\\n    \\\"*.age\\\",\\n    \\\"*.key\\\",\\n    \\\"*.pem\\\",\\n    \\\"*.gpg\\\",\\n    \\\"*.kdbx\\\",\\n    \\\"id_*\\\",\\n    \\\"*token*\\\",\\n    \\\"*secret*\\\",\\n    \\\"credentials*\\\",\\n    \\\"oauth*\\\",\\n];\\n\\npub(crate) type Policy = FilePolicy;\\n\\n#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]\\npub(crate) enum EntryKind {\\n    /// The global config directory and `dotfiles.root`: always tracked.\\n    Implicit,\\n    /// A `[dotfiles]` entry with `mode = \\\"track\\\"`.\\n    Track,\\n    /// The destination of a source-managed `[dotfiles]` entry.\\n    Output,\\n    /// The source a source-managed entry references.\\n    Source,\\n    /// The target of a tracked symlink inside `$HOME`.\\n    Derived,\\n}\\n\\n#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]\\npub(crate) struct TrackedEntry {\\n    /// Absolute, `~` expanded, lexically normalized.\\n    pub path: PathBuf,\\n    pub kind: EntryKind,\\n    /// The declaring mode (`track`, `template`, `copy`, …) or the kind.\\n    pub mode: String,\\n    pub policy: Policy,\\n    /// The shared stream of a tracked file with variants.\\n    pub variant: Option<String>,\\n    /// For outputs: the source that generates them.\\n    pub source: Option<PathBuf>,\\n    /// Why the entry is not shared although sharing was not switched off.\\n    pub note: Option<String>,\\n    pub declared_in: Option<PathBuf>,\\n}\\n\\nimpl TrackedEntry {\\n    pub(crate) fn tree_path(&self, path: &Path) -> Result<String> {\\n        super::sync::layout::Roots::current()\\n            .branch_path(self.kind, path, self.variant.as_deref())\\n            .ok_or_else(|| {\\n                eyre::eyre!(\\n                    \\\"cannot represent tracked path {} portably\\\",\\n                    display_path(path)\\n                )\\n            })\\n    }\\n\\n    pub(crate) fn display(&self) -> String {\\n        display_path(&self.path)\\n    }\\n\\n    pub(crate) fn new(path: PathBuf, kind: EntryKind, mode: &str, policy: Policy) -> Self {\\n        Self {\\n            path,\\n            kind,\\n            mode: mode.to_string(),\\n            policy,\\n            variant: None,\\n            source: None,\\n            note: None,\\n            declared_in: None,\\n        }\\n    }\\n}\\n\\n/// The resolved tracked set for one capture.\\n#[derive(Clone, Debug, Default)]\\npub(crate) struct TrackedSet {\\n    pub entries: Vec<TrackedEntry>,\\n    pub manifest: super::manifest::Manifest,\\n    /// Deployment inputs to validate, not paths enrolled for observation.\\n    pub required_sources: Vec<PathBuf>,\\n    /// `[history] exclude` globs as written (with `~`).\\n    pub exclude: Vec<String>,\\n    /// Declarations that could not be honoured, so they are never mistaken\\n    /// for protection.\\n    pub invalid: Vec<PathReason>,\\n}\\n\\n/// One private file found during a walk.\\n#[derive(Clone, Debug)]\\npub(crate) struct PrivateFile {\\n    pub path: PathBuf,\\n    pub reason: String,\\n    pub policy: Policy,\\n}\\n\\n/// What a walk of the tracked set found.\\n#[derive(Debug, Default)]\\npub(crate) struct Walk {\\n    pub manifest: super::manifest::Manifest,\\n    /// The entries as walked: the set's entries plus derived ones.\\n    pub entries: Vec<TrackedEntry>,\\n    pub roots: Vec<CaptureRoot>,\\n    /// Every captured file with the entry that owns it and its policy.\\n    pub files: BTreeMap<PathBuf, (usize, Policy)>,\\n    pub private: Vec<PrivateFile>,\\n    pub derived: Vec<DerivedRecord>,\\n    pub omitted: Vec<PathReason>,\\n    pub incomplete: Vec<PathReason>,\\n    pub warnings: Vec<String>,\\n}\\n\\nimpl TrackedSet {\\n    /// The effective tracked set for the loaded configuration.\\n    pub(crate) async fn effective() -> Result<Self> {\\n        let config = Config::get().await?;\\n        Self::from_config(&config)\\n    }\\n\\n    /// Explicit tracking from the system and global configuration layers.\\n    pub(crate) fn from_config(config: &Config) -> Result<Self> {\\n        let mut set = Self::default();\\n        set.exclude = super::config::exclude_globs()?;\\n        let requests = crate::system::files::files_from_config(config)?\\n            .into_iter()\\n            .filter(|request| crate::system::files::declaration_is_global(config, request));\\n        set.add_requests(requests);\\n        for invalid in crate::system::files::invalid_declarations() {\\n            set.invalid.push(PathReason {\\n                path: invalid.target,\\n                reason: format!(\\\"{} ({})\\\", invalid.reason, display_path(&invalid.config)),\\n            });\\n        }\\n        Ok(set)\\n    }\\n\\n    /// Add already composed, global declarations. Shared by live discovery\\n    /// and the read-only incoming-configuration preflight.\\n    pub(crate) fn add_requests(\\n        &mut self,\\n        requests: impl IntoIterator<Item = crate::system::files::FileRequest>,\\n    ) {\\n        let set = self;\\n        let environments = select::active_environments();\\n        for request in requests {\\n            if request.enabled\\n                && matches!(\\n                    request.mode,\\n                    FileMode::Symlink | FileMode::SymlinkEach | FileMode::Copy | FileMode::Template\\n                )\\n            {\\n                let source = normalize_target(&request.source);\\n                if !set.required_sources.contains(&source) {\\n                    set.required_sources.push(source);\\n                }\\n            }\\n            if !request.enabled || request.mode != FileMode::Track {\\n                continue;\\n            }\\n            let target = normalize_target(&request.target);\\n            let portable =\\n                if let Ok(relative) = target.strip_prefix(normalize(&global_config_dir())) {\\n                    Some(\\n                        format!(\\\"config/{}\\\", relative.to_string_lossy().replace('\\\\\\\\', \\\"/\\\"))\\n                            .trim_end_matches('/')\\n                            .to_owned(),\\n                    )\\n                } else if let Ok(relative) = target.strip_prefix(normalize(&dirs::HOME)) {\\n                    Some(format!(\\n                        \\\"home/{}\\\",\\n                        relative.to_string_lossy().replace('\\\\\\\\', \\\"/\\\")\\n                    ))\\n                } else {\\n                    None\\n                };\\n            let Some(path) = portable.filter(|path| super::sync::layout::is_safe_branch_path(path))\\n            else {\\n                set.invalid.push(PathReason { path: display_path(&target), reason: \\\"tracking requires a portable path under home or the mise configuration directory\\\".into() });\\n                continue;\\n            };\\n            set.manifest.enrollment.retain(|entry| entry.path != path);\\n            set.manifest.enrollment.push(super::manifest::Enrollment {\\n                path,\\n                autosave: request.policy.autosave,\\n                encrypt: request.policy.encrypt,\\n                variants: request.variants.clone(),\\n            });\\n            set.manifest.enrollment.sort_by(|a, b| a.path.cmp(&b.path));\\n            let declared_in = Some(request.origin.config.clone());\\n            match request.mode {\\n                FileMode::Track => {\\n                    let mut entry = TrackedEntry::new(\\n                        normalize_target(&request.target),\\n                        EntryKind::Track,\\n                        \\\"track\\\",\\n                        request.policy,\\n                    );\\n                    entry.declared_in = declared_in;\\n                    match select::select(&request.variants, &environments) {\\n                        Selection::Single => {}\\n                        Selection::Variant(variant) => {\\n                            entry.variant = Some(variant.name());\\n                        }\\n//! Portable enrollment metadata stored in the ordinary tracked-file tree.\\n//! This is configuration, not a second history or a machine recovery record.\\n\\nuse eyre::{Result, bail};\\nuse serde::{Deserialize, Serialize};\\n\\nuse super::select::Variant;\\nuse super::shadow::{HistoryRepo, Overlay};\\n\\npub(crate) const PATH: &str = \\\".mise-history/manifest.json\\\";\\n\\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\\n#[serde(deny_unknown_fields)]\\npub(crate) struct Enrollment {\\n    /// A portable repository path, rooted at `home/` or `config/`.\\n    pub path: String,\\n    pub autosave: bool,\\n    pub encrypt: bool,\\n    pub variants: Vec<Variant>,\\n}\\n\\n#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]\\n#[serde(deny_unknown_fields)]\\npub(crate) struct Manifest {\\n    pub format: u32,\\n    pub enrollment: Vec<Enrollment>,\\n    pub exclude: Vec<String>,\\n    pub recipients: Vec<String>,\\n}\\n\\nimpl Default for Manifest {\\n    fn default() -> Self {\\n        Self {\\n            format: 1,\\n            enrollment: vec![],\\n            exclude: vec![],\\n            recipients: vec![],\\n        }\\n    }\\n}\\n\\nimpl Manifest {\\n    /// Restore enrollment from Git without needing a captured mise config.\\n    /// Deployment inputs are validated separately; none are inferred here.\\n    pub(crate) fn tracking(&self) -> Result<super::tracked::TrackedSet> {\\n        self.validate()?;\\n        let roots = super::sync::layout::Roots::current();\\n        let environments = super::select::active_environments();\\n        let mut tracked = super::tracked::TrackedSet {\\n            manifest: self.clone(),\\n            exclude: self.exclude.clone(),\\n            ..Default::default()\\n        };\\n        for enrollment in &self.enrollment {\\n            let variant = match super::select::select(&enrollment.variants, &environments) {\\n                super::select::Selection::Single => None,\\n                super::select::Selection::Variant(variant) => Some(variant.name()),\\n                super::select::Selection::NoMatch => continue,\\n                super::select::Selection::Ambiguous(_) => {\\n                    bail!(\\\"ambiguous variants for {}\\\", enrollment.path)\\n                }\\n            };\\n            let local = roots\\n                .locate(&enrollment.path)\\n                .path()\\n                .ok_or_else(|| eyre::eyre!(\\\"invalid enrollment path {}\\\", enrollment.path))?\\n                .to_path_buf();\\n            let mut policy =\\n                crate::system::files::FilePolicy::for_mode(crate::system::files::FileMode::Track);\\n            policy.autosave = enrollment.autosave;\\n            policy.encrypt = enrollment.encrypt;\\n            let mut entry = super::tracked::TrackedEntry::new(\\n                local,\\n                super::tracked::EntryKind::Track,\\n                \\\"track\\\",\\n                policy,\\n            );\\n            entry.variant = variant;\\n            tracked.entries.push(entry);\\n        }\\n        Ok(tracked)\\n    }\\n\\n    /// Every declared encrypted stream, including platforms inactive here.\\n    pub(crate) fn encrypted_paths(&self) -> std::collections::BTreeSet<String> {\\n        let mut paths = std::collections::BTreeSet::new();\\n        for entry in self.enrollment.iter().filter(|entry| entry.encrypt) {\\n            if entry.variants.is_empty() {\\n                paths.insert(entry.path.clone());\\n            } else {\\n                let (root, relative) = entry.path.split_once('/').unwrap_or((&entry.path, \\\"\\\"));\\n                for variant in &entry.variants {\\n                    let stem = format!(\\\"{root}@{}\\\", variant.name());\\n                    paths.insert(if relative.is_empty() {\\n                        stem\\n                    } else {\\n                        format!(\\\"{stem}/{relative}\\\")\\n                    });\\n                }\\n            }\\n        }\\n        paths\\n    }\\n\\n    fn owner(&self, path: &str) -> Option<&Enrollment> {\\n        self.enrollment\\n            .iter()\\n            .filter(|entry| {\\n                path == entry.path\\n                    || path\\n                        .strip_prefix(&entry.path)\\n                        .is_some_and(|rest| rest.starts_with('/'))\\n            })\\n            .max_by_key(|entry| entry.path.len())\\n    }\\n\\n    /// Carry inactive streams and repository-owned files from the same parent\\n    /// tree. Paths explicitly untracked since that parent are deliberately not\\n    /// carried; no live file is removed by this tree construction.\\n    pub(crate) fn preserve_other_files(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\\n        let Some(parent) = repo.ref_oid(HistoryRepo::HISTORY_REF)? else {\\n            return Ok(tree.into());\\n        };\\n        let previous = Self::read(repo, &parent)?.unwrap_or_default();\\n        let environments = super::select::active_environments();\\n        let mut overlays = vec![];\\n        for file in repo.ls_tree(&parent)? {\\n            if file.path.starts_with(\\\".mise-history/\\\") {\\n                continue;\\n            }\\n            let (stem, relative) = file.path.split_once('/').unwrap_or((&file.path, \\\"\\\"));\\n            let (root, variant) = stem\\n                .split_once('@')\\n                .map_or((stem, None), |(root, variant)| (root, Some(variant)));\\n            let portable = if relative.is_empty() {\\n                root.into()\\n            } else {\\n                format!(\\\"{root}/{relative}\\\")\\n            };\\n            let carry = match self.owner(&portable) {\\n                None => previous.owner(&portable).is_none(),\\n                Some(entry) => {\\n                    let selected = match super::select::select(&entry.variants, &environments) {\\n                        super::select::Selection::Single => None,\\n                        super::select::Selection::Variant(variant) => Some(variant.name()),\\n                        super::select::Selection::NoMatch => Some(String::new()),\\n                        super::select::Selection::Ambiguous(_) => {\\n                            bail!(\\\"ambiguous variants for {}\\\", entry.path)\\n                        }\\n                    };\\n                    variant != selected.as_deref()\\n                        && variant.is_some_and(|name| {\\n                            entry.variants.iter().any(|variant| variant.name() == name)\\n                        })\\n                }\\n            };\\n            if carry {\\n                overlays.push(Overlay {\\n                    path: file.path,\\n                    object: Some((file.mode, file.oid)),\\n                });\\n            }\\n        }\\n        repo.compose(tree, &overlays)\\n    }\\n\\n    pub(crate) fn validate(&self) -> Result<()> {\\n        if self.format != 1 {\\n            bail!(\\\"unsupported dotfile repository format {}\\\", self.format);\\n        }\\n        let mut paths = std::collections::BTreeSet::new();\\n        for entry in &self.enrollment {\\n            if !super::sync::layout::is_safe_branch_path(&entry.path)\\n                || !(entry.path.starts_with(\\\"home/\\\")\\n                    || entry.path == \\\"config\\\"\\n                    || entry.path.starts_with(\\\"config/\\\"))\\n                || !paths.insert(&entry.path)\\n            {\\n                bail!(\\\"invalid or repeated enrollment path {}\\\", entry.path);\\n            }\\n            let mut variants = std::collections::BTreeSet::new();\\n            for variant in &entry.variants {\\n                let name = variant.name();\\n                if name.contains('@')\\n                    || !super::sync::layout::is_safe_branch_path(&name)\\n                    || !variants.insert(name)\\n                {\\n                    bail!(\\\"invalid or repeated variant for {}\\\", entry.path);\\n                }\\n            }\\n        }\\n        Ok(())\\n    }\\n\\n    pub(crate) fn read(repo: &HistoryRepo, tree: &str) -> Result<Option<Self>> {\\n        let Some((mode, oid)) = repo.object_at(tree, PATH)? else {\\n            return Ok(None);\\n        };\\n        if mode != \\\"100644\\\" {\\n            bail!(\\\"dotfile enrollment metadata must be a regular file\\\");\\n        }\\n        let manifest: Self =\\n            serde_json::from_slice(&repo.cat_object_bounded(&oid, 4 * 1024 * 1024)?)?;\\n        manifest.validate()?;\\n        Ok(Some(manifest))\\n    }\\n\\n    pub(crate) fn write(&self, repo: &HistoryRepo, tree: &str) -> Result<String> {\\n        self.validate()?;\\n        let oid = repo.hash_blob(&serde_json::to_vec_pretty(self)?)?;\\n        let marker = repo.hash_blob(super::sync::format::marker_content().as_bytes())?;\\n        repo.compose(\\n            tree,\\n            &[\\n                Overlay {\\n                    path: PATH.into(),\\n                    object: Some((\\\"100644\\\".into(), oid)),\\n                },\\n                Overlay {\\n                    path: super::sync::layout::MARKER_PATH.into(),\\n        self.dry_run\\n    }\\n\\n    pub(super) fn inherit_root_flags(&mut self, dry_run: bool, yes: bool) {\\n        self.dry_run |= dry_run;\\n        self.yes |= yes;\\n    }\\n\\n    #[cfg(test)]\\n    pub(super) fn inherited_root_flags(&self) -> (bool, bool) {\\n        (self.dry_run, self.yes)\\n    }\\n\\n    pub(crate) async fn run(mut self) -> Result<()> {\\n        if self.from.is_some() || self.from_git.is_some() {\\n            if self.command.is_some() {\\n                let flag = if self.from_git.is_some() {\\n                    \\\"--from-git\\\"\\n                } else {\\n                    \\\"--from\\\"\\n                };\\n                bail!(\\\"{flag} cannot be used with a bootstrap subcommand\\\");\\n            }\\n            return self.run_from().await;\\n        }\\n        if let Some(command) = self.command.take() {\\n            return command.run().await;\\n        }\\n        let generation = OperationScope::begin(\\\"bootstrap\\\", self.dry_run).await?;\\n        let result = self.run_phases().await;\\n        generation.refresh_tracked().await;\\n        let error = result.as_ref().err().map(|err| format!(\\\"{err:#}\\\"));\\n        generation.finish(error, result.as_ref().ok().cloned());\\n        // a complete run applied the declarations that arrived through\\n                .await?;\\n        }\\n        follow_up.print()?;\\n        Ok(summary)\\n    }\\n\\n    async fn run_from(&self) -> Result<()> {\\n        let expanded = self\\n            .from_git\\n            .as_deref()\\n            .map(crate::github_relay::expand_repository)\\n            .transpose()?;\\n        // a history-managed setup repository is not cloned into the\\n        // configuration directory: its branch goes into mise's own store and\\n        // its files are written by the same recoverable pull as any other\\n        // incoming change; the ordinary bootstrap then runs from them\\n        if let Some(url) = expanded.as_deref()\\n            && let Some(outcome) =\\n                system::history::sync::onboard::from_git(url, self.yes, self.dry_run).await?\\n        {\\n            if self.dry_run {\\n                if let Some(preview) = outcome.preview_config.as_ref() {\\n                    self.run_child_bootstrap(preview.path().to_path_buf())\\n                        .await?;\\n                }\\n                return Ok(());\\n            }\\n            // the configuration that arrived is what to bootstrap from; one\\n            // held for a decision leaves the existing one, whose tasks and\\n            // installations are not what was asked for\\n            if outcome.configuration_held {\\n                bail!(\\n                    \\\"the configuration from {url} waits for a decision (a differing one is here already); nothing was bootstrapped. `mise bootstrap dotfiles status` lists it, `mise bootstrap dotfiles pull --take-remote|--keep-local <path>` decides, then run `mise bootstrap`\\\"\\n                );\\n            }\\n            let config_dir = system::history::tracked::global_config_dir();\\n            self.run_child_bootstrap(config_dir).await?;\\n            if !outcome.durable_access {\\n                warn!(\\\"ongoing synchronization still needs credentials on this host (see above)\\\");\\n            }\\n            return Ok(());\\n        }\\n        let (url, checkout) = if let Some(url) = expanded.as_deref() {\\n            let checkout = crate::env::MISE_GLOBAL_CONFIG_FILE\\n                .as_deref()\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"95ff33\",\"wall_time_seconds\":1.002378709,\"session_id\":22869,\"original_token_count\":52,\"output\":\"mise WARN  GitHub OAuth refresh was rejected (incorrect_client_credentials): The client_id and/or client_secret passed are incorrect.. Reauthorization is required; run `mise token github --oauth --refresh`\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a079e2-ddee-7920-adc1-13c441666749","create_time":1788758087.969165}}}
