es(\\n+        mut self,\\n+        error: Option\u003cString\u003e,\\n+        summary: Option\u003cSummary\u003e,\\n+        writes_finished: bool,\\n+    ) {\\n         let Some(shared) = self.0.take() else {\\n             return;\\n         };\\n         Self::clear_current();\\n-        if let Err(err) = lock_unpoisoned(\u0026shared).finish(error, summary) {\\n+        if let Err(err) = lock_unpoisoned(\u0026shared).finish(error, summary, writes_finished) {\\n             warn!(\\\"history: could not finish the operation record: {err:#}\\\");\\n         }\\n     }\\n@@ -343,6 +358,7 @@ impl Writer {\\n         };\\n         let pending = Pending {\\n             id: outcome_id,\\n+            recovery: store::RecoveryState::Pending,\\n             checkpoint: Checkpoint {\\n                 schema_version: store::SCHEMA_VERSION,\\n                 uuid,\\n@@ -453,7 +469,17 @@ impl Writer {\\n         store::write_pending_in(self.store.state_dir(), \u0026self.pending)\\n     }\\n \\n-    fn finish(\u0026mut self, error: Option\u003cString\u003e, summary: Option\u003cSummary\u003e) -\u003e Result\u003c()\u003e {\\n+    fn finish(\\n+        \u0026mut self,\\n+        error: Option\u003cString\u003e,\\n+        summary: Option\u003cSummary\u003e,\\n+        writes_finished: bool,\\n+    ) -\u003e Result\u003c()\u003e {\\n+        self.pending.recovery = if writes_finished {\\n+            store::RecoveryState::UnfinishedWrites\\n+        } else {\\n+            store::RecoveryState::Pending\\n+        };\\n         let status = if error.is_some() {\\n             OperationStatus::Failed\\n         } else {\\n@@ -485,6 +511,10 @@ impl Writer {\\n     fn write_outcome(\u0026mut self) -\u003e Result\u003c()\u003e {\\n         let state_dir = self.store.state_dir().to_path_buf();\\n         let _store_lock = self.store.lock()?;\\n+        // Persist the outcome before recovery. A failure or concurrent edit\\n+        // must leave the only recovery record intact for a later retry.\\n+        self.write_pending()?;\\n+        recover_pending(\u0026state_dir, \u0026mut self.pending)?;\\n         let checkpoint = \u0026self.pending.checkpoint;\\n         let operation = self.operation().clone();\\n         let mut draft = Draft::new(checkpoint.trigger);\\n@@ -511,6 +541,7 @@ impl Writer {\\n             .attempt_locked(\u0026self.tracked, draft, Some(self.pending.id))?;\\n         let uuid = self.pending.checkpoint.uuid.clone();\\n         store::remove_pending_in(\u0026state_dir, \u0026uuid);\\n+        super::recovery::discard(\u0026state_dir, \u0026operation.journal)?;\\n         store::remove_marker_in(\u0026state_dir);\\n \\n         Ok(())\\n@@ -586,19 +617,30 @@ pub(crate) fn recover_stale(store: \u0026Store, tracked: \u0026TrackedSet) -\u003e Result\u003c()\u003e {\\n     let _store_lock = store.lock()?;\\n     let index = store::load_index_in(state_dir)?;\\n     for (path, mut record) in pending {\\n+        let interrupted = record\\n+            .checkpoint\\n+            .operation\\n+            .as_ref()\\n+            .is_some_and(|operation| operation.status == OperationStatus::Pending);\\n+        recover_pending(state_dir, \u0026mut record)?;\\n         if index.by_uuid(\u0026record.checkpoint.uuid).is_some() {\\n             warn!(\\n                 \\\"history: dropping a stale pending record for checkpoint {}, which was recorded\\\",\\n                 record.checkpoint.uuid\\n             );\\n             let _ = std::fs::remove_file(\u0026path);\\n+            if let Some(operation) = \u0026record.checkpoint.operation {\\n+                super::recovery::discard(state_dir, \u0026operation.journal)?;\\n+            }\\n             continue;\\n         }\\n         warn!(\\n             \\\"history: operation {} did not finish; recording it as failed\\\",\\n             record.checkpoint.uuid\\n         );\\n-        if let Some(operation) = record.checkpoint.operation.as_mut() {\\n+        if let Some(operation) = record.checkpoint.operation.as_mut()\\n+            \u0026\u0026 interrupted\\n+        {\\n             operation.status = OperationStatus::Failed;\\n             operation.finished_at = Some(store::now_rfc3339());\\n             operation.error = Some(\\\"the command exited before finishing; files observed during recovery may include later edits\\\".into());\\n@@ -625,6 +667,9 @@ pub(crate) fn recover_stale(store: \u0026Store, tracked: \u0026TrackedSet) -\u003e Result\u003c()\u003e {\\n         match store.attempt_locked(tracked, draft, Some(record.id)) {\\n             Ok(_) =\u003e {\\n                 let _ = std::fs::remove_file(\u0026path);\\n+                if let Some(operation) = \u0026record.checkpoint.operation {\\n+                    super::recovery::discard(state_dir, \u0026operation.journal)?;\\n+                }\\n             }\\n             Err(err) =\u003e warn!(\\n                 \\\"history: could not close operation {}; keeping {} for the next run: {err:#}\\\",\\n@@ -637,6 +682,22 @@ pub(crate) fn recover_stale(store: \u0026Store, tracked: \u0026TrackedSet) -\u003e Result\u003c()\u003e {\\n     Ok(())\\n }\\n \\n+fn recover_pending(state_dir: \u0026Path, pending: \u0026mut Pending) -\u003e Result\u003c()\u003e {\\n+    if let Some(operation) = \u0026pending.checkpoint.operation {\\n+        match pending.recovery {\\n+            store::RecoveryState::Pending =\u003e {\\n+                super::recovery::recover(state_dir, \u0026operation.journal)?\\n+            }\\n+            store::RecoveryState::UnfinishedWrites =\u003e {\\n+                super::recovery::recover_unfinished(state_dir, \u0026operation.journal)?\\n+            }\\n+            store::RecoveryState::Finished =\u003e return Ok(()),\\n+        }\\n+    }\\n+    pending.recovery = store::RecoveryState::Finished;\\n+    store::write_pending_in(state_dir, pending)\\n+}\\n+\\n fn before_trigger(kind: OperationKind) -\u003e Trigger {\\n     match kind {\\n         OperationKind::Capture =\u003e Trigger::CaptureBefore,\\ndiff --git a/src/system/history/store.rs b/src/system/history/store.rs\\nindex 58eb8921f..edf7c68a3 100644\\n--- a/src/system/history/store.rs\\n+++ b/src/system/history/store.rs\\n@@ -690,12 +690,24 @@ pub(crate) fn pending_path_in(state_dir: \u0026Path, uuid: \u0026str) -\u003e PathBuf {\\n pub(crate) struct Pending {\\n     pub id: u64,\\n     pub checkpoint: Checkpoint,\\n+    pub recovery: RecoveryState,\\n     /// sha256 -\u003e blob oid for journal content already written to the\\n     /// repository (unreferenced until the wrapper commit exists).\\n     #[serde(default)]\\n     pub blobs: BTreeMap\u003cString, String\u003e,\\n }\\n \\n+#[derive(Clone, Copy, Debug, Serialize, Deserialize, PartialEq, Eq)]\\n+#[serde(rename_all = \\\"snake_case\\\")]\\n+pub(crate) enum RecoveryState {\\n+    /// An interrupted batch or an explicitly incomplete all-or-nothing apply.\\n+    Pending,\\n+    /// A normally returned command; retain its completed phases.\\n+    UnfinishedWrites,\\n+    /// All writes completed or were safely recovered; finalize history only.\\n+    Finished,\\n+}\\n+\\n pub(crate) fn write_pending_in(state_dir: \u0026Path, pending: \u0026Pending) -\u003e Result\u003c()\u003e {\\n     write_json(\\n         \u0026pending_path_in(state_dir, \u0026pending.checkpoint.uuid),\\n@@ -703,22 +715,17 @@ pub(crate) fn write_pending_in(state_dir: \u0026Path, pending: \u0026Pending) -\u003e Result\u003c()\\n     )\\n }\\n \\n-/// Every pending record with the file holding it, for recovery under the\\n-/// operation lock: an unreadable record is set aside (never deleted).\\n+/// Every pending record with the file holding it. Unreadable records stop\\n+/// recovery; never hide them or discard possibly referenced preimages.\\n pub(crate) fn list_pending_in(state_dir: \u0026Path) -\u003e Result\u003cVec\u003c(PathBuf, Pending)\u003e\u003e {\\n-    list_pending_with(state_dir, true)\\n-}\\n-\\n-/// The same for a look without the lock (`history --pending`, `status`):\\n-/// a record an operation removes meanwhile is skipped, an unreadable one\\n-/// is left for recovery to judge.\\n-pub(crate) fn peek_pending_in(state_dir: \u0026Path) -\u003e Result\u003cVec\u003c(PathBuf, Pending)\u003e\u003e {\\n-    list_pending_with(state_dir, false)\\n-}\\n-\\n-fn list_pending_with(state_dir: \u0026Path, set_aside: bool) -\u003e Result\u003cVec\u003c(PathBuf, Pending)\u003e\u003e {\\n     let mut pending = vec![];\\n-    for path in file::ls(\u0026pending_dir_in(state_dir)).unwrap_or_default() {\\n+    let directory = match std::fs::read_dir(pending_dir_in(state_dir)) {\\n+        Ok(directory) =\u003e directory,\\n+        Err(error) if error.kind() == std::io::ErrorKind::NotFound =\u003e return Ok(pending),\\n+        Err(error) =\u003e return Err(error.into()),\\n+    };\\n+    for entry in directory {\\n+        let path = entry?.path();\\n         if path.extension().is_some_and(|ext| ext == \\\"json\\\") {\\n             let text = match std::fs::read_to_string(\u0026path) {\\n                 Ok(text) =\u003e text,\\n@@ -727,25 +734,22 @@ fn list_pending_with(state_dir: \u0026Path, set_aside: bool) -\u003e Result\u003cVec\u003c(PathBuf,\\n                     return Err(err).wrap_err_with(|| format!(\\\"reading {}\\\", display_path(\u0026path)));\\n                 }\\n             };\\n-            match serde_json::from_str::\u003cPending\u003e(\u0026text) {\\n-                Ok(record) =\u003e pending.push((path, record)),\\n-                Err(err) if set_aside =\u003e {\\n-                    // recovery data for an unfinished operation: set aside,\\n-                    // never deleted\\n-                    warn!(\\n-                        \\\"history: setting aside unreadable {}: {err}\\\",\\n-                        display_path(\u0026path)\\n-                    );\\n-                    let _ = std::fs::rename(\u0026path, path.with_extension(\\\"json.broken\\\"));\\n-                }\\n-                Err(err) =\u003e debug!(\\\"history: unreadable {}: {err}\\\", display_path(\u0026path)),\\n-            }\\n+            let record = serde_json::from_str::\u003cPending\u003e(\u0026text).wrap_err_with(|| format!(\\n+                \\\"cannot read recovery record {}; repair it before retrying; recovery data was retained\\\", display_path(\u0026path)\\n+            ))?;\\n+            pending.push((path, record));\\n         }\\n     }\\n     pending.sort_by_key(|(_, record)| record.id);\\n     Ok(pending)\\n }\\n \\n+/// Read-only status lookup. A record removed concurrently is skipped, but\\n+/// corruption must remain visible rather than reporting healthy empty state.\\n+pub(crate) fn peek_pending_in(state_dir: \u0026Path) -\u003e Result\u003cVec\u003c(PathBuf, Pending)\u003e\u003e {\\n+    list_pending_in(state_dir)\\n+}\\n+\\n pub(crate) fn remove_pending_in(state_dir: \u0026Path, uuid: \u0026str) {\\n     let _ = std::fs::remove_file(pending_path_in(state_dir, uuid));\\n }\\ndiff --git a/src/system/history/sync/apply.rs b/src/system/history/sync/apply.rs\\nindex 34f9cc201..6cc89c290 100644\\n--- a/src/system/history/sync/apply.rs\\n+++ b/src/system/history/sync/apply.rs\\n@@ -411,12 +411,14 @@ pub(crate) async fn apply(\\n             }\\n         ));\\n         run::write_status(state_dir, \u0026status)?;\\n-        scope.finish(\\n-            status.application_failure.clone(),\\n-            Some(Summary {\\n-                message: Some(\\\"apply failed; recovery attempted\\\".into()),\\n-            }),\\n-        );\\n+        let summary = Some(Summary {\\n+            message: Some(\\\"apply failed; recovery attempted\\\".into()),\\n+        });\\n+        if recovery_errors.is_empty() {\\n+            scope.finish(status.application_failure.clone(), summary);\\n+        } else {\\n+            scope.finish_incomplete(status.application_failure.clone(), summary);\\n+        }\\n         return result.map(|()| ApplyOutcome::default());\\n     }\\n     let (error, summary) = match \u0026result {\\n\"}","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","id":"rs_02be90ffdd5dff4a016a9e4f2fe86c87d0b7fb7568a57c4b94","internal_chat_message_metadata_passthrough":{"turn_id":"01a079e2-ddee-7920-adc1-13c441666749"},"summary":[],"type":"reasoning"},{"call_id":"call_UoXFIgeVJAE7DJqTMW6M7B0Z","id":"ctc_02be90ffdd5dff4a016a9e4f3dca8487d0bffe2c0945e2a495","input":"text(await tools.exec_command({cmd:\"rg -n 'pub.*fn capture_now|fn capture_now|fn lock\\\\(' src/system/history/sync/run.rs\\nsed -n '520,586p' src/system/history/sync/run.rs\\nsed -n '170,222p' src/system/history/sync/run.rs\",workdir:\"/Users/jdx/.codex/worktrees/dotfiles-one-history/mise\",max_output_tokens:2000}));\n","internal_chat_message_metadata_passthrough":{"create_time":1788759854.297386,"turn_id":"01a079e2-ddee-7920-adc1-13c441666749"},"name":"exec","status":"completed","type":"custom_tool_call"},{"call_id":"call_UoXFIgeVJAE7DJqTMW6M7B0Z","id":"ctco_01a07a65-9575-7110-a6f9-3290381d0d20","internal_chat_message_metadata_passthrough":{"create_time":1788759872.885575,"turn_id":"01a079e2-ddee-7920-adc1-13c441666749"},"output":[{"text":"Script completed\nWall time 0.2 seconds\nOutput:\n","type":"input_text"},{"text":"{\"chunk_id\":\"520710\",\"wall_time_seconds\":0.000002125,\"exit_code\":0,\"original_token_count\":1112,\"output\":\"440:pub(crate) fn lock(store: \u0026Store) -\u003e Result\u003cfslock::LockFile\u003e {\\n534:pub(crate) fn capture_now(store: \u0026Store, tracked: \u0026TrackedSet) {\\n            lines.join(\\\"\\\\n\\\")\\n        };\\n        send(\\n            \\\"mise: dotfile sync paused\\\",\\n            \u0026format!(\\n                \\\"Conflicting changes in {body}.\\\\nLocal saves still work. For resolution steps, run:\\\\nmise bootstrap dotfiles status\\\"\\n            ),\\n        );\\n    }\\n    status.conflict_pause_observed = !current.is_empty();\\n}\\n\\n/// Saves the tracked set now (deduplicated against the newest checkpoint),\\n/// so the versions this sync publishes are what is on disk.\\npub(crate) fn capture_now(store: \u0026Store, tracked: \u0026TrackedSet) {\\n    use crate::system::history::checkpoint::Draft;\\n    use crate::system::history::store::Trigger;\\n    match store.attempt(tracked, Draft::new(Trigger::Edit)) {\\n        Ok(_) =\u003e {}\\n        Err(err) =\u003e warn!(\\\"history sync: could not save the current state first: {err:#}\\\"),\\n    }\\n}\\n\\n/// Records what is left to apply or decide, keeping the newest upstream\\n/// version for a path whose application was already pending.\\nfn record_pending(\\n    status: \u0026mut SyncStatus,\\n    plans: \u0026[PathPlan],\\n    roots: \u0026Roots,\\n    shared: \u0026BTreeMap\u003cString, Object\u003e,\\n) {\\n    status.conflicts = plans\\n        .iter()\\n        .filter_map(|plan| plan.conflict.clone())\\n        .collect();\\n    status.pending_applications = plans\\n        .iter()\\n        .filter(|plan| plan.conflict.is_none())\\n        .filter_map(|plan| {\\n            let object = plan.apply.clone()?;\\n            roots.locate(\u0026plan.branch_path).path()?;\\n            Some(PendingApplication {\\n                branch_path: plan.branch_path.clone(),\\n                object,\\n                configuration: is_configuration(\u0026plan.branch_path),\\n                next: plan.next.clone(),\\n                local: shared.get(\u0026plan.branch_path).cloned(),\\n            })\\n        })\\n        .collect();\\n    // said until `mise bootstrap` ran, even once the configuration is written\\n    status.declarations_changed = status.declarations_changed\\n        || status\\n            .pending_applications\\n            .iter()\\n            .any(|pending| pending.configuration);\\n}\\n\\n/// Rebuild the incoming plan against current saved files and the latest\\n/// fetched branch. Pull never trusts an old pending plan after a save.\\npub(crate) fn refresh(store: \u0026Store, tracked: \u0026TrackedSet, status: \u0026mut SyncStatus) -\u003e Result\u003c()\u003e {\\n    refresh_with_interaction(store, tracked, status, false)\\n}\\n\\npub(crate) fn refresh_with_interaction(\\n    store: \u0026Store,\\n    tracked: \u0026TrackedSet,\\n    pub pending: usize,\\n    pub conflicts: usize,\\n    pub fetched_upstream: Option\u003cString\u003e,\\n}\\n\\npub(crate) struct SyncRequest {\\n    pub fetch_only: bool,\\n    /// Save the tracked set first, so what is published is what is on\\n    /// disk. The watcher passes `false`: it saves on its own schedule, and a\\n    /// throttled file's held version or a manual-save entry's unsaved edits\\n    /// must not reach the repository through a sync.\\n    pub capture: bool,\\n    /// The repository to use instead of `[history.origin]` (onboarding,\\n    /// before the configuration that declares it is in place).\\n    pub origin: Option\u003cOriginTomlConfig\u003e,\\n    /// No network: reconcile against the branch as last fetched and record\\n    /// what is pending (after an incoming configuration declared more).\\n    pub offline: bool,\\n    /// A preview: nothing is announced (the caller puts the recorded state\\n    /// back afterwards).\\n    pub dry_run: bool,\\n}\\n\\nimpl SyncRequest {\\n    pub(crate) fn new(fetch_only: bool) -\u003e Self {\\n        Self {\\n            fetch_only,\\n            capture: true,\\n            origin: None,\\n            offline: false,\\n            dry_run: false,\\n        }\\n    }\\n}\\n\\n/// The connected origin, or why there is none.\\npub(crate) fn origin() -\u003e Result\u003cOriginTomlConfig\u003e {\\n    if let Some((_, origin)) = crate::system::history::config::origin()? {\\n        return Ok(origin);\\n    }\\n    // recorded when it was connected: a fresh machine's declaration may\\n    // still be on its way in the configuration being pulled\\n    let status = read_status(\u0026crate::dirs::STATE)?;\\n    if let (Some(url), Some(branch), false) =\\n        (status.origin_url, status.origin_branch, status.disconnected)\\n    {\\n        return Ok(OriginTomlConfig::plain(url, branch));\\n    }\\n    bail!(\\n        \\\"no setup repository is connected; `mise bootstrap dotfiles origin set \u003curl\u003e` connects one\\\"\\n    )\\n}\\n\\n\"}","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","id":"rs_02be90ffdd5dff4a016a9e4f43be1c87d0ac86c93f535b2df1","internal_chat_message_metadata_passthrough":{"turn_id":"01a079e2-ddee-7920-adc1-13c441666749"},"summary":[{"text":"**Refining operation lock scope**","type":"summary_text"}],"type":"reasoning"},{"call_id":"call_QiRKw3aGOk591LZkdYzH4wik","id":"ctc_02be90ffdd5dff4a016a9e4f5ea1c087d0a18223a70b5a9f09","input":"text(await tools.write_stdin({session_id:66230,chars:\"\",yield_time_ms:1000,max_output_tokens:1200}));\ntext(await tools.exec_command({cmd:\"git diff HEAD --check\",workdir:\"/Users/jdx/.codex/worktrees/dotfiles-one-history/mise\",max_output_tokens:500}));\n","internal_chat_message_metadata_passthrough":{"create_time":1788759873.922483,"turn_id":"01a079e2-ddee-7920-adc1-13c441666749"},"name":"exec","status":"completed","type":"custom_tool_call"},{"call_id":"call_QiRKw3aGOk591LZkdYzH4wik","id":"ctco_01a07a66-1108-7393-9707-cfa39025fd7e","internal_chat_message_metadata_passthrough":{"create_time":1788759904.520277,"turn_id":"01a079e2-ddee-7920-adc1-13c441666749"},"output":[{"text":"Script completed\nWall time 0.2 seconds\nOutput:\n","type":"input_text"},{"text":"{\"chunk_id\":\"be817f\",\"wall_time_seconds\":0.000001208,\"exit_code\":0,\"original_token_count\":675,\"output\":\"warning: function `default_identity_file` is never used\\n   --\u003e src/agecrypt.rs:221:15\\n    |\\n221 | pub(crate) fn default_identity_file() -\u003e PathBuf {\\n    |               ^^^^^^^^^^^^^^^^^^^^^\\n    |\\n    = note: `#[warn(dead_code)]` (part of `#[warn(unused)]`) on by default\\n\\nwarning: method `changed_names` is never used\\n    --\u003e src/system/history/shadow.rs:1143:19\\n     |\\n 127 | impl HistoryRepo {\\n     | ---------------- method in this implementation\\n...\\n1143 |     pub(crate) fn changed_names(\u0026self, commit: \u0026str) -\u003e Result\u003cVec\u003cString\u003e\u003e {\\n     |                   ^^^^^^^^^^^^^\\n\\nwarning: function `is_repository_metadata` is never used\\n  --\u003e src/system/history/sync/layout.rs:97:15\\n   |\\n97 | pub(crate) fn is_repository_metadata(path: \u0026str) -\u003e bool {\\n   |               ^^^^^^^^^^^^^^^^^^^^^^\\n\\nwarning: constant `MAX_LINK_DEPTH` is never used\\n  --\u003e src/system/history/tracked.rs:30:7\\n   |\\n30 | const MAX_LINK_DEPTH: usize = 8;\\n   |       ^^^^^^^^^^^^^^\\n\\nwarning: function `is_credential_name` is never used\\n   --\u003e src/system/history/tracked.rs:652:15\\n    |\\n652 | pub(crate) fn is_credential_name(name: \u0026str) -\u003e bool {\\n    |               ^^^^^^^^^^^^^^^^^^\\n\\nwarning: function `normalize_missing` is never used\\n   --\u003e src/system/history/tracked.rs:802:15\\n    |\\n802 | pub(crate) fn normalize_missing(path: \u0026Path) -\u003e PathBuf {\\n    |               ^^^^^^^^^^^^^^^^^\\n\\nwarning: function `link_target` is never used\\n   --\u003e src/system/history/tracked.rs:823:15\\n    |\\n823 | pub(crate) fn link_target(link: \u0026Path) -\u003e Option\u003cPathBuf\u003e {\\n    |               ^^^^^^^^^^^\\n\\nwarning: `mise` (bin \\\"mise\\\" test) generated 7 warnings\\n    Finished `test` profile [unoptimized + debuginfo] target(s) in 23.03s\\n     Running unittests src/main.rs (target/debug/deps/mise-8c08b81259f8c9d2)\\n\\nrunning 7 tests\\ntest system::history::recovery::tests::a_failed_later_write_blocks_earlier_recovery_of_the_same_path ... ok\\ntest system::history::recovery::tests::concurrent_edit_and_missing_completion_are_preserved ... ok\\ntest system::history::recovery::tests::corrupt_preimage