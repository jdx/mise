#!/usr/bin/env bash

# A GitHub Packages gem source lists its versions through GitHub's REST API,
# since the registry itself has no versions endpoint. The owner can be an
# organization or a user, and the API pages its answer. Listing never shells
# out to `gem`, so this needs no Ruby.

# A fake api.github.com. `acme` is a user, so its organization endpoint is a
# 404, and its versions come in two pages.
cat >api.py <<'PYTHON'
import json
import os
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

base = "/users/acme/packages/rubygems/internal-cli/versions"
pages = {
    f"{base}?per_page=100": [
        {"name": "2.3.1", "created_at": "2026-03-01T00:00:00Z"},
        {"name": "2.2.0", "created_at": "2026-02-01T00:00:00Z"},
    ],
    f"{base}?per_page=100&page=2": [
        {"name": "1.0.0", "created_at": "2026-01-01T00:00:00Z"},
    ],
}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_GET(self):
        with open("requests.log", "a") as log:
            log.write(f"{self.path}\n")
        if self.path not in pages:
            self.send_error(404)
            return
        body = json.dumps(pages[self.path]).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        if "page=2" not in self.path:
            port = self.server.server_port
            self.send_header(
                "Link", f'<http://127.0.0.1:{port}{base}?per_page=100&page=2>; rel="next"'
            )
        self.end_headers()
        self.wfile.write(body)


def exit_with_test():
    parent = os.getppid()
    while os.getppid() == parent:
        time.sleep(0.5)
    os._exit(0)


threading.Thread(target=exit_with_test, daemon=True).start()
server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
Path("api.port").write_text(str(server.server_port))
server.serve_forever()
PYTHON

python3 api.py &
api_pid=$!
wait_for_file api.port "GitHub API port" 30 "$api_pid"
port="$(cat api.port)"

cat >mise.toml <<EOF
[settings]
url_replacements = { "https://api.github.com" = "http://127.0.0.1:${port}" }

[tools]
"gem:internal-cli" = { version = "latest", source = "https://rubygems.pkg.github.com/acme" }
EOF

export GITHUB_TOKEN="ghp_e2eSECRET"

# Both pages, oldest first.
assert "mise ls-remote gem:internal-cli" "1.0.0
2.2.0
2.3.1"
assert "mise latest gem:internal-cli@2.2" "2.2.0"

# The organization was asked first, then the user. (mise does not send the
# token to a plain-http replacement, so the fixture sees none.)
assert "cat requests.log" "/orgs/acme/packages/rubygems/internal-cli/versions?per_page=100
/users/acme/packages/rubygems/internal-cli/versions?per_page=100
/users/acme/packages/rubygems/internal-cli/versions?per_page=100&page=2"

unset GITHUB_TOKEN
rm -rf "$MISE_CACHE_DIR"

# A token in the source is used for listing as it is for the install, with no
# GitHub token configured.
sed 's|https://rubygems|https://ghp_e2eSOURCE@rubygems|' mise.toml >mise.toml.new
mv mise.toml.new mise.toml
assert_contains "MISE_GITHUB_GH_CLI_TOKENS=false mise ls-remote gem:internal-cli" "2.3.1"
assert_not_contains "MISE_DEBUG=1 MISE_GITHUB_GH_CLI_TOKENS=false mise ls-remote gem:internal-cli 2>&1" "ghp_e2eSOURCE"
sed 's|ghp_e2eSOURCE@||' mise.toml >mise.toml.new
mv mise.toml.new mise.toml
rm -rf "$MISE_CACHE_DIR"

# Without a token the error names the scope and the fix rather than a bare 401.
assert_fail "MISE_GITHUB_GH_CLI_TOKENS=false mise ls-remote gem:internal-cli" "read:packages"
