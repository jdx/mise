#!/usr/bin/env bash

cat >~/bin/cargo <<'EOS'
#!/usr/bin/env bash
while (($#)); do
  if [[ $1 == "--root" ]]; then
    mkdir -p "$2/bin"
    exit 0
  fi
  shift
done
EOS
chmod u+x ~/bin/cargo
export PATH="$HOME/bin:$PATH"
export MISE_CARGO_BINSTALL=0

cat >mise.toml <<'EOS'
[tools]
"cargo:ignored-option-test" = { version = "1.0.0", asset_pattern = "*.tar.gz" }
EOS
assert_fail "mise install" "is not used by the cargo backend"

# A typo gets the option it is closest to.
cat >mise.toml <<'EOS'
[tools]
"cargo:ignored-option-test" = { version = "1.0.0", featurs = "x" }
EOS
assert_fail "mise install" "hint: Did you mean"

# A core tool installed with options it does not read before mise checked them, so it warns
# and installs anyway.
cat >mise.toml <<'EOS'
[tools]
node = { version = "22.11.0", lazy_bin = "node", asset_pattern = "*.tar.gz" }
EOS
output="$(mise install --dry-run 2>&1)"
assert_contains_text "$output" "node@22.11.0"
assert_contains_text "$output" "is not used by the core backend, so it has no effect (did you mean"
assert_contains_text "$output" "lazy_bins"
assert_contains_text "$output" "asset_pattern"
# Each option is reported once.
warnings="$(grep -c "is not used by the core backend" <<<"$output")"
assert "echo $warnings" "2"

# Only an install reports it: listing tools and the shell hook stay quiet.
assert_not_contains "mise ls 2>&1" "is not used by"
assert_not_contains "mise hook-env -s bash 2>&1" "is not used by"
