#!/usr/bin/env bash

# A project with a lockfile installs an npm tool from its embedded-aube graph
# into `<version>~aube~<digest>`. Another config that asks for the same tool as
# `latest` without a lockfile resolves to what is installed. It must see the
# npm version and the installation that directory name stands for, not treat
# the private name as a version (jdx/mise#14276).
export MISE_EXPERIMENTAL=1

mkdir locked unlocked
cat >locked/mise.toml <<'MISE_TOML'
[tools]
node = "20.11.1"
"npm:inflight" = "latest"
MISE_TOML
cat >unlocked/mise.toml <<'MISE_TOML'
[tools]
node = "20.11.1"
"npm:inflight" = "latest"
MISE_TOML

for layout in identity legacy; do
  echo "=== install_layout = $layout ==="
  export MISE_INSTALL_LAYOUT=$layout
  rm -rf "$MISE_DATA_DIR/installs" locked/mise.lock locked/.mise
  MISE_LOCKFILE=1 mise -C locked install
  graph_dir="$(find "$MISE_DATA_DIR/installs/npm-inflight" -mindepth 1 -maxdepth 1 -name '*~aube~*' -printf '%f\n')"
  [[ -n $graph_dir ]] || fail "no ~aube~ install for npm:inflight"
  version="${graph_dir%%"~aube~"*}"
  graph_path="$(realpath "$MISE_DATA_DIR/installs/npm-inflight/$graph_dir")"

  assert "mise -C unlocked current npm:inflight" "$version"
  assert "mise -C unlocked ls --missing --no-header npm:inflight" ""
  assert_not_contains "mise -C unlocked ls npm:inflight 2>&1" "~aube~"
  where_path="$(realpath "$(mise -C unlocked where npm:inflight)")"
  [[ $where_path == "$graph_path" ]] || fail "unlocked latest uses $where_path, not $graph_path"
  assert_not_contains "mise -C unlocked env 2>&1" "missing"
done
