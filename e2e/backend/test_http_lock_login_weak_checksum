#!/usr/bin/env bash

# An http tool whose URL carries a login and whose checksum is md5 is checked
# against that md5 through the login URL, then locked with the sha256 of what
# it served. mise.lock names the URL without the login, which the mirror
# refuses, so nothing later has to download it from there.

export MISE_LOCKFILE=1
export MISE_LOCKFILE_MODE=generate

PAYLOAD_MD5="321c3cf486ed509164edec1e1981fec8"
PAYLOAD_SHA256="239f59ed55e737c77147cf55ad0c1b030b6d7ee748a7426952f9b852d5a935e5"

start_http_server --handler - <<'PY'
import base64
import http.server

LOGIN = "Basic " + base64.b64encode(b"ci:s3cret").decode()


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.headers.get("Authorization") != LOGIN:
            self.send_response(401)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        body = b"payload"
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass
PY

cat <<EOF >mise.toml
[tools."http:loginmd5-test"]
version = "1.0.0"
url = "http://ci:s3cret@127.0.0.1:$HTTP_PORT/tool.tar.gz"
checksum = "md5:$PAYLOAD_MD5"
EOF

touch mise.lock
mise lock --platform linux-x64
assert_not_contains "cat mise.lock" "s3cret"
assert_contains "cat mise.lock" "url = \"http://127.0.0.1:$HTTP_PORT/tool.tar.gz\""
assert_contains "cat mise.lock" "checksum = \"sha256:$PAYLOAD_SHA256\""
assert_not_contains "cat mise.lock" "md5:"

# An md5 the download does not match is an error, not a sha256 of the download.
cat <<EOF >mise.toml
[tools."http:loginmd5-test"]
version = "1.0.0"
url = "http://ci:s3cret@127.0.0.1:$HTTP_PORT/tool.tar.gz"
checksum = "md5:00000000000000000000000000000000"
EOF
rm -f mise.lock
touch mise.lock
assert_fail "mise lock --platform linux-x64"
assert_not_contains "cat mise.lock" "$PAYLOAD_SHA256"
