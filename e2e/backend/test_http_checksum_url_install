#!/usr/bin/env bash

# `checksum_url` is enforced at install, not only by `mise lock`: with no
# `checksum` and no lockfile entry, a download that does not match the
# published checksum must fail the install.

SRV="$PWD/srv"
mkdir -p "$SRV"

REAL_SHA="34a3c3a03073287eea9375cd9838e60a3b875715005eb2cc854a4461cf2c428d"
BAD_SHA="5acbfff1b086e0f920c5857527976199018afe0cbf16e28d42c7eb9c683508e5"

printf '#!/bin/sh\necho mytool ok\n' >"$SRV/mytool"
printf '%s  mytool\n' "$BAD_SHA" >"$SRV/bad_SHASUMS"
printf '%s  mytool\n' "$REAL_SHA" >"$SRV/good_SHASUMS"

start_http_server --dir "$SRV"

write_config() {
  cat >mise.toml <<EOT
[tools."http:mytool-checksum-url"]
version = "1.0.0"
bin = "mytool"
url = "http://127.0.0.1:${HTTP_PORT}/mytool"
checksum_url = "http://127.0.0.1:${HTTP_PORT}/$1"
EOT
}

# Published checksum differs from the download: install fails.
write_config bad_SHASUMS
assert_fail_contains "mise install" "Checksum"

# Published checksum cannot be resolved: install fails rather than skipping.
write_config missing_SHASUMS
assert_fail_contains "mise install" "could not resolve the checksum"

# Matching published checksum installs.
write_config good_SHASUMS
mise install
assert_contains "mise x -- mytool" "mytool ok"
