#!/usr/bin/env bash

# npm: tools can be installed from a git repository instead of the registry.
repo="$PWD/gitpkg"
mkdir -p "$repo/bin"
cat >"$repo/package.json" <<'JSON'
{"name":"gitpkg","version":"1.0.0","bin":{"gitpkg":"bin/gitpkg.sh"}}
JSON
printf '#!/bin/sh\necho gitpkg-v1\n' >"$repo/bin/gitpkg.sh"
chmod +x "$repo/bin/gitpkg.sh"
git -C "$repo" init -q -b main
git -C "$repo" -c user.name=t -c user.email=t@t add -A
git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m v1
git -C "$repo" tag v1

printf '#!/bin/sh\necho gitpkg-v2\n' >"$repo/bin/gitpkg.sh"
git -C "$repo" -c user.name=t -c user.email=t@t commit -q -am v2

assert_contains "mise x 'npm:git+file://$repo@latest' -- gitpkg" "gitpkg-v2"
assert_contains "mise x 'npm:git+file://$repo@v1' -- gitpkg" "gitpkg-v1"

# prune keeps the commit that `latest` resolves to and lists older ones
spec="npm:git+file://$repo"
head1="$(git -C "$repo" rev-parse HEAD)"
mise use "$spec@latest"
printf '#!/bin/sh\necho gitpkg-v3\n' >"$repo/bin/gitpkg.sh"
git -C "$repo" -c user.name=t -c user.email=t@t commit -q -am v3
head2="$(git -C "$repo" rev-parse HEAD)"
mise install "$spec@latest" --force
assert_contains "mise prune --tools --dry-run 2>&1" "gitpkg@$head1 is prunable"
assert_not_contains "mise prune --tools --dry-run 2>&1" "gitpkg@$head2 is prunable"

# an explicit pin to an older commit installed later must not displace latest
mise install "$spec@$head1"
assert_contains "mise prune --tools --dry-run 2>&1" "gitpkg@v1 is prunable"
assert_not_contains "mise prune --tools --dry-run 2>&1" "gitpkg@$head2 is prunable"

# upgrade sees a new commit however its SHA sorts against the installed one,
# and --prune removes the commit it replaced
rm -rf "$MISE_DATA_DIR"/installs/npm-git-*
printf '[tools]\n"%s" = "latest"\n' "$spec" >mise.toml
mise install
old="$(git -C "$repo" rev-parse HEAD)"
for i in 1 2 3 4 5 6; do
  printf '#!/bin/sh\necho gitpkg-up%s\n' "$i" >"$repo/bin/gitpkg.sh"
  git -C "$repo" -c user.name=t -c user.email=t@t commit -q -am "up$i"
  new="$(git -C "$repo" rev-parse HEAD)"
  assert_contains "mise upgrade --dry-run 2>&1" "Would install"
  mise upgrade --prune
  assert_contains "mise x -- gitpkg" "gitpkg-up$i"
  assert_not_contains 'ls $MISE_DATA_DIR/installs/npm-git-*' "$old"
  old="$new"
done
