#!/usr/bin/env bash

# Keep mise's data inside a pnpm workspace, as GitLab CI commonly does so the
# directory can be cached. The synthetic npm tool project must not be adopted
# by this enclosing workspace.
MISE_DATA_DIR="$PWD/.mise-data"
mkdir -p pkg
cat >package.json <<'EOF'
{"name":"root","private":true}
EOF
cat >pnpm-workspace.yaml <<'EOF'
packages:
  - pkg
EOF
cat >pkg/package.json <<'EOF'
{"name":"pkg","version":"0.0.0","dependencies":{"is-number":"7.0.0"}}
EOF

install_dir="$MISE_DATA_DIR/installs/npm-cowsay/1.6.0"

# npm: tools install via the embedded aube package manager in-process — no
# aube binary on PATH is required, only node to run the tool.
assert_contains "mise x node@20.11.1 npm:cowsay@1.6.0 -- cowsay hello" "hello"

# Embedded aube installs into a per-tool project dir: node_modules holds the
# package + bin shims, and an aube lockfile is written at the project root.
assert_succeed "test -d '$install_dir/node_modules'"
assert_succeed "test -x '$install_dir/node_modules/.bin/cowsay'"
assert_succeed "test -f '$install_dir/aube-lock.yaml'"
assert_succeed "test -f '$install_dir/aube-workspace.yaml'"
assert_contains "cat '$install_dir/aube-lock.yaml'" "cowsay@1.6.0"
assert_succeed "test -f '$install_dir/.config/aube/config.toml'"
assert_succeed "test ! -e '$install_dir/.npmrc'"
assert_succeed "test ! -e '$PWD/node_modules'"
assert_succeed "test ! -e '$PWD/aube-lock.yaml'"

# Regenerable aube state stays under mise's npm cache root, where
# `mise cache prune npm` owns its lifecycle.
assert_succeed "test -d '$MISE_CACHE_DIR/npm/aube/cache/packuments-full-v1'"
assert_succeed "test -d '$MISE_CACHE_DIR/npm/aube/store/v1/files'"

# The in-process installer gets the real process env, so a tool's install_env
# never reaches it. Say so rather than dropping it silently.
mkdir install-env
cat >install-env/mise.toml <<'EOF'
[tools]
"npm:is-number" = { version = "7.0.0", install_env = { AUBE_BLOCK_EXOTIC_SUBDEPS = "false" } }
EOF
install_env_output="$(mise -C install-env install 2>&1)" ||
  fail "install-env install failed:\n$install_env_output"
assert_contains_text "$install_env_output" "install_env (AUBE_BLOCK_EXOTIC_SUBDEPS) is ignored for npm:is-number"
assert_contains_text "$install_env_output" "allow_exotic_deps"

# Aube warnings flow through mise's event renderer without suggesting an aube
# subcommand that mise does not expose.
deprecation_output="$(mise install npm:inflight@1.0.6 2>&1)"
assert_contains_text "$deprecation_output" "deprecated inflight@1.0.6"
assert_not_contains_text "$deprecation_output" "mise deprecations"

# Automatic graph creation determines the physical path before installation
# bookkeeping begins, even when a version-only install already exists.
mkdir auto-lock
cat >auto-lock/mise.toml <<'EOF'
[tools]
node = "20.11.1"
"npm:inflight" = "1.0.6"
EOF
MISE_LOCKFILE=1 mise -C auto-lock install
assert_succeed "find '$MISE_DATA_DIR/installs/npm-inflight' -maxdepth 1 -name '1.0.6~aube~*' | grep -q ."
assert_succeed "test ! -e '$MISE_DATA_DIR/installs/npm-inflight/1.0.6/incomplete'"

# Generate-mode upgrades fill graphs after changing the lockfile revision.
mkdir upgrade-lock
cat >upgrade-lock/mise.toml <<'EOF'
[tools]
"npm:cowsay" = "1.6.0"
EOF
cat >upgrade-lock/mise.lock <<'EOF'
lockfile_version = 1

[[tools."npm:cowsay"]]
version = "1.6.0"
specifiers = ["1.6.0"]
EOF
MISE_LOCKFILE_MODE=generate mise -C upgrade-lock lock --upgrade
assert_contains "cat upgrade-lock/mise.lock" "lockfile_version = 2"
assert_contains "cat upgrade-lock/mise.lock" 'path = ".mise/locks/npm-cowsay/1.6.0"'
assert_contains "cat upgrade-lock/.mise/locks/npm-cowsay/1.6.0/aube-lock.yaml" 'packages:'

# Lock generation resolves aube's complete graph without creating an install.
cat >mise.toml <<'EOF'
[tools]
node = "20.11.1"
"npm:cowsay" = "1.6.0"
EOF
mise lock
assert_contains "cat mise.lock" "lockfile_version = 2"
assert_contains "cat mise.lock" 'path = ".mise/locks/npm-cowsay/1.6.0"'
assert_contains "cat .mise/locks/npm-cowsay/1.6.0/aube-lock.yaml" 'packages:'
cp .mise/locks/npm-cowsay/1.6.0/aube-lock.yaml first-aube-lock.yaml
mise lock
assert_succeed 'cmp first-aube-lock.yaml .mise/locks/npm-cowsay/1.6.0/aube-lock.yaml'
assert_fail "find '$MISE_DATA_DIR/installs/npm-cowsay' -maxdepth 1 -name '1.6.0~aube~*' | grep -q ."

# Changing package managers removes retained embedded-aube metadata.
mkdir package-manager-change
cp mise.toml mise.lock package-manager-change/
cp -R .mise package-manager-change/
MISE_NPM_PACKAGE_MANAGER=npm mise -C package-manager-change lock
assert_not_contains "cat package-manager-change/mise.lock" 'aube ='
assert_fail 'test -d package-manager-change/.mise/locks/npm-cowsay/1.6.0'

# Another npm installer must reject an embedded-aube graph instead of ignoring it.
assert_fail "MISE_NPM_PACKAGE_MANAGER=npm MISE_LOCKFILE=1 mise install --locked"
wrong_manager_output="$(MISE_NPM_PACKAGE_MANAGER=npm MISE_LOCKFILE=1 mise install --locked 2>&1 || true)"
assert_contains_text "$wrong_manager_output" "is locked with an embedded-aube dependency graph"

# Installation replays the graph into its graph-specific path.
MISE_LOCKFILE=1 mise install
assert_succeed "find '$MISE_DATA_DIR/installs/npm-cowsay' -maxdepth 1 -name '1.6.0~aube~*' | grep -q ."
assert_contains "MISE_LOCKFILE=1 mise exec -- cowsay locked" "locked"
# An existing graph-specific install must not bypass package-manager validation.
assert_fail "MISE_NPM_PACKAGE_MANAGER=npm MISE_LOCKFILE=1 mise install --locked"
inactive_listing="$(mise -C "$HOME" ls npm:cowsay --json)"
assert_contains_text "$inactive_listing" '"version": "1.6.0"'
assert_not_contains_text "$inactive_listing" '"version": "1.6.0~aube~'

# Revision 2 locked mode rejects an npm entry whose required graph is absent.
mkdir missing-graph
cat >missing-graph/mise.toml <<'EOF'
[tools]
"npm:cowsay" = "1.5.0"
EOF
cat >missing-graph/mise.lock <<'EOF'
lockfile_version = 2

[[tools."npm:cowsay"]]
version = "1.5.0"
backend = "npm:cowsay"
specifiers = ["1.5.0"]
EOF
assert_fail "cd missing-graph && MISE_LOCKFILE=1 mise install --locked"
missing_graph_output="$(cd missing-graph && MISE_LOCKFILE=1 mise install --locked 2>&1 || true)"
assert_contains_text "$missing_graph_output" "has no embedded-aube dependency graph"

# Git checks sidecars out with CRLF on Windows (core.autocrlf=true). The
# recorded digest covers the normalized graph text, so such a checkout still
# installs, and re-locking leaves the working copy byte-for-byte alone.
mkdir crlf
cp mise.toml mise.lock crlf/
cp -R .mise crlf/
python3 - <<'PY_CRLF'
from pathlib import Path
for name in ['aube-lock.yaml', 'package.json']:
    path = Path('crlf/.mise/locks/npm-cowsay/1.6.0') / name
    data = path.read_bytes()
    assert b'\r\n' not in data, path
    path.write_bytes(data.replace(b'\n', b'\r\n'))
PY_CRLF
cp crlf/.mise/locks/npm-cowsay/1.6.0/aube-lock.yaml crlf-checkout.yaml
MISE_DATA_DIR="$PWD/.crlf-data" MISE_LOCKFILE=1 mise -C crlf install --locked
assert_contains "MISE_DATA_DIR='$PWD/.crlf-data' MISE_LOCKFILE=1 mise -C crlf exec -- cowsay --version" "1.6.0"
mise -C crlf lock
assert_succeed 'cmp crlf-checkout.yaml crlf/.mise/locks/npm-cowsay/1.6.0/aube-lock.yaml'
assert_succeed 'cmp mise.lock crlf/mise.lock'

# A lockfile an older mise wrote from a CRLF checkout pins the raw bytes. It
# keeps installing, and an ordinary install records the normalized digest.
python3 - <<'PY_LEGACY_DIGEST'
import hashlib
from pathlib import Path
graph = Path('crlf/.mise/locks/npm-cowsay/1.6.0/aube-lock.yaml').read_bytes()
legacy = 'sha256:' + hashlib.sha256(graph).hexdigest()
normalized = 'sha256:' + hashlib.sha256(graph.replace(b'\r\n', b'\n')).hexdigest()
assert legacy != normalized
lock = Path('crlf/mise.lock')
assert normalized in lock.read_text()
lock.write_text(lock.read_text().replace(normalized, legacy))
Path('legacy-digest').write_text(legacy)
Path('normalized-digest').write_text(normalized)
PY_LEGACY_DIGEST
MISE_DATA_DIR="$PWD/.legacy-data" MISE_LOCKFILE=1 mise -C crlf install --locked
assert_contains "cat crlf/mise.lock" "$(cat legacy-digest)"
MISE_DATA_DIR="$PWD/.legacy-heal-data" MISE_LOCKFILE=1 mise -C crlf install
assert_contains "cat crlf/mise.lock" "$(cat normalized-digest)"
assert_succeed 'cmp crlf-checkout.yaml crlf/.mise/locks/npm-cowsay/1.6.0/aube-lock.yaml'

# A project lockfile must not require dependency graphs for npm tools owned by
# the global config, whose lockfile is only created explicitly with --global.
global_only_npm="$HOME/global-only-npm"
export MISE_DATA_DIR="$HOME/global-only-data"
mkdir "$global_only_npm"
cat >"$MISE_CONFIG_DIR/config.toml" <<'EOF'
[tools]
"npm:cowsay" = "1.6.0"
EOF
cat >"$global_only_npm/mise.toml" <<'EOF'
[settings]
lockfile = true
EOF
cat >"$global_only_npm/mise.lock" <<'EOF'
lockfile_version = 0
EOF
MISE_LOCKFILE=0 mise -C "$global_only_npm" install
global_dry_run="$(mise -C "$global_only_npm" install --dry-run 2>&1)"
assert_contains_text "$global_dry_run" "all tools are installed"
global_exec="$(mise -C "$global_only_npm" exec -- cowsay --version 2>&1)"
assert_contains_text "$global_exec" "1.6.0"
assert_not_contains_text "$global_exec" "missing: npm:cowsay@1.6.0"

# An explicitly generated global lockfile still gives the global request a
# graph-specific identity and replays that graph during installation.
mise -C "$global_only_npm" lock --global
assert_contains "cat '$MISE_CONFIG_DIR/mise.lock'" "lockfile_version = 2"
assert_contains "cat '$MISE_CONFIG_DIR/mise.lock'" 'path = "locks/npm-cowsay/1.6.0"'
assert_contains "cat '$MISE_CONFIG_DIR/locks/npm-cowsay/1.6.0/aube-lock.yaml'" "packages:"
mise -C "$global_only_npm" install
assert_succeed "find '$MISE_DATA_DIR/installs/npm-cowsay' -maxdepth 1 -name '1.6.0~aube~*' | grep -q ."
assert_contains "mise -C '$global_only_npm' exec -- cowsay --version" "1.6.0"
