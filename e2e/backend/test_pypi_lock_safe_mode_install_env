#!/usr/bin/env bash
set -euo pipefail

# Safe mode refuses the `install_env` tool option when a tool is installed.
# `mise lock` starts uv to build a PyPI tool's dependency graph without
# installing anything, and has to refuse it there as well.

python3 "$ROOT/e2e/fixtures/pypi/server.py" "$PWD/index" &
server_pid=$!
trap 'kill "$server_pid"' EXIT
for _ in {1..100}; do
  [[ -s index/port ]] && break
  sleep 0.1
done
port=$(cat index/port)
export MISE_PYPI_REGISTRY_URL="http://127.0.0.1:$port/pypi/{}/json"

# A stand-in uv that records whether the tool's install_env reached it.
mkdir bin
cat >bin/uv <<'EOF'
#!/bin/sh
if [ "$1" = "--version" ]; then
  echo "uv 0.12.10"
  exit 0
fi
if [ -n "$MISE_TEST_INSTALL_ENV" ]; then
  touch "$MISE_TEST_INSTALL_ENV"
fi
exit 1
EOF
chmod +x bin/uv
export PATH="$PWD/bin:$PATH"

cat >mise.toml <<'EOF'
[tools]
"pypi:mise-lock-cli" = { version = "1.0.0", install_env = { MISE_TEST_INSTALL_ENV = "{{ config_root }}/install-env-used" } }
EOF

# Outside safe mode the option reaches uv.
assert_contains "mise lock 2>&1" "dependency graph unavailable"
assert_succeed "test -e install-env-used"

rm -rf install-env-used mise.lock .mise
assert_contains "MISE_SAFE=1 mise lock 2>&1" "using tool-level install_env for pypi:mise-lock-cli is disabled in safe mode (MISE_SAFE=1)"
assert_fail "test -e install-env-used"
# The tool is still locked, by version only.
assert_contains "cat mise.lock" 'tools."pypi:mise-lock-cli"'
assert_not_contains "cat mise.lock" '.mise/locks/'
