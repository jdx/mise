#!/usr/bin/env bash

# `mise lock` can re-resolve a version to a different asset without removing
# the stale install; `mise install --locked` must catch that drift.

export MISE_LOCKFILE=1

detect_platform
PLATFORM="$MISE_PLATFORM"

SRV="$PWD/srv"
mkdir -p "$SRV"

printf '#!/bin/sh\necho mytool build-a\n' >"$SRV/mytool-a"
printf '#!/bin/sh\necho mytool build-b\n' >"$SRV/mytool-b"

SHA_A="$(shasum -a 256 "$SRV/mytool-a" | awk '{print $1}')"
SHA_B="$(shasum -a 256 "$SRV/mytool-b" | awk '{print $1}')"
printf '%s  mytool-a\n' "$SHA_A" >"$SRV/mytool-a_SHASUMS"
printf '%s  mytool-b\n' "$SHA_B" >"$SRV/mytool-b_SHASUMS"

# Serve the directory on an ephemeral port
PORT_FILE="$TMPDIR/mise_lock_stale_install_port"
python3 - "$SRV" "$PORT_FILE" <<'PY' &
import http.server, socketserver, sys, os
srv, port_file = sys.argv[1], sys.argv[2]
os.chdir(srv)
socketserver.TCPServer.allow_reuse_address = True
with socketserver.TCPServer(("127.0.0.1", 0), http.server.SimpleHTTPRequestHandler) as httpd:
    with open(port_file, "w") as f:
        f.write(str(httpd.server_address[1]))
    httpd.serve_forever()
PY
SERVER_PID=$!
cleanup() { kill "$SERVER_PID" 2>/dev/null || true; }
trap cleanup EXIT

wait_for_file "$PORT_FILE" "lock stale-install port file" 30 "$SERVER_PID"
PORT=$(cat "$PORT_FILE")

cat >mise.toml <<EOF
[tools."http:mytool-stale"]
version = "1.0.0"
bin = "mytool"
url = "http://127.0.0.1:${PORT}/mytool-a"
checksum_url = "http://127.0.0.1:${PORT}/mytool-a_SHASUMS"
EOF

mise lock --platform "$PLATFORM"
assert_contains "cat mise.lock" "sha256:${SHA_A}"
mise install --locked
assert_contains "mise x -- mytool" "mytool build-a"

# The lock is re-resolved for the SAME version against a different asset. The
# existing install directory is left untouched on disk.
cat >mise.toml <<EOF
[tools."http:mytool-stale"]
version = "1.0.0"
bin = "mytool"
url = "http://127.0.0.1:${PORT}/mytool-b"
checksum_url = "http://127.0.0.1:${PORT}/mytool-b_SHASUMS"
EOF
mise lock --platform "$PLATFORM"
assert_contains "cat mise.lock" "sha256:${SHA_B}"

# A plain locked install (no --force) must not keep serving the artifact the
# lockfile no longer describes.
mise install --locked
assert_contains "mise x -- mytool" "mytool build-b"

# A pre-fix install has no marker file at all; missing must count as
# drifted, not trusted, even with the lock otherwise unchanged.
INSTALL_PATH="$(mise where "http:mytool-stale@1.0.0")"
rm -f "$INSTALL_PATH/.mise.lock-checksum"
mise install --locked
assert_contains "mise x -- mytool" "mytool build-b"
assert_contains "cat '$INSTALL_PATH/.mise.lock-checksum'" "sha256:${SHA_B}"

# No checksum_url means only the URL to compare -- a different checksumless
# URL for the same version must still count as drift.
cat >mise.toml <<EOF
[tools."http:mytool-nocksum"]
version = "1.0.0"
bin = "mytool"
url = "http://127.0.0.1:${PORT}/mytool-a"
EOF
mise lock --platform "$PLATFORM"
assert_contains "cat mise.lock" "mytool-a"
mise install --locked
assert_contains "mise x -- mytool" "mytool build-a"

cat >mise.toml <<EOF
[tools."http:mytool-nocksum"]
version = "1.0.0"
bin = "mytool"
url = "http://127.0.0.1:${PORT}/mytool-b"
EOF
mise lock --platform "$PLATFORM"
assert_contains "cat mise.lock" "mytool-b"
mise install --locked
assert_contains "mise x -- mytool" "mytool build-b"

# shared_extraction's marker lives beside the install symlink, not inside it;
# uninstall must remove that sibling too or the tool dir never empties out.
cat >mise.toml <<EOF
[tools."http:mytool-shared"]
version = "1.0.0"
bin = "mytool"
url = "http://127.0.0.1:${PORT}/mytool-a"
checksum_url = "http://127.0.0.1:${PORT}/mytool-a_SHASUMS"
shared_extraction = true
EOF
mise lock --platform "$PLATFORM"
mise install --locked
assert_contains "mise x -- mytool" "mytool build-a"
TOOL_DIR="$(dirname "$(mise where "http:mytool-shared@1.0.0")")"
mise uninstall "http:mytool-shared@1.0.0"
assert_fail "test -e '$TOOL_DIR'"

cat >mise.toml <<EOF
[tools."http:mytool-drift"]
version = "1.0.0"
bin = "mytool"
url = "http://127.0.0.1:${PORT}/mytool-a"
checksum_url = "http://127.0.0.1:${PORT}/mytool-a_SHASUMS"
EOF
mise lock --platform "$PLATFORM"
assert_contains "cat mise.lock" "mytool-a"

# mise.toml now points elsewhere without a re-lock, before any install ever
# ran; must fail instead of silently drifting from the still-pinned lock.
cat >mise.toml <<EOF
[tools."http:mytool-drift"]
version = "1.0.0"
bin = "mytool"
url = "http://127.0.0.1:${PORT}/mytool-b"
checksum_url = "http://127.0.0.1:${PORT}/mytool-b_SHASUMS"
EOF
assert_fail 'mise install --locked' 'mise.lock pins'
