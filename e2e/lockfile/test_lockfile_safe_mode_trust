#!/usr/bin/env bash

# A project's mise.lock may name where to download a tool from. That is only
# honored once the user vouches for the project; safe mode vouches for nothing,
# so a trusted project (or CI, which counts as trusted) must still have its
# lockfile's artifact URLs ignored there.

export MISE_LOCKFILE=1
export MISE_TRUSTED_CONFIG_PATHS=""
unset CI GITHUB_ACTIONS GITHUB_ACTION 2>/dev/null || true

mkdir -p proj
cd proj || exit 1
echo '[tools]
"github:mvdan/sh" = "3.10.0"' >mise.toml
mise trust mise.toml
mise lock --platform linux-x64
assert_contains "cat mise.lock" "url = "
sed -i -e 's|^url = .*|url = "http://127.0.0.1:9/shfmt"|' -e "/^url_api = /d" mise.lock

# control: a trusted project outside safe mode downloads from the locked URL
assert_fail "mise install --force"

# safe mode ignores the locked URL and downloads from where the backend would
assert_succeed "MISE_SAFE=1 mise install --force"
assert_contains "MISE_SAFE=1 mise x github:mvdan/sh -- shfmt --version" "3.10.0"
