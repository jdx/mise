#!/usr/bin/env bash

export MISE_LOCKFILE=1

# Use local fixture plugin for tiny to avoid network access.
ln -sf "$ROOT/test/data/plugins/tiny" "$MISE_DATA_DIR/plugins/tiny"
rm -f mise.toml mise.lock

echo "=== Lockfile with initial tool ==="
cat <<EOF >mise.toml
[tools]
dummy = "1.0.0"
EOF

mise install dummy@1.0.0
mise lock --platform linux-x64
assert_contains "cat mise.lock" "[[tools.dummy]]"
assert_not_contains "cat mise.lock" "[[tools.tiny]]"

echo "=== Replace configured tool and relock ==="
cat <<EOF >mise.toml
[tools]
tiny = "2.1.0"
EOF

mise install tiny@2.1.0
mise lock --platform linux-x64
assert_contains "cat mise.lock" "[[tools.tiny]]"
assert_not_contains "cat mise.lock" "[[tools.dummy]]"

if [[ $(uname -s) == Darwin ]]; then
  INACTIVE_OS=linux
else
  INACTIVE_OS=macos
fi

echo "=== Preserve an inactive version of an active tool ==="
cat <<EOF >mise.toml
[tools]
tiny = [
  { version = "2.1.0" },
  { version = "latest", os = ["$INACTIVE_OS"] },
]
EOF
cat <<EOF >>mise.lock

[[tools.tiny]]
version = "1.0.0"
EOF

assert "mise lock --dry-run --json --platform linux-x64" "[]"
assert_not_contains \
  "mise lock --dry-run --platform linux-x64" \
  "tiny@1.0.0"

mise lock tiny --platform linux-x64
assert_contains "cat mise.lock" 'version = "1.0.0"'

mise lock --platform linux-x64
assert_contains "cat mise.lock" 'version = "1.0.0"'

echo "=== Prune the inactive version after its declaration is removed ==="
cat <<EOF >mise.toml
[tools]
tiny = "2.1.0"
EOF

mise lock --platform linux-x64
assert_not_contains "cat mise.lock" 'version = "1.0.0"'

echo "=== Preserve tool excluded on the current OS ==="
cat <<EOF >mise.toml
[tools]
cocoapods = { version = "1.16.2", os = ["$INACTIVE_OS"] }
EOF
cat <<EOF >>mise.lock

[[tools.cocoapods]]
version = "1.16.2"
backend = "gem:cocoapods"
EOF

OUTPUT=$(mise lock --platform linux-x64 2>&1)
assert_contains "echo \"$OUTPUT\"" "Pruned 1 stale tool entry"
assert_not_contains "echo \"$OUTPUT\"" "No tools configured to lock"
assert_not_contains "cat mise.lock" "[[tools.tiny]]"
assert_contains "cat mise.lock" "[[tools.cocoapods]]"

echo "=== Remove all tools and relock ==="
cat <<EOF >mise.toml
[tools]
EOF

assert_contains \
  "mise lock --dry-run --platform linux-x64" \
  "Dry run - would prune 1 stale tool entry"
assert_contains "cat mise.lock" "[[tools.cocoapods]]"

OUTPUT=$(mise lock --platform linux-x64 2>&1)
assert_contains "echo \"$OUTPUT\"" "Pruned 1 stale tool entry"
assert_not_contains "echo \"$OUTPUT\"" "No tools configured to lock"
# empty lockfile should just have header and tools section
assert "cat mise.lock" "$LOCKFILE_HEADER

[tools]"

echo "=== Cleanup ==="
rm -f mise.toml mise.lock
