#!/usr/bin/env bash

# `mise lock --check` fails, listing each problem, when a locked install would
# reject the lockfile, and passes when it is complete. It never writes.

export MISE_LOCKFILE=1
# The harness pins merge mode; generate, the default, requires checksums.
export MISE_LOCKFILE_MODE=generate

cat <<'TOML' >mise.toml
[tools]
jq = "1.7.1"
TOML

assert_fail_contains "mise lock --check --platform linux-x64" "the lockfile does not exist"
assert "test ! -f mise.lock"

mise lock --platform linux-x64
assert_contains "MISE_OFFLINE=1 mise lock --check" "mise.lock is up to date (1 tool version, 1 platform entry)"
assert_contains "mise lock --check --json" '"platform": "linux-x64"'
assert_contains "mise lock --check --json" '"problems": []'

# A platform mise lock would add has no URL to download.
assert_fail_contains "mise lock --check --platform linux-x64,macos-arm64" "No lockfile URL found for jq@1.7.1 on platform macos-arm64"

# A missing checksum fails, and the lockfile is left as it is.
sed -i.bak '/^checksum = /d' mise.lock
cp mise.lock before.lock
assert_fail_contains "mise lock --check" "No lockfile checksum found for jq@1.7.1 on platform linux-x64"
assert_fail_contains "mise lock --check" "to update the lockfile"
assert_fail_contains "mise lock --check --json" '"problems": ['
assert "cmp before.lock mise.lock"

# A request bumped in mise.toml but not in the lockfile fails.
mise lock --platform linux-x64
cat <<'TOML' >mise.toml
[tools]
jq = "1.6"
TOML
cp mise.lock before.lock
assert_fail_contains "mise lock --check" "jq@1.6 is not in the lockfile"
assert "cmp before.lock mise.lock"

# Like a locked install, the check enforces only the scopes locked_scopes names.
assert_contains "MISE_LOCKED_SCOPES=global mise lock --check" "mise.lock is up to date"

# Offline, sub-1:latest has nothing to subtract from, so it needs an entry.
cat <<'TOML' >mise.toml
[tools]
jq = "sub-1:latest"
TOML
assert_fail_contains "mise lock --check" "jq@sub-1:latest is not in the lockfile"

assert_fail_contains "mise lock --check --bump" "cannot be combined with --bump"
assert_fail_contains "mise lock --check jq@1.6" "name the tool without a version"

# A tool whose os option rules out every checked platform is not checked.
cat <<'TOML' >mise.toml
[tools]
jq = "1.7.1"
yq = { version = "4.44.1", os = ["windows"] }
TOML
assert_contains "MISE_OFFLINE=1 mise lock --check" "mise.lock is up to date (1 tool version, 1 platform entry)"

# A checksum the download could not be verified against fails.
cp mise.lock good.lock
sed -i.bak 's/^checksum = "[a-z0-9]*:/checksum = "/' mise.lock
assert_fail_contains "mise lock --check" "Invalid lockfile checksum"
cp good.lock mise.lock

# A remote task include is skipped rather than fetched.
cat <<'TOML' >mise.toml
[tools]
jq = "1.7.1"

[task_config]
includes = ["git::https://127.0.0.1:1/does-not-exist.git//tasks?ref=v1"]
TOML
assert_contains "GIT_TERMINAL_PROMPT=0 MISE_EXPERIMENTAL=1 mise lock --check 2>&1" "skipping remote task include"
assert_contains "GIT_TERMINAL_PROMPT=0 MISE_EXPERIMENTAL=1 mise lock --check 2>&1" "mise.lock is up to date"

# A revision 2 lockfile must record the dependency graph an npm tool replays.
mkdir missing-graph
cat <<'TOML' >missing-graph/mise.toml
[tools]
"npm:cowsay" = "1.5.0"
TOML
cat <<'TOML' >missing-graph/mise.lock
lockfile_version = 2

[[tools."npm:cowsay"]]
version = "1.5.0"
backend = "npm:cowsay"
specifiers = ["1.5.0"]
TOML
assert_fail_contains "cd missing-graph && mise lock --check --platform linux-x64" "has no embedded-aube dependency graph"

# System versions need no lockfile.
mkdir system-only
cat <<'TOML' >system-only/mise.toml
[tools]
jq = "system"
TOML
assert_contains "cd system-only && mise lock --check --platform linux-x64" "is up to date"
assert "test ! -f system-only/mise.lock"

# A tool stub mise.lock lists is checked like a configured tool.
mkdir -p stub/bin
cd stub || exit 1
echo '[tools]' >mise.toml
cat >bin/jq <<'EOF'
#!/usr/bin/env -S mise tool-stub

tool = "jq"
version = "1.7.1"
EOF
mise generate tool-stub bin/jq --lock
assert_contains "cat mise.lock" 'tool-stubs = ["bin/jq"]'
assert_contains "MISE_OFFLINE=1 mise lock --check" "mise.lock is up to date (1 tool version"
sed -i.bak 's/^version = "1.7.1"/version = "1.6"/' bin/jq
assert_fail_contains "mise lock --check" "jq@1.6 is not in the lockfile"
