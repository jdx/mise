#!/usr/bin/env bash

# A stub locked with `mise generate tool-stub --lock` carries its own version
# and artifact data, so it must run in locked mode without a nearby mise.lock.

export MISE_LOCKFILE=1

detect_platform

cat >jq <<'EOF'
#!/usr/bin/env -S mise tool-stub

tool = "aqua:jqlang/jq"
version = "1.7.1"
EOF

# Without embedded lock data, locked mode rejects the stub. This runs before
# anything installs jq, since an installed version would satisfy the request.
assert_fail_contains "MISE_LOCKED=1 mise tool-stub ./jq --version 2>&1" "is not in the lockfile"

assert_succeed "mise generate tool-stub ./jq --lock"
assert_contains "cat jq" "[lock.platforms."

# The embedded checksums apply to installs, locked or not. This also runs
# before jq is installed.
sed -e 's/^version = /bin = "jq"\nversion = /' \
  -e "/^\[lock\.platforms\.$MISE_PLATFORM\]/,/^checksum/ s/^checksum = .*/checksum = \"sha256:$(printf '0%.0s' {1..64})\"/" \
  jq >jq-tampered
assert_contains "cat jq-tampered" "sha256:0000000000000000"
assert_fail_contains "mise tool-stub ./jq-tampered --version 2>&1" "Checksum mismatch"

assert_contains "MISE_LOCKED=1 mise tool-stub ./jq --version" "jq-1.7.1"
