#!/usr/bin/env bash

# `mise lock --dry-run` reports what resolving would change in each platform
# entry, and writes nothing.

export MISE_LOCKFILE=1

cat <<'EOF' >mise.toml
[tools]
jq = "1.7.1"
EOF

output=$(mise lock --dry-run --platform linux-x64 2>&1)
assert_contains "echo '$output'" "jq@1.7.1 for linux-x64 (new entry)"
assert_contains "echo '$output'" "1 of 1 platform entries would change"
assert "test ! -f mise.lock"

mise lock --platform linux-x64
output=$(mise lock --dry-run --platform linux-x64 2>&1)
assert_contains "echo '$output'" "Dry run - already up to date"
assert_contains "echo '$output'" "jq@1.7.1 for linux-x64 (unchanged)"

output=$(mise lock --dry-run --platform linux-x64,macos-arm64 2>&1)
assert_contains "echo '$output'" "jq@1.7.1 for linux-x64 (unchanged)"
assert_contains "echo '$output'" "jq@1.7.1 for macos-arm64 (new platform)"
assert_not_contains "cat mise.lock" "macos-arm64"

sed -i.bak '/^checksum = /d' mise.lock
cp mise.lock before.lock
output=$(mise lock --dry-run --platform linux-x64 2>&1)
assert_contains "echo '$output'" "jq@1.7.1 for linux-x64 (checksum filled)"
assert "cmp before.lock mise.lock"

cat <<'EOF' >mise.toml
[tools]
jq = "1.6"
EOF
output=$(mise lock --dry-run --platform linux-x64 2>&1)
assert_contains "echo '$output'" "jq@1.6 for linux-x64 (version change from 1.7.1)"
assert "cmp before.lock mise.lock"
