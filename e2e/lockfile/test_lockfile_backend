#!/usr/bin/env bash

export MISE_LOCKFILE=1

assert "mise tool gh --backend" "aqua:cli/cli"
cat <<EOF >mise.toml
[tools.gh]
version = "1.0.0"
EOF
cat <<EOF >mise.lock
[[tools.gh]]
version = "1.0.0"
backend = "github:cli/cli[filter_bins=gh]"
EOF
assert "mise tool gh --backend" "github:cli/cli[filter_bins=gh]"
