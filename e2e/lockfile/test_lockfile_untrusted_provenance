#!/usr/bin/env bash

# A lockfile entry with a checksum lets `mise install` skip repeating the
# provenance check: the lockfile says the download was verified when it was
# written. Only a lockfile the user vouches for may say that. Until its config
# is trusted, and always in safe mode, a project's mise.lock pins the bytes and
# nothing more, so a checksum in it (with or without a recorded provenance)
# must not switch off the signature check of a download the signature does not
# cover.
#
# zls is downloaded over http and signed with minisign. A local stand-in serves
# an archive and a signature that does not verify, so the test needs no network.

export MISE_LOCKFILE=1
export MISE_TRUSTED_CONFIG_PATHS=""
export MISE_USE_VERSIONS_HOST=0
export MISE_DOWNLOADS_DIR="$PWD/dl"
unset CI GITHUB_ACTIONS GITHUB_ACTION 2>/dev/null || true

start_http_server --handler - "$PWD/archive.sha256" "$PWD/requests.log" <<'PY'
import base64
import hashlib
import http.server
import io
import sys
import tarfile

TOOL = b"#!/bin/sh\necho replaced\n"
buffer = io.BytesIO()
with tarfile.open(fileobj=buffer, mode="w:xz") as tar:
    member = tarfile.TarInfo("zls")
    member.size = len(TOOL)
    member.mode = 0o755
    tar.addfile(member, io.BytesIO(TOOL))
ARCHIVE = buffer.getvalue()

# The key id of the zls key in the aqua registry, then zeros where its
# signature belongs: what a host without the secret key can serve.
KEY = base64.b64decode("RWR+9B91GBZ0zOjh6Lr17+zKf5BoSuFvrx2xSeDE57uIYvnKBGmMjOex")
MINISIG = (
    b"untrusted comment: signature from secret key\n"
    + base64.b64encode(b"ED" + KEY[2:10] + bytes(64))
    + b"\ntrusted comment: none\n"
    + base64.b64encode(bytes(64))
    + b"\n"
)

with open(sys.argv[1], "w") as f:
    f.write(hashlib.sha256(ARCHIVE).hexdigest())


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        body = None
        if self.path.endswith("-0.15.0.tar.xz"):
            body = ARCHIVE
        elif self.path.endswith("-0.15.0.tar.xz.minisig"):
            body = MINISIG
        if body is not None and self.command == "GET":
            with open(sys.argv[2], "a") as f:
                f.write(self.path + "\n")
        self.send_response(404 if body is None else 200)
        self.send_header("Content-Length", str(len(body or b"")))
        self.end_headers()
        if self.command == "GET":
            self.wfile.write(body or b"")

    do_HEAD = do_GET

    def log_message(self, format, *args):
        pass
PY
export MISE_URL_REPLACEMENTS="{\"https://builds.zigtools.org/\": \"http://127.0.0.1:$HTTP_PORT/\", \"https://api.github.com/\": \"http://127.0.0.1:$HTTP_PORT/github-api/\"}"
checksum="sha256:$(cat archive.sha256)"
detect_platform

mkdir -p proj
cd proj || exit 1
cat <<EOF >mise.toml
[tools]
zls = "0.15.0"
EOF

write_lock() {
  cat <<EOF >mise.lock
lockfile_version = 4

[[tools.zls]]
version = "0.15.0"
backend = "aqua:zigtools/zls"

[tools.zls."platforms.$MISE_PLATFORM"]
checksum = "$checksum"
EOF
  printf '%s\n' "$@" >>mise.lock
}

# The signature was asked for and refused the download, which was not installed.
assert_signature_refused() {
  : >../requests.log
  assert_fail "$1" "signature verification failed"
  assert_contains "cat ../requests.log" ".minisig"
  assert_directory_not_exists "$MISE_DATA_DIR/installs/zls/0.15.0"
  rm -rf "$MISE_DOWNLOADS_DIR"
}

# control: with no lockfile the signature is checked
assert_signature_refused "MISE_SAFE=1 mise install"

# a checksum that safe mode does not trust pins the bytes and replaces no check
write_lock
assert_signature_refused "MISE_SAFE=1 mise install"
assert_signature_refused "MISE_SAFE=1 mise install --locked"

# nor may it say which provenance the download had
write_lock 'provenance = "minisign"'
assert_signature_refused "MISE_SAFE=1 mise install"

# outside safe mode, while the project is not trusted, a missing command
# installs nothing for it: a mistyped command is no consent to the project's
# config, so neither its tool request nor its lockfile is acted on, and the
# project stays untrusted
for provenance in "" 'provenance = "minisign"'; do
  write_lock "$provenance"
  assert_contains "MISE_YES=0 mise trust --show" "untrusted"
  : >../requests.log
  assert_fail "MISE_YES=0 mise hook-not-found -s bash zls"
  assert_not_contains "cat ../requests.log" "zls"
  assert_directory_not_exists "$MISE_DATA_DIR/installs/zls"
  assert_contains "MISE_YES=0 mise trust --show" "untrusted"
done

# once the project is trusted its lockfile vouches for the download it
# recorded, and the install does not repeat the check
case "$MISE_PLATFORM_ARCH" in
  arm64) arch=aarch64 ;;
  *) arch=x86_64 ;;
esac
write_lock "url = \"https://builds.zigtools.org/zls-$arch-$MISE_PLATFORM_OS-0.15.0.tar.xz\"" 'provenance = "minisign"'
mise trust mise.toml
: >../requests.log
assert_succeed "mise install"
assert_not_contains "cat ../requests.log" ".minisig"
assert_contains "mise x -- zls" "replaced"
