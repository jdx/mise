#!/usr/bin/env bash

# Installing or running a tool must not update the lockfile when its config
# sets `tool_config.locked`, as in locked mode. Only an explicit `mise lock`
# records a new version or prunes a stale one.
export MISE_LOCKFILE=1
export MISE_LOCKFILE_MODE=generate
# Keep windows-x64 out of the lockfile so the platform check below can add it.
export MISE_LOCKFILE_PLATFORMS=linux-x64

for name in a b; do
  printf '#!/bin/sh\necho %s\n' "$name" >"$PWD/fixture-$name"
  chmod +x "$PWD/fixture-$name"
done
sum_a="$(shasum -a 256 fixture-a | cut -d' ' -f1)"
sum_b="$(shasum -a 256 fixture-b | cut -d' ' -f1)"

write_config() {
  cat <<EOT >mise.toml
[tool_config]
locked = true

[tools]
"http:fixture-a" = { version = "1.0.0", url = "file://$PWD/fixture-a", checksum = "sha256:$sum_a" }
"http:fixture-b" = { version = "$1", url = "file://$PWD/fixture-b", checksum = "sha256:$sum_b" }
EOT
}

write_config 1.0.0
assert "mise lock"
cp mise.lock lock.before

write_config 2.0.0
assert_fail_contains "mise exec -- fixture-b 2>&1" "is not in the lockfile"
assert "diff lock.before mise.lock"
assert_fail_contains "mise exec -- fixture-b 2>&1" "is not in the lockfile"

assert "mise install http:fixture-a"
assert "diff lock.before mise.lock"

# An explicit `mise lock` is what records the new pin.
assert "mise lock"
assert_contains "cat mise.lock" 'version = "2.0.0"'
assert "mise exec -- fixture-b"

# With every pin recorded, an install still does not lock more platforms.
assert_not_contains "cat mise.lock" "platforms.windows-x64"
cp mise.lock lock.before
assert "MISE_LOCKFILE_PLATFORMS=windows-x64 mise install http:fixture-a"
assert "diff lock.before mise.lock"

# An install leaves the lockfile alone, as locked mode does: a stale entry of a
# tool that left the config stays until `mise lock` prunes it.
cp fixture-a fixture-c
cat <<EOT >mise.toml
[tool_config]
locked = true

[tools]
"http:fixture-a" = { version = "1.0.0", url = "file://$PWD/fixture-a", checksum = "sha256:$sum_a" }
"http:fixture-b" = { version = "2.0.0", url = "file://$PWD/fixture-b", checksum = "sha256:$sum_b" }
"http:fixture-c" = { version = "1.0.0", url = "file://$PWD/fixture-c", checksum = "sha256:$sum_a" }
EOT
assert "mise lock"
assert_contains "cat mise.lock" 'http:fixture-c'
cp mise.lock lock.before
write_config 3.0.0
assert "mise install http:fixture-a"
assert "diff lock.before mise.lock"
assert "mise lock"
assert_not_contains "cat mise.lock" 'http:fixture-c'
assert_contains "cat mise.lock" 'version = "3.0.0"'

# Without tool_config.locked, the same install prunes the stale entry.
cat <<EOT >mise.toml
[tools]
"http:fixture-a" = { version = "1.0.0", url = "file://$PWD/fixture-a", checksum = "sha256:$sum_a" }
"http:fixture-c" = { version = "1.0.0", url = "file://$PWD/fixture-c", checksum = "sha256:$sum_a" }
EOT
assert "mise lock"
assert_contains "cat mise.lock" 'http:fixture-c'
cat <<EOT >mise.toml
[tools]
"http:fixture-a" = { version = "1.0.0", url = "file://$PWD/fixture-a", checksum = "sha256:$sum_a" }
EOT
assert "mise install http:fixture-a"
assert_not_contains "cat mise.lock" 'http:fixture-c'
