#!/usr/bin/env bash

# `mise lock --bump` keeps the locked version when minimum_release_age hides
# every release matching the request, rather than resolving to the request text.

export MISE_LOCKFILE=1

FIXTURE_DIR="$TMPDIR/bump-release-age"
mkdir -p "$FIXTURE_DIR"
cat <<'JSON' >"$FIXTURE_DIR/releases.json"
{"releases":[{"version":"1.2.0","published":"2999-01-01T00:00:00Z"}]}
JSON
echo "tool" >"$FIXTURE_DIR/tool"

start_http_server --dir "$FIXTURE_DIR"
BASE="http://localhost:$HTTP_PORT"

cat <<TOML >mise.toml
[settings]
minimum_release_age = "12h"

[tools."http:dated"]
version = "1"
url = "$BASE/tool"
version_list_url = "$BASE/releases.json"
version_expr = 'map(fromJSON(body).releases, { #.version })'
version_date_expr = 'map(fromJSON(body).releases, { [#.version, #.published] })'
TOML

cat <<'EOF' >mise.lock
# @generated - this file is auto-generated by `mise lock` https://mise.jdx.dev/dev-tools/mise-lock.html

[[tools."http:dated"]]
version = "1.1.0"
backend = "http:dated"
specifiers = ["1"]
EOF

assert_contains "mise lock --bump --platform linux-x64" "http:dated"
assert_contains "cat mise.lock" 'version = "1.1.0"'
assert_not_contains "cat mise.lock" 'version = "1"'
assert_not_contains "mise lock --bump --dry-run --json --platform linux-x64" '"new_versions": [
      "1"'

# Naming the tool on the command line keeps the locked version too.
assert_contains "mise lock --bump http:dated@1 --platform linux-x64" "http:dated"
assert_contains "cat mise.lock" 'version = "1.1.0"'
assert_not_contains "cat mise.lock" 'version = "1"'
