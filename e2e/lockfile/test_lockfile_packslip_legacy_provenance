#!/usr/bin/env bash

# A Packslip lock entry that an older mise wrote with the previous backend's
# `provenance = "cosign"` must not block `mise lock --bump`: the Packslip signer
# is the replacement trust baseline.
export MISE_LOCKFILE=1
export MISE_MINIMUM_RELEASE_AGE=0
detect_platform

cat <<'EOF2' >mise.toml
[tools]
hk = "1"
EOF2
mise lock --platform "$MISE_PLATFORM"
assert_contains "cat mise.lock" 'backend = "packslip:github.com/jdx/hk"'

# Recreate what an older mise wrote: the previous backend's provenance and no
# signer. awk keeps the edit portable to BSD sed platforms.
awk '
  /^signer = / || /^repository_ids = / { next }
  { print }
  /^url = / { print "provenance = \"cosign\"" }
' mise.lock >mise.lock.new && mv mise.lock.new mise.lock
assert_contains "cat mise.lock" 'provenance = "cosign"'
assert_not_contains "cat mise.lock" 'signer = '

# Re-verify the release instead of reusing the edited entry as it is.
MISE_LOCKED_VERIFY_PROVENANCE=1 mise lock --platform "$MISE_PLATFORM" --bump hk
assert_contains "cat mise.lock" 'signer = '
