#!/usr/bin/env bash

# An entry an earlier mise wrote with the mirror login in its URL is recorded
# again without the login, and keeps the checksum it pinned: leaving the login
# out of the URL names the same artifact, so it does not re-pin it.

export MISE_LOCKFILE=1
export MISE_LOCKFILE_MODE=generate

FIRST_SHA="5e3f2fdc5e1c1d2b4a9f5e4b5a5b8c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b"
SECOND_SHA="0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0"
echo "$FIRST_SHA" >tool.tar.gz.sha256
printf '%s' "payload" >tool.tar.gz
start_http_server
cat <<EOF >mise.toml
[tools."http:loginpins-test"]
version = "1.0.0"
url = "http://ci:s3cret@127.0.0.1:$HTTP_PORT/tool.tar.gz"
checksum_url = "http://127.0.0.1:$HTTP_PORT/tool.tar.gz.sha256"
EOF

touch mise.lock
mise lock --platform linux-x64
assert_contains "cat mise.lock" "checksum = \"sha256:$FIRST_SHA\""
assert_contains "cat mise.lock" "url = \"http://127.0.0.1:$HTTP_PORT/tool.tar.gz\""

# What an earlier mise wrote: the same entry with the login in its URL.
sed -i.bak 's|url = "http://127.0.0.1:|url = "http://ci:s3cret@127.0.0.1:|' mise.lock
assert_contains "cat mise.lock" "ci:s3cret@"

# The mirror now publishes another checksum for the same URL.
echo "$SECOND_SHA" >tool.tar.gz.sha256

mise lock --platform linux-x64
assert_not_contains "cat mise.lock" "s3cret"
assert_contains "cat mise.lock" "url = \"http://127.0.0.1:$HTTP_PORT/tool.tar.gz\""
assert_contains "cat mise.lock" "checksum = \"sha256:$FIRST_SHA\""
