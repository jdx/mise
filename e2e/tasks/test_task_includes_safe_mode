#!/usr/bin/env bash

# Safe mode loads project config without trust, so the task files a project's
# includes reach must stay inside the project. Read as a task file, a file of
# the user's is quoted in the parse error, or listed as tasks when it happens to
# parse, and stderr is often a job log the project's author can read.

mkdir -p "$HOME/private"
cat <<'EOF' >"$HOME/private/credentials.toml"
[registry]
token = "s3cr3t"
EOF
echo 'oauth_token = "t0k3n"' >"$HOME/private/hosts.toml"

# control: outside safe mode the (trusted) config reads the file
cat <<'EOF' >mise.toml
[task_config]
includes = ["~/private/credentials.toml"]
EOF
assert_fail_contains "mise tasks ls 2>&1" "s3cr3t"

echo "=== named by path: ~, absolute, .., a directory and a glob ==="
for include in "~/private/credentials.toml" "$HOME/private/credentials.toml" \
  "../private/credentials.toml" "../private" "../private/cred*.toml"; do
  cat <<EOF >mise.toml
[task_config]
includes = ["$include"]
EOF
  assert_contains "MISE_SAFE=1 mise tasks ls 2>&1" "resolves outside the project"
  assert_not_contains "MISE_SAFE=1 mise tasks ls 2>&1" "s3cr3t"
  assert_not_contains "MISE_SAFE=1 mise lock --dry-run 2>&1" "s3cr3t"
done

echo "=== a glob whose folder is outside is skipped before the folder is walked ==="
cat <<'EOF' >mise.toml
[task_config]
includes = ["../private/**/*.toml"]
EOF
assert_contains "MISE_SAFE=1 mise tasks ls 2>&1" "ignoring task directory ~/workdir/../private:"
assert_not_contains "MISE_SAFE=1 mise tasks ls 2>&1" "ignoring task file"

echo "=== a file that parses is not listed, also through a link ==="
ln -s "$HOME/private/hosts.toml" linked.toml
for include in "~/private/hosts.toml" "linked.toml"; do
  cat <<EOF >mise.toml
[task_config]
includes = ["$include"]
EOF
  assert_contains "mise tasks ls --json" "t0k3n"
  assert_not_contains "MISE_SAFE=1 mise tasks ls --json 2>&1" "t0k3n"
done
rm linked.toml

echo "=== a link inside a task directory ==="
echo '[tools]' >mise.toml
mkdir -p mise-tasks
ln -s "$HOME/private/hosts.toml" mise-tasks/hosts.toml
ln -s "$HOME/private/credentials.toml" mise-tasks/creds.toml
assert_not_contains "MISE_SAFE=1 mise tasks ls --json 2>&1" "t0k3n"
assert_not_contains "MISE_SAFE=1 mise tasks ls --json 2>&1" "s3cr3t"
assert_fail "MISE_SAFE=1 mise tasks info oauth_token"
assert_not_contains_text "$(MISE_SAFE=1 mise tasks info oauth_token 2>&1 || true)" "t0k3n"
# `mise prune` reads the task files of every tracked config for the tools they declare
assert_not_contains "MISE_SAFE=1 mise prune --dry-run 2>&1" "s3cr3t"
assert_not_contains "MISE_SAFE=1 mise prune --dry-run 2>&1" "t0k3n"
rm -r mise-tasks

cat <<'EOF' >mise.toml
[task_config]
includes = ["~/private/credentials.toml"]
EOF
assert_not_contains "MISE_SAFE=1 mise prune --dry-run 2>&1" "s3cr3t"

echo "=== a conf.d folder that links outside the project does not move its bounds ==="
# A folder fragment's includes resolve in the folder the link leads to, and are
# judged against the project that holds the link.
mkdir -p "$HOME/linked-fragment/private" .mise/conf.d
cp "$HOME/private/hosts.toml" "$HOME/linked-fragment/private/"
cat <<'EOF' >"$HOME/linked-fragment/mise.toml"
[task_config]
includes = ["private/hosts.toml"]
EOF
ln -s "$HOME/linked-fragment" .mise/conf.d/linked
echo '[tools]' >mise.toml
assert_contains "mise tasks ls --json 2>&1" "t0k3n"
assert_not_contains "MISE_SAFE=1 mise tasks ls --json 2>&1" "t0k3n"
assert_contains "MISE_SAFE=1 mise tasks ls 2>&1" "resolves outside the project"
rm -r .mise

echo "=== includes inside the project still load ==="
mkdir -p ci/tasks
cat <<'EOF' >ci/inside.toml
[inside-file]
run = "echo inside"
EOF
cat <<'EOF' >ci/tasks/inside.toml
[inside-dir]
run = "echo inside"
EOF
cat <<'EOF' >mise.toml
[task_config]
includes = ["ci/inside.toml", "ci/tasks"]
EOF
assert_contains "MISE_SAFE=1 mise tasks ls" "inside-file"
assert_contains "MISE_SAFE=1 mise tasks ls" "inside-dir"
assert_not_contains "MISE_SAFE=1 mise tasks ls 2>&1" "resolves outside the project"
rm -r ci mise.toml

echo "=== so do task files elsewhere in the checkout ==="
mkdir -p repo/.git repo/ci repo/sub
cat <<'EOF' >repo/ci/shared.toml
[shared]
run = "echo shared"
tools = { dummy = "1.0.0" }
EOF
cat <<'EOF' >repo/sub/mise.toml
[task_config]
includes = ["../ci/shared.toml"]
EOF
assert_contains "MISE_SAFE=1 mise -C repo/sub tasks ls" "shared"

echo "=== mise lock keeps the entries of a task file it skipped ==="
mkdir -p outside
cat <<'EOF' >outside/tasks.toml
[outside]
run = "echo outside"
tools = { dummy = "1.0.0" }
EOF
cat <<'EOF' >repo/sub/mise.toml
[task_config]
includes = ["../../outside/tasks.toml"]
EOF
cat <<'EOF' >repo/sub/mise.lock
[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF
MISE_SAFE=1 mise -C repo/sub lock >/dev/null 2>&1 || true
assert_contains "cat repo/sub/mise.lock" "1.0.0"

echo "=== and the version it pins when the config locks another one ==="
cat <<'EOF' >outside/tasks.toml
[outside]
run = "echo outside"
tools = { "github:mvdan/sh" = "3.9.0" }
EOF
cat <<'EOF' >repo/sub/mise.toml
[tools]
"github:mvdan/sh" = "3.10.0"

[task_config]
includes = ["../../outside/tasks.toml"]
EOF
cat <<'EOF' >repo/sub/mise.lock
[[tools."github:mvdan/sh"]]
version = "3.9.0"
backend = "github:mvdan/sh"
EOF
assert_succeed "MISE_SAFE=1 mise -C repo/sub lock --platform linux-x64"
assert_contains "cat repo/sub/mise.lock" "3.10.0"
assert_contains "cat repo/sub/mise.lock" "3.9.0"

echo "=== and in generate mode, with the platforms the lockfile already has ==="
cat <<'EOF' >repo/sub/mise.lock
[[tools."github:mvdan/sh"]]
version = "3.9.0"
backend = "github:mvdan/sh"
EOF
assert_succeed "MISE_LOCKFILE_MODE=generate MISE_LOCKFILE_AUTO_PRUNE=1 MISE_SAFE=1 mise -C repo/sub lock"
assert_contains "cat repo/sub/mise.lock" "3.10.0"
assert_contains "cat repo/sub/mise.lock" "3.9.0"
rm -r repo outside

echo "=== mise lock keeps the entries of a remote task include it skipped ==="
mkdir -p repo/sub
cat <<'EOF' >repo/sub/mise.toml
[task_config]
includes = ["git::https://example.invalid/tasks.git//tasks.toml?ref=v1"]
EOF
cat <<'EOF' >repo/sub/mise.lock
[[tools.dummy]]
version = "1.0.0"
backend = "asdf:dummy"
EOF
MISE_EXPERIMENTAL=1 MISE_SAFE=1 mise -C repo/sub lock >/dev/null 2>&1 || true
assert_contains "cat repo/sub/mise.lock" "1.0.0"
rm -r repo

echo "=== mise prune keeps every version when a tracked project's remote include is skipped ==="
mkdir -p remote-proj other
cat <<'EOF' >remote-proj/mise.toml
[task_config]
includes = ["git::https://example.invalid/tasks.git//tasks.toml?ref=v1"]
EOF
assert "mise trust remote-proj/mise.toml"
assert "mise install dummy@1.0.0"
assert "mise ls -C remote-proj"
assert_contains "MISE_SAFE=1 mise -C other prune --dry-run 2>&1" 'not pruning: safe mode (MISE_SAFE=1) skipped the remote task include `git::https://example.invalid'
assert_not_contains "MISE_SAFE=1 mise -C other prune --dry-run 2>&1" "dummy@1.0.0"
# Without experimental the include loads in no mode, so skipping it hides nothing.
assert_not_contains "MISE_EXPERIMENTAL=0 MISE_SAFE=1 mise -C other prune --dry-run 2>&1" "not pruning"
assert_contains "MISE_EXPERIMENTAL=0 MISE_SAFE=1 mise -C other prune --dry-run 2>&1" "dummy@1.0.0"
rm -r remote-proj other

echo "=== and task files a monorepo's projects share ==="
mkdir -p shared packages/foo
cat <<'EOF' >shared/common.toml
[common-task]
run = "echo common"
EOF
cat <<'EOF' >mise.toml
monorepo_root = true

[monorepo]
config_roots = ["packages/*"]
EOF
cat <<'EOF' >packages/foo/mise.toml
[task_config]
includes = ["../../shared/common.toml", "../../../private/hosts.toml"]
EOF
assert_contains "MISE_SAFE=1 mise tasks ls --all" "//packages/foo:common-task"
assert_not_contains "MISE_SAFE=1 mise tasks ls --all --json 2>&1" "t0k3n"
assert_contains "MISE_SAFE=1 mise -C packages/foo tasks ls" "common-task"
assert_not_contains "MISE_SAFE=1 mise -C packages/foo tasks ls --json 2>&1" "t0k3n"
rm -r shared packages mise.toml

echo "=== a monorepo rooted at the home directory does not bound its projects' includes ==="
cat <<'EOF' >"$HOME/mise.toml"
monorepo_root = true

[monorepo]
config_roots = ["home-mono/*"]
EOF
mkdir -p "$HOME/home-mono/foo"
cat <<'EOF' >"$HOME/home-mono/foo/mise.toml"
[task_config]
includes = ["../../private/hosts.toml"]
EOF
assert_contains "MISE_SAFE=1 mise -C $HOME/home-mono/foo tasks ls 2>&1" "resolves outside the project"
assert_not_contains "MISE_SAFE=1 mise -C $HOME/home-mono/foo tasks ls --json 2>&1" "t0k3n"
rm -r "$HOME/mise.toml" "$HOME/home-mono"

echo "=== global config keeps its includes ==="
mkdir -p "$MISE_TMP_DIR/tasks"
cat <<'EOF' >"$MISE_TMP_DIR/tasks/global.toml"
[from-global-include]
run = "echo global"
EOF
cat <<EOF >"$MISE_CONFIG_DIR/config.toml"
[task_config]
includes = ["$MISE_TMP_DIR/tasks"]
EOF
assert_contains "MISE_SAFE=1 mise tasks ls" "from-global-include"

echo "=== a project's include of a link in the global task directory is judged where it leads ==="
# Global config includes another directory, so only the project's include reads this one
# (the home directory's own default walk reaches it too, but bounded by the home directory).
outside_private="$(dirname "$HOME")/outside-private"
mkdir -p "$outside_private" "$MISE_CONFIG_DIR/tasks"
echo 'oauth_token = "0uts1de"' >"$outside_private/hosts.toml"
ln -s "$outside_private/hosts.toml" "$MISE_CONFIG_DIR/tasks/hosts.toml"
cat <<EOF >mise.toml
[task_config]
includes = ["$MISE_CONFIG_DIR/tasks/hosts.toml"]
EOF
assert_contains "mise tasks ls --json" "0uts1de"
assert_not_contains "MISE_SAFE=1 mise tasks ls --json 2>&1" "0uts1de"
rm mise.toml "$MISE_CONFIG_DIR/tasks/hosts.toml"

echo "=== the global task directory still follows its links without a global config ==="
outside_global="$(dirname "$HOME")/outside-global"
mkdir -p "$outside_global"
printf '[linked-global]\nrun = "echo linked"\n' >"$outside_global/linked.toml"
ln -s "$outside_global/linked.toml" "$MISE_CONFIG_DIR/tasks/linked.toml"
mv "$MISE_CONFIG_DIR/config.toml" "$MISE_CONFIG_DIR/config.toml.before"
assert_contains "MISE_SAFE=1 mise tasks ls" "linked-global"
mv "$MISE_CONFIG_DIR/config.toml.before" "$MISE_CONFIG_DIR/config.toml"
rm "$MISE_CONFIG_DIR/tasks/linked.toml"

echo "=== a project config beside global config does not share its exemption ==="
# ~/mise.toml has the same config root as ~/.config/mise/config.toml, but the
# includes it declares are a project's. When no task is found, `mise tasks ls`
# looks through the includes for files that are not executable, and must not
# walk one outside the project.
outside_home="$(dirname "$HOME")/outside-home"
mkdir -p "$outside_home/scripts"
echo "echo private" >"$outside_home/scripts/private-script"
cat <<EOF >"$HOME/mise.toml"
[task_config]
includes = ["$outside_home/scripts"]
EOF
assert_contains "MISE_SAFE=1 mise -C $HOME tasks ls 2>&1" "resolves outside the project"
assert_not_contains "MISE_SAFE=1 mise -C $HOME tasks ls 2>&1" "private-script"
rm "$HOME/mise.toml"

echo "=== a home directory reached through a link is not the project's checkout ==="
# A checkout that is the home directory holds the user's own files, also when
# HOME names it through a link.
realhome="$(dirname "$HOME")/realhome"
linkedhome="$(dirname "$HOME")/linkedhome"
mkdir -p "$realhome/.git" "$realhome/private" "$realhome/proj"
ln -s "$realhome" "$linkedhome"
echo 'oauth_token = "h0met0k3n"' >"$realhome/private/hosts.toml"
cat <<'EOF' >"$realhome/proj/mise.toml"
[task_config]
includes = ["../private/hosts.toml"]
EOF
# control: when it is not the home directory, the checkout bounds the includes
assert_contains "MISE_SAFE=1 mise -C $linkedhome/proj tasks ls --json 2>&1" "h0met0k3n"
assert_not_contains "HOME=$linkedhome MISE_SAFE=1 mise -C $linkedhome/proj tasks ls --json 2>&1" "h0met0k3n"
