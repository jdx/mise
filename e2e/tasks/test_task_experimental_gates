#!/usr/bin/env bash

# Remote `git::` task files, `git::`/`oci::` task includes and OpenTelemetry
# export are experimental: with experimental off, a config that mentions them
# still loads, and nothing is fetched or exported.

export MISE_EXPERIMENTAL=0

# Nothing listens on port 9 here, so a missing gate shows up as a fetch error.
cat <<'TOML' >mise.toml
[tasks.local]
run = "echo local-ok"

[tasks.remote]
description = "a remote task"
file = "git::https://127.0.0.1:9/org/repo.git//tasks/hello"
TOML

assert "mise run local" "local-ok"
assert_fail_matches "mise run remote" "loading task .remote. from a .git::. file is experimental"

# Listing and completion do not fetch the remote file, so they keep working and
# still offer the remote task from its TOML metadata.
assert_contains "mise tasks ls" "local"
assert_contains "mise tasks ls" "a remote task"
assert_contains "mise tasks ls 2>&1" "listing it without fetching"
assert_contains "mise tasks ls --complete" "local:"
assert_contains "mise tasks ls --complete" "remote:a remote task"
assert_not_contains "mise tasks ls --complete 2>&1" "experimental"
assert_contains "mise tasks --usage" 'cmd local'
assert_contains "mise tasks --usage" 'cmd remote'
assert_not_contains "mise tasks --usage 2>&1" "experimental"

# Validation does not fetch the remote file either: it reports it as a warning
# and still validates the other tasks.
assert_succeed "mise tasks validate local"
assert_succeed "mise tasks validate"
assert_contains "mise tasks validate 2>&1" "is experimental; not fetched"
assert_not_contains "mise tasks validate 2>&1" "not found"

cat <<'TOML' >mise.toml
[task_config]
includes = ["git::https://127.0.0.1:9/org/repo.git//tasks"]

[tasks.local]
run = "echo local-ok"
TOML

# The remote include is skipped with a warning; the config's own tasks still
# list, complete and run.
assert_succeed "mise config ls"
assert "mise run local" "local-ok"
assert_matches "mise run local 2>&1" "skipping task include .git::https://127.0.0.1:9/org/repo.git//tasks.: including tasks from a .git::. source is experimental"
assert_contains "mise tasks ls" "local"
assert_contains "mise tasks ls --complete" "local:"

cat <<'TOML' >mise.toml
[task_config]
includes = ["oci::127.0.0.1:9/org/tasks:v1"]

[tasks.local]
run = "echo local-ok"
TOML

assert "mise run local" "local-ok"
assert_matches "mise run local 2>&1" "including tasks from an .oci::. source is experimental"

cat <<'TOML' >mise.toml
[settings.otel]
enabled = true

[tasks.local]
run = "echo local-ok"
TOML

# Without an endpoint nothing is exported, so the setting alone is fine.
assert "mise run local" "local-ok"
assert_fail_contains "OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:9 mise run local" "OpenTelemetry export is experimental"

export MISE_EXPERIMENTAL=1
assert "OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:9 OTEL_EXPORTER_OTLP_TIMEOUT=100 mise run local" "local-ok"
