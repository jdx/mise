#!/usr/bin/env bash
set -euo pipefail

# A conda tool that only a task's `tools` declares is pinned by the lockfile,
# and its dependency packages must be read from that same lockfile. The pin was
# found but the `[conda-packages]` tables were not, so installing on a machine
# that had only run `mise lock` failed with "conda package ... not found in
# lockfile". https://github.com/jdx/mise/issues/16115
export MISE_LOCKFILE=1
unset MISE_LOCKFILE_MODE
detect_platform

cat >mise.toml <<'TOML'
[tasks.t]
tools = { "conda:jq" = "1.7.1" }
run = "jq --version"
TOML

touch mise.lock
mise lock --platform "$MISE_PLATFORM"
assert_contains "cat mise.lock" 'conda_deps = ['
assert_contains "cat mise.lock" "[conda-packages.$MISE_PLATFORM."

rm -rf "$MISE_DATA_DIR/installs" "$MISE_CACHE_DIR"
assert_contains "mise run t" "jq-1.7.1"
