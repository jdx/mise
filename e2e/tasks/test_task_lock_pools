#!/usr/bin/env bash
# A lock is a pool of slots (`task.lock_pools`), and `lock = { name, count }` takes several
# of them, all or none, across separate `mise run` processes and inside one.

export LOCK_LOG="$PWD/running.log"
export LOCK_SIGNALS="$PWD/signals"
mkdir -p "$LOCK_SIGNALS" a b c d e

cat <<'EOF2' >a/mise.toml
[settings.task.lock_pools]
cpu = "4"

[tasks.hold]
lock = { name = "cpu", count = 3 }
run = '''
echo "hold sees $MISE_TASK_LOCKS" >"$LOCK_SIGNALS/held-a"
i=0; while [ ! -f "$LOCK_SIGNALS/release" ]; do i=$((i + 1)); [ "$i" -lt 600 ] || exit 1; sleep 0.1; done
'''
EOF2

cat <<'EOF2' >c/mise.toml
[settings.task.lock_pools]
cpu = "4"
pair = "2"

[tasks.big]
lock = { name = "cpu", count = 2 }
run = "echo big ran"

[tasks.small]
lock = "cpu"
run = 'echo "small sees $MISE_TASK_LOCKS"'

[tasks.too-big]
lock = { name = "cpu", count = 99 }
run = "echo too-big ran"

[tasks.outer]
lock = { name = "cpu", count = 2 }
run = "mise run --lock-timeout 10s inner"

[tasks.inner]
lock = { name = "cpu", count = 2 }
run = 'echo "inner sees $MISE_TASK_LOCKS"'

[tasks.greedy-child]
lock = { name = "cpu", count = 1 }
run = "mise run --lock-timeout 10s inner"

[tasks.p1]
lock = { name = "pair", count = 1 }
run = 'mkdir "$LOCK_SIGNALS/w1"; ls "$LOCK_SIGNALS" | grep -c "^w" >>"$LOCK_LOG"; sleep 1; rmdir "$LOCK_SIGNALS/w1"'
[tasks.p2]
lock = { name = "pair", count = 1 }
run = 'mkdir "$LOCK_SIGNALS/w2"; ls "$LOCK_SIGNALS" | grep -c "^w" >>"$LOCK_LOG"; sleep 1; rmdir "$LOCK_SIGNALS/w2"'
[tasks.p3]
lock = { name = "pair", count = 1 }
run = 'mkdir "$LOCK_SIGNALS/w3"; ls "$LOCK_SIGNALS" | grep -c "^w" >>"$LOCK_LOG"; sleep 1; rmdir "$LOCK_SIGNALS/w3"'
EOF2

# schema: invalid
cat <<'EOF2' >e/mise.toml
[tasks.bad]
lock = "cpu:1"
run = "true"
EOF2

# schema: invalid
cat <<'EOF2' >d/mise.toml
[tasks.bad]
lock = { name = "cpu", count = 0 }
run = "true"
EOF2

cat <<'EOF2' >b/mise.toml
[settings.task.lock_pools]
cpu = "lots"

[tasks.ok]
lock = "cpu"
run = "true"
EOF2

assert_contains "cd c && timeout 30 mise tasks info big" "cpu (2 of 4 slots)"
# A count above the pool is lowered to the whole pool.
assert_contains "cd c && timeout 30 mise tasks info too-big" "cpu (4 of 4 slots)"
assert_fail_contains "cd b && timeout 30 mise run ok" "task.lock_pools.cpu must be a whole number"
assert_fail_contains "cd d && timeout 30 mise tasks info bad" "lock count must be a positive whole number"
assert_fail_contains "cd e && timeout 30 mise tasks info bad" "cannot end in"

(cd a && mise run hold) >a.log 2>&1 &
a_pid=$!
wait_for_file "$LOCK_SIGNALS/held-a" "hold in a" 30 "$a_pid"
assert "cat $LOCK_SIGNALS/held-a" "hold sees cpu,cpu:1,cpu:2"

# One of four slots is free: a single slot fits, two do not.
assert_contains "cd c && timeout 30 mise run --lock-timeout 1s small 2>&1" "small sees cpu:3"
assert_fail_contains "cd c && timeout 30 mise run --lock-timeout 1s big" \
  "waiting for lock cpu (2 of 4 slots), held by hold in ~/workdir/"

touch "$LOCK_SIGNALS/release"
wait "$a_pid"

# A task started under a lock that holds enough slots shares them.
assert_contains "cd c && timeout 30 mise run outer 2>&1" "inner sees cpu,cpu:1"
# One that needs more than its parent holds fails instead of risking a deadlock.
assert_fail_contains "cd c && timeout 30 mise run greedy-child 2>&1" "cannot take more of lock"

# Inside one run, at most two of the three tasks hold the two-slot pool at once.
(cd c && timeout 60 mise run --jobs 3 p1 ::: p2 ::: p3)
assert "sort -n '$LOCK_LOG' | tail -n 1" "2"
