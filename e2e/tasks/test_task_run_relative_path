#!/usr/bin/env bash

# `mise run ./script` runs the script relative to the current directory, not the
# project root, even when the project root has a file of the same name.

cat <<EOF >mise.toml
[tools]
EOF

cat <<EOF >greet.sh
#!/usr/bin/env bash
echo "root greet"
EOF
chmod +x greet.sh

mkdir -p sub
cat <<EOF >sub/greet.sh
#!/usr/bin/env bash
echo "sub greet"
EOF
chmod +x sub/greet.sh

cat <<EOF >sub/only-here.sh
#!/usr/bin/env bash
echo "only in sub"
EOF
chmod +x sub/only-here.sh

assert "mise run ./greet.sh" "root greet"

cd sub || exit 1
assert "mise run ./greet.sh" "sub greet"
assert "mise run ./only-here.sh" "only in sub"
assert "mise run ../greet.sh" "root greet"
