#!/usr/bin/env bash

# With the paranoid `config` category alone, trust is bound to a config's content. The task
# commands renew the record of a file they edit, so a trusted project stays trusted.
export MISE_TRUSTED_CONFIG_PATHS=""
export MISE_PARANOID=config
export MISE_YES=0
unset CI GITHUB_ACTIONS GITHUB_ACTION 2>/dev/null || true

cat <<'EOF' >mise.toml
[env]
PARANOID_MARKER = "loaded"

[tasks.build]
run = "make"

[tasks.lint]
run = "make lint"
EOF
mise trust mise.toml
assert_contains "mise env -s bash" "PARANOID_MARKER"

mise tasks add test -- make test
assert_contains "mise env -s bash" "PARANOID_MARKER"
mise tasks set build --description "Build"
assert_contains "mise env -s bash" "PARANOID_MARKER"
MISE_YES=1 mise tasks rm lint
assert_contains "mise env -s bash" "PARANOID_MARKER"
assert "cat mise.toml" '[env]
PARANOID_MARKER = "loaded"

[tasks.build]
run = "make"
description = "Build"

[tasks.test]
run = "make test"'

# an edit made outside mise loses the trust, which is what the commands above renew
echo '# edited' >>mise.toml
assert_fail_contains "mise env -s bash 2>&1" "not trusted"

echo "=== looking for a shadowed script does not render it before it is trusted ==="
cat <<'EOF' >mise.toml
[tasks.rendered]
run = "echo toml"
EOF
mise trust mise.toml
marker="$PWD/rendered-marker"
mkdir -p mise-tasks
cat <<EOF >mise-tasks/rendered
#!/usr/bin/env bash
#MISE description="{{ exec(command='touch $marker') }}"
echo rendered
EOF
chmod +x mise-tasks/rendered
MISE_YES=1 mise tasks rm --dry-run rendered >/dev/null 2>&1 || true
assert_fail "test -e $marker"
MISE_YES=1 mise tasks set --dry-run --path mise.toml rendered --hide >/dev/null 2>&1 || true
assert_fail "test -e $marker"

echo "=== renewing trust on the first removal does not refuse the next one ==="
# Paranoid mode trusts a config reached through a link out of the project only through
# `trusted_config_paths`, which is trust from before the command. Each removal may follow the
# link, also after the first one changed the file and renewed its record.
# Outside the project above, whose config and task scripts would load as a parent.
base="$HOME/linked"
mkdir -p "$base/shared" "$base/project" "$base/shared-dir/mise" "$base/dir-project/.config"
write_tasks() {
  cat <<'TOML' >"$1"
[tasks.a]
run = "echo a"

[tasks.b]
run = "echo b"

[tasks.keep]
run = "echo keep"
TOML
}
kept="[tasks.keep]"

# a linked file, with `trusted_config_paths` covering the project but not the link's target
write_tasks "$base/shared/mise.toml"
ln -s "$base/shared/mise.toml" "$base/project/mise.toml"
cd "$base/project" || exit 1
MISE_TRUSTED_CONFIG_PATHS="$base/project" MISE_YES=1 mise tasks rm a b
assert "grep '^\[tasks' $base/shared/mise.toml" "$kept"

# the same file, trusted through `trusted_config_paths` at the target as well
write_tasks "$base/shared/mise.toml"
MISE_TRUSTED_CONFIG_PATHS="$base/project:$base/shared" MISE_YES=1 mise tasks rm a b
assert "grep '^\[tasks' $base/shared/mise.toml" "$kept"

# a linked `.config/mise` directory
write_tasks "$base/shared-dir/mise/config.toml"
ln -s "$base/shared-dir/mise" "$base/dir-project/.config/mise"
cd "$base/dir-project" || exit 1
MISE_TRUSTED_CONFIG_PATHS="$base/dir-project" MISE_YES=1 mise tasks rm a b
assert "grep '^\[tasks' $base/shared-dir/mise/config.toml" "$kept"
