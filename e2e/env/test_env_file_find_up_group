#!/usr/bin/env bash

# Separate `_.file` find_up entries each search the whole tree up from the config root, in the order listed, so a parent's
# later-listed file beats a closer earlier-listed one. One entry with a `path` list searches the
# names together, directory by directory: the closest directory wins, and within one directory a
# later name wins.
mkdir -p workspace/project
printf 'EXAMPLE=parent-local\nONLY_PARENT_LOCAL=1\n' >workspace/.env.local
printf 'EXAMPLE=parent\nONLY_PARENT=1\n' >workspace/.env
printf 'EXAMPLE=project\nONLY_PROJECT=1\n' >workspace/project/.env
printf 'EXAMPLE=abs\nONLY_ABS=1\n' >workspace/abs.env
cd workspace/project || exit 1

cat >mise.toml <<'TOML'
[env]
_.file = [
  { path = ".env", find_up = true },
  { path = ".env.local", find_up = true },
]
TOML
assert_contains "mise env --dotenv" "EXAMPLE=parent-local"

cat >mise.toml <<'TOML'
[env]
_.file = { path = [".env", ".env.local"], find_up = true }
TOML
assert_contains "mise env --dotenv" "EXAMPLE=project"
assert_contains "mise env --dotenv" "ONLY_PARENT_LOCAL=1"
assert_contains "mise env --dotenv" "ONLY_PROJECT=1"
assert_contains "mise env --dotenv" "ONLY_PARENT=1"

# Within one directory a later name wins.
printf 'EXAMPLE=project-local\n' >.env.local
assert_contains "mise env --dotenv" "EXAMPLE=project-local"
rm .env.local

# The group works as one item of a longer list, and a later entry still overrides it.
cat >mise.toml <<TOML
[env]
_.file = [
  { path = [".env", ".env.local"], find_up = true },
  "$PWD/../abs.env",
]
TOML
assert_contains "mise env --dotenv" "EXAMPLE=abs"
assert_contains "mise env --dotenv" "ONLY_PROJECT=1"

# An absolute path ends a group: the names before and after it are searched as separate groups,
# in list order, so a later name beats the absolute file and an earlier one loses to it.
cat >mise.toml <<TOML
[env]
_.file = { path = ["$PWD/../abs.env", ".env"], find_up = true }
TOML
assert_contains "mise env --dotenv" "EXAMPLE=project"
cat >mise.toml <<TOML
[env]
_.file = { path = [".env", "$PWD/../abs.env"], find_up = true }
TOML
assert_contains "mise env --dotenv" "EXAMPLE=abs"
# ...even when the later name is only found in a parent directory.
mv .env .env.hidden
cat >mise.toml <<TOML
[env]
_.file = { path = ["$PWD/../abs.env", ".env"], find_up = true }
TOML
assert_contains "mise env --dotenv" "EXAMPLE=parent"
mv .env.hidden .env

# A name listed twice loads at its last position, so it still wins over names listed between.
printf 'EXAMPLE=local\n' >.env.local
cat >mise.toml <<'TOML'
[env]
_.file = { path = [".env", ".env.local", ".env"], find_up = true }
TOML
assert_contains "mise env --dotenv" "EXAMPLE=project"
rm .env.local

# Every occurrence still loads in order, so a file between two loads of the same file can expand
# values from the earlier one.
mkdir -p repeated
# shellcheck disable=SC2016
printf 'BASE=/opt/app\nAFTER=$OUTPUT\n' >repeated/base.env
# shellcheck disable=SC2016
printf '{"OUTPUT": "$BASE/out"}\n' >repeated/derived.json
cat >repeated/mise.toml <<'TOML'
[env]
_.file = { path = ["base.env", "derived.json", "base.env"], find_up = true, expand = true }
TOML
assert_contains "cd repeated && mise env --dotenv" "OUTPUT=/opt/app/out"
# Only the second load of base.env can see OUTPUT, which derived.json set in between.
assert_contains "cd repeated && mise env --dotenv" "AFTER=/opt/app/out"

# A templated name resolves after the files listed before it, so it can use their values.
mkdir -p staged
printf 'STAGE=dev\n' >staged/.env
printf 'FROM_DEV=1\n' >staged/dev.env
cat >staged/mise.toml <<'TOML'
[env]
_.file = { path = [".env", "{{ env.STAGE }}.env"], find_up = true }
TOML
assert_contains "cd staged && mise env --dotenv" "FROM_DEV=1"

# Without find_up a path list loads its files in the order written, relative to the config.
cat >mise.toml <<'TOML'
[env]
_.file = { path = [".env", "extra.env"] }
TOML
printf 'EXAMPLE=extra\n' >extra.env
assert_contains "mise env --dotenv" "EXAMPLE=extra"
rm mise.toml

# An absolute path with `..` starts at the directory it names, so it never visits the directories
# it climbed out of: project/.env is below workspace and is not searched.
cat >mise.toml <<TOML
[env]
_.file = { path = "$PWD/../.env", find_up = true }
TOML
assert_contains "mise env --dotenv" "ONLY_PARENT=1"
assert_not_contains "mise env --dotenv" "ONLY_PROJECT"
