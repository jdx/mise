#!/usr/bin/env bash
# [env] _.source uses unix_default_inline_shell_args on Unix.
# See https://github.com/jdx/mise/discussions/6095
require_cmd fish

mkdir -p "$HOME/.config/fish/functions"
cat >"$HOME/.config/fish/functions/hello.fish" <<'EOF'
function hello
    echo $argv
end
EOF

assert "fish -c 'hello mise'" "mise"

cat >script.fish <<'EOF'
set -gx MY_BUILD_VALUE (hello mise)
EOF

cat >mise.toml <<'EOF'
[env]
_.source = "./script.fish"
EOF

# Default inline shell is `sh -c -o errexit`, so a fish script fails to source.
assert_fail "mise env --json"

assert_json_partial_object "MISE_UNIX_DEFAULT_INLINE_SHELL_ARGS='fish -c' mise env --json" "MY_BUILD_VALUE" '{
  "MY_BUILD_VALUE": "mise"
}'
