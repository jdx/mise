#!/usr/bin/env bash
# [env] _.source shell is per-directive so a shared mise.toml can source fish.
# See https://github.com/jdx/mise/discussions/6095
require_cmd fish

mkdir -p "$HOME/.config/fish/functions"
cat >"$HOME/.config/fish/functions/hello.fish" <<'EOF'
function hello
    echo $argv
end
EOF

assert "fish -c 'hello mise'" "mise"

cat >script.fish <<'EOF'
set -gx MY_BUILD_VALUE (hello mise)
EOF

cat >mise.toml <<'EOF'
[env]
_.source = "./script.fish"
EOF

# String form still uses bash, so fish `set -gx` is not imported.
assert_not_contains "mise env --json" "MY_BUILD_VALUE"

# `shell` belongs on the directive so clones share the same behavior.
cat >mise.toml <<'EOF'
[env]
_.source = { path = "./script.fish", shell = "fish -c" }
EOF

assert_json_partial_object "mise env --json" "MY_BUILD_VALUE" '{
  "MY_BUILD_VALUE": "mise"
}'
