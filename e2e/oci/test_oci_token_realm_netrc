#!/usr/bin/env bash
# A registry names the token `realm` that mise asks after a Bearer challenge,
# and is sent the token that comes back. The request to the realm carries the
# registry login or nothing, never the netrc login of the host the realm names.

export MISE_EXPERIMENTAL=1

cat >"$HOME/serve.py" <<'PY'
import http.server, sys

class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path.startswith("/token"):
            # another host's token service, reached as `localhost`
            login = "login" if self.headers.get("Authorization") else "anonymous"
            with open(sys.argv[2], "a") as f:
                f.write(login + "\n")
            body = b'{"token":"t"}'
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        # the registry, reached as `127.0.0.1`: it serves no image
        if self.headers.get("Authorization"):
            self.send_response(404)
        else:
            realm = "http://localhost:%d/token" % self.server.server_port
            self.send_response(401)
            self.send_header("WWW-Authenticate", 'Bearer realm="%s",service="registry"' % realm)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def log_message(self, *a):
        pass

s = http.server.HTTPServer(("127.0.0.1", 0), H)
with open(sys.argv[1] + ".tmp", "w") as f:
    f.write(str(s.server_port))
import os
os.rename(sys.argv[1] + ".tmp", sys.argv[1])
s.serve_forever()
PY

python3 "$HOME/serve.py" "$HOME/port" "$HOME/token-requests" &
server_pid=$!
trap 'kill $server_pid 2>/dev/null' EXIT
for _ in $(seq 100); do
  [ -s "$HOME/port" ] && break
  sleep 0.1
done
port=$(cat "$HOME/port")

cat >"$HOME/netrc" <<NETRC
machine localhost
  login alice
  password secret
NETRC
chmod 600 "$HOME/netrc"
export MISE_NETRC_FILE="$HOME/netrc"

cat >mise.toml <<TOML
[tools]
TOML

assert_fail_contains "mise oci build --no-mise --from 127.0.0.1:$port/public/base:latest" "404"
assert "sort -u $HOME/token-requests" "anonymous"
