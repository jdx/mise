#!/usr/bin/env bash
# `mise prune --system` removes unused versions from the system installs
# directory, and `mise upgrade` cleans up the system version it replaced.
# https://github.com/jdx/mise/issues/15932

export MISE_SYSTEM_DATA_DIR="$HOME/.local/share/mise-system"
system_installs="$MISE_SYSTEM_DATA_DIR/installs"
user_installs="$MISE_DATA_DIR/installs"

mise install --system dummy@1.0.0 tiny@1.0.0 tiny@2.1.0
mise install tiny@1.1.0

cat >mise.toml <<'EOF'
[tools]
tiny = "2"
EOF

# A plain prune only looks at the user's own installs.
output="$(mise prune --dry-run --tools 2>&1)"
[[ $output == *"tiny@1.1.0"* ]] || fail "user install was not in prune plan: $output"
[[ $output != *"dummy@1.0.0"* ]] || fail "plain prune planned a system install: $output"
[[ $output != *"tiny@1.0.0"* ]] || fail "plain prune planned a system install: $output"

# --system plans unused system versions, keeps the configured one and leaves
# the user's installs alone.
output="$(mise prune --system --dry-run 2>&1)"
[[ $output == *"dummy@1.0.0"* ]] || fail "unused system install was not in prune plan: $output"
[[ $output == *"tiny@1.0.0"* ]] || fail "unused system install was not in prune plan: $output"
[[ $output != *"tiny@2.1.0"* ]] || fail "configured system install was in prune plan: $output"
[[ $output != *"tiny@1.1.0"* ]] || fail "user install was in system prune plan: $output"
assert_contains "mise prune --system --dry-run 2>&1" "other users must reinstall"

assert_fail "mise prune --system --configs"

mise prune --system
assert_fail "test -d '$system_installs/dummy/1.0.0'"
assert_fail "test -d '$system_installs/tiny/1.0.0'"
assert_directory_exists "$system_installs/tiny/2.1.0"
assert_directory_exists "$user_installs/tiny/1.1.0"
assert "readlink $system_installs/tiny/latest" "./2.1.0"
assert_fail "test -L '$system_installs/tiny/1'"

# Upgrading a system install schedules the replaced version for removal like a
# user install, instead of dropping the receipt.
cat >mise.toml <<'EOF'
[tools]
dummy = "1"

[settings]
upgrade.prune_after = "0s"
EOF
mise install --system dummy@1.0.0
mise upgrade dummy
assert_directory_exists "$system_installs/dummy/1.1.0"
assert_directory_exists "$system_installs/dummy/1.0.0"
output="$(mise current dummy 2>&1)"
[[ $output != *"ignoring tool purgatory entry"* ]] || fail "system receipt was dropped: $output"
assert_fail "test -d '$system_installs/dummy/1.0.0'"
assert_directory_exists "$system_installs/dummy/1.1.0"
