#!/usr/bin/env bash
# A link deployed from a linked worktree must point at the main checkout.
require_cmd git
root="$(pwd -P)"
export MISE_HISTORY_ENABLED=0
main="$root/main"
worktree="$root/linked"
git init -q "$main"
mkdir -p "$main/nested" "$main/files"
printf 'main\n' >"$main/files/value"
printf 'ordinary\n' >"$main/nested/ordinary"
printf 'absolute\n' >"$root/absolute"
cat <<EOF2 >"$main/nested/mise.toml"
[dotfiles]
"~/.persistent" = { mode = "symlink-main", source = "files/value", relative = false }
"~/.ordinary" = "ordinary"
"~/.absolute" = { mode = "symlink", source = "$root/absolute", relative = false }
EOF2
commit() {
  git -C "$1" -c user.name=Test -c user.email=test@example.test -c commit.gpgsign=false commit -qm init
}
git init -q "$root/submodule-source"
printf '[dotfiles]\n"~/.bad-submodule" = { mode = "symlink-main", source = "files/value" }\n' >"$root/submodule-source/mise.toml"
git -C "$root/submodule-source" add .
commit "$root/submodule-source"
git -C "$main" -c protocol.file.allow=always submodule add -q "$root/submodule-source" module
git -C "$main" add .
commit "$main"
git -C "$main" worktree add --quiet --detach "$worktree" HEAD
printf 'linked\n' >"$worktree/files/value"
assert_contains "cd '$worktree/nested' && mise bootstrap dotfiles apply --dry-run" "main/files/value"
assert_fail 'test -L ~/.persistent'
assert_succeed "cd '$worktree/nested' && mise bootstrap dotfiles apply --yes"
assert 'readlink ~/.persistent' "$main/files/value"
assert 'cat ~/.persistent' 'main'
assert 'cat ~/.ordinary' 'ordinary'
assert 'readlink ~/.absolute' "$root/absolute"
git -C "$main" worktree remove --force "$worktree"
assert 'cat ~/.persistent' 'main'

# A global config installed as a symlink still finds the declaring checkout
# from an unrelated directory, and a canonical source is never a glob.
mkdir -p "$main/standalone" "$root/unrelated"
git init -q "$main/standalone"
printf 'standalone\n' >"$main/standalone/value"
printf 'literal\n' >"$main/files/value[12]"
printf 'decoy\n' >"$main/files/value1"
ln -s 'value[12]' "$main/files/alias"
cat <<EOF2 >"$main/mise.global.toml"
[dotfiles]
"~/.literal" = { mode = "symlink-main", source = "files/alias", relative = false }
"~/.standalone" = { mode = "symlink-main", source = "standalone/value" }
"~/.ordinary-glob" = { mode = "symlink", source = "ordinary-value*", relative = false }
EOF2
printf 'adjacent\n' >"$MISE_CONFIG_DIR/ordinary-value1"
global_config="$MISE_CONFIG_DIR/config.toml"
ln -s "$main/mise.global.toml" "$global_config"
assert_contains "cd '$root/unrelated' && mise dotfiles apply --dry-run" 'value[12]'
assert_fail 'test -L ~/.literal'
assert_succeed "cd '$root/unrelated' && mise dotfiles apply --yes"
assert 'readlink ~/.literal' "$main/files/value[12]"
assert 'cat ~/.literal' 'literal'
assert 'cat ~/.standalone' 'standalone'
assert 'cat ~/.ordinary-glob' 'adjacent'
rm "$global_config"

# Escape, spelling, and missing-source checks run in both planning and apply.
ln -s "$root/absolute" "$main/escape"
git -C "$main" worktree add --quiet --detach "$main/inner-worktree" HEAD
git init -q "$main/inner-worktree/vendor"
printf 'disposable\n' >"$main/inner-worktree/vendor/value"
cat <<EOF2 >"$main/nested/mise.toml"
[dotfiles]
"~/.bad-escape" = { mode = "symlink-main", source = "escape" }
"~/.bad-parent" = { mode = "symlink-main", source = "../absolute" }
"~/.bad-missing" = { mode = "symlink-main", source = "missing" }
"~/.bad-inner" = { mode = "symlink-main", source = "inner-worktree/files/value" }
"~/.bad-inner-vendor" = { mode = "symlink-main", source = "inner-worktree/vendor/value" }
EOF2
for flags in --dry-run --yes; do
  assert_contains "cd '$main/nested' && mise dotfiles apply $flags 2>&1" 'leads outside the checkout'
  assert_contains "cd '$main/nested' && mise dotfiles apply $flags 2>&1" 'requires a literal checkout-relative source'
  assert_contains "cd '$main/nested' && mise dotfiles apply $flags 2>&1" 'cannot resolve main checkout source'
  assert_contains "cd '$main/nested' && mise dotfiles apply $flags 2>&1" 'inner-worktree/files/value is inside a linked worktree'
  assert_contains "cd '$main/nested' && mise dotfiles apply $flags 2>&1" 'inner-worktree/vendor/value is inside a linked worktree'
done
assert_fail 'test -L ~/.bad-escape'
assert_fail 'test -L ~/.bad-parent'
assert_fail 'test -L ~/.bad-missing'
assert_fail 'test -L ~/.bad-inner'
assert_fail 'test -L ~/.bad-inner-vendor'

mkdir "$root/no-checkout"
printf '[dotfiles]\n"~/.bad-root" = { mode = "symlink-main", source = "file" }\n' >"$root/no-checkout/mise.toml"
assert_contains "cd '$root/no-checkout' && mise dotfiles apply --dry-run 2>&1" 'found no main Git checkout'
assert_fail 'test -L ~/.bad-root'

# Do not fall through from a submodule to its superproject, or mistake a
# bare repository's common Git directory for a checkout.
assert_contains "cd '$main/module' && mise dotfiles apply --dry-run 2>&1" 'found no main Git checkout'
assert_fail 'test -L ~/.bad-submodule'
git clone -q --bare "$main" "$root/bare"
git --git-dir="$root/bare" worktree add --quiet --detach "$root/bare-linked" HEAD
assert_contains "cd '$root/bare-linked/nested' && mise dotfiles apply --dry-run 2>&1" 'found no main Git checkout'
