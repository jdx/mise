#!/usr/bin/env bash
# A version named on the command line carries no install options, so under the
# identity install layout it can mean an installation a configuration made with
# options. `mise where` uses one such installation when it is the only one, and
# lists them instead of guessing when there are several.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity
work="$PWD"

mkdir env opt
cat >env/mise.toml <<'EOF2'
[tools]
dummy = { version = "2.0.0", install_env = { DUMMY_VARIANT = "musl" } }
EOF2
cat >opt/mise.toml <<'EOF2'
[tools]
dummy = { version = "2.0.0", flavor = "full" }
EOF2

echo "=== the only installation of the version is found ==="
assert "mise -C $work/env install"
env_dir="$(mise -C "$work/env" where dummy)"
assert "mise where dummy@2.0.0" "$env_dir"

echo "=== several are listed, not guessed between ==="
assert "mise -C $work/opt install"
opt_dir="$(mise -C "$work/opt" where dummy)"
assert_fail "mise where dummy@2.0.0" "installed with several sets of options"
assert_fail "mise where dummy@2.0.0" "$(basename "$opt_dir")"
assert_fail "mise where dummy@2.0.0" "$(basename "$env_dir")"

echo "=== naming the options finds the variant ==="
assert "mise where 'dummy[flavor=full]@2.0.0'" "$opt_dir"
assert "mise -C $work/opt where dummy@2.0.0" "$opt_dir"

echo "=== a lone variant stands for the bare version in every command ==="
mkdir solo
cat >solo/mise.toml <<'EOF2'
[tools]
dummy = { version = "1.0.0", flavor = "full" }
EOF2
assert "mise -C $work/solo install"
solo_dir="$(mise -C "$work/solo" where dummy)"
assert "mise where dummy@1.0.0" "$solo_dir"
assert "mise bin-paths dummy@1.0.0 | xargs realpath" "$(realpath "$solo_dir/bin")"
assert "mise which dummy --tool dummy@1.0.0 | xargs realpath" "$(realpath "$solo_dir/bin/dummy")"
assert_contains "mise x dummy@1.0.0 -- dummy" "This is Dummy 1.0.0!"
assert_contains "mise install dummy@1.0.0 2>&1" "already installed"
assert "test \"\$(mise installs ls dummy --json | jq '[.[] | select(.version == \"1.0.0\")] | length')\" -eq 1"
# a forced install of the bare version makes its own installation, which it then uses
assert "mise install --force dummy@1.0.0"
assert "test \"\$(mise installs ls dummy --json | jq '[.[] | select(.version == \"1.0.0\")] | length')\" -eq 2"
plain_dir="$(mise where dummy@1.0.0)"
[[ $plain_dir != "$solo_dir" ]] || fail "the bare version still resolves to the variant"
assert "mise -C $work/solo where dummy" "$solo_dir"

echo "=== a version named with options a configuration sets never stands in for another variant ==="
mkdir minimal
cat >minimal/mise.toml <<'EOF2'
[tools]
dummy = { version = "1.1.0", flavor = "minimal" }
EOF2
assert "mise -C $work/minimal install"
mkdir full
cat >full/mise.toml <<'EOF2'
[tools]
dummy = { version = "1.1.0", flavor = "full" }
EOF2
assert_fail "mise -C $work/full where dummy@1.1.0"
assert_fail "mise -C $work/full where dummy 1.1.0"
