#!/usr/bin/env bash

# Structured command examples reach both user-facing CLI help and mise's
# serialized usage specification. This builds the full command graph several
# times, so it belongs in E2E rather than the individually time-boxed units.
# shellcheck disable=SC2016
for command in activate run install env use; do
  assert_contains "mise $command --help" "Examples:"
done

mise usage >mise.usage.kdl
assert_contains "cat mise.usage.kdl" 'synopsis="[TASK] [ARGS]…"'
for example in \
  'eval "$(mise activate bash)"' \
  'mise run lint' \
  'mise install node@20.0.0' \
  'eval "$(mise env -s bash)"' \
  'mise use'; do
  assert_contains "cat mise.usage.kdl" "$example"
done
