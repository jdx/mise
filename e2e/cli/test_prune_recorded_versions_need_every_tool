#!/usr/bin/env bash
# A record for one templated tool of a config does not stand for the others: prune
# refuses until every templated tool of the config has been recorded.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[vars]
d = "1.0.0"
t = "2.0.0"' >project/mise.toml
echo '[tools]
dummy = "{{vars.d}}"
tiny = "{{vars.t}}"' >project/child/mise.toml
assert "mise -C project/child install"
# Leave a record that names only tiny, as one written by an earlier mise would.
claims="$(echo "$MISE_DATA_DIR"/installs/.mise/claims/*.toml)"
python3 - "$claims" <<'PY'
import re, sys
text = open(sys.argv[1]).read()
blocks = re.split(r"(?m)^(?=\[\[needs\]\])", text)
open(sys.argv[1], "w").write("".join(b for b in blocks if 'backend = "dummy"' not in b))
PY
assert_contains "cat '$claims'" 'backend = "tiny"'
assert_not_contains "cat '$claims'" 'backend = "dummy"'

assert_fail "mise -C elsewhere prune --yes" "no installation has been recorded"
assert_contains "mise ls dummy" "1.0.0"

# Using the project records the rest.
assert "mise -C project/child exec -- true"
assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e 'length == 0' prunable.json"
