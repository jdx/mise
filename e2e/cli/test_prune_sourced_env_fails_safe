#!/usr/bin/env bash

# A sourced script can set or override any key, so a template reading env next to
# one cannot be evaluated from another directory, even when a parent also sets
# the key. Prune must refuse rather than use the parent's value.
mkdir -p project/child elsewhere
echo 'export PRUNE_SOURCED_VERSION=1.0.0' >project/child/env.sh
echo '[env]
PRUNE_SOURCED_VERSION = "9.9.9"' >project/mise.toml
echo '[env]
_.source = "env.sh"
[tools]
dummy = "{{env.PRUNE_SOURCED_VERSION}}"' >project/child/mise.toml
assert "mise -C project/child install"
assert "mise install dummy@3.0.0"

assert_fail "mise -C elsewhere prune --yes"
assert_fail "mise -C elsewhere ls --prunable --json"
assert_contains "mise ls dummy" "1.0.0"
assert_contains "mise ls dummy" "3.0.0"
