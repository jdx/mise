#!/usr/bin/env bash

if [[ -z ${MISE_TEST_PITCHFORK:-} ]]; then
  echo "Skipping: set MISE_TEST_PITCHFORK to a build with proxy idle shutdown"
  exit 0
fi
cp "$MISE_TEST_PITCHFORK" ~/bin/pitchfork
export PATH="$HOME/bin:$PATH"
# Keep Unix socket paths within macOS sockaddr_un limits, including the
# random client socket names. This short external directory needs its own cleanup.
PITCHFORK_STATE_DIR=$(mktemp -d /tmp/mise-pf.XXXXXX)
export PITCHFORK_STATE_DIR
export PITCHFORK_CONFIG_DIR="$TMPDIR/pf-config"
export PITCHFORK_PROXY_IDLE_TIMEOUT=5s
export PITCHFORK_INTERVAL=500ms
export PITCHFORK_PROXY_ENABLE=true
export PITCHFORK_PROXY_HTTPS=false
export PITCHFORK_PROXY_DNS=false
export PITCHFORK_PROXY_SYNC_HOSTS=false
export PITCHFORK_PROXY_AUTO_TRUST=false
export PITCHFORK_PROXY_TLD=localhost
PITCHFORK_PROXY_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
export PITCHFORK_PROXY_PORT
trap 'pitchfork supervisor stop >/dev/null 2>&1 || true; rm -rf -- "$PITCHFORK_STATE_DIR"' EXIT

mkdir project
cd project
git init -q
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons_settings]
namespace = "proxy-test"
[daemons.prepare]
run = "echo ready > dependency-ready; exec sleep 600"
ready_cmd = "test -f dependency-ready"
[daemons.api]
run = "test -f dependency-ready && sleep 2 && exec python3 -m http.server $API_PORT --bind 127.0.0.1"
port = { auto = true, base = 35000 }
ready_cmd = "curl -fsS http://127.0.0.1:$API_PORT/proof"
depends = ["prepare"]
TOML
git add mise.toml
git -c user.name=test -c user.email=test@example.invalid commit -qm fixture
git worktree add -qb other ../other

# Register each checkout with mise, then leave the stack stopped. The API has
# never started: a proxy request must start its dependency from generated config.
for checkout in "$PWD" "$PWD/../other"; do
  (
    cd "$checkout"
    basename "$checkout" >proof
    mise daemons start prepare
    mise daemons stop
    mv dependency-ready dependency-before-stop
    url=$(mise env --json | jq -r .API_URL)
    hostport=${url#http://}
    assert_contains "curl --noproxy '*' -fsS --max-time 30 --resolve '$hostport:127.0.0.1' '$url/proof'" "$(basename "$checkout")"
    assert "test -f dependency-ready"
    assert_contains "mise daemons ls --json" '"status": "running"'
  )
done

# Both worktree URLs still resolve to their own process after the second starts.
first_url=$(mise env --json | jq -r .API_URL)
second_url=$(cd ../other && mise env --json | jq -r .API_URL)
assert "test '$first_url' != '$second_url'"
assert_contains "curl --noproxy '*' -fsS --resolve '${first_url#http://}:127.0.0.1' '$first_url/proof'" project
assert_contains "curl --noproxy '*' -fsS --resolve '${second_url#http://}:127.0.0.1' '$second_url/proof'" other

# Inactivity must stop both the API and its proxy-started dependency in each
# checkout. Poll status without sending traffic that would reset the idle timer.
wait_for_stopped() {
  local attempt
  for ((attempt = 0; attempt < 40; attempt++)); do
    if mise daemons ls --json | jq -e 'length == 2 and all(.[]; .status == "stopped")' >/dev/null; then
      return 0
    fi
    sleep 1
  done
  mise daemons ls --json
  return 1
}
export -f wait_for_stopped
for checkout in "$PWD" "$PWD/../other"; do
  (
    cd "$checkout"
    assert wait_for_stopped
    mv dependency-ready dependency-before-restart
    url=$(mise env --json | jq -r .API_URL)
    assert_contains "curl --noproxy '*' -fsS --max-time 30 --resolve '${url#http://}:127.0.0.1' '$url/proof'" "$(basename "$checkout")"
    assert "test -f dependency-ready"
    assert_contains "mise daemons ls --json" '"status": "running"'
  )
done

# Explicitly claiming a proxy-started stack keeps its dependency graph running.
mise daemons start api
sleep 8
assert "mise daemons ls --json | jq -e 'length == 2 and all(.[]; .status == \"running\")'"
