#!/usr/bin/env bash

# Per-entry `os` on brew and brew-cask packages: entries scoped to another
# platform are skipped but stay visible. Other managers reject table entries.

detect_platform
if [[ $MISE_PLATFORM_OS == "macos" ]]; then
  OTHER_OS="linux"
else
  OTHER_OS="macos"
fi
if [[ $MISE_PLATFORM_ARCH == "arm64" ]]; then
  OTHER_ARCH="x64"
else
  OTHER_ARCH="arm64"
fi

cat <<EOF >mise.toml
[bootstrap.packages]
"brew-cask:firefox" = { version = "latest", os = ["$OTHER_OS"] }
"brew:os-arch-elsewhere" = { version = "latest", os = ["$MISE_PLATFORM_OS/$OTHER_ARCH"] }
EOF

# OS-mismatched Homebrew entries render as skipped without querying brew.
assert_contains "mise bootstrap packages status" "skipped (os: $OTHER_OS)"
assert_contains "mise bootstrap packages status" "skipped (os: $MISE_PLATFORM_OS/$OTHER_ARCH)"
json_cmd="mise bootstrap packages status --json"
assert "$json_cmd | jq -r '.\"brew-cask\".packages[] | select(.package == \"firefox\") | .state'" "skipped"
assert "$json_cmd | jq -r '.\"brew-cask\".packages[] | select(.package == \"firefox\") | .reason'" "os mismatch"
assert "$json_cmd | jq -r '.\"brew-cask\".packages[] | select(.package == \"firefox\") | .os[0]'" "$OTHER_OS"
assert "$json_cmd | jq -r '.\"brew-cask\".packages[] | select(.package == \"firefox\") | .requested_version'" "latest"
assert "$json_cmd | jq -r '.\"brew-cask\".packages[] | select(.package == \"firefox\") | .installed_version | length'" "0"
assert_succeed "mise bootstrap packages status --missing"
assert_contains "mise bootstrap packages apply --dry-run --yes 2>&1" "brew-cask: 1 package(s) skipped (os mismatch)"
assert_contains "mise bootstrap plan" "skipped (os: $OTHER_OS)"

# Matching entries behave like plain entries when brew is available.
if command -v brew >/dev/null; then
  cat <<EOF >mise.toml
[bootstrap.packages]
"brew:jq" = { version = "latest", os = ["$MISE_PLATFORM_OS"] }
EOF
  assert_not_contains "mise bootstrap packages status" "skipped (os: $MISE_PLATFORM_OS)"
  assert_not "mise bootstrap packages status --json | jq -r '.brew.packages[] | select(.package == \"jq\") | .state'" "skipped"
fi

# Table entries are not accepted for non-Homebrew managers.
cat <<EOF >mise.toml
[bootstrap.packages]
"apt:curl" = { version = "latest", os = ["$MISE_PLATFORM_OS"] }
EOF
assert_contains "mise bootstrap packages status 2>&1" "table entries are supported only for brew and brew-cask"
assert "mise bootstrap packages status --json 2>/dev/null | jq length" "0"
