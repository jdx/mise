#!/usr/bin/env bash

# The hook-env fast path does not load settings. It applies hook_env.chpwd_only
# and hook_env.cache_ttl as the previous full run saved them in __MISE_SESSION.

assert_fast_path() {
  local output
  output=$(mise hook-env -s bash "$@")
  if [[ -z $output ]]; then
    ok "fast path taken for hook-env $*"
  else
    fail "expected the fast path for hook-env $* but got: '$output'"
  fi
}

assert_full_run() {
  local output
  output=$(mise hook-env -s bash "$@")
  if [[ $output == *"__MISE_SESSION"* ]]; then
    ok "full run for hook-env $*"
  else
    fail "expected a full run for hook-env $* but got: '$output'"
  fi
}

mkdir chpwd_only ttl

builtin cd chpwd_only
cat >mise.toml <<'EOF'
[settings]
hook_env.chpwd_only = true
EOF
eval "$(mise activate bash)"
export __MISE_ZSH_PRECMD_RUN=1
sleep 1
# The directory changed, but chpwd_only skips that check before a prompt.
touch new-file
assert_fast_path --reason precmd
assert_full_run --reason chpwd

builtin cd ../ttl
unset __MISE_SESSION __MISE_ZSH_PRECMD_RUN
cat >mise.toml <<'EOF'
[settings]
hook_env.cache_ttl = "1h"
EOF
eval "$(mise activate bash)"
sleep 1
# Within the TTL, the filesystem checks are skipped entirely.
touch new-file
assert_fast_path
