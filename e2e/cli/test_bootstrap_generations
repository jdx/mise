#!/usr/bin/env bash
# `mise bootstrap generations`: the operations bootstrap recorded, as a view
# over `mise history`. Every mutating bootstrap command records a pair of
# checkpoints (before and after) with a journal of what the run changed.

require_cmd git

count="mise history --json -n 0 | jq length"

mkdir -p "$MISE_CONFIG_DIR/dotfiles"
echo "alias ll='ls -l'" >"$MISE_CONFIG_DIR/dotfiles/zshrc"
echo one >"$MISE_CONFIG_DIR/dotfiles/copied"
cat <<'EOF2' >"$MISE_CONFIG_DIR/config.toml"
[dotfiles]
"~/.zshrc" = "dotfiles/zshrc"
"~/.copied" = { source = "dotfiles/copied", mode = "copy" }
EOF2

# dry runs record nothing
assert_succeed "mise bootstrap dotfiles apply --dry-run"
assert_contains "mise bootstrap generations 2>&1" "no bootstrap operations recorded"

# the first apply records a before/outcome pair
assert_succeed "mise bootstrap dotfiles apply --yes"
assert "readlink ~/.zshrc" "$MISE_CONFIG_DIR/dotfiles/zshrc"
assert "$count" "2"
assert "mise bootstrap generations --json | jq -r '.[0] | \"\\(.id) \\(.operation.status) \\(.operation.command) \\(.tree.available)\"'" \
  "2 completed bootstrap dotfiles apply --yes true"
assert "mise bootstrap generations --json | jq length" "1"
# the journal records every path the run touched: prior state before, resulting state after
assert "mise bootstrap generations --json | jq -r '[.[0].operation.journal[] | select(.kind == \"path_changed\") | .path] | join(\" \")'" "$HOME/.zshrc $HOME/.copied"
assert "mise bootstrap generations --json | jq -r '.[0].operation.journal[0].prior.state, .[0].operation.journal[1].after.state, .[0].operation.journal[3].after.state'" $'missing\nsymlink\nfile'
assert_contains "mise bootstrap generations show 2" "dotfiles: ~/.zshrc: ~/.zshrc missing -> a symlink to"
assert_contains "mise bootstrap generations show latest" "before checkpoint 1"
assert_contains "mise bootstrap generations show latest --files" "~/.config/mise/dotfiles/copied"
assert_fail "mise bootstrap generations show 99" "no history checkpoint 99"
assert_fail "mise bootstrap generations show 1" "not a bootstrap operation"

# a run that changes nothing leaves nothing behind
assert_succeed "mise bootstrap dotfiles apply --yes"
assert "$count" "2"

# a change to a source is a new pair; the edit happened before the run, so it
# shows between the pairs rather than within the run
echo two >"$MISE_CONFIG_DIR/dotfiles/copied"
echo added >"$MISE_CONFIG_DIR/dotfiles/added"
assert_succeed "mise bootstrap dotfiles apply --yes"
assert "cat ~/.copied" "two"
assert "$count" "4"
# ids reserved by the no-op run are never reused
assert "mise bootstrap generations --json | jq -r '[.[].id] | join(\",\")'" "6,2"
assert "mise bootstrap generations show latest~1 --json | jq -r .id" "2"
assert_contains "mise bootstrap generations diff 2 6" "dotfiles/copied"
assert_contains "mise bootstrap generations diff 2 6 --patch" "+two"
assert_contains "mise bootstrap generations diff 2 6 --root config/dotfiles/copied --patch" "-one"
assert_contains "mise bootstrap generations diff 2 6 --root ~/.config/mise/dotfiles/copied --patch" "-one"
assert_contains "mise bootstrap generations diff 2 6 2>&1" "dotfiles: ~/.copied: ~/.copied a file (4 bytes) -> a file"
assert_contains "mise bootstrap generations diff 6 2 2>&1" "dotfiles: ~/.copied: ~/.copied a file (4 bytes) -> a file"
assert_not_contains "mise bootstrap generations diff 2 6 --no-journal 2>&1" "dotfiles: ~/.copied"
# within the run only the copied output changed
assert_contains "mise bootstrap generations diff 6" "home/.copied"
assert_fail "mise bootstrap generations diff 2 6 --exit-code"
assert_succeed "mise bootstrap generations diff 2 --exit-code --root config"
assert_fail "mise bootstrap generations diff 99" "no history checkpoint 99"
assert_fail "mise bootstrap generations diff 2 6 --root config/missing" "not in either snapshot"
assert_contains "mise bootstrap generations diff 2 6 --root config/dotfiles/added --patch" "+added"

# a full bootstrap run records one pair, not one per part
assert_succeed "mise bootstrap --yes --only dotfiles"
assert "$count" "4"
echo three >"$MISE_CONFIG_DIR/dotfiles/copied"
assert_succeed "mise bootstrap --yes --only dotfiles"
assert "$count" "6"
assert "mise bootstrap generations --json | jq -r '.[0].operation.command'" "bootstrap --yes --only dotfiles"
assert "mise bootstrap generations --json | jq -r '.[0].operation.parts | join(\",\")'" "dotfiles"

# edits, unapply, and add journal the files they touch, with the prior content kept
cat <<'EOF2' >>"$MISE_CONFIG_DIR/config.toml"
"~/.bashrc/activate" = { block = 'eval "$(mise activate bash)"' }
EOF2
echo 'export PS1=x' >~/.bashrc
assert_succeed "mise bootstrap dotfiles apply --yes"
assert "mise bootstrap generations --json | jq -r '[.[0].operation.journal[] | select(.kind == \"path_changed\") | .path] | join(\" \")'" "$HOME/.bashrc"
assert "mise bootstrap generations --json | jq -r '.[0].operation.journal[0].prior.state, .[0].operation.journal[0].prior.content.size, .[0].operation.journal[1].after.state'" $'file\n13\nfile'
assert "mise bootstrap generations --json | jq -r '.[0].operation.journal[0].prior.content.inline' | base64 -d" "export PS1=x"
assert_contains "mise bootstrap generations show latest" "dotfiles: ~/.bashrc: ~/.bashrc a file (13 bytes) -> a file"

assert_succeed "mise bootstrap dotfiles unapply --yes ~/.bashrc"
assert "cat ~/.bashrc" "export PS1=x"
assert "mise bootstrap generations --json | jq -r '.[0].operation.journal[0].kind, .[0].operation.journal[0].path, .[0].operation.journal[1].after.state'" $'path_changed\n'"$HOME/.bashrc"$'\nfile'

echo 'real file' >~/.newrc
assert_succeed "mise bootstrap dotfiles add --yes ~/.newrc"
assert "readlink ~/.newrc" "$HOME/.dotfiles/.newrc"
# the outcome covers what the run declared: the new source is in its snapshot
assert_contains "mise bootstrap generations show latest --files" "~/.dotfiles/.newrc"
assert_contains "mise bootstrap generations diff 2 latest --patch" "+real file"
assert "mise bootstrap generations --json | jq -r '[.[0].operation.journal[] | select(.kind == \"path_changed\") | .prior.state] | .[0:2] | join(\" \")'" "file missing"
assert "mise bootstrap generations --json | jq -r '.[0].operation.journal[0].prior.content.inline' | base64 -d" "real file"

# a symlink-each entry journals every link and its ownership state file
mkdir -p "$MISE_CONFIG_DIR/dotfiles/bin"
echo one >"$MISE_CONFIG_DIR/dotfiles/bin/one"
cat <<'EOF2' >>"$MISE_CONFIG_DIR/config.toml"
"~/.local/mybin" = { source = "dotfiles/bin", mode = "symlink-each" }
EOF2
assert_succeed "mise bootstrap dotfiles apply --yes"
assert "readlink ~/.local/mybin/one" "$MISE_CONFIG_DIR/dotfiles/bin/one"
assert "mise bootstrap generations --json | jq -r '[.[0].operation.journal[] | select(.kind == \"path_changed\") | .path | select(endswith(\"/one\") or endswith(\".toml\") or endswith(\"/mybin\"))] | length'" "3"
