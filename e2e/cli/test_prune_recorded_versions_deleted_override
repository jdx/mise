#!/usr/bin/env bash
# A child config that overrode a parent's templated tool is deleted. The directory
# context it defined cannot come back, so it must not keep blocking prune.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[vars]
d = "1.0.0"
t = "2.0.0"
[tools]
dummy = "{{vars.d}}"
tiny = "{{vars.t}}"' >project/mise.toml
echo '[tools]
tiny = "3.0.0"' >project/child/mise.toml
assert "mise -C project install"
assert "mise -C project/child install"
assert "mise install dummy@3.0.0"

rm project/child/mise.toml
assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e '[.dummy[].version] == [\"3.0.0\"] and [.tiny[].version] == [\"3.0.0\"]' prunable.json"

# Used only through the child, whose deletion retires its context: nothing then
# vouches for the parent as it is now, so prune refuses.
mkdir -p only/child
echo '[vars]
d = "1.0.0"
t = "2.0.0"
[tools]
dummy = "{{vars.d}}"
tiny = "{{vars.t}}"' >only/mise.toml
echo '[tools]
tiny = "2.0.0"' >only/child/mise.toml
assert "mise -C only/child install"
rm only/child/mise.toml
assert_fail "mise -C elsewhere prune --yes" "no installation has been recorded"
