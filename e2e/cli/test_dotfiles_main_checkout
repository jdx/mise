#!/usr/bin/env bash
# `main_checkout = true` links a source inside a linked Git worktree at the
# same path in the main checkout, so the link survives removing the worktree.
require_cmd git
export MISE_HISTORY_ENABLED=0
root="$(pwd -P)"
main="$root/main"
wt="$root/wt"
commit() {
  git -C "$1" -c user.name=Test -c user.email=test@example.test -c commit.gpgsign=false commit -qm init
}
git init -q "$main"
mkdir -p "$main/nested" "$main/files" "$main/tree"
echo main >"$main/files/value"
echo tree >"$main/tree/a"
ln -s value "$main/files/alias"
cat >"$main/nested/mise.toml" <<'TOML'
[dotfiles]
"~/.stable" = { source = "../files/value", main_checkout = true, relative = false }
"~/.tree" = { source = "../tree", mode = "symlink-each", main_checkout = true, relative = false }
"~/.plain" = { source = "../files/value", relative = false }
"~/.glob/*" = { source = "../tree/*", main_checkout = true, relative = false }
"~/.alias" = { source = "../files/alias", main_checkout = true, relative = false }
TOML
git -C "$main" add .
commit "$main"

# from the main checkout itself the source is linked as it is
assert_succeed "cd '$main/nested' && mise dot apply --yes"
assert "readlink ~/.stable" "$main/nested/../files/value"
rm -r ~/.stable ~/.tree ~/.plain ~/.glob ~/.alias

# from a linked worktree, preview and apply both name the main checkout,
# and an entry without the key still links into the worktree
git -C "$main" worktree add -q --detach "$wt" HEAD
echo linked >"$wt/files/value"
assert_contains "cd '$wt/nested' && mise dot apply --dry-run" "main/files/value ~/.stable"
assert_contains "cd '$wt/nested' && mise dot apply --dry-run" "main/tree/a ~/.glob/a"
assert_succeed "cd '$wt/nested' && mise dot apply --yes"
assert "readlink ~/.stable" "$main/files/value"
assert "readlink ~/.tree/a" "$main/tree/a"
assert "readlink ~/.glob/a" "$main/tree/a"
assert "readlink ~/.alias" "$main/files/alias"
assert "cat ~/.stable" "main"
assert "cat ~/.plain" "linked"

# the links survive removing the worktree
git -C "$main" worktree remove --force "$wt"
assert "cat ~/.stable" "main"
assert "cat ~/.tree/a" "tree"

# a source that exists only in the worktree is not linked into it
git -C "$main" worktree add -q --detach "$wt" HEAD
echo new >"$wt/files/new"
mkdir -p "$wt/missing"
cat >"$wt/missing/mise.toml" <<'TOML'
[dotfiles]
"~/.new" = { source = "../files/new", main_checkout = true }
TOML
assert_fail_contains "cd '$wt/missing' && mise dot apply --yes 2>&1" "main/files/new"
assert_fail "test -L ~/.new"

# a link in the main checkout that leads back into a worktree is refused
ln -s "$wt/files/value" "$main/files/back"
mkdir -p "$wt/back"
cat >"$wt/back/mise.toml" <<'TOML'
[dotfiles]
"~/.back" = { source = "../files/back", main_checkout = true }
"~/.hop" = { source = "../files/hop", main_checkout = true }
"~/.vendored" = { source = "../files/vendored", main_checkout = true }
TOML
# through a worktree to a file outside it, or into a repository nested in one
mkdir -p "$root/persistent" "$wt/vendor"
echo kept >"$root/persistent/value"
ln -s "$root/persistent/value" "$wt/files/forward"
ln -s "$wt/files/forward" "$main/files/hop"
git init -q "$wt/vendor"
echo vendored >"$wt/vendor/value"
ln -s "$wt/vendor/value" "$main/files/vendored"
assert_contains "cd '$wt/back' && mise dot apply --dry-run 2>&1" "files/back leads back into a linked Git worktree"
assert_contains "cd '$wt/back' && mise dot apply --dry-run 2>&1" "files/hop leads back into a linked Git worktree"
assert_contains "cd '$wt/back' && mise dot apply --dry-run 2>&1" "files/vendored leads back into a linked Git worktree"

# a source that climbs out of the worktree with .. is linked without it
mkdir -p "$wt/escape"
cat >"$wt/escape/mise.toml" <<'TOML'
[dotfiles]
"~/.escape" = { source = "../../persistent/value", main_checkout = true, relative = false }
TOML
assert_succeed "cd '$wt/escape' && mise dot apply --yes"
assert "readlink ~/.escape" "$root/persistent/value"

# a worktree of a bare repository has no main checkout
git clone -q --bare "$main" "$root/bare"
git --git-dir="$root/bare" worktree add -q --detach "$root/bare-wt" HEAD
assert_contains "cd '$root/bare-wt/nested' && mise dot apply --dry-run 2>&1" "has no main checkout to link to"

# only symlink modes take the key
mkdir -p "$root/copy"
echo copied >"$root/copy/value"
# schema: invalid
cat >"$root/copy/mise.toml" <<'TOML'
[dotfiles]
"~/.copied" = { source = "value", mode = "copy", main_checkout = true }
TOML
assert_contains "cd '$root/copy' && mise dot apply --dry-run 2>&1" 'main_checkout requires mode = "symlink" or "symlink-each"'
