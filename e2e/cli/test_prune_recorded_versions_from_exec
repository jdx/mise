#!/usr/bin/env bash
# A command that only uses installs (mise exec) records what the project resolved,
# so a version installed separately and later rendered by an edit is protected.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[vars]
v = "1.0.0"' >project/mise.toml
echo '[tools]
dummy = "{{vars.v}}"' >project/child/mise.toml
assert "mise -C project/child install"
assert "mise install dummy@2.0.0"

echo '[vars]
v = "2.0.0"' >project/mise.toml
assert "mise -C project/child exec -- true"

assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e '[.dummy[].version] == [\"1.0.0\"]' prunable.json"
