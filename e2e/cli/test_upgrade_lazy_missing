#!/usr/bin/env bash

# A lazy tool with nothing installed is waiting for its first run, not outdated.
# A bare `mise upgrade` leaves it alone, as a bare `mise install` does, and
# naming the tool installs it, as `mise install dummy` does. The dummy backend
# offers 1.0.0, 1.1.0, and 2.0.0.

mise uninstall dummy --all

# Missing and lazy: nothing to upgrade.
cat >"$MISE_CONFIG_DIR/config.toml" <<'EOF'
[tools]
dummy = { version = "latest", lazy = true, lazy_bins = ["dummy"] }
EOF
assert_not_contains "mise upgrade --dry-run 2>&1" "Would install"
assert_succeed "mise upgrade --dry-run-code"
mise upgrade
assert_empty "mise ls --installed dummy"

# The same for a lazy tool declared in system config, such as a distribution's
# defaults, and for `mise upgrade --global`.
rm "$MISE_CONFIG_DIR/config.toml"
cat >"$MISE_SYSTEM_DIR/config.toml" <<'EOF'
[tools]
dummy = { version = "latest", lazy = true, lazy_bins = ["dummy"] }
EOF
mise upgrade
mise upgrade --global
assert_empty "mise ls --installed dummy"

# A range doesn't list it as newer than the range allows, either.
cat >"$MISE_SYSTEM_DIR/config.toml" <<'EOF'
[tools]
dummy = { version = "1", lazy = true, lazy_bins = ["dummy"] }
EOF
upgrade_output=$(mise upgrade 2>&1)
assert_contains_text "$upgrade_output" "All tools are up to date"
assert_not_contains_text "$upgrade_output" "configured version ranges"
assert_empty "mise ls --installed dummy"

# Naming the tool installs it.
assert_contains "mise upgrade dummy --dry-run 2>&1" "Would install dummy@1.1.0"
mise upgrade dummy
assert_contains "mise ls --installed dummy" "1.1.0"

# Once installed, a bare upgrade moves it forward as before.
mise uninstall dummy --all
mise install dummy@1.0.0
mise upgrade --prune
assert_contains "mise ls --installed dummy" "1.1.0"
assert_not_contains "mise ls --installed dummy" "1.0.0"

# A missing tool without lazy still installs.
mise uninstall dummy --all
cat >"$MISE_SYSTEM_DIR/config.toml" <<'EOF'
[tools]
dummy = "latest"
EOF
mise upgrade
assert_contains "mise ls --installed dummy" "2.0.0"
