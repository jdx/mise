#!/usr/bin/env bash
export MISE_EXPERIMENTAL=1
export MISE_LOCKFILE=1

# The installation a version link names: the directory itself on the legacy
# layout, the installs/<label>-<hash> directory it links to on the identity one.
installation() {
  realpath "$MISE_DATA_DIR/installs/dummy/$1"
}

assert "mise use dummy@3.1.0"
assert "mise where dummy" "$(installation 3.1.0)"
assert "mise install dummy@2"
assert "mise where dummy@2" "$(installation 2.0.0)"
assert "mise where dummy@3" "$(installation 3.1.0)"
assert "mise alias set dummy my/dummy 3"
assert "mise install dummy@my/dummy"
assert "mise where dummy@my/dummy" "$(installation 3)"
assert "mise uninstall dummy@my/dummy"
assert_fail "mise where dummy@1111" "dummy@1111 not installed"

echo 'tools.dummy = "latest"' >mise.toml
cat <<EOF >mise.lock
[[tools.dummy]]
version = "3.0.0"
backend = "asdf:dummy"
EOF
assert "mise i"
assert "mise where dummy" "$(installation 3.0.0)"
