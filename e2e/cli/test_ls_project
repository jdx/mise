#!/usr/bin/env bash

export CLICOLOR=0

mise i dummy@{1.0.0,2.0.0}

# a version that a later file overrides is not listed, as with --no-global
mkdir -p layered
printf '[tools]\ndummy = "1.0.0"\n' >layered/mise.toml
printf '[tools]\ndummy = "2.0.0"\n' >layered/mise.local.toml
assert "cd layered && mise ls --project dummy --json | jq -r '.[] | select(.version==\"2.0.0\") | .active'" "true"
assert "cd layered && mise ls --project dummy --json | jq -r 'length'" "1"

# from inside a conf.d fragment folder, the project that owns it is found
mkdir -p frag/.mise/conf.d/team
printf '[tools]\ndummy = "2.0.0"\n' >frag/.mise/conf.d/team/mise.toml
assert "cd frag/.mise/conf.d/team && mise ls --project dummy --json | jq -r '.[] | select(.active) | .version'" "2.0.0"
