#!/usr/bin/env bash

export MISE_OFFLINE=1
export DAEMON_LOG="$PWD/pitchfork.log"
: >"$DAEMON_LOG"
cat >~/bin/pitchfork <<'SH'
#!/usr/bin/env bash
printf 'cwd=%s args=%s\n' "$PWD" "$*" >> "$DAEMON_LOG"
case "$1" in
  usage)
    if [[ ${OLD_PITCHFORK:-0} == 1 ]]; then echo 'cmd start {}'; else echo 'cmd config help="External files" {'; fi
    ;;
  status)
    # $2 is the daemon id. RUNNING_ID names one the supervisor still reports as
    # running, which is how a partial stop is simulated. STATUS_BROKEN stands
    # for a supervisor that fails for some other reason than not knowing the id.
    if [[ ${STATUS_BROKEN:-} == silent ]]; then
      exit 1
    elif [[ -n ${STATUS_BROKEN:-} ]]; then
      echo 'supervisor socket timed out' >&2
      exit 1
    elif [[ -n ${RUNNING_ID:-} && $2 == "$RUNNING_ID" ]]; then
      printf '{"status":"running","pid":4242}\n'
    else
      # What pitchfork says about an id it does not have, which is what makes
      # it safe to go ahead: it names the daemon.
      echo "daemon $2 not found" >&2
      exit 1
    fi
    ;;
  stop)
    # Pitchfork validating the whole list up front and refusing it: the failure
    # says nothing about whether the daemons it did know are stopped.
    if [[ -n ${STOP_FAILS:-} ]]; then
      echo "no such daemon $STOP_FAILS" >&2
      exit 1
    fi
    ;;
  supervisor) printf '{"status":"%s"}\n' "${SUPERVISOR_STATUS:-down}" ;;
  project) echo '[]' ;;
esac
SH
chmod u+x ~/bin/pitchfork
export PATH="$HOME/bin:$PATH"
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons]
postgres = "18"
redis = "8"
[daemons.analytics]
preset = "postgres"
version = "18"
port = 5433
[env]
PGPORT = "1234"
TOML
assert_fail_contains "mise daemons start nonexistent 2>&1" 'no matching project daemons'
assert_fail_contains "mise daemons start --force nonexistent 2>&1" 'no matching project daemons'
assert_fail_contains "mise daemons start postgres nonexistent 2>&1" 'no matching project daemons'
for action in start stop restart; do
  assert_fail_contains "mise daemons $action --group web 2>&1" 'use pitchfork directly'
  assert_fail_contains "mise daemons $action postgres --group=web 2>&1" 'use pitchfork directly'
done
assert "test ! -s '$DAEMON_LOG'"
assert_contains "mise daemons ls --json" '"preset": "postgres"'
assert_contains "mise env -s bash" 'PGPORT=1234'
assert_contains "mise env -s bash" 'redis://127.0.0.1:6379'
assert_not_contains "cat '$DAEMON_LOG'" 'config add'
assert_not_contains "cat '$DAEMON_LOG'" 'supervisor'
assert_contains "mise ls --json" 'mise.toml-daemon'
assert_contains "mise unuse postgres 2>&1" 'declared by [daemons]'
assert_contains "cat mise.toml" 'postgres = "18"'

cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.api]
run = "sleep 30"
ready_cmd = "echo {{ env.SOMETHING }}"
TOML
assert_fail "OLD_PITCHFORK=1 mise daemons start"
assert_contains "OLD_PITCHFORK=1 mise daemons start 2>&1 || true" 'external configuration support'
mise daemons start
assert_contains "cat '$DAEMON_LOG'" 'config add'
assert_contains "cat '$DAEMON_LOG'" '/api'
assert "test ! -f pitchfork.toml"
generated=$(find "$MISE_STATE_DIR/daemons" -name pitchfork.toml -print -quit)
assert_contains "cat '$generated'" 'mise = true'
assert_not_contains "cat '$generated'" 'MISE_ENV = ""'
assert_contains "cat '$generated'" '{{ env.SOMETHING }}'
mise daemons stop
assert_contains "cat '$DAEMON_LOG'" 'args=stop '
assert_fail "MISE_EXPERIMENTAL=0 mise daemons ls"
assert_fail "MISE_SAFE=1 mise daemons start"

cat >mise.toml <<'TOML'
[daemons]
unknown_preset = "1"
TOML
assert_contains "mise daemons ls 2>&1 || true" 'available presets: postgres, redis'
cat >mise.toml <<'TOML'
[daemons.bad]
version = "18"
TOML
assert_contains "mise daemons ls 2>&1 || true" 'requires preset'
cat >mise.toml <<'TOML'
[daemons.".."]
preset = "postgres"
version = "18"
TOML
assert_contains "mise daemons ls 2>&1 || true" 'invalid daemon name'

# Dry runs validate task-backed daemons without starting pitchfork.
cat >mise.toml <<'TOML'
[tasks.dev]
daemons = ["api"]
run = "echo dev"
[daemons.api]
task = "missing"
TOML
assert_fail_contains "mise run --dry-run dev 2>&1" 'daemon api runs unknown task "missing"'

# A task that requires daemons starts them through pitchfork before it runs, and
# the task the daemon supervises keeps its own depends.
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[tasks.dev]
daemons = ["api"]
run = "echo dev-ran"
[tasks.build]
run = "echo built"
[tasks."dev:core"]
depends = ["build"]
run = "echo core"
[daemons.api]
run = "sleep 30"
[daemons.core]
task = "dev:core"
TOML
: >"$DAEMON_LOG"
assert_contains "mise run dev" 'dev-ran'
assert_contains "cat '$DAEMON_LOG'" 'args=start '
assert_contains "cat '$DAEMON_LOG'" '/api'
assert_not_contains "cat '$DAEMON_LOG'" '/core'
generated=$(find "$MISE_STATE_DIR/daemons" -name pitchfork.toml -print -quit)
# The supervised task runs through plain `mise run`, so its depends still run;
# a marker in the daemon environment is what stops the recursion instead.
assert_not_contains "cat '$generated'" 'skip-deps'
assert_contains "cat '$generated'" 'MISE_DAEMON_TASK'
# The marker makes that nested run skip daemons rather than fail on them.
assert_contains "MISE_DAEMON_TASK=1 mise run dev" 'dev-ran'
: >"$DAEMON_LOG"
assert "test ! -s '$DAEMON_LOG'"
assert_contains "MISE_DAEMON_TASK=1 mise run dev" 'dev-ran'
assert "test ! -s '$DAEMON_LOG'"

# An unknown daemon name fails the run and `mise tasks validate`.
cat >mise.toml <<'TOML'
[tasks.dev]
daemons = ["nope"]
run = "echo dev"
TOML
assert_fail_contains "mise run dev 2>&1" 'not defined in [daemons]'
assert_fail_contains "mise tasks validate 2>&1" 'missing-daemon'

# Daemon names are templates, like task dependencies.
cat >mise.toml <<'TOML'
[vars]
db = "postgres"
[tasks.dev]
daemons = ["{{ vars.db }}"]
run = "echo dev"
[daemons]
postgres = "18"
TOML
assert_contains "mise tasks info dev" 'postgres'
assert_succeed "mise tasks validate"

# An empty daemon requirement is a no-op and does not require experimental mode.
cat >mise.toml <<'TOML'
[tasks.dev]
daemons = []
run = "echo dev"
TOML
assert_succeed "MISE_EXPERIMENTAL=0 mise run --dry-run dev"

# Preset tool requests obey their declaring configuration's lock policy.
cat >mise.toml <<'TOML'
[tool_config]
locked = true
[daemons]
postgres = "18"
TOML
assert_fail_contains "MISE_LOCKFILE=1 mise install --dry-run 2>&1" "tool_config.locked"

# The dashboard opens once in the current project, even with inherited daemons.
: >mise.toml
mkdir -p tui-parent/child
cd tui-parent
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.parent]
run = "sleep 30"
TOML
cd child
cat >mise.toml <<'TOML'
[daemons.child]
run = "sleep 30"
TOML
: >"$DAEMON_LOG"
SUPERVISOR_STATUS=up mise daemons tui -- --help
assert "test $(grep -c 'args=tui --help$' "$DAEMON_LOG") -eq 1"
assert_contains "cat '$DAEMON_LOG'" "cwd=$PWD args=tui --help"
assert_fail "mise daemons tui"

assert_fail "mise daemons tui parent"

# Updating a profile must persist ownership even if mise=false leaves the config unchanged.
mkdir -p "$HOME/profile-cache"
cd "$HOME/profile-cache"
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.api]
run = "sleep 30"
mise = false
auto = ["start"]
TOML
MISE_ENV=first mise daemons start
profile_state=$(find "$MISE_STATE_DIR/daemons" -name state.json -exec jq -r --arg root "$PWD" 'select(.root == $root) | input_filename' {} +)
unset __MISE_SESSION
MISE_ENV=second mise hook-env --shell-pid "$$" -s bash >"$TMPDIR/profile-hook"
assert_contains "jq -r '.profile[]' '$profile_state'" second

# Deleting a project leaves its daemon state behind until it is pruned explicitly.
mkdir -p "$HOME/live-project" "$HOME/doomed-project"
cd "$HOME/live-project"
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.api]
run = "sleep 30"
TOML
mise daemons start
live_state=$(find "$MISE_STATE_DIR/daemons" -name state.json -exec jq -r --arg root "$PWD" 'select(.root == $root) | input_filename' {} +)
assert_contains "mise daemons ls --json" '"data_size"'
assert_contains "mise daemons ls --json" "\"state_dir\": \"$(dirname "$live_state")\""

cd "$HOME/doomed-project"
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.db]
run = "sleep 30"
TOML
mise daemons start
doomed_state=$(find "$MISE_STATE_DIR/daemons" -name state.json -exec jq -r --arg root "$PWD" 'select(.root == $root) | input_filename' {} +)
doomed_dir=$(dirname "$doomed_state")
mkdir -p "$doomed_dir/data/db"
echo data >"$doomed_dir/data/db/file"
cd "$HOME"
rm -rf "$HOME/doomed-project"

# A dry run reports the deleted project without removing anything.
assert_contains "mise daemons prune --dry-run 2>&1" 'dryrun'
assert_contains "mise daemons prune --dry-run 2>&1" "$(basename "$doomed_dir")"
assert_contains "mise daemons prune --dry-run 2>&1" 'from deleted ~/doomed-project'
assert "test -f '$doomed_state'"

# Starting daemons elsewhere hints at the leftover state but never deletes it.
cd "$HOME/live-project"
assert_contains "mise daemons start 2>&1" 'mise daemons prune'
assert "test -f '$doomed_state'"

mise daemons prune --yes
# The data and the state are gone; the lock files that made the removal safe
# stay behind, and without state.json it is no longer an entry.
assert "test ! -f '$doomed_state'"
assert "test ! -d '$doomed_dir/data'"
assert "test ! -f '$doomed_dir/pitchfork.toml'"
assert "test -f '$live_state'"
assert_contains "mise daemons prune --yes 2>&1" 'no daemon state'

# State for a project that still exists is kept even with no daemons declared.
: >mise.toml
mise daemons prune --yes
assert "test -f '$live_state'"

# State whose absence could be an unmounted volume is never deleted by --yes.
mkdir -p "$HOME/mountish/project"
cd "$HOME/mountish/project"
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.db]
run = "sleep 30"
TOML
mise daemons start
ambiguous_state=$(find "$MISE_STATE_DIR/daemons" -name state.json -exec jq -r --arg root "$PWD" 'select(.root == $root) | input_filename' {} +)
cd "$HOME"
# Removing the project leaves its parent empty, which is what an unmounted
# mount point looks like, so mise cannot tell the two apart.
rm -rf "$HOME/mountish/project"
assert_contains "mise daemons prune --yes 2>&1" 'unmounted volume'
assert "test -f '$ambiguous_state'"

# A stop that pitchfork refuses must not let the data go while a daemon runs.
mkdir -p "$HOME/still-running"
cd "$HOME/still-running"
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.db]
run = "sleep 30"
TOML
mise daemons start
running_state=$(find "$MISE_STATE_DIR/daemons" -name state.json -exec jq -r --arg root "$PWD" 'select(.root == $root) | input_filename' {} +)
running_id=$(jq -r '.ids[0]' "$running_state")
cd "$HOME"
rm -rf "$HOME/still-running"
# The supervisor is up, the stop is refused for an id it has forgotten, and the
# remaining daemon is still running: the state must survive.
export SUPERVISOR_STATUS=up STOP_FAILS="gone/other" RUNNING_ID="$running_id"
assert_contains "mise daemons prune --yes 2>&1" 'is still running'
assert "test -f '$running_state'"

# A status pitchfork cannot answer is not an answer: the state stays.
unset RUNNING_ID
export STATUS_BROKEN=1
assert_contains "mise daemons prune --yes 2>&1" 'cannot check'
assert "test -f '$running_state'"
# A status that fails without saying anything is not an answer either.
export STATUS_BROKEN=silent
assert_contains "mise daemons prune --yes 2>&1" 'cannot check'
assert "test -f '$running_state'"
unset STATUS_BROKEN

# With nothing running any more, the same state prunes.
mise daemons prune --yes
assert "test ! -f '$running_state'"
unset SUPERVISOR_STATUS STOP_FAILS
