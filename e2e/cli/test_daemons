#!/usr/bin/env bash

export MISE_OFFLINE=1
export DAEMON_LOG="$PWD/pitchfork.log"
: >"$DAEMON_LOG"
cat >~/bin/pitchfork <<'SH'
#!/usr/bin/env bash
printf 'cwd=%s args=%s\n' "$PWD" "$*" >> "$DAEMON_LOG"
case "$1" in
  usage)
    if [[ ${OLD_PITCHFORK:-0} == 1 ]]; then echo 'cmd start {}'; else echo 'cmd config help="External files" {'; fi
    ;;
  status) exit 1 ;;
  supervisor) printf '{"status":"%s"}\n' "${SUPERVISOR_STATUS:-down}" ;;
  project) echo '[]' ;;
esac
SH
chmod u+x ~/bin/pitchfork
export PATH="$HOME/bin:$PATH"

# mise keeps each project's generated configuration in a state directory named
# after a hash of the project root, so the several projects this test sets up
# are indistinguishable by path and a bare `find` returns whichever one the
# filesystem happens to list first. state.json records the root it belongs to.
daemon_state_dir() {
  local requested="${1:-$PWD}" root state
  # mise records the physical path; bash keeps symlinks in $PWD.
  root=$(cd -- "$requested" >/dev/null && pwd -P) || fail "cannot resolve daemon root $requested"
  state=$(jq -r --arg root "$root" 'select(.root == $root) | input_filename' "$MISE_STATE_DIR"/daemons/*/state.json)
  test -n "$state" || fail "no daemon state directory for $root"
  # One root means one directory; anything else would put us back to picking one
  # arbitrarily, and a multi-line "$state" would silently build a garbled path.
  test "$(echo "$state" | wc -l)" -eq 1 || fail "several daemon state directories for $root: $state"
  echo "${state%/state.json}"
}
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons]
postgres = "18"
redis = "8"
[daemons.analytics]
preset = "postgres"
version = "18"
port = 5433
[env]
PGPORT = "1234"
TOML
assert_fail_contains "mise daemons start nonexistent 2>&1" 'no matching project daemons'
assert_fail_contains "mise daemons start --force nonexistent 2>&1" 'no matching project daemons'
assert_fail_contains "mise daemons start postgres nonexistent 2>&1" 'no matching project daemons'
for action in start stop restart status logs; do
  assert_fail_contains "mise daemons $action --group web 2>&1" 'no [daemon_groups] entry named'
  assert_fail_contains "mise daemons $action postgres --group=web 2>&1" 'no [daemon_groups] entry named'
done
assert "test ! -s '$DAEMON_LOG'"
assert_contains "mise daemons ls --json" '"preset": "postgres"'
assert_contains "mise env -s bash" 'PGPORT=1234'
assert_contains "mise env -s bash" 'redis://127.0.0.1:6379'
assert_not_contains "cat '$DAEMON_LOG'" 'config add'
assert_not_contains "cat '$DAEMON_LOG'" 'supervisor'
assert_contains "mise ls --json" 'mise.toml-daemon'
assert_contains "mise unuse postgres 2>&1" 'declared by [daemons]'
assert_contains "cat mise.toml" 'postgres = "18"'

cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.api]
run = "sleep 30"
ready_cmd = "echo {{ env.SOMETHING }}"
TOML
assert_fail "OLD_PITCHFORK=1 mise daemons start"
assert_contains "OLD_PITCHFORK=1 mise daemons start 2>&1 || true" 'external configuration support'
mise daemons start
assert_contains "cat '$DAEMON_LOG'" 'config add'
assert_contains "cat '$DAEMON_LOG'" '/api'
assert "test ! -f pitchfork.toml"
generated="$(daemon_state_dir)/pitchfork.toml"
assert_contains "cat '$generated'" 'mise = true'
assert_not_contains "cat '$generated'" 'MISE_ENV = ""'
assert_contains "cat '$generated'" '{{ env.SOMETHING }}'
mise daemons stop
assert_contains "cat '$DAEMON_LOG'" 'args=stop '
assert_fail "MISE_EXPERIMENTAL=0 mise daemons ls"
assert_fail "MISE_SAFE=1 mise daemons start"

# Groups expand to project daemons; pitchfork's own groups stay out of reach.
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.postgres]
run = "sleep 30"
[daemons.core]
run = "sleep 30"
[daemons.node0]
run = "sleep 30"
[daemons.core2]
run = "sleep 30"
[daemon_groups]
default = ["postgres", "core", "node0"]
two-cluster = ["default", "core2"]
TOML
: >"$DAEMON_LOG"
mise daemons start two-cluster
started=$(grep 'args=start ' "$DAEMON_LOG")
assert_contains "echo '$started'" '/postgres'
assert_contains "echo '$started'" '/core2'
generated="$(daemon_state_dir)/pitchfork.toml"
assert_contains "cat '$generated'" '[groups.two-cluster]'
assert_contains "cat '$generated'" '[groups.default]'
# A bare start selects the default group instead of every daemon.
: >"$DAEMON_LOG"
mise daemons start
started=$(grep 'args=start ' "$DAEMON_LOG")
assert_contains "echo '$started'" '/postgres'
assert_not_contains "echo '$started'" '/core2'
# --group accepts a declared group and rejects anything else.
: >"$DAEMON_LOG"
mise daemons stop --group two-cluster
assert_contains "cat '$DAEMON_LOG'" '/core2'
assert_fail_contains "mise daemons start --group backend 2>&1" 'no [daemon_groups] entry named'
assert_fail_contains "mise daemons start missing-group 2>&1" 'no matching project daemons'

# A bare start covers a project without a default group, even when an inherited
# project has one.
group_base=$PWD
mkdir -p group-parent/child
cd group-parent
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.parent-a]
run = "sleep 30"
[daemons.parent-b]
run = "sleep 30"
[daemon_groups]
default = ["parent-a"]
TOML
cd child
cat >mise.toml <<'TOML'
[daemons.child-a]
run = "sleep 30"
TOML
: >"$DAEMON_LOG"
mise daemons start
started=$(grep 'args=start ' "$DAEMON_LOG")
# The parent honors its own default group.
assert_contains "echo '$started'" '/parent-a'
assert_not_contains "echo '$started'" '/parent-b'
# The child declares none, so all of its daemons still start.
assert_contains "echo '$started'" '/child-a'
# restart uses the default group the same way; stop still covers everything.
: >"$DAEMON_LOG"
mise daemons restart
restarted=$(grep 'args=restart ' "$DAEMON_LOG")
assert_contains "echo '$restarted'" '/parent-a'
assert_not_contains "echo '$restarted'" '/parent-b'
: >"$DAEMON_LOG"
mise daemons stop
stopped=$(grep 'args=stop ' "$DAEMON_LOG")
assert_contains "echo '$stopped'" '/parent-b'
# A child redefining a daemon name takes it over: one process starts, under the
# child's namespace, and the parent keeps running the daemons it still owns.
mkdir -p "$group_base/override/child"
cd "$group_base/override"
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.postgres]
run = "parent postgres"
[daemons.api]
run = "parent api"
[daemon_groups]
default = ["postgres", "api"]
TOML
cd child
cat >mise.toml <<'TOML'
[daemons.postgres]
run = "child postgres"
TOML
: >"$DAEMON_LOG"
mise daemons start
parent_start=$(grep 'args=start ' "$DAEMON_LOG" | grep -v 'override/child ')
# The parent starts what it still owns, and not the name the child took over.
assert_contains "echo '$parent_start'" '/api'
assert_not_contains "echo '$parent_start'" '/postgres'
# The child runs the one postgres, under its own namespace.
child_start=$(grep 'args=start ' "$DAEMON_LOG" | grep 'override/child ')
assert_contains "echo '$child_start'" '/postgres'
# The generated parent configuration no longer defines the name it lost.
parent_conf="$(daemon_state_dir "$group_base/override")/pitchfork.toml"
assert_not_contains "cat '$parent_conf'" 'parent postgres'
cd "$group_base/group-parent/child"

# A removed group points at ls rather than failing silently.
assert_fail_contains "mise daemons stop --group gone 2>&1" 'mise daemons ls'
cd "$group_base"

cat >mise.toml <<'TOML'
[daemons.api]
run = "sleep 30"
[daemon_groups]
web = ["api", "missing"]
TOML
assert_contains "mise daemons ls 2>&1 || true" 'is not a daemon or group declared for'
cat >mise.toml <<'TOML'
[daemons.api]
run = "sleep 30"
[daemon_groups]
api = ["api"]
TOML
assert_contains "mise daemons ls 2>&1 || true" 'conflicts with the daemon of the same name'

cat >mise.toml <<'TOML'
[daemons]
unknown_preset = "1"
TOML
assert_contains "mise daemons ls 2>&1 || true" 'available presets: postgres, redis'
cat >mise.toml <<'TOML'
[daemons.bad]
version = "18"
TOML
assert_contains "mise daemons ls 2>&1 || true" 'requires preset'
cat >mise.toml <<'TOML'
[daemons.".."]
preset = "postgres"
version = "18"
TOML
assert_contains "mise daemons ls 2>&1 || true" 'invalid daemon name'

# Dry runs validate task-backed daemons without starting pitchfork.
cat >mise.toml <<'TOML'
[tasks.dev]
daemons = ["api"]
run = "echo dev"
[daemons.api]
task = "missing"
TOML
assert_fail_contains "mise run --dry-run dev 2>&1" 'daemon api runs unknown task "missing"'

# A task that requires daemons starts them through pitchfork before it runs, and
# the task the daemon supervises keeps its own depends.
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[tasks.dev]
daemons = ["api"]
run = "echo dev-ran"
[tasks.build]
run = "echo built"
[tasks."dev:core"]
depends = ["build"]
run = "echo core"
[daemons.api]
run = "sleep 30"
[daemons.core]
task = "dev:core"
TOML
: >"$DAEMON_LOG"
assert_contains "mise run dev" 'dev-ran'
assert_contains "cat '$DAEMON_LOG'" 'args=start '
assert_contains "cat '$DAEMON_LOG'" '/api'
assert_not_contains "cat '$DAEMON_LOG'" '/core'
generated="$(daemon_state_dir)/pitchfork.toml"
# The supervised task runs through plain `mise run`, so its depends still run;
# a marker in the daemon environment is what stops the recursion instead.
assert_not_contains "cat '$generated'" 'skip-deps'
assert_contains "cat '$generated'" 'MISE_DAEMON_TASK'
# The marker makes that nested run skip daemons rather than fail on them.
assert_contains "MISE_DAEMON_TASK=1 mise run dev" 'dev-ran'
: >"$DAEMON_LOG"
assert "test ! -s '$DAEMON_LOG'"
assert_contains "MISE_DAEMON_TASK=1 mise run dev" 'dev-ran'
assert "test ! -s '$DAEMON_LOG'"

# An unknown daemon name fails the run and `mise tasks validate`.
cat >mise.toml <<'TOML'
[tasks.dev]
daemons = ["nope"]
run = "echo dev"
TOML
assert_fail_contains "mise run dev 2>&1" 'not defined in [daemons]'
assert_fail_contains "mise tasks validate 2>&1" 'missing-daemon'

# Daemon names are templates, like task dependencies.
cat >mise.toml <<'TOML'
[vars]
db = "postgres"
[tasks.dev]
daemons = ["{{ vars.db }}"]
run = "echo dev"
[daemons]
postgres = "18"
TOML
assert_contains "mise tasks info dev" 'postgres'
assert_succeed "mise tasks validate"

# An empty daemon requirement is a no-op and does not require experimental mode.
cat >mise.toml <<'TOML'
[tasks.dev]
daemons = []
run = "echo dev"
TOML
assert_succeed "MISE_EXPERIMENTAL=0 mise run --dry-run dev"

# Preset tool requests obey their declaring configuration's lock policy.
cat >mise.toml <<'TOML'
[tool_config]
locked = true
[daemons]
postgres = "18"
TOML
assert_fail_contains "MISE_LOCKFILE=1 mise install --dry-run 2>&1" "tool_config.locked"

# The dashboard opens once in the current project, even with inherited daemons.
: >mise.toml
mkdir -p tui-parent/child
cd tui-parent
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.parent]
run = "sleep 30"
TOML
cd child
cat >mise.toml <<'TOML'
[daemons.child]
run = "sleep 30"
TOML
: >"$DAEMON_LOG"
SUPERVISOR_STATUS=up mise daemons tui -- --help
assert "test $(grep -c 'args=tui --help$' "$DAEMON_LOG") -eq 1"
assert_contains "cat '$DAEMON_LOG'" "cwd=$PWD args=tui --help"
assert_fail "mise daemons tui"

assert_fail "mise daemons tui parent"

# Updating a profile must persist ownership even if mise=false leaves the config unchanged.
mkdir -p "$HOME/profile-cache"
cd "$HOME/profile-cache"
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.api]
run = "sleep 30"
mise = false
auto = ["start"]
TOML
MISE_ENV=first mise daemons start
profile_state="$(daemon_state_dir)/state.json"
unset __MISE_SESSION
MISE_ENV=second mise hook-env --shell-pid "$$" -s bash >"$TMPDIR/profile-hook"
assert_contains "jq -r '.profile[]' '$profile_state'" second

# port = "auto" keeps the base port in an ordinary checkout and moves it in a
# linked worktree, and the resolved port must reach mise env, not pitchfork only.
mkdir -p "$HOME/auto-primary/.git"
cd "$HOME/auto-primary"
cat >mise.toml <<'TOML'
[tools]
pitchfork = "system"
[daemons.api]
run = "sleep 30"
[daemons.api.port]
auto = true
base = 3000
[daemons.db]
preset = "postgres"
version = "18"
port = "auto"
TOML
assert_contains "mise env -s bash" "API_PORT=3000"
assert_contains "mise env -s bash" "PGPORT=5432"

# A linked worktree of that checkout gets its own ports.
mkdir -p "$HOME/auto-primary/.git/worktrees/wt"
printf 'ref: refs/heads/main\n' >"$HOME/auto-primary/.git/HEAD"
printf '../..\n' >"$HOME/auto-primary/.git/worktrees/wt/commondir"
mkdir -p "$HOME/auto-wt"
printf 'gitdir: %s\n' "$HOME/auto-primary/.git/worktrees/wt" >"$HOME/auto-wt/.git"
cp mise.toml "$HOME/auto-wt/mise.toml"
cd "$HOME/auto-wt"
wt_api=$(mise env -s bash | sed -n 's/^export API_PORT=//p' | tr -d "'\"")
wt_pg=$(mise env -s bash | sed -n 's/^export PGPORT=//p' | tr -d "'\"")
assert "test -n '$wt_api' && test '$wt_api' != 3000"
assert "test -n '$wt_pg' && test '$wt_pg' != 5432"
# Stable across invocations, and the daemon listing reports the same port.
assert "test \"\$(mise env -s bash | sed -n 's/^export API_PORT=//p' | tr -d \"'\\\"\")\" = '$wt_api'"
assert_contains "mise daemons ls --json | jq -r '.[] | select(.name == \"api\") | .port'" "$wt_api"
assert_contains "mise daemons ls --json | jq -r '.[] | select(.name == \"api\") | .port_auto'" "true"
