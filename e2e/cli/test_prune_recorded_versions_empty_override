#!/usr/bin/env bash
# `tiny = []` in a child adds no request, so the parent's templated tiny still applies
# there and must be recorded for real, not marked as overridden.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[vars]
d = "1.0.0"
t = "2.0.0"
[tools]
dummy = "{{vars.d}}"
tiny = "{{vars.t}}"' >project/mise.toml
echo '[tools]
tiny = []' >project/child/mise.toml
assert "mise -C project install"
assert "mise -C project/child install"
assert_not_contains "cat $MISE_DATA_DIR/installs/.mise/claims/*.toml" "overridden = true"

assert "mise install dummy@3.0.0"
assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e '[.dummy[].version] == [\"3.0.0\"] and (has(\"tiny\") | not)' prunable.json"
