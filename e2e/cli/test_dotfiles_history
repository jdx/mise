#!/usr/bin/env bash
# `mise bootstrap dotfiles history`: checkpoints of the tracked configuration files, saved
# explicitly and by every mutating bootstrap command.

require_cmd git

store="$MISE_STATE_DIR/history"
repo="$store/repo.git"

# assertions run in a subshell, so these are commands rather than functions
if [[ "$(uname -s)" == "Darwin" ]]; then
  mode_of="stat -f %Lp"
else
  mode_of="stat -c %a"
fi
count="mise bootstrap dotfiles history --json -n 0 | jq length"

mkdir -p "$MISE_CONFIG_DIR/dotfiles"
echo one >"$MISE_CONFIG_DIR/dotfiles/copied"
cat <<'EOF2' >"$MISE_CONFIG_DIR/config.toml"
[dotfiles]
"~/.copied" = { source = "dotfiles/copied", mode = "copy" }
EOF2

# nothing recorded yet; status explains how to save
assert_contains "mise bootstrap dotfiles history 2>&1" "no history checkpoints recorded"
assert_contains "mise bootstrap dotfiles status" "no checkpoint recorded yet"
assert_contains "mise bootstrap dotfiles paths" "~/.config/mise"

# an explicit save records checkpoint 1 with the config directory in it
assert_succeed "mise bootstrap dotfiles save --description first"
assert "$count" "1"
assert "$mode_of '$store'" "700"
assert "mise bootstrap dotfiles history --json | jq -r '.[0] | \"\\(.id) \\(.trigger) \\(.description) \\(.description_source) \\(.tree.available)\"'" \
  "1 save first user true"
assert "mise bootstrap dotfiles history show 1 --json | jq -r '.uuid | length'" "36"
first_uuid="$(mise bootstrap dotfiles history show 1 --json | jq -r .uuid)"
assert "mise bootstrap dotfiles history show 1 --json | jq -r '.machine.name | length > 0'" "true"
assert_contains "mise bootstrap dotfiles history show 1 --files" "~/.config/mise/dotfiles/copied"
assert_contains "mise bootstrap dotfiles history show latest" "Checkpoint 1 (save)"
assert_succeed "git --git-dir='$repo' rev-parse --verify -q 'refs/checkpoints/$(mise bootstrap dotfiles history show 1 --json | jq -r .uuid)'"
assert "git --git-dir='$repo' ls-tree --name-only 'refs/checkpoints/$(mise bootstrap dotfiles history show 1 --json | jq -r .uuid)' | tr '\n' ' '" "meta.json snapshot "

# saving again without changes records nothing; a change records a checkpoint whose
# computed description names the edited files
assert_contains "mise bootstrap dotfiles save 2>&1" "nothing changed"
assert "$count" "1"
echo two >"$MISE_CONFIG_DIR/dotfiles/copied"
assert_succeed "mise bootstrap dotfiles save"
assert "$count" "2"
assert "mise bootstrap dotfiles history --json | jq -r '.[0].description'" "edited mise/dotfiles/copied"
assert "mise bootstrap dotfiles history --json | jq -r '.[0].changes.since == (.[1].uuid)'" "true"
assert "mise bootstrap dotfiles history --json | jq -r '.[0].changes.modified | join(\",\")'" "~/.config/mise/dotfiles/copied"

# ls --path lists only checkpoints where the path changed; latest~N is scoped to them
echo three >"$MISE_CONFIG_DIR/dotfiles/copied"
assert_succeed "mise bootstrap dotfiles save --description noise"
echo '[settings]' >"$MISE_CONFIG_DIR/config.local.toml"
assert_succeed "mise bootstrap dotfiles save --description local"
assert "mise bootstrap dotfiles history --json --path ~/.config/mise/dotfiles/copied | jq -r '[.[].id] | join(\",\")'" "3,2,1"
assert "mise bootstrap dotfiles history show latest --path ~/.config/mise/dotfiles/copied --json | jq -r .id" "3"
assert "mise bootstrap dotfiles history show 'latest~1' --path ~/.config/mise/dotfiles/copied --json | jq -r .id" "2"
assert "mise bootstrap dotfiles history --json --trigger save | jq length" "4"

# diff: working tree vs latest, one checkpoint vs its predecessor, two checkpoints
echo four >"$MISE_CONFIG_DIR/dotfiles/copied"
assert_contains "mise bootstrap dotfiles history diff" "copied"
assert_contains "mise bootstrap dotfiles history diff --patch --path ~/.config/mise/dotfiles/copied" "+four"
assert_fail "mise bootstrap dotfiles history diff --exit-code"
assert_contains "mise bootstrap dotfiles history diff 2 --patch" "+two"
assert_contains "mise bootstrap dotfiles history diff 1 3 --patch --path ~/.config/mise/dotfiles/copied" "-one"
assert_contains "mise bootstrap dotfiles history diff 1 1 2>&1" "no differences"
assert_fail "mise bootstrap dotfiles history diff 99" "no history checkpoint 99"
assert_fail "mise bootstrap dotfiles history diff 1 2 --path ~/.config/mise/nope" "not in either snapshot"

# describe annotates a checkpoint without rewriting it
assert_succeed "mise bootstrap dotfiles history describe 2 'the second one'"
assert "mise bootstrap dotfiles history show 2 --json | jq -r '.description, .description_source'" $'the second one\nuser'
assert "git --git-dir='$repo' notes --ref refs/notes/mise-history show 'refs/checkpoints/$(mise bootstrap dotfiles history show 2 --json | jq -r .uuid)' | jq -r .description" "the second one"

# a mutating bootstrap command records a pair: before and outcome, linked
assert_succeed "mise bootstrap dotfiles apply --yes"
assert "cat ~/.copied" "four"
assert "mise bootstrap dotfiles history --json | jq -r '.[0].trigger, .[1].trigger'" $'bootstrap\nbootstrap-before'
assert "mise bootstrap dotfiles history --json | jq -r '.[0].operation.before == .[1].uuid'" "true"
assert "mise bootstrap dotfiles history --json | jq -r '.[0].operation | \"\\(.kind) \\(.status) \\(.command)\"'" "bootstrap completed bootstrap dotfiles apply --yes"
assert "mise bootstrap dotfiles history --json | jq -r '[.[0].operation.journal[] | select(.kind == \"path_changed\") | .path] | join(\" \")'" "$HOME/.copied"
# the copied destination is tracked as the output of its entry: the run changed it
assert "mise bootstrap dotfiles history --json | jq -r '.[0].changes.added | join(\",\")'" "~/.copied"
assert_contains "mise bootstrap dotfiles history show latest" "dotfiles: ~/.copied: ~/.copied missing -> a file"
assert "mise bootstrap dotfiles status --json | jq -r .history.checkpoints" "6"
# a run that changes nothing leaves no checkpoints behind
assert_succeed "mise bootstrap dotfiles apply --yes"
assert "$count" "6"

# retention keeps the newest checkpoints, pairs together, and a consistent repository
for i in 5 6 7; do
  echo "$i" >"$MISE_CONFIG_DIR/dotfiles/copied"
  assert_succeed "mise bootstrap dotfiles save"
done
assert "$count" "9"
echo eight >"$MISE_CONFIG_DIR/dotfiles/copied"
assert_succeed "MISE_HISTORY_KEEP_COUNT=3 mise bootstrap dotfiles save"
# explicit saves are pruned before operation pairs, and a pair goes together
assert "$count" "3"
# ids reserved by a no-op run are never reused, so numbering has gaps
assert "mise bootstrap dotfiles history --json | jq -r '[.[].id] | join(\",\")'" "12,6,5"
assert_fail "git --git-dir='$repo' rev-parse --verify -q 'refs/checkpoints/$first_uuid'"
assert_succeed "git --git-dir='$repo' fsck --no-progress"
assert "git --git-dir='$repo' for-each-ref refs/checkpoints | wc -l | tr -d ' '" "3"

# the index is a cache: rebuilt from the repository when missing (ids are
# local handles and start over; uuids and contents do not)
assert_succeed "mise bootstrap dotfiles history describe latest kept"
rm -r "$store/index"
assert "$count" "3"
assert "mise bootstrap dotfiles history --json | jq -r '[.[].id] | join(\",\")'" "3,2,1"
assert "mise bootstrap dotfiles history show 3 --json | jq -r '.description, .description_source'" $'kept\nuser'
assert "mise bootstrap dotfiles history show 2 --json | jq -r '.operation.status'" "completed"

# an operation that died is closed as failed by the next write (a save, a
# bootstrap, the watcher); reading the history changes nothing
uuid="$(mise bootstrap dotfiles history show 2 --json | jq -r .uuid)"
jq '{id: 99, checkpoint: (.uuid = "01000000-0000-7000-8000-000000000000" | .operation.status = "pending" | .operation.before = null), blobs: {}}' \
  "$store/index/meta/$uuid.json" >"$store/index/pending/01000000-0000-7000-8000-000000000000.json"
assert_not_contains "mise bootstrap dotfiles history 2>&1" "did not finish"
assert "$count" "3"
assert_contains "mise bootstrap dotfiles save 2>&1" "did not finish; recording it as failed"
assert "mise bootstrap dotfiles history --json | jq -r '.[0].operation.status'" "failed"
assert "$count" "4"

# recording can be turned off, and save then fails instead of pretending
assert_fail "MISE_HISTORY_ENABLED=0 mise bootstrap dotfiles save" "history is disabled"
assert_succeed "MISE_HISTORY_ENABLED=0 mise bootstrap dotfiles save --best-effort"
echo nine >"$MISE_CONFIG_DIR/dotfiles/copied"
assert_succeed "MISE_HISTORY_ENABLED=0 mise bootstrap dotfiles apply --yes"
assert "$count" "4"

# without a usable git nothing can be captured: save fails, bootstrap still runs
bindir="$PWD/stub-bin"
mkdir -p "$bindir"
printf '#!/bin/sh\nexit 127\n' >"$bindir/git"
chmod +x "$bindir/git"
echo ten >"$MISE_CONFIG_DIR/dotfiles/copied"
assert_fail "PATH='$bindir:$PATH' mise bootstrap dotfiles save" "cannot save"
assert_succeed "PATH='$bindir:$PATH' mise bootstrap dotfiles apply --yes"
assert "cat ~/.copied" "ten"
assert_contains "PATH='$bindir:$PATH' mise bootstrap dotfiles status" "capture is unavailable"

# the user's own checkout of the config directory is never touched
git -C "$MISE_CONFIG_DIR" init -q -b main
git -C "$MISE_CONFIG_DIR" config user.email test@example.com
git -C "$MISE_CONFIG_DIR" config user.name "mise test"
git -C "$MISE_CONFIG_DIR" add .
git -C "$MISE_CONFIG_DIR" commit -qm initial
head="$(git -C "$MISE_CONFIG_DIR" rev-parse HEAD)"
echo eleven >"$MISE_CONFIG_DIR/dotfiles/copied"
assert_succeed "mise bootstrap dotfiles save"
assert "git -C '$MISE_CONFIG_DIR' rev-parse HEAD" "$head"
assert "git -C '$MISE_CONFIG_DIR' status --porcelain" " M dotfiles/copied"

# mise's own state, cache, and data directories under a tracked root are never captured
mkdir -p ~/.local/other
echo hi >~/.local/other/file
assert_succeed "MISE_DOTFILES_ROOT=$HOME/.local mise bootstrap dotfiles save"
tree="$(mise bootstrap dotfiles history show latest --json | jq -r .tree.snapshot)"
assert_contains "git --git-dir='$repo' ls-tree -r --name-only '$tree'" "home/.local/other/file"
assert_not_contains "git --git-dir='$repo' ls-tree -r --name-only '$tree'" "state/mise"
assert_not_contains "git --git-dir='$repo' ls-tree -r --name-only '$tree'" "share/mise"
