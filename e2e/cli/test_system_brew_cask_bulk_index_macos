#!/usr/bin/env bash

if [[ "$(uname)" != "Darwin" ]]; then
  exit 0
fi

python3 - "$PWD" <<'PYTHON'
import json
import os
from pathlib import Path
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# The bulk cask index: one request for every cask, a staleness window, and a
# conditional request that is answered 304. None of that is visible from the
# resolved metadata, which is identical either way, so it is asserted here
# against the requests the fixture actually receives.

root = Path(sys.argv[1]).resolve()
prefix = root / "brew-prefix"
cache = Path(os.environ["MISE_CACHE_DIR"])

BULK_PATH = "/api/cask.json"
LAST_MODIFIED = "Wed, 17 Sep 2026 10:00:00 GMT"
TOKENS = ["alpha", "beta"]

# (path, If-Modified-Since or None, status answered)
requests = []
document = json.dumps([
    {
        "token": token,
        "version": "1.0",
        "sha256": "no_check",
        "url": f"http://127.0.0.1/{token}.zip",
        "artifacts": [{"app": [f"{token.title()}.app"]}],
    }
    for token in TOKENS
]).encode()


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_GET(self):
        conditional = self.headers.get("If-Modified-Since")
        if self.path != BULK_PATH:
            # Reaching the per-cask endpoint at all means the bulk document did
            # not answer, which is the whole thing this test is about.
            requests.append((self.path, conditional, 500))
            self.send_error(500, "must resolve from the bulk index, not per-cask")
            return

        if conditional == LAST_MODIFIED:
            requests.append((self.path, conditional, 304))
            self.send_response(304)
            self.send_header("Last-Modified", LAST_MODIFIED)
            self.end_headers()
            return

        requests.append((self.path, conditional, 200))
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(document)))
        self.send_header("Last-Modified", LAST_MODIFIED)
        self.end_headers()
        self.wfile.write(document)


server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
base = f"http://127.0.0.1:{server.server_port}"
env = dict(
    os.environ,
    MISE_SYSTEM_BREW_PREFIX=str(prefix),
    MISE_BREW_CASK_OPT_APPDIR=str(prefix / "Applications"),
    MISE_URL_REPLACEMENTS=json.dumps({"https://formulae.brew.sh": base}),
)
thread = threading.Thread(target=server.serve_forever, daemon=True)
thread.start()


def run(label):
    """One `mise` invocation. Returns the requests it alone produced."""
    before = len(requests)
    command = ["mise", "bootstrap", "packages", "apply", "--yes", "--dry-run"]
    result = subprocess.run(command, env=env, text=True, capture_output=True, timeout=60)
    output = result.stdout + result.stderr
    print(f"$ {label}: {' '.join(command)}", flush=True)
    print(output, end="", flush=True)
    assert result.returncode == 0, output
    for token in TOKENS:
        assert token in output, (token, output)
    return requests[before:]


def last_checked():
    """The staleness stamp, wherever the redirected-cache digest put it."""
    found = sorted(cache.glob("system-brew/api/**/cask.last-checked"))
    assert len(found) == 1, found
    return found[0]


try:
    (root / "mise.toml").write_text(
        "[settings]\nexperimental = true\n[bootstrap.packages]\n"
        + "".join(f'"brew-cask:{token}" = "latest"\n' for token in TOKENS)
    )

    # Cold. One unconditional fetch of the bulk document serves both casks, and
    # the per-cask endpoint is never reached. Two casks rather than one so that
    # a refresh running per lookup instead of per process is a failure here.
    cold = run("cold")
    assert cold == [(BULK_PATH, None, 200)], cold

    # Warm, inside the staleness window: no request at all, not even a
    # conditional one.
    warm = run("warm")
    assert warm == [], warm

    # Past the window. Only the stamp moves: backdating the document itself
    # would invalidate the index, which records its size and mtime, and this
    # needs to exercise the conditional request rather than a rebuild.
    expired = time.time() - 3600
    os.utime(last_checked(), (expired, expired))

    stale = run("expired")
    assert stale == [(BULK_PATH, LAST_MODIFIED, 304)], stale

    # A 304 carries no body, so the document and its index are untouched. It
    # still has to restart the window, or every later run would re-ask.
    again = run("warm after 304")
    assert again == [], again
finally:
    server.shutdown()
    thread.join()
    server.server_close()
PYTHON
