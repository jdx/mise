#!/usr/bin/env bash
# shellcheck disable=SC2016
# A directory with its own .git under a tracked tree is saved as a commit
# pointer only. Capture, status, and paths report it, and a machine adopting
# the setup skips the pointer with a reason instead of failing on it or
# emptying a nested repository it already has.
require_cmd git
export MISE_HISTORY_NOTIFY=false
repo="$MISE_STATE_DIR/history/repo.git"
origin="$PWD/nested-origin.git"
git init -q --bare -b main "$origin"
plugin=~/.hammerspoon/Spoons/Sky.spoon
mkdir -p "$plugin"
echo 'hs.alert("hi")' >~/.hammerspoon/init.lua
echo 'return {}' >"$plugin/init.lua"
git -C "$plugin" init -q -b main
git -C "$plugin" -c user.name=t -c user.email=t@example.com add -A
git -C "$plugin" -c user.name=t -c user.email=t@example.com commit -q -m init
sha=$(git -C "$plugin" rev-parse HEAD)

# Enrollment and every save say what a nested repository leaves out.
assert_contains 'mise dot track ~/.hammerspoon 2>&1' 'nested: ~/.hammerspoon/Spoons/Sky.spoon (nested repository'
assert "git --git-dir=$repo ls-tree HEAD home/.hammerspoon/Spoons/Sky.spoon | cut -d' ' -f1,3 | cut -f1" "160000 $sha"
assert_fail "git --git-dir=$repo cat-file -e HEAD:home/.hammerspoon/Spoons/Sky.spoon/init.lua"
assert "git --git-dir=$repo show HEAD:home/.hammerspoon/init.lua" 'hs.alert("hi")'
assert_contains 'mise dot save 2>&1' 'nested: ~/.hammerspoon/Spoons/Sky.spoon (nested repository'
assert_contains 'mise dot paths' 'nested: ~/.hammerspoon/Spoons/Sky.spoon (nested repository; its files are not saved'
assert "mise dot paths --json | jq -r '.nested[0].path'" '~/.hammerspoon/Spoons/Sky.spoon'
assert_contains 'mise dot status' 'tracked (1 nested)'
assert_contains 'mise dot status' '1 nested repository not saved'
assert "mise dot status --json | jq -r '.history.nested | length'" 1
assert_contains 'mise dot history show' 'nested: ~/.hammerspoon/Spoons/Sky.spoon'

# Tracking the nested repository as its own entry saves its files.
assert_succeed 'mise dot track ~/.hammerspoon/Spoons/Sky.spoon'
assert "git --git-dir=$repo show HEAD:home/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return {}'
assert_not_contains 'mise dot paths' 'nested:'
assert_succeed 'mise dot untrack ~/.hammerspoon/Spoons/Sky.spoon'
assert_succeed 'mise dot save'
assert "git --git-dir=$repo ls-tree HEAD home/.hammerspoon/Spoons/Sky.spoon | cut -d' ' -f1" 160000

# Another machine adopts the setup: the pointer is skipped with a reason,
# the ordinary files arrive, and a nested repository it already has is
# left alone.
assert_succeed "mise dot track $MISE_CONFIG_DIR/config.toml"
assert_succeed "mise dot origin set file://$origin --yes"
assert "git --git-dir=$origin ls-tree main home/.hammerspoon/Spoons/Sky.spoon | cut -d' ' -f1" 160000
wrapper() {
  local home="$1" script="$2"
  mkdir -p "$home"
  cat <<EOF2 >"$script"
#!/usr/bin/env bash
export HOME="$home" XDG_CONFIG_HOME="$home/.config" MISE_CONFIG_DIR="$home/.config/mise" \\
  MISE_STATE_DIR="$home/.local/state/mise" MISE_DATA_DIR="$home/.local/share/mise" \\
  MISE_CACHE_DIR="$home/.cache/mise" MISE_TRUSTED_CONFIG_PATHS="$home" MISE_HISTORY_NOTIFY=false
cd "\$HOME" && exec mise "\$@"
EOF2
  chmod +x "$script"
}
second="$(dirname "$HOME")/nested-second"
wrapper "$second" "$PWD/second"
b="$PWD/second"
mkdir -p "$second/.hammerspoon/Spoons/Sky.spoon"
echo 'return { second = true }' >"$second/.hammerspoon/Spoons/Sky.spoon/init.lua"
git -C "$second/.hammerspoon/Spoons/Sky.spoon" init -q -b main
git -C "$second/.hammerspoon/Spoons/Sky.spoon" -c user.name=t -c user.email=t@example.com add -A
git -C "$second/.hammerspoon/Spoons/Sky.spoon" -c user.name=t -c user.email=t@example.com commit -q -m second
assert_contains "$b bootstrap --adopt file://$origin --yes --only dotfiles 2>&1" 'skipped: nested repository'
assert "cat $second/.hammerspoon/init.lua" 'hs.alert("hi")'
assert "cat $second/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return { second = true }'
assert_succeed "test -d $second/.hammerspoon/Spoons/Sky.spoon/.git"
assert_contains "$b dot status" 'not shared: ~/.hammerspoon/Spoons/Sky.spoon (nested repository'
assert "$b dot status --json | jq -r '.history.sync.pending_applications | length'" 0
assert_succeed "$b dot sync"

# A machine without the directory is not asked to create it, and its
# later syncs neither remove the pointer nor fail on it.
third="$(dirname "$HOME")/nested-third"
wrapper "$third" "$PWD/third"
c="$PWD/third"
assert_contains "$c bootstrap --adopt file://$origin --yes --only dotfiles 2>&1" 'skipped: nested repository'
assert "cat $third/.hammerspoon/init.lua" 'hs.alert("hi")'
assert_fail "test -e $third/.hammerspoon/Spoons/Sky.spoon"
assert_succeed "$c dot sync"
assert_succeed "$b dot sync"
assert_succeed "test -d $second/.hammerspoon/Spoons/Sky.spoon/.git"

# Pointers at different commits (or absent) are each machine's own: once
# every machine has pulled what the others published, nobody is pending
# and further rounds publish nothing.
round() {
  for m in "$c" "$b" mise; do
    assert_succeed "$m dot sync"
    assert_succeed "$m dot pull --yes"
    assert_succeed "$m dot sync"
  done
}
round
round
commits=$(git --git-dir="$origin" rev-list --count main)
round
assert "git --git-dir=$origin rev-list --count main" "$commits"
assert "mise dot status --json | jq -r '.history.sync.pending_applications | length'" 0
assert "$b dot status --json | jq -r '.history.sync.pending_applications | length'" 0
assert "$c dot status --json | jq -r '.history.sync.pending_applications | length'" 0
assert "cat $second/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return { second = true }'
assert_fail "test -e $third/.hammerspoon/Spoons/Sky.spoon"

# Another machine's pointer at a different commit is upstream when this
# one converts the repository to ordinary content: the files still publish.
echo 'return { second = 2 }' >"$second/.hammerspoon/Spoons/Sky.spoon/init.lua"
git -C "$second/.hammerspoon/Spoons/Sky.spoon" -c user.name=t -c user.email=t@example.com commit -qam second-2
echo 'hs.alert("b")' >"$second/.hammerspoon/init.lua"
assert_succeed "$b dot save"
assert_succeed "$b dot sync"
assert "git --git-dir=$origin ls-tree main home/.hammerspoon/Spoons/Sky.spoon | awk '{print \$3}'" "$(git -C "$second/.hammerspoon/Spoons/Sky.spoon" rev-parse HEAD)"
assert_succeed 'mise dot sync'
assert_succeed 'mise dot pull --yes'
assert_succeed 'mise dot sync'

# Removing a nested repository this machine had on disk is a real change,
# not a pointer to bridge: the save records the removal.
rm -rf "$second/.hammerspoon/Spoons/Sky.spoon"
# a save that fails after the removal (an encrypted entry with no usable
# recipient) leaves the ownership record alone, so the retry still
# records the removal instead of treating the old pointer as inherited
echo 'secret' >"$second/.hammerspoon/private.lua"
cat >>"$second/.config/mise/config.toml" <<'TOML'
"~/.hammerspoon/private.lua" = { mode = "track", encrypt = true }
[history.encryption]
recipients = ["not-a-recipient"]
TOML
assert_fail "$b dot save"
assert_contains "cat $second/.local/state/mise/history/own-nested.json" '~/.hammerspoon/Spoons/Sky.spoon'
python3 - "$second/.config/mise/config.toml" <<'PY'
import sys
p=sys.argv[1]; s=open(p).read()
s=s.replace('"~/.hammerspoon/private.lua" = { mode = "track", encrypt = true }\n','').replace('[history.encryption]\nrecipients = ["not-a-recipient"]\n','')
open(p,'w').write(s)
PY
rm -f "$second/.hammerspoon/private.lua"
assert_succeed "$b dot save"
assert_fail "git --git-dir=$second/.local/state/mise/history/repo.git cat-file -e HEAD:home/.hammerspoon/Spoons/Sky.spoon"
mkdir -p "$second/.hammerspoon/Spoons/Sky.spoon"
echo 'return { second = 2 }' >"$second/.hammerspoon/Spoons/Sky.spoon/init.lua"
git -C "$second/.hammerspoon/Spoons/Sky.spoon" init -q -b main
git -C "$second/.hammerspoon/Spoons/Sky.spoon" -c user.name=t -c user.email=t@example.com add -A
git -C "$second/.hammerspoon/Spoons/Sky.spoon" -c user.name=t -c user.email=t@example.com commit -q -m second-2-again
assert_succeed "$b dot save"

# A machine that only inherits the pointer (no checkout on disk) adopts
# while another machine's pointer is upstream, then diverges.
fifth="$(dirname "$HOME")/nested-fifth"
wrapper "$fifth" "$PWD/fifth"
e="$PWD/fifth"
assert_contains "$e bootstrap --adopt file://$origin --yes --only dotfiles 2>&1" 'skipped: nested repository'
assert_fail "test -e $fifth/.hammerspoon/Spoons/Sky.spoon"
echo 'e' >"$fifth/.hammerspoon/only-on-e.lua"
assert_succeed "$e dot save"

# Removing the nested .git turns the pointer into ordinary content: the
# next save captures the files (not a pointer-only change), and the other
# machines receive them. Pulling another machine's pointer change first
# keeps the files (the pointer is never reintroduced), and the sync after
# it publishes them.
rm -rf "$plugin/.git"
assert_succeed 'mise dot save'
assert "git --git-dir=$repo show HEAD:home/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return {}'
assert_not_contains 'mise dot paths' 'nested:'
echo 'return { second = 3 }' >"$second/.hammerspoon/Spoons/Sky.spoon/init.lua"
git -C "$second/.hammerspoon/Spoons/Sky.spoon" -c user.name=t -c user.email=t@example.com commit -qam second-3
echo 'hs.alert("b3")' >"$second/.hammerspoon/init.lua"
assert_succeed "$b dot save"
assert_succeed "$b dot sync"
assert_succeed 'mise dot sync --fetch-only'
assert_succeed 'mise dot pull --yes'
assert "cat ~/.hammerspoon/init.lua" 'hs.alert("b3")'
assert "cat $plugin/init.lua" 'return {}'
assert "git --git-dir=$repo show HEAD:home/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return {}'
assert_succeed 'mise dot sync'
assert "git --git-dir=$origin show main:home/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return {}'

# The inheriting machine receives the converted files: the pointer it
# never had on disk is not its own, and its divergence is no obstacle.
assert_succeed "$e dot sync --fetch-only"
assert_succeed "$e dot pull --yes"
assert "cat $fifth/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return {}'
assert_fail "test -e $fifth/.hammerspoon/Spoons/Sky.spoon/.git"
assert_succeed "$e dot sync"
assert_succeed "$c dot sync"
assert_succeed "$c dot pull --yes"
assert "cat $third/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return {}'

# A machine that still has the repository checked out pauses at that path
# instead of having the files written into its checkout or publishing its
# pointer over them (its next save records the pointer again alongside a
# real change).
echo 'hs.alert("changed on b")' >"$second/.hammerspoon/init.lua"
assert_succeed "$b dot save"
assert_fail "$b dot sync 2>&1" 'Sky.spoon is a nested repository here and ordinary files on another machine'
assert_fail "$b dot pull --yes 2>&1" 'Sky.spoon is a nested repository here and ordinary files on another machine'
assert "cat $second/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return { second = 3 }'
assert_succeed "test -d $second/.hammerspoon/Spoons/Sky.spoon/.git"
assert "git -C $second/.hammerspoon/Spoons/Sky.spoon status --porcelain | wc -l | tr -d ' '" 0
assert "git --git-dir=$origin show main:home/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return {}'

# Once the checkout is gone, the files arrive.
rm -rf "$second/.hammerspoon/Spoons/Sky.spoon"
assert_succeed "$b dot pull --yes"
assert "cat $second/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return {}'
assert_succeed "$b dot sync"

# A fresh machine that already has the repository checked out where the
# setup now carries ordinary files pauses its adoption instead of having
# them written into the checkout.
fourth="$(dirname "$HOME")/nested-fourth"
wrapper "$fourth" "$PWD/fourth"
d="$PWD/fourth"
mkdir -p "$fourth/.hammerspoon/Spoons/Sky.spoon"
echo 'return { fourth = true }' >"$fourth/.hammerspoon/Spoons/Sky.spoon/init.lua"
git -C "$fourth/.hammerspoon/Spoons/Sky.spoon" init -q -b main
git -C "$fourth/.hammerspoon/Spoons/Sky.spoon" -c user.name=t -c user.email=t@example.com add -A
git -C "$fourth/.hammerspoon/Spoons/Sky.spoon" -c user.name=t -c user.email=t@example.com commit -q -m fourth
assert_fail "$d bootstrap --adopt file://$origin --yes --only dotfiles 2>&1" 'Sky.spoon is a nested repository here and ordinary files on another machine'
assert "cat $fourth/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return { fourth = true }'
assert "git -C $fourth/.hammerspoon/Spoons/Sky.spoon status --porcelain | wc -l | tr -d ' '" 0

# A repository initialised after the last save is in no saved tree, but
# it is on disk: an incoming edit under it pauses instead of being written.
git -C "$third/.hammerspoon/Spoons/Sky.spoon" init -q -b main
git -C "$third/.hammerspoon/Spoons/Sky.spoon" -c user.name=t -c user.email=t@example.com add -A
git -C "$third/.hammerspoon/Spoons/Sky.spoon" -c user.name=t -c user.email=t@example.com commit -q -m third
# Before the next save records the repository as a pointer, nothing is
# incoming under it and a pull holds nothing up; the save then makes it a
# pointer against upstream content, which pauses until it is resolved.
assert_succeed "$c dot pull --yes"
assert_fail "$c dot sync 2>&1" 'Sky.spoon is a nested repository here and ordinary files on another machine'
echo 'return { edited = true }' >"$plugin/init.lua"
assert_succeed 'mise dot save'
assert_succeed 'mise dot sync'
assert_fail "$c dot sync 2>&1" 'Sky.spoon is a nested repository here and ordinary files on another machine'
assert_fail "$c dot pull --yes 2>&1" 'Sky.spoon is a nested repository here and ordinary files on another machine'
assert "cat $third/.hammerspoon/Spoons/Sky.spoon/init.lua" 'return {}'
assert "git -C $third/.hammerspoon/Spoons/Sky.spoon status --porcelain | wc -l | tr -d ' '" 0
