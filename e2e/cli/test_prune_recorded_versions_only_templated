#!/usr/bin/env bash
# Only a config's templated tools are recorded; a literal tool is still resolved by
# prune itself, so removing it from the config stops protecting it.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[vars]
d = "1.0.0"' >project/mise.toml
echo '[tools]
dummy = "{{vars.d}}"
tiny = "2.0.0"' >project/child/mise.toml
assert "mise -C project/child install"
assert_not_contains "cat $MISE_DATA_DIR/installs/.mise/claims/*.toml" 'backend = "tiny"'

echo '[tools]
dummy = "{{vars.d}}"' >project/child/mise.toml
assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e '[.tiny[].version] == [\"2.0.0\"]' prunable.json"
assert "jq -e 'has(\"dummy\") | not' prunable.json"
