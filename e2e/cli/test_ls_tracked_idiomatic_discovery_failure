#!/usr/bin/env bash

export MISE_EXPERIMENTAL=1

mkdir -p "$MISE_DATA_DIR/plugins/failing" "$MISE_STATE_DIR/tracked-configs" project other
cat <<'EOF' >"$MISE_DATA_DIR/plugins/failing/metadata.lua"
error("intentional metadata discovery failure")
EOF
cat <<'EOF' >project/package.json
{
  "packageManager": "yarn@4.0.0"
}
EOF
ln -s "$PWD/project/package.json" "$MISE_STATE_DIR/tracked-configs/failing-plugin"
cat <<'EOF' >"$MISE_CONFIG_DIR/config.toml"
[settings]
experimental = true
idiomatic_version_file_enable_tools = ["failing"]
EOF

output=$(mise -C other ls --all-sources 2>&1)
assert_contains "echo '$output'" "error loading tracked config file"
assert_contains "echo '$output'" "unknown config file type"
assert_contains "echo '$output'" "project/package.json"
assert_not_contains "echo '$output'" "skipping disabled idiomatic tracked config"
