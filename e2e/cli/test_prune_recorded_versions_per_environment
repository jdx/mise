#!/usr/bin/env bash
# Using a project under another MISE_ENV is not a config edit: the versions each
# environment rendered to stay protected.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project elsewhere
echo '[tools]
dummy = "{{env.PRUNE_VERSION}}"' >project/mise.toml
assert "MISE_ENV=dev PRUNE_VERSION=1.0.0 mise -C project install"
assert "MISE_ENV=prod PRUNE_VERSION=2.0.0 mise -C project install"
assert "mise install dummy@3.0.0"

assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e '[.dummy[].version] == [\"3.0.0\"]' prunable.json"
