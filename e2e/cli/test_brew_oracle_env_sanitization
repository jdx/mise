#!/usr/bin/env bash

# Capability data is forwarded only to the three named destructive oracles.
# A normal e2e test must never inherit it, even when its parent process sets it.
assert_fail "env | grep -q '^MISE_BREW_ORACLE_'"
assert_fail "env | grep -q '^MISE_BREW_LIFECYCLE_TEST_PREFIX='"
assert_fail "env | grep -q '^CI='"
