#!/usr/bin/env bash

# Per-section targets keep global config split into readable conf.d fragments.
mkdir -p "$MISE_CONFIG_DIR/conf.d"
cat >"$MISE_CONFIG_DIR/config.toml" <<EOF
[settings.write_targets]
tools = "$MISE_CONFIG_DIR/conf.d/10-tools.toml"
packages = "$MISE_CONFIG_DIR/conf.d/20-packages.toml"
dotfiles = "$MISE_CONFIG_DIR/conf.d/30-dotfiles.toml"
EOF

# New entries select the configured category target.
mise use --global dummy@system
assert_contains "cat $MISE_CONFIG_DIR/conf.d/10-tools.toml" 'dummy = "system"'
assert_not_contains "cat $MISE_CONFIG_DIR/config.toml" 'dummy = "system"'

mise bootstrap packages use --global --no-install pacman:ripgrep
assert_contains "cat $MISE_CONFIG_DIR/conf.d/20-packages.toml" '"pacman:ripgrep" = "latest"'
assert_not_contains "cat $MISE_CONFIG_DIR/config.toml" 'pacman:ripgrep'

printf 'new dotfile\n' >"$HOME/.write-target"
mise dot add --global --no-apply --yes "$HOME/.write-target"
assert_contains "cat $MISE_CONFIG_DIR/conf.d/30-dotfiles.toml" '"~/.write-target"'
assert_not_contains "cat $MISE_CONFIG_DIR/config.toml" 'write-target'

# Explicit paths still win over defaults.
mise use --path explicit-tools.toml dummy@1
assert_contains "cat explicit-tools.toml" 'dummy = "1"'
assert_not_contains "cat $MISE_CONFIG_DIR/conf.d/10-tools.toml" 'dummy = "1"'

mise bootstrap packages use --path explicit-packages.toml --no-install pacman:jq
assert_contains "cat explicit-packages.toml" '"pacman:jq" = "latest"'
assert_not_contains "cat $MISE_CONFIG_DIR/conf.d/20-packages.toml" 'pacman:jq'

printf 'explicit dotfile\n' >"$HOME/.explicit-write-target"
mise dot add --path explicit-dotfiles.toml --no-apply --yes "$HOME/.explicit-write-target"
assert_contains "cat explicit-dotfiles.toml" '"~/.explicit-write-target"'
assert_not_contains "cat $MISE_CONFIG_DIR/conf.d/30-dotfiles.toml" 'explicit-write-target'

# Existing global entries remain in their fragment, regardless of the default.
mise use --global dummy@2
assert_contains "cat $MISE_CONFIG_DIR/conf.d/10-tools.toml" 'dummy = "2"'
assert_not_contains "cat $MISE_CONFIG_DIR/config.toml" 'dummy = "2"'

mise bootstrap packages use --global --no-install pacman:ripgrep@2
assert_contains "cat $MISE_CONFIG_DIR/conf.d/20-packages.toml" '"pacman:ripgrep" = "2"'
assert_not_contains "cat $MISE_CONFIG_DIR/config.toml" 'pacman:ripgrep'

mkdir -p "$HOME/.dotfiles"
printf 'old source\n' >"$HOME/.dotfiles/existing-write-target"
printf 'updated source\n' >"$HOME/.existing-write-target"
cat >>"$MISE_CONFIG_DIR/conf.d/30-dotfiles.toml" <<'EOF'
"~/.existing-write-target" = { source = "~/.dotfiles/existing-write-target", mode = "copy" }
EOF
mise dot add --global --no-apply --yes "$HOME/.existing-write-target"
assert "cat $HOME/.dotfiles/existing-write-target" "updated source"
assert_not_contains "cat $MISE_CONFIG_DIR/config.toml" 'existing-write-target'

# Environment selectors are still project-local and do not use global defaults.
mise use --env staging dummy@3
assert_contains "cat mise.staging.toml" 'dummy = "3"'
assert_not_contains "cat $MISE_CONFIG_DIR/conf.d/10-tools.toml" 'dummy = "3"'

mise bootstrap packages use --env staging --no-install pacman:fd
assert_contains "cat mise.staging.toml" '"pacman:fd" = "latest"'
assert_not_contains "cat $MISE_CONFIG_DIR/conf.d/20-packages.toml" 'pacman:fd'

# Multiple existing fragments are intentionally not guessed; an explicit path is required.
cat >"$MISE_CONFIG_DIR/conf.d/11-other-tools.toml" <<'EOF'
[tools]
tiny = "1"
legacy = "1"
EOF
assert_fail_contains "mise use --global --dry-run dummy@3 tiny@1 2>&1" "use --path to choose one"
assert_fail_contains "mise use --global --dry-run legacy@2 fresh@1 2>&1" "run separate commands"

# Without a configured default, global writes retain their existing destination.
mkdir -p no-defaults
MISE_CONFIG_DIR="$PWD/no-defaults" mise use --global dummy@system
assert_contains "cat no-defaults/config.toml" 'dummy = "system"'
