#!/usr/bin/env bash
# Entries recorded under different environments cannot stand in for each other: each
# environment the config was used in has to have recorded every templated tool.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[tools]
dummy = "{{env.PRUNE_D}}"
tiny = "{{env.PRUNE_T}}"' >project/mise.toml
assert "MISE_ENV=dev PRUNE_D=1.0.0 PRUNE_T=2.0.0 mise -C project install"
# In prod only dummy is installed; the tiny version prod renders to is not.
assert "MISE_ENV=prod PRUNE_D=2.0.0 PRUNE_T=3.0.0 mise -C project install dummy"

assert_fail "mise -C elsewhere prune --yes" "no installation has been recorded"
assert_contains "mise ls tiny" "2.0.0"
