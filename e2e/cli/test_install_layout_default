#!/usr/bin/env bash
# The identity install layout is the default, with or without experimental
# features; install_layout = "legacy" opts out and is deprecated.
installs="$MISE_DATA_DIR/installs"

echo "=== nothing set: the identity layout ==="
export MISE_EXPERIMENTAL=0
assert "mise install dummy@1.0.0"
assert_matches "mise where dummy@1.0.0" "^$installs/dummy-[a-z2-7]{8}\$"
assert "test -L '$installs/dummy/1.0.0'"
assert_not_contains "mise install dummy@1.0.0 2>&1" "deprecated"

echo "=== install_layout = legacy opts out, with a deprecation warning ==="
assert_contains "MISE_INSTALL_LAYOUT=legacy mise install dummy@1.1.0 2>&1" "deprecated [install_layout_legacy]"
assert_contains "MISE_INSTALL_LAYOUT=legacy mise install dummy@1.1.0 2>&1" "mise installs migrate"
assert "MISE_INSTALL_LAYOUT=legacy mise where dummy@1.1.0 2>/dev/null" "$installs/dummy/1.1.0"
assert "test -d '$installs/dummy/1.1.0' && test ! -L '$installs/dummy/1.1.0'"

echo "=== an unknown install_layout is reported, and the default kept ==="
assert_contains "MISE_INSTALL_LAYOUT=legasy mise install dummy@1.0.1 2>&1" "neither"
assert "test -L '$installs/dummy/1.0.1'"

echo "=== mise installs works without experimental ==="
assert_contains "mise installs ls dummy" "$(basename "$(mise where dummy@1.0.0)")"
