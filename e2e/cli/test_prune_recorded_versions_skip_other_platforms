#!/usr/bin/env bash
# A templated tool restricted to another OS is never resolved here, so it cannot be
# recorded and must not make prune refuse the whole config.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[vars]
d = "1.0.0"
t = "2.0.0"' >project/mise.toml
echo '[tools]
dummy = "{{vars.d}}"
tiny = { version = "{{vars.t}}", os = ["windows"] }' >project/child/mise.toml
assert "mise -C project/child install"
assert "mise install dummy@3.0.0"

assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e '[.dummy[].version] == [\"3.0.0\"]' prunable.json"
