#!/usr/bin/env bash
# Experimental tracking must not change released dotfile workflows.
export MISE_EXPERIMENTAL=0

mkdir -p "$MISE_CONFIG_DIR/dotfiles"
echo original >"$HOME/.native"
echo copied >"$MISE_CONFIG_DIR/dotfiles/source"
cat >"$MISE_CONFIG_DIR/config.toml" <<'EOF'
[dotfiles]
"~/.copied" = { mode = "copy", source = "dotfiles/source" }
EOF

assert_fail "mise bootstrap dotfiles track ~/.native" 'dotfile tracking is experimental'
assert_fail "mise bootstrap dotfiles save" 'dotfile tracking is experimental'
assert_fail "mise bootstrap dotfiles history" 'dotfile tracking is experimental'
assert_fail "mise bootstrap dotfiles paths" 'dotfile tracking is experimental'
assert "cat ~/.native" original
assert_fail "grep 'mode = \"track\"' '$MISE_CONFIG_DIR/config.toml'"
assert_succeed "mise bootstrap dotfiles apply --yes"
assert "cat ~/.copied" copied
assert_directory_not_exists "$MISE_STATE_DIR/history"
assert_contains "mise bootstrap dotfiles status" 'experimental'
assert_directory_not_exists "$MISE_STATE_DIR/history"

export MISE_EXPERIMENTAL=1
assert_succeed "mise bootstrap dotfiles track ~/.native"
assert_succeed "mise bootstrap dotfiles history"
export MISE_EXPERIMENTAL=0
assert_fail "mise bootstrap dotfiles apply --yes" 'dotfile tracking is experimental'
assert_fail "mise bootstrap --yes" 'dotfile tracking is experimental'
assert "cat ~/.native" original
assert_succeed "mise bootstrap dotfiles status"
