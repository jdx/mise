#!/usr/bin/env bash

secret_root="$PWD/secret-root"
secret_target="$PWD/root-secret.conf"
mkdir -p "$secret_root"
echo '{{ secret(name="root_only_secret") }}' >"$secret_root/secret.tmpl"

cat <<EOF >mise.toml
[bootstrap]
config_roots = ["secret-root"]
EOF

cat <<EOF >"$secret_root/mise.toml"
[bootstrap.secrets]
root_only_secret = "MISE_ROOT_ONLY_SECRET"

[dotfiles]
"$secret_target" = { source = "secret.tmpl", mode = "template" }
EOF

# Secrets declared only in a selected bootstrap root are available to that
# root's dotfile templates and appear in aggregate status.
assert_succeed "MISE_ROOT_ONLY_SECRET=from-root-secret mise bootstrap dotfiles apply --yes"
assert "cat '$secret_target'" "from-root-secret"
assert_contains "MISE_ROOT_ONLY_SECRET=from-root-secret mise bootstrap status" "root_only_secret"
