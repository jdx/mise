#!/usr/bin/env bash
# The same config used from another directory loads other config files and can render
# another version. That is a second outcome, not an edit that replaces the first.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[tools]
dummy = "{{env.PRUNE_VERSION}}"' >project/mise.toml
echo '[vars]
unrelated = "child"' >project/child/mise.toml
assert "PRUNE_VERSION=1.0.0 mise -C project install"
assert "PRUNE_VERSION=2.0.0 mise -C project/child install"
assert "mise install dummy@3.0.0"

assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e '[.dummy[].version] == [\"3.0.0\"]' prunable.json"
