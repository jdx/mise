#!/usr/bin/env bash

# An explicit fuzzy version must not prevent --bump from updating the config.
cat <<'EOF' >mise.toml
[tools]
dummy = "1.0.0"
EOF
mise install dummy@1.0.0
mise install dummy@2.0.0

output=$(mise up --bump dummy@latest --dry-run)
assert_contains "echo '$output'" "Would bump dummy@2.0.0"
assert_contains "cat mise.toml" 'dummy = "1.0.0"'

mise up --bump dummy@latest --prune
assert "mise ls dummy" "dummy  2.0.0  ~/workdir/mise.toml  2.0.0"
assert_contains "cat mise.toml" 'dummy = "2.0.0"'

# Explicit selectors constrain resolution and are persisted verbatim.
cat <<'EOF' >mise.toml
[tools]
dummy = "1.0.0"
EOF
mise install dummy@3.1.0

output=$(mise up --bump dummy@3 --dry-run)
assert_contains "echo '$output'" "Would bump dummy@3"
assert_contains "cat mise.toml" 'dummy = "1.0.0"'

# An already-installed explicit selector is still persisted when another tool
# needs a regular upgrade.
cat <<'EOF' >mise.toml
[tools]
dummy = "1.0.0"
tiny-local = "1.0.0"
EOF
ln -s "$ROOT/test/data/plugins/tiny" "$MISE_DATA_DIR/plugins/tiny-local"
mise install dummy@3.1.0
mise install tiny-local@1.0.0
mise up --bump dummy@3 tiny-local --prune
assert_contains "cat mise.toml" 'dummy = "3"'
assert_contains "cat mise.toml" 'tiny-local = "3.1.0"'

# An unresolved explicit selector must not prevent a successful sibling bump.
cat <<'EOF' >mise.toml
[tools]
dummy = "1.0.0"
tiny-local = "1.0.0"
EOF
mise install tiny-local@1.0.0
mise up --bump dummy@path:/does-not-exist tiny-local --prune >/dev/null 2>&1 || :
assert_contains "cat mise.toml" 'dummy = "1.0.0"'
assert_contains "cat mise.toml" 'tiny-local = "3.1.0"'

mise up --bump dummy@3 --prune
assert_contains "cat mise.toml" 'dummy = "3"'

cat <<'EOF' >mise.toml
[tools]
dummy = "1.0.0"
EOF
mise up --bump dummy@3.1 --prune
assert_contains "cat mise.toml" 'dummy = "3.1"'

# A higher-precedence environment request is not a writable config source.
cat <<'EOF' >mise.toml
[tools]
dummy = "1.0.0"
EOF
MISE_DUMMY_VERSION=1.0.0 mise up --bump dummy@latest --prune
assert_contains "cat mise.toml" 'dummy = "1.0.0"'

# An unresolved explicit selector must not overwrite a working configuration.
cat <<'EOF' >mise.toml
[tools]
dummy = "1.0.0"
EOF
mise up --bump dummy@path:/does-not-exist --prune >/dev/null 2>&1 || :
assert_contains "cat mise.toml" 'dummy = "1.0.0"'
