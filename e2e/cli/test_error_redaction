#!/usr/bin/env bash
# The detailed error report, the rendered config diagnostic and `mise doctor`
# are written without passing through the logger. They must hide what the log
# lines of the same run hide: `redact = true` values and credentials embedded
# in URLs.

export NO_COLOR=1 MISE_HTTP_RETRIES=0 MISE_USE_VERSIONS_HOST=0

# serves neither the archive nor the repository, so both tools fail with a 404
start_http_server

cat >mise.toml <<EOF
[env]
DOWNLOAD_KEY = { value = "dk_s3cr3t-marker", redact = true }

[tools]
"http:internal-cli" = { version = "1.0.0", url = "http://127.0.0.1:$HTTP_PORT/cli.tar.gz?key={{ env.DOWNLOAD_KEY }}" }
EOF

install="mise install http:internal-cli pipx:git+http://x-access-token:ghs_s3cr3t-marker@127.0.0.1:$HTTP_PORT/acme/tool.git@1.0.0"

# MISE_VERBOSE=1 selects the detailed report in release builds too
for mode in MISE_FRIENDLY_ERROR=1 MISE_FRIENDLY_ERROR=0 MISE_VERBOSE=1; do
  out="$(env "$mode" RUST_BACKTRACE=0 bash -c "$install" 2>&1)" && fail "[$mode $install] expected failure"
  assert_contains_text "$out" "pipx:git+http://[redacted]@127.0.0.1:$HTTP_PORT/acme/tool.git@1.0.0"
  assert_not_contains_text "$out" "s3cr3t-marker"
done

# mise doctor prints the configured tools and env, outside the logger
cat >mise.toml <<EOF
[env]
DOWNLOAD_KEY = { value = "dk_s3cr3t-marker", redact = true }

[tools]
"pipx:git+http://x-access-token:ghs_s3cr3t-marker@127.0.0.1:$HTTP_PORT/acme/tool.git" = "1.0.0"
EOF
assert_not_contains "mise doctor 2>&1 || true" "s3cr3t-marker"
assert_not_contains "mise doctor -J 2>&1 || true" "s3cr3t-marker"
assert_contains "mise doctor 2>&1 || true" "pipx:git+http://[redacted]@127.0.0.1"

# a parse error quotes the offending line of the config, URL and all
cat >mise.toml <<'EOF'
[tools]
"pipx:git+https://x-access-token:ghs_s3cr3t-marker@git.example.com/acme/tool.git" = 1.0.0.0
EOF
out="$(mise ls 2>&1)" && fail "[mise ls] expected failure"
assert_contains_text "$out" "mise::config::parse_error"
assert_contains_text "$out" "pipx:git+https://[redacted]@git.example.com/acme/tool.git"
assert_not_contains_text "$out" "s3cr3t-marker"
