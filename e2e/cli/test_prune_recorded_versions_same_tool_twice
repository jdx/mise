#!/usr/bin/env bash
# Two templated versions of one tool cannot be told apart in the record, so prune
# keeps every installation of that tool for the config, whether the two versions
# render to the same install or to different ones.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[vars]
a = "1.0.0"
b = "2.0.0"' >project/mise.toml
echo '[tools]
dummy = ["{{vars.a}}", "{{vars.b}}"]' >project/child/mise.toml
assert "mise -C project/child install"
assert "mise install dummy@3.0.0"
assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e 'has(\"dummy\") | not' prunable.json"

echo '[vars]
a = "1.0.0"
b = "1.0.0"' >project/mise.toml
assert "mise -C project/child exec -- true"
assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e 'has(\"dummy\") | not' prunable.json"
