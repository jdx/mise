#!/usr/bin/env bash
# MISE_YES answers the confirmation of rollback and undo, as it does for
# sync and pull, so scripts can restore without a terminal.
echo first >~/.zshrc
assert_succeed "mise dot track ~/.zshrc --yes"
echo second >~/.zshrc
assert_succeed "mise dot save ~/.zshrc"

assert_contains "MISE_YES=0 mise dot rollback ~/.zshrc </dev/null 2>&1" "skipped"
assert "cat ~/.zshrc" "second"
assert_succeed "MISE_YES=1 mise dot rollback ~/.zshrc </dev/null"
assert "cat ~/.zshrc" "first"
assert_succeed "MISE_YES=1 mise dot undo </dev/null"
assert "cat ~/.zshrc" "second"
