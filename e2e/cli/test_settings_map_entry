#!/usr/bin/env bash

# A dotted key sets one entry of a map setting and keeps the others.
mise settings set task.lock_pools '{"gpu":"1"}'
mise settings set task.lock_pools.cpu 8
assert "mise settings get task.lock_pools.gpu" "1"
assert_contains "mise settings get task.lock_pools" "cpu"
assert_contains "mise settings get task.lock_pools" "gpu"
mise settings set task.lock_pools.cpu 4
assert_contains "mise settings get task.lock_pools" "4"
mise settings unset task.lock_pools.cpu
assert_not_contains "mise settings get task.lock_pools" "cpu"
assert_contains "mise settings get task.lock_pools" "gpu"
assert_fail "mise settings set task.nothing.cpu 8" "Unknown setting"

# MISE_TASK_LOCK_POOLS takes NAME=SLOTS pairs or a JSON object.
assert_contains "MISE_TASK_LOCK_POOLS=cpu=8,gpu=2 mise settings get task.lock_pools" "cpu"
assert_contains "MISE_TASK_LOCK_POOLS='{\"cpu\":\"6\"}' mise settings get task.lock_pools" "6"
