#!/usr/bin/env bash

if [[ $(uname) != Darwin ]] || [[ $(uname -m) != arm64 ]]; then
  echo "SKIP: downstream formula oracle requires macOS arm64" >&2
  exit 0
fi

# shellcheck source=e2e/cli/brew_oracle_guard.sh
source "${BASH_SOURCE[0]%/*}/brew_oracle_guard.sh"
# shellcheck source=e2e/cli/brew_oracle.sh
source "${BASH_SOURCE[0]%/*}/brew_oracle.sh"

shard=${MISE_BREW_ORACLE_CORPUS_SHARD:-}
shards=${MISE_BREW_ORACLE_CORPUS_SHARDS:-}
[[ $shard =~ ^[0-9]+$ && $shards =~ ^[1-9][0-9]*$ && $shard -lt $shards ]] ||
  brew_oracle_fail "valid downstream corpus shard identity is required"
marker="macos-corpus-formulae-$shard"
test_name="test_system_install_brew_interop_formulae_macos_slow-shard-$shard"
prefix=/opt/homebrew
brew_oracle_require_disposable "$marker" "$prefix"
brew_oracle_configure_runtime "$prefix"
brew=$BREW_ORACLE_BREW
manifest="${BASH_SOURCE[0]%/*}/brew_interop_macos_packages.tsv"

# bash itself is a fixture. Keep assertion subprocesses independent from the
# Homebrew link that this oracle deliberately removes and recreates.
hash -p /bin/bash bash
[[ $(hash -t bash) == /bin/bash ]] ||
  brew_oracle_fail "downstream formula oracle did not pin its assertion shell"

tokens=()
versions=()
digests=()
index=0
while read -r kind token version digest; do
  [[ -n $kind && $kind != \#* ]] || continue
  [[ $kind == formula ]] || continue
  if ((index % shards == shard)); then
    tokens+=("$token")
    versions+=("$version")
    digests+=("$digest")
  fi
  index=$((index + 1))
done <"$manifest"
fixture_count=${#tokens[@]}
((fixture_count > 0)) || brew_oracle_fail "downstream formula shard has zero fixtures"

# Record and validate every selected root before normalizing this disposable
# runner to a clean fixture topology. No removal begins until the whole shard's
# pre-existing state has proved native and Cellar-contained.
preexisting="$MISE_BREW_ORACLE_RESULT_DIR/preexisting-formula-roots.tsv"
: >"$preexisting"
for token in "${tokens[@]}"; do
  if "$brew" list --formula "$token" >/dev/null 2>&1; then
    opt="$prefix/opt/$token"
    [[ -L $opt ]] || brew_oracle_fail "pre-existing formula lacks an opt link: $token"
    keg=$(realpath "$opt")
    [[ $keg == "$prefix/Cellar/$token/"* && -f $keg/INSTALL_RECEIPT.json ]] ||
      brew_oracle_fail "pre-existing formula is not native Cellar state: $token"
    printf '%s\t%s\t%s\n' "$token" "$("$brew" list --versions "$token")" "$keg" \
      >>"$preexisting"
  fi
done
for token in "${tokens[@]}"; do
  if "$brew" list --formula "$token" >/dev/null 2>&1; then
    "$brew" uninstall --formula --force --ignore-dependencies "$token"
  fi
  assert_fail "'$brew' list --formula '$token'"
done

current_token=
prune_opt_backup="$MISE_BREW_ORACLE_RUNNER_TEMP/mise-brew-corpus-formulae-$shard-opt-backup"
[[ ! -e $prune_opt_backup && ! -L $prune_opt_backup ]] ||
  brew_oracle_fail "stale formula prune backup exists: $prune_opt_backup"
mkdir "$prune_opt_backup"
hidden_opt_names=()

restore_formula_prune_roots() {
  local installed backup opt
  for installed in "${hidden_opt_names[@]}"; do
    backup="$prune_opt_backup/$installed"
    opt="$prefix/opt/$installed"
    [[ -L $backup ]] ||
      brew_oracle_fail "formula prune backup is missing: $backup"
    [[ ! -e $opt && ! -L $opt ]] ||
      brew_oracle_fail "formula prune restore target is occupied: $opt"
    mv "$backup" "$opt"
  done
  hidden_opt_names=()
}

cleanup() {
  restore_formula_prune_roots
  if [[ -n $current_token ]]; then
    "$brew" uninstall --formula --force --ignore-dependencies \
      "$current_token" >/dev/null 2>&1 || true
  fi
  brew_oracle_remove_runtime_bridge
}
trap cleanup EXIT

snapshot_formula() {
  local token=$1 output=$2 keg opt linked roots normalized
  opt="$prefix/opt/$token"
  [[ -L $opt ]] || brew_oracle_fail "formula opt link is missing: $token"
  keg=$(readlink -f "$opt")
  [[ $keg == "$prefix/Cellar/$token/"* ]] ||
    brew_oracle_fail "formula opt link escapes its Cellar: $token"
  roots=("keg=$keg" "opt=$opt")
  linked="$prefix/var/homebrew/linked/$token"
  if [[ -e $linked || -L $linked ]]; then
    roots+=("linked=$linked")
  fi
  brew_oracle_snapshot "$output" "${roots[@]}"
  # Mise's private lifecycle incarnation is recovery authority, not Homebrew
  # package payload. Assert its safe topology, then exclude it from the
  # producer-equivalence snapshot.
  if [[ -e $keg/.brew/.mise-lifecycle-incarnation ]]; then
    [[ -f $keg/.brew/.mise-lifecycle-incarnation && ! -L $keg/.brew/.mise-lifecycle-incarnation ]] ||
      brew_oracle_fail "formula lifecycle incarnation is not a real file: $token"
  fi
  normalized="$output.normalized"
  grep -vF 'f 600 keg/.brew/.mise-lifecycle-incarnation ' "$output" >"$normalized"
  mv "$normalized" "$output"
}

record_formula_receipt() {
  local producer=$1 token=$2 opt keg receipt output
  opt="$prefix/opt/$token"
  [[ -L $opt ]] || brew_oracle_fail "formula receipt opt link is missing: $token"
  keg=$(readlink -f "$opt")
  [[ $keg == "$prefix/Cellar/$token/"* ]] ||
    brew_oracle_fail "formula receipt opt link escapes its Cellar: $token"
  receipt="$keg/INSTALL_RECEIPT.json"
  jq -e 'type == "object"' "$receipt" >/dev/null ||
    brew_oracle_fail "formula receipt is missing or malformed: $token"
  output="$MISE_BREW_ORACLE_RESULT_DIR/$producer-$token-INSTALL_RECEIPT.json"
  cp "$receipt" "$output"
}

compare_formula_receipts() {
  local token=$1 brew_receipt mise_receipt brew_normalized mise_normalized
  brew_receipt="$MISE_BREW_ORACLE_RESULT_DIR/brew-$token-INSTALL_RECEIPT.json"
  mise_receipt="$MISE_BREW_ORACLE_RESULT_DIR/mise-$token-INSTALL_RECEIPT.json"
  brew_normalized="$MISE_BREW_ORACLE_RESULT_DIR/brew-$token-INSTALL_RECEIPT.normalized.json"
  mise_normalized="$MISE_BREW_ORACLE_RESULT_DIR/mise-$token-INSTALL_RECEIPT.normalized.json"
  brew_oracle_normalize_json "$brew_receipt" "$brew_normalized"
  brew_oracle_normalize_json "$mise_receipt" "$mise_normalized"
  brew_oracle_diff "$brew_normalized" "$mise_normalized"
}

isolate_formula_prune_roots() {
  local excluded=$1 installed keg opt backup
  ((${#hidden_opt_names[@]} == 0)) ||
    brew_oracle_fail "formula prune roots are already isolated"
  printf '[bootstrap.packages]\n' >mise.toml
  for opt in "$prefix"/opt/*; do
    [[ -L $opt ]] || continue
    installed=${opt##*/}
    [[ -n $installed && $installed != "$excluded" ]] || continue
    keg=$(readlink -f "$opt")
    # Match maintenance::linked_formulae: aliases and unlinked Cellar racks
    # are outside prune's candidate universe and need no synthetic config.
    [[ $keg == "$prefix/Cellar/$installed/"* ]] || continue
    [[ -f $keg/INSTALL_RECEIPT.json ]] ||
      brew_oracle_fail "formula prune found an unreceipted linked keg: $installed"
    backup="$prune_opt_backup/$installed"
    [[ ! -e $backup && ! -L $backup ]] ||
      brew_oracle_fail "formula prune backup target is occupied: $backup"
    mv "$opt" "$backup"
    hidden_opt_names+=("$installed")
  done
}

for position in "${!tokens[@]}"; do
  token=${tokens[$position]}
  current_token=$token
  brew_oracle_record_api_fixture \
    formula "$token" "${versions[$position]}" "${digests[$position]}"

  cat <<EOF >mise.toml
[bootstrap.packages]
"brew:$token" = "latest"
EOF

  # Real Homebrew producer, mise consumer and exact-root remover.
  "$brew" install --formula "$token"
  assert_contains "mise bootstrap packages status" "installed"
  record_formula_receipt brew "$token"
  snapshot_formula "$token" "$MISE_BREW_ORACLE_RESULT_DIR/brew-$token.snapshot"
  mise bootstrap packages apply --yes
  record_formula_receipt brew-after-mise "$token"
  snapshot_formula \
    "$token" "$MISE_BREW_ORACLE_RESULT_DIR/brew-after-mise-$token.snapshot"
  brew_oracle_diff \
    "$MISE_BREW_ORACLE_RESULT_DIR/brew-$token.snapshot" \
    "$MISE_BREW_ORACLE_RESULT_DIR/brew-after-mise-$token.snapshot"
  isolate_formula_prune_roots "$token"
  mise bootstrap packages prune --manager brew --yes
  restore_formula_prune_roots
  assert_fail "'$brew' list --formula '$token'"

  # Mise producer, real Homebrew consumer and remover.
  cat <<EOF >mise.toml
[bootstrap.packages]
"brew:$token" = "latest"
EOF
  mise bootstrap packages apply --yes
  assert_contains "mise bootstrap packages status" "installed"
  assert_contains "'$brew' list --formula" "$token"
  assert_succeed "'$brew' info --formula '$token'"
  record_formula_receipt mise "$token"
  compare_formula_receipts "$token"
  snapshot_formula "$token" "$MISE_BREW_ORACLE_RESULT_DIR/mise-$token.snapshot"
  brew_oracle_diff \
    "$MISE_BREW_ORACLE_RESULT_DIR/brew-$token.snapshot" \
    "$MISE_BREW_ORACLE_RESULT_DIR/mise-$token.snapshot"
  "$brew" uninstall --formula --force --ignore-dependencies "$token"
  assert_fail "'$brew' list --formula '$token'"
  current_token=
done

rmdir "$prune_opt_backup"
