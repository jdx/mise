#!/usr/bin/env bash

# Tracked mise.dev.toml, while the caller has prod active: the active prod file
# would override the vars dev was installed with, so prune must refuse.
mkdir -p project elsewhere
echo '[vars]
v = "1.0.0"' >project/mise.toml
echo '[vars]
v = "2.0.0"' >project/mise.prod.toml
echo '[tools]
dummy = "{{vars.v}}"' >project/mise.dev.toml
assert "MISE_ENV=dev mise -C project install"
assert "mise install dummy@3.0.0"

assert_fail "MISE_ENV=prod mise -C elsewhere prune --yes" "MISE_ENV"
assert_contains "mise ls dummy" "1.0.0"
assert_contains "mise ls dummy" "3.0.0"
