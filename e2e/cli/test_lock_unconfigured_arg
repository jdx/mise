#!/usr/bin/env bash

# A tool argument selects among the configured tools, so one that names
# nothing configured is an error instead of a silent no-op.
# The harness pins lockfile_mode to merge through the environment.
unset MISE_LOCKFILE_MODE
export MISE_LOCKFILE=1

cat <<'TOML' >mise.toml
[tools]
tiny = "latest"
TOML

assert_fail_contains "mise lock --platform linux-x64 dummy" "cannot lock dummy"
assert_fail_contains "mise lock --platform linux-x64 tiny dummy" "cannot lock dummy"
assert "test ! -e mise.lock"

assert_contains "mise lock --platform linux-x64 tiny 2>&1" "Lockfile ready"
assert_contains "cat mise.lock" "tiny"
