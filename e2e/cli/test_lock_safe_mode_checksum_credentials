#!/usr/bin/env bash

# `mise lock` downloads an artifact that has no checksum to hash it. In safe
# mode the download is made for a project tool, so it gets no netrc
# credentials, also when the project's release points it at a host no project
# option names. Served from a local stand-in for the GitHub API.

log="$PWD/auth.log"
start_http_server --handler - "$log" <<'PY'
import http.server
import json
import sys

LOG = sys.argv[1]


class Handler(http.server.BaseHTTPRequestHandler):
    def reply(self, status, content_type, body):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def release(self):
        port = self.server.server_address[1]
        return {
            "tag_name": "v1.0.0",
            "draft": False,
            "prerelease": False,
            "created_at": "2026-01-01T00:00:00Z",
            "published_at": "2026-01-01T00:00:00Z",
            "assets": [
                {
                    "name": "tool-bin",
                    # another name for the same server, which no project option names
                    "browser_download_url": f"http://localhost:{port}/download/tool-bin",
                    "url": f"http://127.0.0.1:{port}/api/assets/1",
                }
            ],
        }

    def do_GET(self):
        path = self.path.split("?")[0]
        if path.startswith("/download/") or path.startswith("/api/assets/"):
            with open(LOG, "a") as f:
                f.write(f"{self.command} {path} {self.headers.get('Authorization', '-')}\n")
            self.reply(200, "application/octet-stream", b"#!/bin/sh\necho tool\n")
        elif path.endswith("/releases"):
            self.reply(200, "application/json", json.dumps([self.release()]).encode())
        elif "/releases/" in path:
            self.reply(200, "application/json", json.dumps(self.release()).encode())
        else:
            self.reply(404, "text/plain", b"not found")

    do_HEAD = do_GET
PY

export MISE_USE_VERSIONS_HOST=0
# the generator is what hashes an artifact the release gives no checksum for
export MISE_LOCKFILE_MODE=generate
printf 'machine localhost\nlogin netrc-user\npassword netrc-secret\nmachine 127.0.0.1\nlogin netrc-user\npassword netrc-secret\n' >"$HOME/.netrc"
chmod 600 "$HOME/.netrc"
basic="$(printf 'netrc-user:netrc-secret' | base64)"

cat >mise.toml <<EOF
[tools]
"github:acme/tool" = { version = "1.0.0", api_url = "http://127.0.0.1:$HTTP_PORT", asset_pattern = "tool-bin" }
EOF

MISE_SAFE=1 mise lock --platform linux-x64 >/dev/null 2>&1 || true
assert_succeed "grep -qs ' /download/tool-bin ' '$log'"
assert_fail "grep -qs -- '$basic' '$log'"

# without safe mode the project is trusted, so the credentials go along
rm -f "$log" mise.lock
mise lock --platform linux-x64 >/dev/null 2>&1 || true
assert_succeed "grep -qs -- '$basic' '$log'"
