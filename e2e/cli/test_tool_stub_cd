#!/usr/bin/env bash

# A shebang passes a tool stub as it was run, often by a relative path. MISE_CD
# moves mise to another directory before the stub is read, keyed and run, but the
# stub that runs is still the one the command named, on the run that resolves its
# tool and on the run the cache answers. A -C typed on the command line instead
# says where the stub path is relative to.

mkdir -p one/bin two/bin three
write_stub() {
  cat >"$1" <<EOF
#!/usr/bin/env -S mise tool-stub
tool = "dummy"
bin = "dummy"
version = "$2"
EOF
  chmod +x "$1"
}
write_stub one/bin/dummy 1.0.0
write_stub two/bin/dummy 2.0.0
# The same stub text in both projects, so only the project's mise.lock picks the
# version: the run must read the lockfile beside the stub it runs.
write_stub one/bin/latest latest
write_stub two/bin/latest latest
for v in 1 2; do
  dir=$([ $v = 1 ] && echo one || echo two)
  echo '[tools]' >"$dir/mise.toml"
  cat >"$dir/mise.lock" <<EOF
[[tools.dummy]]
version = "$v.0.0"
backend = "asdf:dummy"
EOF
done

cd one || exit 1
assert_contains "MISE_CD=../two bin/dummy" "This is Dummy 1.0.0!"
assert_contains "MISE_CD=../two bin/dummy" "This is Dummy 1.0.0!" # from the cache
cd ../two || exit 1
assert_contains "bin/dummy" "This is Dummy 2.0.0!"

cd ../one || exit 1
assert_contains "MISE_LOCKFILE=1 MISE_CD=../two bin/latest" "This is Dummy 1.0.0!"
assert_contains "MISE_LOCKFILE=1 MISE_CD=../two bin/latest" "This is Dummy 1.0.0!"
cd ../two || exit 1
assert_contains "MISE_LOCKFILE=1 bin/latest" "This is Dummy 2.0.0!"

# A -C typed on the command line says where a relative stub path is, as it does for
# any other command, even with MISE_CD set.
cd ../one || exit 1
assert_contains "mise -C ../two tool-stub bin/dummy" "This is Dummy 2.0.0!"
assert_contains "mise --cd ../two tool-stub bin/dummy" "This is Dummy 2.0.0!"
assert_contains "MISE_CD=../three mise -C ../two tool-stub bin/dummy" "This is Dummy 2.0.0!"
assert_contains "mise tool-stub bin/dummy" "This is Dummy 1.0.0!"

# The stub tracked for `mise prune` is the one that ran, here in a directory MISE_CD
# does not lead to, so the tool it needs is kept.
cd ../one || exit 1
rm ../two/bin/dummy ../two/bin/latest bin/latest ../*/mise.lock
assert_contains "MISE_CD=../three bin/dummy" "This is Dummy 1.0.0!"
assert_not_contains "mise prune --dry-run 2>&1" "dummy@1.0.0"
assert_contains "mise prune --dry-run 2>&1" "dummy@2.0.0"
