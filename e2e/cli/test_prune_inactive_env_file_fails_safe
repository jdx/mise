#!/usr/bin/env bash

# The MISE_ENV a project was installed under is unknown to prune. An environment
# file that sets the vars it reads, active or not, may have supplied them, so
# prune refuses instead of rendering against whichever files the caller loads.
mkdir -p inactive/child active/child elsewhere
echo '[vars]
v = "9.9.9"' >inactive/mise.toml
echo '[vars]
v = "1.0.0"' >inactive/mise.dev.toml
echo '[tools]
dummy = "{{vars.v}}"' >inactive/child/mise.toml
assert "MISE_ENV=dev mise -C inactive/child install"
assert "mise install dummy@3.0.0"

assert_fail "mise -C elsewhere prune --yes" "MISE_ENV"
assert_fail "mise -C elsewhere ls --prunable --json" "MISE_ENV"
assert_contains "mise ls dummy" "1.0.0"
assert_contains "mise ls dummy" "3.0.0"
