#!/usr/bin/env bash
# Editing the config file itself makes its record out of date, and prune refuses
# until the project is used again.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[vars]
v = "1.0.0"
w = "2.0.0"' >project/mise.toml
echo '[tools]
dummy = "{{vars.v}}"' >project/child/mise.toml
assert "mise -C project/child install"
assert "mise install dummy@3.0.0"
assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e '[.dummy[].version] == [\"3.0.0\"]' prunable.json"

echo '[tools]
dummy = "{{vars.w}}"' >project/child/mise.toml
assert_fail "mise -C elsewhere prune --yes" "no installation has been recorded"
assert_contains "mise ls dummy" "1.0.0"

assert "mise -C project/child install"
assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e '[.dummy[].version] | sort == [\"1.0.0\", \"3.0.0\"]' prunable.json"
