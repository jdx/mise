#!/usr/bin/env bash
# A setup can name a task that finishes setting a machine up:
# `[history] post_adopt` runs once after `mise bootstrap --adopt` installs
# the setup, a dry run names it before the machine commits to it, a later
# sync does not repeat it, and a failure says the setup is installed but
# unfinished.
# shellcheck disable=SC2016

require_cmd git

origin="$PWD/origin.git"
git init -q --bare -b main "$origin"

# ---- machine A publishes a setup whose configuration names the task.
# The task runs `mise bootstrap` itself, which every machine below then
# exercises: a bootstrap a post-adopt task invokes must not wait for the
# claim its parent holds, and must not run the one-time work again.
cat <<'EOF2' >"$MISE_CONFIG_DIR/config.toml"
[history]
post_adopt = "setup"

[tasks.setup]
run = 'printf "ran\n" >>"$HOME/post-adopt-ran"; sleep "${SETUP_SLEEP:-0}"; mise bootstrap --only dotfiles,task >/dev/null 2>&1; test -z "$FAIL_SETUP"'
EOF2
assert_succeed "mise bootstrap dotfiles track $MISE_CONFIG_DIR/config.toml"
assert_succeed "mise bootstrap dotfiles origin set file://$origin --yes"

wrapper() {
  local home="$1" script="$2"
  mkdir -p "$home"
  cat <<EOF2 >"$script"
#!/usr/bin/env bash
export HOME="$home" XDG_CONFIG_HOME="$home/.config" MISE_CONFIG_DIR="$home/.config/mise" \\
  MISE_STATE_DIR="$home/.local/state/mise" MISE_DATA_DIR="$home/.local/share/mise" \\
  MISE_CACHE_DIR="$home/.cache/mise" MISE_TRUSTED_CONFIG_PATHS="$home"
cd "\$HOME" && exec mise "\$@"
EOF2
  chmod +x "$script"
}

# ---- machine C: the dry run names the task the setup brings, and runs
# nothing. The name comes out of the incoming setup, which is not installed
# yet, so reading it from this machine's own configuration would find
# nothing at all.
C="$(dirname "$HOME")/c-home"
wrapper "$C" "$PWD/c"
c="$PWD/c"
assert_contains "$c bootstrap --adopt file://$origin --dry-run 2>&1" "would run the post-adopt task setup"
assert_fail "test -e $C/post-adopt-ran"

# adopting runs it once, after the files are installed
assert_succeed "timeout 180 $c bootstrap --adopt file://$origin --yes --only dotfiles,task"
assert "cat $C/post-adopt-ran" "ran"
assert_contains "cat $C/.config/mise/config.toml" 'post_adopt = "setup"'

# a second run adopts nothing, so there is nothing to finish: the task does
# not run again
assert_succeed "timeout 180 $c bootstrap --adopt file://$origin --yes --only dotfiles,task"
assert "cat $C/post-adopt-ran" "ran"

# and an ordinary bootstrap agrees about what already ran. The adoption's
# child sets MISE_GLOBAL_CONFIG_FILE and this one does not, so the two
# read the machine's layers by different routes: if they derived the
# setup identity differently, the one-time task would run a second time
assert_succeed "$c bootstrap --only dotfiles,task"
assert "cat $C/post-adopt-ran" "ran"

# the record is keyed by the setup, not by the task name: `setup` is what
# half of these tasks are called, and a machine that connects to a
# different setup must still get that setup's task run. The origin lives
# in config.local.toml, so pointing this machine at another one is the
# smallest way to ask that question.
sed -i.bak "s|url = \"file://$origin\"|url = \"file://$origin-other\"|" "$C/.config/mise/config.local.toml"
assert_contains "cat $C/.config/mise/config.local.toml" "origin.git-other"
assert_succeed "$c bootstrap --only dotfiles,task"
assert "cat $C/post-adopt-ran" $'ran\nran'
sed -i.bak "s|url = \"file://$origin-other\"|url = \"file://$origin\"|" "$C/.config/mise/config.local.toml"
# and back on the original setup it is still finished
assert_succeed "$c bootstrap --only dotfiles,task"
assert "cat $C/post-adopt-ran" $'ran\nran'

# ---- two bootstraps at once, with history off so the history
# operation scope does not serialize them for us — which is exactly the
# case the claim exists for. The one that does not get the claim waits
# for the outcome and adopts it: reporting success for work it never saw
# finish would tell automation the machine is set up when nothing
# observed it being set up.
W="$(dirname "$HOME")/wait-home"
wrapper "$W" "$PWD/wait"
w="$PWD/wait"
# installed without the task, so both runs below start from "unfinished"
assert_succeed "$w bootstrap --adopt file://$origin --yes --only dotfiles"
assert_fail "test -e $W/post-adopt-ran"

MISE_HISTORY_ENABLED=false SETUP_SLEEP=6 timeout 180 "$w" bootstrap --only dotfiles,task >"$PWD/slow.log" 2>&1 &
slow=$!
sleep 2
assert_contains "MISE_HISTORY_ENABLED=false timeout 300 $w bootstrap --only dotfiles,task 2>&1" 'waiting for it'
wait "$slow"
# the task ran once, and both runs succeeded
assert "cat $W/post-adopt-ran" "ran"

# when it fails, the waiting one fails too, with the same guidance
F="$(dirname "$HOME")/wait-fail-home"
wrapper "$F" "$PWD/waitfail"
f="$PWD/waitfail"
assert_succeed "$f bootstrap --adopt file://$origin --yes --only dotfiles"
MISE_HISTORY_ENABLED=false FAIL_SETUP=1 SETUP_SLEEP=6 timeout 180 "$f" bootstrap --only dotfiles,task >"$PWD/fail.log" 2>&1 &
failing=$!
sleep 2
out="$(MISE_HISTORY_ENABLED=false timeout 300 "$f" bootstrap --only dotfiles,task 2>&1)" && fail "a waiting bootstrap must not report success for a task that failed"
[[ $out == *"did not finish it"* ]] || fail "the wait does not say the setup is unfinished: $out"
[[ $out == *'run `mise bootstrap` again'* ]] || fail "the wait does not say how to retry: $out"
wait "$failing" || true
# and once it is fixed, an ordinary bootstrap finishes the machine
assert_succeed "timeout 180 $f bootstrap --only dotfiles,task"
assert "cat $F/post-adopt-ran" $'ran\nran'

# a claim whose holder is killed is not a machine wedged forever: the
# next bootstrap takes the claim and finishes the job
K="$(dirname "$HOME")/killed-home"
wrapper "$K" "$PWD/killed"
k="$PWD/killed"
assert_succeed "$k bootstrap --adopt file://$origin --yes --only dotfiles"
SETUP_SLEEP=60 timeout -s KILL 4 "$k" bootstrap --only dotfiles,task >/dev/null 2>&1 || true
assert "cat $K/post-adopt-ran" "ran"
assert_succeed "timeout 180 $k bootstrap --only dotfiles,task"
assert "cat $K/post-adopt-ran" $'ran\nran'

# ---- machine D excludes the task part: the setup is installed and the
# task is left alone, exactly as `bootstrap` would be
D="$(dirname "$HOME")/d-home"
wrapper "$D" "$PWD/d"
d="$PWD/d"
assert_succeed "$d bootstrap --adopt file://$origin --yes --only dotfiles"
assert_contains "cat $D/.config/mise/config.toml" 'post_adopt = "setup"'
assert_fail "test -e $D/post-adopt-ran"

# ---- a `--from` checkout adopts nothing and connects nothing, so there
# is no setup to finish and the task never runs, even though the
# configuration it checks out declares one
FROM="$(dirname "$HOME")/from-home"
wrapper "$FROM" "$PWD/from"
from="$PWD/from"
plain="$PWD/plain-seed"
git init -q -b main "$plain"
cp "$MISE_CONFIG_DIR/config.toml" "$plain/config.toml"
git -C "$plain" add config.toml
git -C "$plain" -c user.name=t -c user.email=t@t commit -q -m init
assert_succeed "$from bootstrap --from file://$plain --yes --only dotfiles,task"
assert_fail "test -e $FROM/post-adopt-ran"

# ---- machine E: the task fails. The setup is installed and unfinished,
# not undone, and the message names the command to run again.
E="$(dirname "$HOME")/e-home"
wrapper "$E" "$PWD/e"
e="$PWD/e"
out="$(FAIL_SETUP=1 $e bootstrap --adopt "file://$origin" --yes --only dotfiles,task 2>&1)" && fail "a failing post-adopt task must fail the adoption"
[[ $out == *"post-adopt task setup failed"* ]] || fail "the failure does not name the task: $out"
[[ $out == *'run `mise bootstrap` again'* ]] || fail "the failure does not say how to finish: $out"
# installed, and the task did run: what is missing is what the task does
assert_contains "cat $E/.config/mise/config.toml" 'post_adopt = "setup"'
assert "cat $E/post-adopt-ran" "ran"

# a task that failed is not recorded as finished. It is the bootstrap
# that finishes the machine, so an ordinary `mise bootstrap` — the one
# the failure names, and the one a user reaches for after a setup paused
# on a conflict — runs it, and only then is it done with
assert_succeed "$e bootstrap --only dotfiles,task"
assert "cat $E/post-adopt-ran" $'ran\nran'
assert_succeed "$e bootstrap --only dotfiles,task"
assert "cat $E/post-adopt-ran" $'ran\nran'
