#!/usr/bin/env bash

# shellcheck source=e2e/cli/brew_oracle_guard.sh
source "${BASH_SOURCE[0]%/*}/brew_oracle_guard.sh"

if grep -Eq 'if: *always\(\).*full-ci' "$ROOT/.github/workflows/test.yml"; then
  fail "destructive oracle jobs must remain cancellable"
fi

result_dir="$TMPDIR/oracle-results"
mkdir "$result_dir"
MISE_BREW_ORACLE_RESULT_DIR=$result_dir
MISE_BREW_ORACLE_RUNNER_TEMP=$TMPDIR
MISE_BREW_ORACLE_MISE_SHA=$(git -c safe.directory="$ROOT" -C "$ROOT" rev-parse HEAD)
MISE_BREW_ORACLE_HOMEBREW_REFERENCE_RELEASE=6.0.17
MISE_BREW_ORACLE_HOMEBREW_REFERENCE_SHA=1111111111111111111111111111111111111111
MISE_BREW_ORACLE_HOMEBREW_RUNTIME_RELEASE=$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_RELEASE
MISE_BREW_ORACLE_HOMEBREW_RUNTIME_SHA=$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_SHA
unset CI MISE_BREW_ORACLE_UNFORWARDED GITHUB_TOKEN GH_TOKEN MISE_GITHUB_TOKEN

export RUNNER_TRACKING_ID=tracking-is-not-authorization
unset MISE_BREW_ORACLE_DISPOSABLE
if brew_oracle_require_disposable missing-capability /opt/homebrew; then
  fail "missing disposable capability was accepted"
fi
unset RUNNER_TRACKING_ID

MISE_BREW_ORACLE_DISPOSABLE=1
for credential in GITHUB_TOKEN GH_TOKEN MISE_GITHUB_TOKEN; do
  printf -v "$credential" '%s' must-not-leak
  export "${credential?}"
  if brew_oracle_require_disposable credential-leak /opt/homebrew; then
    fail "CI credential $credential was accepted by the destructive oracle"
  fi
  unset "$credential"
done
brew_oracle_require_disposable valid-marker /opt/homebrew
brew_oracle_complete test_brew_oracle_guard 2 /opt/homebrew
brew_oracle_verify_marker \
  "$result_dir/valid-marker.completed" \
  test_brew_oracle_guard 2 /opt/homebrew "$MISE_BREW_ORACLE_MISE_SHA" \
  "$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_RELEASE" \
  "$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_SHA" \
  "$MISE_BREW_ORACLE_HOMEBREW_RUNTIME_RELEASE" \
  "$MISE_BREW_ORACLE_HOMEBREW_RUNTIME_SHA"

if brew_oracle_require_disposable valid-marker /opt/homebrew; then
  fail "stale completion marker was accepted"
fi
if brew_oracle_verify_marker \
  "$result_dir/missing.completed" missing 1 /opt/homebrew "$MISE_BREW_ORACLE_MISE_SHA" \
  6.0.17 1111111111111111111111111111111111111111 \
  5.1.4 2222222222222222222222222222222222222222; then
  fail "missing completion marker was accepted"
fi
if brew_oracle_verify_marker \
  "$result_dir/valid-marker.completed" test_brew_oracle_guard 2 /opt/homebrew \
  "$MISE_BREW_ORACLE_MISE_SHA" 6.0.18 \
  "$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_SHA" \
  "$MISE_BREW_ORACLE_HOMEBREW_RUNTIME_RELEASE" \
  "$MISE_BREW_ORACLE_HOMEBREW_RUNTIME_SHA"; then
  fail "wrong Homebrew reference version was accepted"
fi
if brew_oracle_verify_marker \
  "$result_dir/valid-marker.completed" wrong-test-name 2 /opt/homebrew \
  "$MISE_BREW_ORACLE_MISE_SHA" \
  "$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_RELEASE" \
  "$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_SHA" \
  "$MISE_BREW_ORACLE_HOMEBREW_RUNTIME_RELEASE" \
  "$MISE_BREW_ORACLE_HOMEBREW_RUNTIME_SHA"; then
  fail "wrong test name was accepted"
fi
if brew_oracle_verify_marker \
  "$result_dir/valid-marker.completed" test_brew_oracle_guard 2 /opt/homebrew \
  3333333333333333333333333333333333333333 \
  "$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_RELEASE" \
  "$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_SHA" \
  "$MISE_BREW_ORACLE_HOMEBREW_RUNTIME_RELEASE" \
  "$MISE_BREW_ORACLE_HOMEBREW_RUNTIME_SHA"; then
  fail "wrong mise SHA was accepted"
fi
if brew_oracle_complete test_brew_oracle_guard 0 /opt/homebrew; then
  fail "zero fixtures were accepted"
fi

brew_oracle_require_disposable invalid-result-owner /opt/homebrew
MISE_BREW_ORACLE_RESULT_UID=not-a-uid
MISE_BREW_ORACLE_RESULT_GID=$(id -g)
if brew_oracle_complete test_brew_oracle_guard 1 /opt/homebrew; then
  fail "invalid result ownership was accepted"
fi
unset MISE_BREW_ORACLE_RESULT_UID MISE_BREW_ORACLE_RESULT_GID
if [[ -e $result_dir/invalid-result-owner.completed ]]; then
  fail "invalid result ownership left a completion marker"
fi

brew_oracle_require_disposable early-producer /opt/homebrew
(exit 0)
if brew_oracle_verify_marker \
  "$result_dir/early-producer.completed" early_producer 1 /opt/homebrew \
  "$MISE_BREW_ORACLE_MISE_SHA" \
  "$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_RELEASE" \
  "$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_SHA" \
  "$MISE_BREW_ORACLE_HOMEBREW_RUNTIME_RELEASE" \
  "$MISE_BREW_ORACLE_HOMEBREW_RUNTIME_SHA"; then
  fail "early producer left passing proof"
fi

brew_oracle_require_disposable wrong-prefix /opt/homebrew
if brew_oracle_complete test_brew_oracle_guard 1 /private/tmp/not-homebrew; then
  fail "wrong actual prefix was accepted"
fi

foreign_path="$TMPDIR/foreign-target"
mkdir "$foreign_path"
if brew_oracle_require_absent_path "$foreign_path" "foreign fixture"; then
  fail "foreign target was accepted"
fi

MISE_BREW_ORACLE_RESULT_DIR=$HOME
if brew_oracle_require_disposable escaped-result /opt/homebrew; then
  fail "result directory outside runner temp was accepted"
fi

result_link="$TMPDIR/oracle-results-link"
ln -s "$result_dir" "$result_link"
MISE_BREW_ORACLE_RESULT_DIR=$result_link
if brew_oracle_require_disposable symlinked-result /opt/homebrew; then
  fail "symlinked result directory was accepted"
fi

MISE_BREW_ORACLE_RESULT_DIR=$result_dir
MISE_BREW_ORACLE_HOMEBREW_RUNTIME_SHA=not-installed
if brew_oracle_require_disposable incomplete-runtime-identity /opt/homebrew; then
  fail "incomplete Homebrew runtime identity was accepted"
fi

MISE_BREW_ORACLE_HOMEBREW_RUNTIME_RELEASE=6.0.16
MISE_BREW_ORACLE_HOMEBREW_RUNTIME_SHA=$MISE_BREW_ORACLE_HOMEBREW_REFERENCE_SHA
if brew_oracle_require_disposable mismatched-runtime /opt/homebrew; then
  fail "Homebrew runtime differing from the pinned reference was accepted"
fi
