#!/usr/bin/env bash
# e2e:writable-rootfs

# Linuxbrew pour test: the dedicated job runs this as root in the e2e
# container's fresh writable rootfs and fresh /home bind mount. The host's
# /home/linuxbrew is never a mutation target.
if [[ $(uname) != Linux ]]; then
  echo "SKIP: brew formula oracle requires Linux" >&2
  exit 0
fi
[[ $(id -u) == 0 ]] || {
  echo "brew oracle safety check failed: Linux oracle must run as root" >&2
  exit 1
}
case "$(uname -m)" in
  x86_64 | aarch64) ;;
  *)
    echo "SKIP: unsupported Linux architecture for brew oracle" >&2
    exit 0
    ;;
esac

# shellcheck source=e2e/cli/brew_oracle_guard.sh
source "${BASH_SOURCE[0]%/*}/brew_oracle_guard.sh"
brew_oracle_require_disposable linux-formula /home/linuxbrew/.linuxbrew

linuxbrew_home_existed=0
linuxbrew_home_mode=
if [[ -L /home/linuxbrew ]]; then
  brew_oracle_fail "Linuxbrew home is a symlink"
elif [[ -e /home/linuxbrew ]]; then
  [[ -d /home/linuxbrew ]] || brew_oracle_fail "Linuxbrew home is not a directory"
  [[ $(stat -c %u:%g /home/linuxbrew) == 0:0 ]] ||
    brew_oracle_fail "Linuxbrew home is not root-owned"
  ! mountpoint -q /home/linuxbrew || brew_oracle_fail "Linuxbrew home is a mount point"
  [[ -z $(find /home/linuxbrew -mindepth 1 -maxdepth 1 -print -quit) ]] ||
    brew_oracle_fail "ambiguous non-empty Linuxbrew home"
  linuxbrew_home_existed=1
  linuxbrew_home_mode=$(stat -c %a /home/linuxbrew)
fi
if getent passwd linuxbrew >/dev/null 2>&1; then
  brew_oracle_fail "pre-existing linuxbrew user is ambiguous"
fi
# Do not inspect process command lines: this oracle's own shell and awk source
# contain the literal canonical prefix and therefore self-match. Inspect live
# kernel path references instead, excluding this shell and its parent.
for proc in /proc/[0-9]*; do
  pid=${proc##*/}
  [[ $pid != $$ && $pid != $PPID ]] || continue
  for proc_link in "$proc/cwd" "$proc/exe" "$proc/root" "$proc"/fd/*; do
    [[ -L $proc_link ]] || continue
    proc_target=$(readlink -f "$proc_link" 2>/dev/null || true)
    case "$proc_target" in
      /home/linuxbrew/.linuxbrew | /home/linuxbrew/.linuxbrew/*)
        brew_oracle_fail "process $pid references the Linuxbrew prefix through $proc_link"
        ;;
    esac
  done
done

{
  printf 'existed=%s\n' "$linuxbrew_home_existed"
  printf 'mode=%s\n' "${linuxbrew_home_mode:-absent}"
  printf 'owner=%s\n' "$(stat -c %u:%g /home/linuxbrew 2>/dev/null || printf absent)"
} >"$MISE_BREW_ORACLE_RESULT_DIR/linux-home.preexisting"

cleanup_linuxbrew_home() {
  rm -rf /home/linuxbrew
  if [[ $linuxbrew_home_existed == 1 ]]; then
    install -d -m "$linuxbrew_home_mode" -o root -g root /home/linuxbrew
  fi
}
trap cleanup_linuxbrew_home EXIT

cat <<EOF >mise.toml
[bootstrap.packages]
"brew:xz" = "latest"
EOF

assert_contains "mise bootstrap packages status" "missing"

mise bootstrap packages apply --yes
assert_contains "mise bootstrap packages status" "installed"
assert_succeed "test -L /home/linuxbrew/.linuxbrew/var/homebrew/linked/xz"
assert_succeed "test \"$(readlink -f /home/linuxbrew/.linuxbrew/opt/xz)\" = \"$(readlink -f /home/linuxbrew/.linuxbrew/var/homebrew/linked/xz)\""

# the poured binary runs at the canonical prefix (relocation + linking worked)
assert_contains "/home/linuxbrew/.linuxbrew/bin/xz --version" "xz"

# repair either active-keg record without repouring or relinking the keg
keg="$(readlink -f /home/linuxbrew/.linuxbrew/opt/xz)"
receipt_mtime="$(stat -c %y "$keg/INSTALL_RECEIPT.json")"
keg_inode="$(stat -c %i "$keg")"
public_link_inode="$(stat -c %i /home/linuxbrew/.linuxbrew/bin/xz)"
rm /home/linuxbrew/.linuxbrew/var/homebrew/linked/xz
assert_contains "mise bootstrap packages status" "needs repair"
mise bootstrap packages apply --yes
assert_succeed "test \"$(readlink -f /home/linuxbrew/.linuxbrew/var/homebrew/linked/xz)\" = \"$keg\""
assert_succeed "test \"$(stat -c %y "$keg/INSTALL_RECEIPT.json")\" = \"$receipt_mtime\""
assert_succeed "test \"$(stat -c %i "$keg")\" = \"$keg_inode\""
assert_succeed "test \"$(stat -c %i /home/linuxbrew/.linuxbrew/bin/xz)\" = \"$public_link_inode\""

rm /home/linuxbrew/.linuxbrew/opt/xz
assert_contains "mise bootstrap packages status" "needs repair"
mise bootstrap packages apply --yes
assert_succeed "test \"$(readlink -f /home/linuxbrew/.linuxbrew/opt/xz)\" = \"$keg\""
assert_succeed "test \"$(stat -c %i "$keg")\" = \"$keg_inode\""
assert_succeed "test \"$(stat -c %i /home/linuxbrew/.linuxbrew/bin/xz)\" = \"$public_link_inode\""

# idempotent
assert_contains "mise bootstrap packages apply --yes 2>&1" "already"

# import previews and writes the currently installed requested formula
assert_contains "mise bootstrap packages import --manager brew --dry-run --path imported.toml" '"brew:xz" = "latest"'
mise bootstrap packages import --manager brew --path imported.toml
assert_contains "cat imported.toml" '"brew:xz" = "latest"'

# prune is a no-op while the formula is still configured
assert_contains "mise bootstrap packages prune --manager brew --dry-run 2>&1" "nothing to prune"

# after removing it from config, prune previews and removes the linked formula
cat <<EOF >mise.toml
[bootstrap.packages]
EOF
assert_contains "mise bootstrap packages prune --manager brew --dry-run" "remove brew:xz"
mise bootstrap packages prune --manager brew --yes
assert_fail "test -e /home/linuxbrew/.linuxbrew/opt/xz"
assert_fail "test -L /home/linuxbrew/.linuxbrew/var/homebrew/linked/xz"

brew_oracle_complete test_system_install_brew_linux 1 /home/linuxbrew/.linuxbrew
