#!/usr/bin/env bash

export MISE_LOCKFILE=1

# A format-0 unbound entry must not survive beside the bound entry that a
# tool option change produces for the same version and backend.
cat <<EOT >mise.lock
[[tools."pipx:cowsay"]]
version = "6.1"
backend = "pipx:cowsay"
EOT
cat <<EOT >mise.toml
[tools]
"pipx:cowsay" = { version = "6.1", uvx = false }
EOT

mise lock --upgrade --platform linux-x64
assert "grep -c '^version = ' mise.lock" "1"
assert_contains "cat mise.lock" "specifiers"

# A second plain run keeps a single entry.
mise lock --platform linux-x64
assert "grep -c '^version = ' mise.lock" "1"
