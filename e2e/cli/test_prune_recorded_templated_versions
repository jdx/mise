#!/usr/bin/env bash
# With the identity install layout, prune protects what a templated version rendered to
# when the project was installed, instead of rendering it from the prune directory.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project/child elsewhere
echo '[vars]
tool_version = "1.0.0"' >project/mise.toml
echo '[tools]
dummy = "{{vars.tool_version}}"' >project/child/mise.toml
assert "mise -C project/child install"
assert "mise install dummy@3.0.0"

for directory in project/child elsewhere; do
  assert "mise -C '$directory' ls --prunable --json >prunable.json"
  assert "jq -e '[.dummy[].version] == [\"3.0.0\"]' prunable.json"
  assert_contains "mise -C '$directory' prune --dry-run 2>&1" "dummy@3.0.0"
  assert_not_contains "mise -C '$directory' prune --dry-run 2>&1" "dummy@1.0.0"
done

# Editing the parent re-renders the child; the next use records the new version and
# replaces the old record, so 1.0.0 stops being protected.
echo '[vars]
tool_version = "2.0.0"' >project/mise.toml
assert "mise -C project/child install"
assert "mise -C elsewhere ls --prunable --json >prunable.json"
assert "jq -e '[.dummy[].version] | sort == [\"1.0.0\", \"3.0.0\"]' prunable.json"
