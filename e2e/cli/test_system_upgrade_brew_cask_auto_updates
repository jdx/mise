#!/usr/bin/env bash

if [[ "$(uname)" != "Darwin" ]]; then
  exit 0
fi

python3 - "$PWD" <<'PYTHON'
import io
import json
import os
from pathlib import Path
import plistlib
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import zipfile

root = Path(sys.argv[1]).resolve()
prefix = root / "brew-prefix"
appdir = prefix / "Applications"
metadata = {}
archives = {}
downloads = []


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path in metadata:
            body = json.dumps(metadata[path]).encode()
            kind = "application/json"
        elif path in archives:
            downloads.append(path)
            body = archives[path]
            kind = "application/zip"
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
base = f"http://127.0.0.1:{server.server_port}"
cases = {
    "older": ("9.2.3", "9.2.6", True),
    "equal": ("9.2.6", "9.2.3", True),
    "newer": ("9.2.7", "9.2.3", True),
    "unknown": ("9.2.6,123", "9.2.3", True),
    "external": ("9.2.3", "9.2.3", True),
    "ordinary": ("9.2.3", "9.2.3", False),
}
receipts = {}
for token, (live, recorded, auto) in cases.items():
    app = appdir / f"{token}.app"
    (app / "Contents").mkdir(parents=True)
    (app / "Contents/Info.plist").write_bytes(plistlib.dumps({"CFBundleShortVersionString": live}))
    (app / "Contents/payload").write_text("original")
    caskroom = prefix / "Caskroom" / token / recorded
    caskroom.mkdir(parents=True)
    (caskroom / app.name).symlink_to(app)
    if token == "external":
        (caskroom.parent / ".metadata").mkdir()
    else:
        receipt = caskroom / ".mise-cask.toml"
        receipt.write_text(
            f"schema_version = 1\nversion = {json.dumps(recorded)}\nauto_updates = {str(auto).lower()}\n"
            f"apps = [{json.dumps(str(app))}]\nmetadata_only_apps = [{json.dumps(str(app))}]\n"
        )
        receipts[token] = (receipt, receipt.read_bytes())
    content = io.BytesIO()
    with zipfile.ZipFile(content, "w") as archive:
        archive.writestr(f"{app.name}/Contents/Info.plist", plistlib.dumps({"CFBundleShortVersionString": "9.2.6"}))
        archive.writestr(f"{app.name}/Contents/payload", "distribution")
    archives[f"/{token}.zip"] = content.getvalue()
    metadata[f"/api/cask/{token}.json"] = {
        "token": token,
        "version": "9.2.6",
        "auto_updates": auto,
        "url": f"{base}/{token}.zip",
        "sha256": "no_check",
        "artifacts": [{"unsupported_future_artifact": ["ignored"]}] if token == "external" else [{"app": [app.name]}],
    }
(root / "mise.toml").write_text("[bootstrap.packages]\n" + "".join(f'"brew-cask:{token}" = "latest"\n' for token in cases))
env = dict(os.environ, MISE_SYSTEM_BREW_PREFIX=str(prefix), MISE_BREW_CASK_OPT_APPDIR=str(appdir),
           MISE_URL_REPLACEMENTS=json.dumps({"https://formulae.brew.sh": base}))


def run(*args):
    command = ["mise", "bootstrap", "packages", *args]
    print("$ " + " ".join(command), flush=True)
    result = subprocess.run(command, env=env, text=True, capture_output=True)
    print(result.stdout, end="", flush=True)
    print(result.stderr, end="", flush=True)
    assert result.returncode == 0, (command, result.returncode)
    return result


def snapshot():
    return {
        str(path.relative_to(prefix)): ("link", os.readlink(path)) if path.is_symlink()
        else ("file", path.read_bytes()) if path.is_file() else ("dir",)
        for path in prefix.rglob("*")
    }


thread = threading.Thread(target=server.serve_forever, daemon=True)
thread.start()
try:
    before = snapshot()
    status = json.loads(run("status", "--json").stdout)["brew-cask"]["packages"]
    equal = next(package for package in status if package["package"] == "equal")
    assert equal["state"] == "installed" and equal["installed_version"] == "9.2.3" and equal["auto_updates"] is True, equal

    result = run("upgrade", "--dry-run", "--yes")
    output = result.stdout + result.stderr
    assert "brew-cask:older: would upgrade 9.2.3 -> 9.2.6" in output
    assert "brew-cask: 2 would upgrade, 1 up to date, 3 skipped" in output
    assert "macOS may revoke Privacy & Security" not in output
    assert snapshot() == before
    assert downloads == []

    result = run("apply", "--yes")
    assert "already installed" in result.stdout + result.stderr
    assert snapshot() == before
    assert downloads == []

    result = run("upgrade", "--yes")
    output = result.stdout + result.stderr
    assert output.count("brew-cask:older: upgraded 9.2.3 -> 9.2.6") == 1, output
    assert "brew-cask:equal: already up to date (9.2.6)" in output
    assert "brew-cask:newer: skipped: live version 9.2.7 is newer than cask 9.2.6" in output
    assert "brew-cask:unknown: skipped:" in output
    assert "brew-cask:external: skipped: managed by Homebrew" in output
    assert "brew-cask: 2 upgraded, 1 up to date, 3 skipped" in output
    assert "brew-cask: already up to date" not in output
    assert output.count("macOS may revoke Privacy & Security") == 2, output
    assert sorted(downloads) == ["/older.zip", "/ordinary.zip"], downloads
    for token in cases:
        expected = "distribution" if token in ("older", "ordinary") else "original"
        assert (appdir / f"{token}.app/Contents/payload").read_text() == expected, token
    for token in ("equal", "newer", "unknown"):
        path, original = receipts[token]
        assert path.read_bytes() == original, token
    older_receipt = prefix / "Caskroom/older/9.2.6/.mise-cask.toml"
    assert 'version = "9.2.6"' in older_receipt.read_text()
    assert "auto_updates = true" in older_receipt.read_text()
    assert "metadata_only_apps" in older_receipt.read_text()
    assert (prefix / "Caskroom/older/9.2.6/older.app").is_symlink()
    status = json.loads(run("status", "--json").stdout)["brew-cask"]["packages"]
    equal = next(package for package in status if package["package"] == "equal")
    assert equal["installed_version"] == "9.2.3" and equal["auto_updates"] is True, equal
finally:
    server.shutdown()
    thread.join()
    server.server_close()
PYTHON
