#!/usr/bin/env bash
# A templated config with nothing recorded for it (installed before the layout, or its
# record was lost) makes prune refuse rather than render it from the wrong directory.
export MISE_EXPERIMENTAL=1
export MISE_INSTALL_LAYOUT=identity

mkdir -p project elsewhere
echo '[vars]
v = "1.0.0"' >project/mise.toml
mkdir project/child
echo '[tools]
dummy = "{{vars.v}}"' >project/child/mise.toml
assert "mise -C project/child install"
assert "mise install dummy@3.0.0"
rm -rf "$MISE_DATA_DIR/installs/.mise/claims"

assert_fail "mise -C elsewhere prune --yes" "no installation has been recorded"
assert_fail "mise -C elsewhere ls --prunable --json" "no installation has been recorded"
assert_contains "mise ls dummy" "1.0.0"

# Using the project again records it.
assert "mise -C project/child install"
assert_contains "mise -C elsewhere prune --dry-run 2>&1" "dummy@3.0.0"
