#!/usr/bin/env bash

set -euo pipefail

unset CARGO_HOME RUSTUP_HOME MISE_CARGO_HOME MISE_RUSTUP_HOME

# A fake rustup whose `check` reports a stable update (rustup 1.29 wording)
# for as long as $STATE/update_available exists. Installing stable clears it.
HOST=aarch64-unknown-linux-musl
PREFIX=$PWD/prefix
BIN=$PREFIX/bin
STATE=$PREFIX/state
mkdir -p "$BIN" "$PREFIX/libexec/bin" "$PREFIX/etc/rustup" "$STATE" "$PWD/home" "$PWD/project"
echo 'default_toolchain = "stable"' >"$PREFIX/etc/rustup/settings.toml"

for command in rustup cargo rustc; do
  cat >"$PREFIX/libexec/bin/$command" <<'PROXY'
#!/usr/bin/env bash
set -euo pipefail
STATE=$TEST_RUST_PROVIDER_PREFIX/state
case "$(basename "$0")" in
rustup)
	echo "$*" >>"$STATE/rustup.log"
	case "${1:-} ${2:-}" in
	"--version ") echo "rustup 1.29.1 (fake)" ;;
	"show profile") echo minimal ;;
	"toolchain install")
		mkdir -p "$STATE/toolchains/$3"
		rm -f "$STATE/update_available"
		;;
	"toolchain uninstall") rm -rf "$STATE/toolchains/$3" ;;
	"component list" | "target list") ;;
	"check ")
		if [[ -e $STATE/update_available ]]; then
			echo "stable-aarch64-unknown-linux-musl - update available: 1.98.1 (aaaa 2026-09-01) -> 1.99.0 (bbbb 2026-09-28)"
		else
			echo "stable-aarch64-unknown-linux-musl - up to date : 1.99.0 (bbbb 2026-09-28)"
		fi
		echo "nightly-aarch64-unknown-linux-musl - update available: 1.100.0-nightly (cccc 2026-08-23) -> 1.101.0-nightly (dddd 2026-10-01)"
		echo "rustup - up to date : 1.29.1"
		exit 100
		;;
	*)
		echo "unexpected rustup args: $*" >&2
		exit 1
		;;
	esac
	;;
rustc | cargo)
	if [[ ! -d "$STATE/toolchains/$RUSTUP_TOOLCHAIN" ]]; then
		echo "error: toolchain '$RUSTUP_TOOLCHAIN' is not installed" >&2
		exit 1
	fi
	echo "$(basename "$0") $RUSTUP_TOOLCHAIN (fake)"
	;;
esac
PROXY
  chmod +x "$PREFIX/libexec/bin/$command"
  cat >"$BIN/$command" <<WRAPPER
#!/usr/bin/env bash
export RUSTUP_OVERRIDE_UNIX_FALLBACK_SETTINGS="$PREFIX/etc/rustup/settings.toml"
export TEST_RUST_PROVIDER_PREFIX="$PREFIX"
exec "$PREFIX/libexec/bin/$command" "\$@"
WRAPPER
  chmod +x "$BIN/$command"
done

cat >project/mise.toml <<'TOML'
[tools]
rust = "stable"
TOML

cd project
export HOME="$PWD/../home"
export MISE_DATA_DIR="$PWD/../data"
export PATH="$BIN:$PATH"
# rustup lists the toolchain under the configured host, not mise's build target
export MISE_RUST_DEFAULT_HOST="$HOST"

mise install
assert_contains "grep -c '^toolchain install stable' '$STATE/rustup.log'" "1"

# Up to date: only nightly is outdated, which must not count against stable.
assert "mise outdated rust --json" "{}"
mise upgrade rust
assert_contains "grep -c '^toolchain install stable' '$STATE/rustup.log'" "1"

# rustup 1.29 reports a stable update: mise sees it and reinstalls the channel.
touch "$STATE/update_available"
assert_contains "mise upgrade rust --dry-run" "Would install rust@stable"
mise upgrade rust
assert_contains "grep -c '^toolchain install stable' '$STATE/rustup.log'" "2"
# The channel is updated in place: a failed install must not strand the old toolchain.
assert "! grep -q '^toolchain uninstall' '$STATE/rustup.log'"
assert "mise outdated rust --json" "{}"
