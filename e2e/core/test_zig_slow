#!/usr/bin/env bash

assert "mise x zig@0.13.0 -- zig version" "0.13.0"

# #10251: zig@master is a rolling channel. Resolve its current concrete version
# from Zig's official index; master may temporarily point at a stable release.
# It must not short-circuit to the unrelated installed 0.13.0 or create a frozen
# "master" install directory.
master_version=$(curl -fsSL https://ziglang.org/download/index.json | jq -r '.master.version')
assert "mise x zig@master -- zig version" "$master_version"
[ ! -d "$MISE_DATA_DIR/installs/zig/master" ] || fail "zig@master must not create a frozen installs/zig/master dir"
[ -d "$MISE_DATA_DIR/installs/zig/$master_version" ] || fail "zig@master should install the concrete indexed version"
