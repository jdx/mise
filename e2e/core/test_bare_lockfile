#!/usr/bin/env bash

export MISE_LOCKFILE=1

cat <<'EOF' >mise.toml
[tools]
bare = "1.33.4"
EOF

mise lock --platform linux-x64,linux-arm64,macos-x64,macos-arm64

assert_contains "cat mise.lock" '[[tools.bare]]'
assert_contains "cat mise.lock" 'backend = "core:bare"'
assert_contains "cat mise.lock" 'checksum = "sha256:'
assert_contains "cat mise.lock" 'bare-runtime-linux-x64-1.33.4.tgz'
assert_contains "cat mise.lock" 'bare-runtime-linux-arm64-1.33.4.tgz'
assert_contains "cat mise.lock" 'bare-runtime-darwin-x64-1.33.4.tgz'
assert_contains "cat mise.lock" 'bare-runtime-darwin-arm64-1.33.4.tgz'

assert "mise install --locked --dry-run"
