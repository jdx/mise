#!/usr/bin/env bash
# A config folder that is a git repository of its own, such as a tracked
# `.config`, is still the config of the directory around it.

export MISE_TRUSTED_CONFIG_PATHS=""

mkdir -p projects/sibling
cd projects || exit 1

mkdir -p .config/mise/tasks mise/tasks
cat <<EOF2 >.config/mise.toml
[env]
CONFIG_ENV = "1"
EOF2
cat <<EOF2 >mise/config.toml
[env]
MISE_DIR_ENV = "1"
EOF2
cat <<EOF2 >mise/tasks/clonetask
#!/usr/bin/env bash
echo clonetask
EOF2
cat <<EOF2 >.config/mise/tasks/foldertask
#!/usr/bin/env bash
echo foldertask
EOF2
chmod +x mise/tasks/clonetask .config/mise/tasks/foldertask
git init -q .config
git init -q mise
mise trust

assert_contains "mise env -s bash" "CONFIG_ENV"
assert_contains "mise env -s bash" "MISE_DIR_ENV"
assert_contains "mise tasks ls" "clonetask"
assert_contains "mise tasks ls" "foldertask"

cd sibling || exit 1
assert_contains "mise env -s bash" "CONFIG_ENV"
assert_contains "mise env -s bash" "MISE_DIR_ENV"
assert_contains "mise tasks ls" "clonetask"
assert_contains "mise tasks ls" "foldertask"

# An ignore recorded for the folder itself, from before it shared its parent's
# trust root, still refuses the config and its tasks.
mkdir -p "$MISE_STATE_DIR/ignored-configs"
ln -s "$(cd .. && pwd -P)/.config" "$MISE_STATE_DIR/ignored-configs/legacy-config"
assert_not_contains "mise env -s bash 2>&1" "CONFIG_ENV"
assert_not_contains "mise tasks ls 2>&1" "foldertask"
# a trusted_config_paths entry for the directory overrides the saved ignore
assert_contains "MISE_TRUSTED_CONFIG_PATHS=$(cd .. && pwd -P) mise tasks ls" "foldertask"
# a narrower trusted_config_paths entry covering the task directory does too
assert_contains "MISE_TRUSTED_CONFIG_PATHS=$(cd .. && pwd -P)/.config/mise mise tasks ls" "foldertask"
# and the tasks stay out when mise runs from inside the ignored folder
(cd ../.config && assert_not_contains "mise tasks ls 2>&1" "foldertask")
assert_contains "mise env -s bash" "MISE_DIR_ENV"

# Trusting the config clears that ignore again.
mise trust ../.config/mise.toml
assert_contains "mise env -s bash" "CONFIG_ENV"
assert_contains "mise tasks ls" "foldertask"

# A plain `mise trust` clears it as well.
mise untrust ../.config/mise.toml
ln -s "$(cd .. && pwd -P)/.config" "$MISE_STATE_DIR/ignored-configs/legacy-config"
assert_fail "MISE_YES=0 mise env -s bash"
mise trust
assert_contains "mise env -s bash" "CONFIG_ENV"
