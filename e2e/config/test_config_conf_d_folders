#!/usr/bin/env bash
# A folder inside conf.d is a config fragment with its own config root:
# conf.d/<name>/mise.toml always loads, mise.<env>.toml loads with that env,
# and relative paths resolve inside the folder.

# Project folder fragments
mkdir -p .mise/conf.d/git .mise/conf.d/.hidden
cat >.mise/conf.d/01-file.toml <<'EOF'
[env]
FRAGMENT_ORDER = "file"
EOF
cat >.mise/conf.d/git/mise.toml <<'EOF'
[env]
FRAGMENT_ORDER = "folder"
GIT_ROOT = "{{ config_root }}"

[tasks.where]
run = "pwd"
EOF
cat >.mise/conf.d/git/mise.dev.toml <<'EOF'
[env]
GIT_ENV = "dev"
EOF
cat >.mise/conf.d/.hidden/mise.toml <<'EOF'
[env]
HIDDEN_FOLDER = "unexpected"
EOF

assert_contains "mise config ls" ".mise/conf.d/git/mise.toml"
assert_not_contains "mise config ls" ".mise/conf.d/git/mise.dev.toml"
assert_not_contains "mise config ls" ".hidden"
# folders load after single-file fragments
assert_contains "mise env -s bash" "FRAGMENT_ORDER=folder"
assert_contains "mise env -s bash" "GIT_ROOT=$PWD/.mise/conf.d/git"
assert_not_contains "mise env -s bash" "GIT_ENV"
assert_not_contains "mise env -s bash" "HIDDEN_FOLDER"
assert "mise run --skip-tools where" "$PWD/.mise/conf.d/git"

# a folder's task_config.includes resolve inside it, its file tasks run there,
# and it does not replace the project's default task directories
mkdir -p .mise/tasks .mise/conf.d/git/tasks
printf '#!/usr/bin/env bash\necho "project-task"\n' >.mise/tasks/project-task
cat >.mise/conf.d/git/tasks/git-file <<'EOF'
#!/usr/bin/env bash
echo "$PWD $MISE_CONFIG_ROOT"
EOF
chmod +x .mise/tasks/project-task .mise/conf.d/git/tasks/git-file
cat >>.mise/conf.d/git/mise.toml <<'EOF'

[task_config]
includes = ["tasks"]
EOF
assert "mise run --skip-tools git-file" "$PWD/.mise/conf.d/git $PWD/.mise/conf.d/git"
assert "mise run --skip-tools project-task" "project-task"
# a folder fragment has higher precedence than a single-file fragment
cat >>.mise/conf.d/01-file.toml <<'EOF'

[tasks.where]
run = "echo file-fragment"
EOF
assert "mise run --skip-tools where" "$PWD/.mise/conf.d/git"

# a task a folder defines beats one from the enclosing root's default task
# directories, whether or not a single-file fragment sits beside the folder
mkdir -p shadow/.mise/tasks shadow/.mise/conf.d/folder
echo '[env]' >shadow/mise.toml
cat >shadow/.mise/tasks/shadowed <<'EOF'
#!/usr/bin/env bash
echo default-dir
EOF
chmod +x shadow/.mise/tasks/shadowed
cat >shadow/.mise/conf.d/folder/mise.toml <<'EOF'
[tasks.shadowed]
run = "echo folder"
EOF
assert "cd shadow && mise run --skip-tools shadowed" "folder"
echo '[env]' >shadow/.mise/conf.d/00-file.toml
assert "cd shadow && mise run --skip-tools shadowed" "folder"

# task_config cascaded from a parent root still reaches a folder's tasks,
# including its excludes
mkdir -p cascade/child/.mise/conf.d/frag/tasks
cat >cascade/wrap <<'EOF'
#!/usr/bin/env bash
echo wrapped
exec bash "$@"
EOF
chmod +x cascade/wrap
cat >cascade/mise.toml <<EOF
[task_config]
cascade = true
shell = "$PWD/cascade/wrap -c"
excludes = ["child/.mise/conf.d/frag/tasks/excluded"]
EOF
cat >cascade/child/.mise/conf.d/frag/mise.toml <<'EOF'
[task_config]
includes = ["tasks"]

[tasks.frag-shell]
run = "echo frag"
EOF
for t in kept excluded; do
  printf '#!/usr/bin/env bash\necho %s\n' "$t" >"cascade/child/.mise/conf.d/frag/tasks/$t"
  chmod +x "cascade/child/.mise/conf.d/frag/tasks/$t"
done
assert_contains "cd cascade/child && mise tasks ls" "kept"
assert_not_contains "cd cascade/child && mise tasks ls" "excluded"
assert "cd cascade/child && mise run --skip-tools frag-shell" "wrapped
frag"

# environment files inside a folder follow the usual rule
assert_contains "MISE_ENV=dev mise config ls" ".mise/conf.d/git/mise.dev.toml"
assert_contains "MISE_ENV=dev mise env -s bash" "GIT_ENV=dev"

# the project's own config still has higher precedence than every fragment
cat >.mise/config.toml <<'EOF'
[env]
FRAGMENT_ORDER = "config"
EOF
assert_contains "mise env -s bash" "FRAGMENT_ORDER=config"

# Global folder fragments keep relative sources and config_root inside the folder,
# including when the folder is a symlink into a dotfiles checkout.
mkdir -p "$HOME/dotfiles/shell/zsh" "$MISE_CONFIG_DIR/conf.d/dev-git"
echo "[user]" >"$MISE_CONFIG_DIR/conf.d/dev-git/gitconfig"
cat >"$MISE_CONFIG_DIR/conf.d/dev-git/mise.toml" <<'EOF'
[env]
DEV_GIT_ROOT = "{{ config_root }}"

[dotfiles]
"~/.gitconfig" = "gitconfig"
EOF
echo "# zsh" >"$HOME/dotfiles/shell/zsh/zshrc"
cat >"$HOME/dotfiles/shell/zsh/mise.dev.toml" <<'EOF'
[dotfiles]
"~/.zshrc" = "zshrc"
EOF
ln -s "$HOME/dotfiles/shell/zsh" "$MISE_CONFIG_DIR/conf.d/shell-zsh"

assert_contains "mise env -s bash" "DEV_GIT_ROOT=$MISE_CONFIG_DIR/conf.d/dev-git"

# Global folder fragment tasks run in the folder too, with config_root and
# MISE_CONFIG_ROOT pointing at it, and leave the global tasks directory loaded.
mkdir -p "$MISE_CONFIG_DIR/tasks" "$MISE_CONFIG_DIR/conf.d/dev-git/tasks"
printf '#!/usr/bin/env bash\necho "global-task"\n' >"$MISE_CONFIG_DIR/tasks/global-task"
cat >"$MISE_CONFIG_DIR/conf.d/dev-git/tasks/dev-git-file" <<'EOF'
#!/usr/bin/env bash
echo "$PWD $MISE_CONFIG_ROOT"
EOF
chmod +x "$MISE_CONFIG_DIR/tasks/global-task" "$MISE_CONFIG_DIR/conf.d/dev-git/tasks/dev-git-file"
cat >>"$MISE_CONFIG_DIR/conf.d/dev-git/mise.toml" <<'EOF'

[task_config]
includes = ["tasks"]

[tasks.dev-git-root]
run = 'echo "{{ config_root }}"'

[tasks.dev-git-pwd]
run = "pwd"
EOF
assert "mise run --skip-tools dev-git-root" "$MISE_CONFIG_DIR/conf.d/dev-git"
assert "mise run --skip-tools dev-git-pwd" "$MISE_CONFIG_DIR/conf.d/dev-git"
assert "mise run --skip-tools dev-git-file" "$MISE_CONFIG_DIR/conf.d/dev-git $MISE_CONFIG_DIR/conf.d/dev-git"
assert "mise run --skip-tools global-task" "global-task"
assert_contains "mise bootstrap --dry-run" "conf.d/dev-git/gitconfig"
assert_not_contains "mise bootstrap --dry-run" "zshrc"
assert_contains "MISE_ENV=dev mise bootstrap --dry-run" "shell-zsh/zshrc"

# Folder fragments are never write targets, just like single-file fragments.
mise set -g WRITE_TARGET=global
assert_contains "cat $MISE_CONFIG_DIR/config.toml" "WRITE_TARGET"
assert_not_contains "cat $MISE_CONFIG_DIR/conf.d/dev-git/mise.toml" "WRITE_TARGET"
mkdir -p only-folder/.mise/conf.d/tools
echo '[env]' >only-folder/.mise/conf.d/tools/mise.toml
mise use --path only-folder dummy@system
assert_contains "cat only-folder/mise.toml" "dummy"
assert_not_contains "cat only-folder/.mise/conf.d/tools/mise.toml" "dummy"
