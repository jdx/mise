#!/usr/bin/env bash

# A project's symlinks come with its working tree. Writing its config must not
# follow a link to a file elsewhere, or into mise's state directory, unless the
# project is trusted.
export MISE_TRUSTED_CONFIG_PATHS=""
export MISE_YES=0
unset CI GITHUB_ACTIONS GITHUB_ACTION 2>/dev/null || true

mkdir -p proj outside
cat <<'TOML' >outside/victim.toml
[tools]
TOML
cd proj || exit 1

echo "=== a link out of the project is not followed ==="
ln -s ../outside/victim.toml mise.toml
assert_fail_contains "mise set FOO=bar 2>&1" "refusing to write"
assert_not_contains "cat ../outside/victim.toml" "FOO"
assert_fail "mise config set env.FOO bar"
assert_not_contains "cat ../outside/victim.toml" "FOO"
assert_fail "mise tasks add hi -- echo hi"
assert_not_contains "cat ../outside/victim.toml" "hi"

echo "=== mise settings set and unset --local do not follow it either ==="
cat <<'TOML' >../outside/settings.toml
[settings]
jobs = 4
TOML
rm mise.toml
ln -s ../outside/settings.toml mise.toml
assert_fail_contains "mise settings unset --local jobs 2>&1" "refusing to write"
assert_contains "cat ../outside/settings.toml" "jobs = 4"
assert_fail_contains "mise settings set --local jobs 2 2>&1" "refusing to write"
assert_contains "cat ../outside/settings.toml" "jobs = 4"

echo "=== a dangling link out of the project creates nothing ==="
rm mise.toml
ln -s ../outside/new.toml mise.toml
assert_fail_contains "mise set FOO=bar 2>&1" "refusing to write"
assert_fail "test -e ../outside/new.toml"

echo "=== nothing is written into the state directory ==="
rm mise.toml
ln -s "$MISE_STATE_DIR/trusted-configs/planted" mise.toml
assert_fail_contains "mise set FOO=bar 2>&1" "refusing to write"
assert_fail "test -e $MISE_STATE_DIR/trusted-configs/planted"

echo "=== nor through a directory link that stays in a project holding the state directory ==="
mkdir -p ../state-in/state/sub
echo "[env]" >../state-in/state/sub/config.toml
cd ../state-in || exit 1
ln -s state/sub .mise
# control: while the state directory is elsewhere, the link inside the project is followed
assert "MISE_TRUSTED_CONFIG_PATHS=$PWD mise set --file .mise/config.toml CONTROL=1"
assert_contains "cat state/sub/config.toml" 'CONTROL = "1"'
assert_fail_contains "MISE_TRUSTED_CONFIG_PATHS=$PWD MISE_STATE_DIR=$PWD/state mise set --file .mise/config.toml FOO=bar 2>&1" "in mise's state directory"
assert_not_contains "cat state/sub/config.toml" "FOO"
cd ../proj || exit 1

echo "=== a link inside the project is followed ==="
rm mise.toml
mkdir -p config
cat <<'TOML' >config/real.toml
[tools]
TOML
ln -s config/real.toml mise.toml
assert "mise set FOO=bar"
assert_contains "cat config/real.toml" 'FOO = "bar"'
assert "test -L mise.toml"

echo "=== so is a directory link inside the project above a directory the write creates ==="
mkdir -p ../in-link/real
cd ../in-link || exit 1
ln -s real .config
assert "MISE_TRUSTED_CONFIG_PATHS=$PWD mise set --file .config/mise/config.toml NEWDIR=1"
assert_contains "cat real/mise/config.toml" 'NEWDIR = "1"'
cd ../proj || exit 1

echo "=== trust that yes grants in a fresh clone does not cover a link out ==="
mkdir -p ../clone
cat <<'TOML' >../outside/clone.toml
[env]
LINKED = "1"
[tools]
tiny = "1"
TOML
cd ../clone || exit 1
ln -s ../outside/clone.toml mise.toml
assert_fail_contains "MISE_YES=1 mise use --rm tiny 2>&1" "trusted before this command"
assert_contains "cat ../outside/clone.toml" 'tiny = "1"'
echo "=== and mise use refuses it before installing anything ==="
# A fresh clone: the run above recorded the trust that yes granted.
mkdir -p ../clone-use
cd ../clone-use || exit 1
ln -s ../outside/clone.toml mise.toml
assert_fail_contains "MISE_YES=1 mise use dummy@1.0.0 2>&1" "trusted before this command"
assert_fail "test -e $MISE_DATA_DIR/installs/dummy/1.0.0"
assert_not_contains "cat ../outside/clone.toml" "dummy"
cd ../proj || exit 1

echo "=== a linked directory out of the project is not followed ==="
mkdir -p ../dir-link ../outside/conf
cat <<'TOML' >../outside/conf/mise.toml
[tools]
TOML
cd ../dir-link || exit 1
ln -s ../outside/conf .config
assert_fail_contains "mise set --file .config/mise.toml FOO=bar 2>&1" "through a linked directory"
assert_fail_contains "MISE_SAFE=1 mise set --file .config/mise.toml FOO=bar 2>&1" "refusing to write"
assert_not_contains "cat ../outside/conf/mise.toml" "FOO"
assert_fail_contains "mise set --file .config/mise.local.toml FOO=bar 2>&1" "refusing to write"
assert_fail "test -e ../outside/conf/mise.local.toml"
cd ../proj || exit 1

echo "=== a trusted project may link out ==="
rm mise.toml
ln -s ../outside/victim.toml mise.toml
assert "mise trust mise.toml"
assert "mise set FOO=bar"
assert_contains "cat ../outside/victim.toml" 'FOO = "bar"'
assert_fail_contains "MISE_SAFE=1 mise set BAR=baz 2>&1" "refusing to write"

echo "=== a project's link to global config is not followed, trusted or not ==="
mkdir -p ../to-global "$HOME/.config/mise"
cat <<'TOML' >"$HOME/.config/mise/config.toml"
[env]
GLOBAL = "1"
TOML
cd ../to-global || exit 1
ln -s "$HOME/.config/mise/config.toml" mise.toml
assert_fail_contains "mise set FOO=bar 2>&1" "refusing to write"
assert_not_contains "cat $HOME/.config/mise/config.toml" "FOO"
assert "mise trust ."
assert_fail_contains "mise set FOO=bar 2>&1" "Write global config with"
assert_not_contains "cat $HOME/.config/mise/config.toml" "FOO"
assert "mise set -g FOO=bar"
assert_contains "cat $HOME/.config/mise/config.toml" 'FOO = "bar"'

echo "=== a directory link to global config inside the project is not followed ==="
back="$PWD"
cd "$HOME" || exit 1
ln -s .config/mise .mise
assert_fail_contains "mise set --file .mise/config.toml HOMELINK=1 2>&1" "Write global config with"
assert_not_contains "cat $HOME/.config/mise/config.toml" "HOMELINK"
# nor is one that is the project directory itself, as `~/cfg` is for `~/cfg/config.toml`
ln -s .config/mise cfg
assert_fail_contains "mise set --file cfg/config.toml CFGLINK=1 2>&1" "Write global config with"
assert_not_contains "cat $HOME/.config/mise/config.toml" "CFGLINK"
# nor is one to a folder of global config's conf.d, for a fragment that does not exist yet
mkdir -p .config/mise/conf.d/folder
rm .mise
ln -s .config/mise/conf.d/folder .mise
assert_fail_contains "mise set --file .mise/mise.toml FRAGLINK=1 2>&1" "Write global config with"
assert_fail "test -e $HOME/.config/mise/conf.d/folder/mise.toml"
# nor is a file link to a global config file that does not exist yet, which the home directory's
# project root would otherwise hold
ln -s .config/mise/config.local.toml mise.toml
assert_fail_contains "mise set --file mise.toml FILELINK=1 2>&1" "Write global config with"
assert_fail "test -e $HOME/.config/mise/config.local.toml"
rm mise.toml
# nor is one to a fragment in a folder of conf.d that does not exist yet, which the write would
# create and global discovery would load
ln -s .config/mise/conf.d/newfolder/mise.toml mise.toml
assert_fail_contains "mise set --file mise.toml NEWFOLDER=1 2>&1" "Write global config with"
assert_fail "test -e $HOME/.config/mise/conf.d/newfolder"
rm mise.toml
# nor is a task script's link to global config, which stays in the home directory's project root
rm .mise
mkdir -p mise-tasks
ln -s ../.config/mise/config.toml mise-tasks/gcfg
assert_fail_contains "mise tasks add --file --force gcfg -- echo replaced 2>&1" "leads into global config"
assert_fail_contains "MISE_SAFE=1 mise tasks add --file --force gcfg -- echo replaced 2>&1" "leads into global config"
assert_contains "cat $HOME/.config/mise/config.toml" 'FOO = "bar"'
rm -r mise-tasks
ln -s .config/mise .mise
cd "$back" || exit 1

echo "=== nor is one that would create a global config file ==="
mkdir -p ../to-global-dir
cd ../to-global-dir || exit 1
ln -s "$HOME/.config/mise" .mise
assert_fail_contains "mise set --file .mise/config.local.toml NEWFILE=1 2>&1" "Write global config with"
assert_fail "test -e $HOME/.config/mise/config.local.toml"
cd "$back" || exit 1

echo "=== global config reached through a linked home directory is global config ==="
linkhome="$(dirname "$HOME")/linkhome"
ln -s "$HOME" "$linkhome"
assert "mise set --file $linkhome/.config/mise/config.toml VIALINK=1"
assert_contains "cat $HOME/.config/mise/config.toml" 'VIALINK = "1"'

echo "=== so is one reached through a link above it at another depth ==="
# Like /home linked to /usr/home: the link sits in a directory that holds the
# home directory, and leaves the path a component longer.
top="$(dirname "$HOME")"
ln -s "$top" "$top/$(basename "$top")"
assert "mise set --file $top/$(basename "$top")/$(basename "$HOME")/.config/mise/config.toml DEPTH=1"
assert_contains "cat $HOME/.config/mise/config.toml" 'DEPTH = "1"'

echo "=== and a config directory outside the home directory, through a link beside it ==="
xdg="$top/xdg"
mkdir -p "$xdg/real/mise"
echo "[env]" >"$xdg/real/mise/config.toml"
ln -s "$xdg/real" "$xdg/alias"
assert "MISE_CONFIG_DIR=$xdg/real/mise mise set --file $xdg/alias/mise/config.toml OUTSIDE=1"
assert_contains "cat $xdg/real/mise/config.toml" 'OUTSIDE = "1"'

echo "=== also when the global config directory links into a dotfiles checkout ==="
# The link to the home directory is judged against where global config is
# spelled, not against where the dotfiles checkout puts the file.
mv "$HOME/.config/mise" "$top/dotfiles-mise"
ln -s "$top/dotfiles-mise" "$HOME/.config/mise"
ln -s "$HOME" "$HOME/h"
assert "mise set --file $HOME/h/.config/mise/config.toml DOTFILES=1"
assert_contains "cat $top/dotfiles-mise/config.toml" 'DOTFILES = "1"'
assert "mise set --file $linkhome/.config/mise/config.toml VIALINK2=1"
assert_contains "cat $top/dotfiles-mise/config.toml" 'VIALINK2 = "1"'

echo "=== a project's link to the home directory is not followed to global config ==="
mkdir -p ../home-link
cd ../home-link || exit 1
for name in home h; do
  ln -s "$HOME" "$name"
  assert_fail_contains "mise set --file $name/.config/mise/config.toml PROJLINK=1 2>&1" "Write global config with"
  assert_not_contains "cat $HOME/.config/mise/config.toml" "PROJLINK"
done
cd "$back" || exit 1

echo "=== tasks rm removes nothing when one file links out ==="
mkdir -p ../rm-two
cat <<'TOML' >../outside/rm.toml
[tasks.b]
run = "echo b"
TOML
cd ../rm-two || exit 1
cat <<'TOML' >mise.toml
[tasks.a]
run = "echo a"
TOML
ln -s ../outside/rm.toml mise.local.toml
assert_fail_contains "MISE_YES=1 mise tasks rm a b 2>&1" "refusing to write"
assert_contains "cat mise.toml" "[tasks.a]"
assert_contains "cat ../outside/rm.toml" "[tasks.b]"

echo "=== a dry run previews a dangling link's import without writing ==="
mkdir -p ../preview
cd ../preview || exit 1
echo "tiny 1.0.0" >.tool-versions
ln -s ../outside/preview.toml mise.toml
assert_contains "mise edit --dry-run --tool-versions .tool-versions 2>&1" 'tiny = "1.0.0"'
assert_fail "test -e ../outside/preview.toml"
assert_fail_contains "mise edit --tool-versions .tool-versions 2>&1" "refusing to write"
assert_fail "test -e ../outside/preview.toml"
# mise use previews the change to the link too, and only the write refuses it. Without --path it
# would pick .tool-versions, since the dangling link does not exist yet.
assert_contains "mise use --dry-run --path mise.toml tiny@1.0.0 2>&1" "would update"
# --dry-run-code exits 1 to say there is a change
assert_fail_contains "mise use --dry-run-code --path mise.toml tiny@1.0.0 2>&1" "would update"
assert_fail "test -e ../outside/preview.toml"
assert_fail_contains "mise use --path mise.toml tiny@1.0.0 2>&1" "refusing to write"
assert_fail "test -e ../outside/preview.toml"

echo "=== a bare file name's link inside the project is followed ==="
mkdir -p ../bare/config
cd ../bare || exit 1
echo "[tools]" >config/real.toml
ln -s config/real.toml mise.toml
assert "mise edit --force"
assert "test -L mise.toml"
assert_contains "cat config/real.toml" "mise config files are hierarchical"

echo "=== a task directory linked out of the project is not changed ==="
mkdir -p ../task-link ../outside/tasks
printf '#!/usr/bin/env bash\necho out\n' >../outside/tasks/out
chmod +x ../outside/tasks/out
cd ../task-link || exit 1
echo "[tools]" >mise.toml
ln -s ../outside/tasks mise-tasks
assert_fail_contains "MISE_YES=1 mise tasks rm out 2>&1" "through a linked directory"
assert "test -e ../outside/tasks/out"
assert_fail_contains "mise tasks add --file new -- echo new 2>&1" "through a linked directory"
assert_fail "test -e ../outside/tasks/new"

echo "=== nor is a conf.d folder linked out of the project, though it is a config root ==="
mkdir -p ../task-folder/.mise/conf.d ../outside/folder/tasks
printf '#!/usr/bin/env bash\necho folder\n' >../outside/folder/tasks/fout
chmod +x ../outside/folder/tasks/fout
printf '[task_config]\nincludes = ["tasks"]\n' >../outside/folder/mise.toml
cd ../task-folder || exit 1
echo "[tools]" >mise.toml
ln -s ../../../outside/folder .mise/conf.d/folder
# safe mode never follows a link out of the project: the folder's task directory
# is not read, so its tasks are neither listed nor removed
assert_not_contains "MISE_SAFE=1 mise tasks ls 2>/dev/null" "fout"
assert_contains "MISE_SAFE=1 mise tasks ls 2>&1" "resolves outside the project and safe mode"
assert_fail_contains "MISE_SAFE=1 MISE_YES=1 mise tasks rm fout 2>&1" "no task named fout"
assert "test -e ../outside/folder/tasks/fout"

echo "=== nor is .config/mise linked out of the project, though its mise.toml makes it a root ==="
mkdir -p ../task-dot-config/.config ../outside/dot-config/tasks
echo "[tools]" >../outside/dot-config/mise.toml
cd ../task-dot-config || exit 1
ln -s ../../outside/dot-config .config/mise
assert_fail_contains "MISE_SAFE=1 mise tasks add --file new -- echo new 2>&1" "through a linked directory"
assert_fail "test -e ../outside/dot-config/tasks/new"

echo "=== nor a task directory linked into a state directory inside the project ==="
mkdir -p ../task-state/state/scripts
cd ../task-state || exit 1
echo "[tools]" >mise.toml
ln -s state/scripts mise-tasks
# control: while the state directory is elsewhere, the link inside the project is followed
assert "MISE_TRUSTED_CONFIG_PATHS=$PWD mise tasks add --file control -- echo control"
assert "test -e state/scripts/control"
assert_fail_contains "MISE_TRUSTED_CONFIG_PATHS=$PWD MISE_STATE_DIR=$PWD/state mise tasks add --file planted -- echo planted 2>&1" "in mise's state directory"
assert_fail "test -e state/scripts/planted"
assert_fail_contains "MISE_TRUSTED_CONFIG_PATHS=$PWD MISE_STATE_DIR=$PWD/state MISE_YES=1 mise tasks rm control 2>&1" "in mise's state directory"
assert "test -e state/scripts/control"
cd ../task-link || exit 1

echo "=== a task script's own link out is removed, not followed ==="
rm mise-tasks
mkdir mise-tasks
ln -s ../../outside/tasks/out mise-tasks/out
assert_fail_contains "mise tasks add --file --force out -- echo replaced 2>&1" "through its symlink"
assert_not_contains "cat ../outside/tasks/out" "replaced"
assert "MISE_YES=1 mise tasks rm out"
assert_fail "test -L mise-tasks/out"
assert "test -e ../outside/tasks/out"

echo "=== a trusted project's task directory may link out ==="
rm -r mise-tasks
ln -s ../outside/tasks mise-tasks
assert "mise trust"
assert "MISE_YES=1 mise tasks rm out"
assert_fail "test -e ../outside/tasks/out"

echo "=== a linked .mise is checked for a file mise does not look for there ==="
mkdir -p ../dot-mise ../outside/dot-mise
echo "[env]" >../outside/dot-mise/mise.local.toml
cd ../dot-mise || exit 1
echo "[tools]" >mise.toml
ln -s ../outside/dot-mise .mise
assert_fail_contains "MISE_SAFE=1 mise set --file .mise/mise.local.toml FOO=bar 2>&1" "refusing to write"
assert_not_contains "cat ../outside/dot-mise/mise.local.toml" "FOO"

echo "=== a path that goes up out of a link with .. is refused ==="
# The system opens linked/../mise.toml beside where the link leads, not in the project, so the
# file mise edit would read is not the one its write would replace.
mkdir -p ../dotdot ../outside/deep/dir
echo "[env]" >../outside/deep/mise.toml
cd ../dotdot || exit 1
echo "[env]" >mise.toml
ln -s ../outside/deep/dir linked
assert_fail_contains "mise edit --force linked/../mise.toml 2>&1" "goes up from"
assert "cat mise.toml" "[env]"
assert "cat ../outside/deep/mise.toml" "[env]"
# a .. out of a regular directory names the file it appears to
mkdir sub
assert "mise edit --force sub/../mise.toml"
assert_contains "cat mise.toml" "mise config files are hierarchical"

echo "=== a task include that goes up out of a link with .. is refused ==="
# Discovery reads linked/../tasks beside where the link leads, so the script it found is not the
# one the change would reach in the project's own tasks directory.
mkdir -p ../task-dotdot ../outside/tdeep/dir ../outside/tdeep/tasks
printf '#!/usr/bin/env bash\necho outside\n' >../outside/tdeep/tasks/dd
chmod +x ../outside/tdeep/tasks/dd
cd ../task-dotdot || exit 1
mkdir tasks
printf '#!/usr/bin/env bash\necho inside\n' >tasks/dd
chmod +x tasks/dd
ln -s ../outside/tdeep/dir linked
cat <<'TOML' >mise.toml
[task_config]
includes = ["linked/../tasks"]
TOML
mise trust mise.toml
assert_contains "mise run dd" "outside"
assert_fail_contains "MISE_YES=1 mise tasks rm dd 2>&1" "goes up from"
assert_contains "cat tasks/dd" "inside"
assert_contains "cat ../outside/tdeep/tasks/dd" "outside"
assert_fail_contains "mise tasks add --file --force dd -- echo replaced 2>&1" "goes up from"
assert_contains "cat tasks/dd" "inside"
assert_contains "cat ../outside/tdeep/tasks/dd" "outside"

echo "=== mise tasks edit checks an existing script that links out of the project ==="
# The editor writes through the script's link, so it is refused like a write by mise, and once
# the project was trusted before the command, the editor opens the file the check approved.
mkdir -p ../edit-link/mise-tasks ../outside/edit
printf '#!/usr/bin/env bash\necho edited\n' >../outside/edit/ed
chmod +x ../outside/edit/ed
cd ../edit-link || exit 1
echo "[tools]" >mise.toml
ln -s ../../outside/edit/ed mise-tasks/ed
assert_fail_contains "EDITOR=echo mise tasks edit ed 2>&1" "refusing to write"
assert "mise trust ."
assert "EDITOR=echo mise tasks edit ed" "$(cd ../outside/edit && pwd -P)/ed"
# --path only prints the path, so it writes nothing and checks nothing
assert "mise tasks edit --path ed" "$PWD/mise-tasks/ed"

echo "=== mise tasks edit checks a TOML task file that links out of the project ==="
# The editor saves the file through its link, so the config write check applies to it as it does
# to `mise tasks rm`, and the editor opens the file the check approved.
mkdir -p ../edit-toml ../outside/edit-toml
printf '[tasks.tt]\nrun = "echo hi"\n' >../outside/edit-toml/mise.toml
cd ../edit-toml || exit 1
ln -s ../outside/edit-toml/mise.toml mise.toml
assert_fail_contains "EDITOR=echo mise tasks edit tt 2>&1" "refusing to write"
assert "mise tasks edit --path tt" "$PWD/mise.toml"
assert "mise trust mise.toml"
assert "EDITOR=echo mise tasks edit tt" "$(cd ../outside/edit-toml && pwd -P)/mise.toml"

echo "=== the config directory MISE_GLOBAL_CONFIG_FILE replaces holds no global config ==="
# Global discovery then reads only the file the variable names, so a file in the default
# directory is a project's like any other: in safe mode its link out is not followed.
override_target="$(dirname "$HOME")/override-target"
mkdir -p "$override_target" "$HOME/.config/mise/conf.d"
echo "[env]" >"$override_target/linked.toml"
ln -s "$override_target/linked.toml" "$HOME/.config/mise/conf.d/linked.toml"
assert_fail_contains "MISE_GLOBAL_CONFIG_FILE=$HOME/elsewhere.toml MISE_SAFE=1 mise set --file $HOME/.config/mise/conf.d/linked.toml OVERRIDDEN=1 2>&1" "refusing to write"
assert_not_contains "cat $override_target/linked.toml" "OVERRIDDEN"
# without the variable the directory is global config, which may link anywhere
assert "MISE_SAFE=1 mise set --file $HOME/.config/mise/conf.d/linked.toml GLOBAL=1"
assert_contains "cat $override_target/linked.toml" 'GLOBAL = "1"'
