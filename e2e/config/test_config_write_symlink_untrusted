#!/usr/bin/env bash

# A project's symlinks come with its working tree. Writing its config must not
# follow a link to a file elsewhere, or into mise's state directory, unless the
# project is trusted.
export MISE_TRUSTED_CONFIG_PATHS=""
export MISE_YES=0
unset CI GITHUB_ACTIONS GITHUB_ACTION 2>/dev/null || true

mkdir -p proj outside
cat <<'TOML' >outside/victim.toml
[tools]
TOML
cd proj || exit 1

echo "=== a link out of the project is not followed ==="
ln -s ../outside/victim.toml mise.toml
assert_fail_contains "mise set FOO=bar 2>&1" "refusing to write"
assert_not_contains "cat ../outside/victim.toml" "FOO"
assert_fail "mise config set env.FOO bar"
assert_not_contains "cat ../outside/victim.toml" "FOO"
assert_fail "mise tasks add hi -- echo hi"
assert_not_contains "cat ../outside/victim.toml" "hi"

echo "=== a dangling link out of the project creates nothing ==="
rm mise.toml
ln -s ../outside/new.toml mise.toml
assert_fail_contains "mise set FOO=bar 2>&1" "refusing to write"
assert_fail "test -e ../outside/new.toml"

echo "=== nothing is written into the state directory ==="
rm mise.toml
ln -s "$MISE_STATE_DIR/trusted-configs/planted" mise.toml
assert_fail_contains "mise set FOO=bar 2>&1" "refusing to write"
assert_fail "test -e $MISE_STATE_DIR/trusted-configs/planted"

echo "=== a link inside the project is followed ==="
rm mise.toml
mkdir -p config
cat <<'TOML' >config/real.toml
[tools]
TOML
ln -s config/real.toml mise.toml
assert "mise set FOO=bar"
assert_contains "cat config/real.toml" 'FOO = "bar"'
assert "test -L mise.toml"

echo "=== trust that yes grants in a fresh clone does not cover a link out ==="
mkdir -p ../clone
cat <<'TOML' >../outside/clone.toml
[env]
LINKED = "1"
[tools]
tiny = "1"
TOML
cd ../clone || exit 1
ln -s ../outside/clone.toml mise.toml
assert_fail_contains "MISE_YES=1 mise use --rm tiny 2>&1" "trusted before this command"
assert_contains "cat ../outside/clone.toml" 'tiny = "1"'
cd ../proj || exit 1

echo "=== a linked directory out of the project is not followed ==="
mkdir -p ../dir-link ../outside/conf
cat <<'TOML' >../outside/conf/mise.toml
[tools]
TOML
cd ../dir-link || exit 1
ln -s ../outside/conf .config
assert_fail_contains "mise set --file .config/mise.toml FOO=bar 2>&1" "through a linked directory"
assert_fail_contains "MISE_SAFE=1 mise set --file .config/mise.toml FOO=bar 2>&1" "refusing to write"
assert_not_contains "cat ../outside/conf/mise.toml" "FOO"
assert_fail_contains "mise set --file .config/mise.local.toml FOO=bar 2>&1" "refusing to write"
assert_fail "test -e ../outside/conf/mise.local.toml"
cd ../proj || exit 1

echo "=== a trusted project may link out ==="
rm mise.toml
ln -s ../outside/victim.toml mise.toml
assert "mise trust mise.toml"
assert "mise set FOO=bar"
assert_contains "cat ../outside/victim.toml" 'FOO = "bar"'
assert_fail_contains "MISE_SAFE=1 mise set BAR=baz 2>&1" "refusing to write"

echo "=== a project's link to global config is not followed, trusted or not ==="
mkdir -p ../to-global "$HOME/.config/mise"
cat <<'TOML' >"$HOME/.config/mise/config.toml"
[env]
GLOBAL = "1"
TOML
cd ../to-global || exit 1
ln -s "$HOME/.config/mise/config.toml" mise.toml
assert_fail_contains "mise set FOO=bar 2>&1" "refusing to write"
assert_not_contains "cat $HOME/.config/mise/config.toml" "FOO"
assert "mise trust ."
assert_fail_contains "mise set FOO=bar 2>&1" "Write global config with"
assert_not_contains "cat $HOME/.config/mise/config.toml" "FOO"
assert "mise set -g FOO=bar"
assert_contains "cat $HOME/.config/mise/config.toml" 'FOO = "bar"'

echo "=== a directory link to global config inside the project is not followed ==="
back="$PWD"
cd "$HOME" || exit 1
ln -s .config/mise .mise
assert_fail_contains "mise set --file .mise/config.toml HOMELINK=1 2>&1" "Write global config with"
assert_not_contains "cat $HOME/.config/mise/config.toml" "HOMELINK"
# nor is one that is the project directory itself, as `~/cfg` is for `~/cfg/config.toml`
ln -s .config/mise cfg
assert_fail_contains "mise set --file cfg/config.toml CFGLINK=1 2>&1" "Write global config with"
assert_not_contains "cat $HOME/.config/mise/config.toml" "CFGLINK"
cd "$back" || exit 1

echo "=== nor is one that would create a global config file ==="
mkdir -p ../to-global-dir
cd ../to-global-dir || exit 1
ln -s "$HOME/.config/mise" .mise
assert_fail_contains "mise set --file .mise/config.local.toml NEWFILE=1 2>&1" "Write global config with"
assert_fail "test -e $HOME/.config/mise/config.local.toml"
cd "$back" || exit 1

echo "=== global config reached through a linked home directory is global config ==="
linkhome="$(dirname "$HOME")/linkhome"
ln -s "$HOME" "$linkhome"
assert "mise set --file $linkhome/.config/mise/config.toml VIALINK=1"
assert_contains "cat $HOME/.config/mise/config.toml" 'VIALINK = "1"'

echo "=== so is one reached through a link above it at another depth ==="
# Like /home linked to /usr/home: the link sits in a directory that holds the
# home directory, and leaves the path a component longer.
top="$(dirname "$HOME")"
ln -s "$top" "$top/$(basename "$top")"
assert "mise set --file $top/$(basename "$top")/$(basename "$HOME")/.config/mise/config.toml DEPTH=1"
assert_contains "cat $HOME/.config/mise/config.toml" 'DEPTH = "1"'

echo "=== and a config directory outside the home directory, through a link beside it ==="
xdg="$top/xdg"
mkdir -p "$xdg/real/mise"
echo "[env]" >"$xdg/real/mise/config.toml"
ln -s "$xdg/real" "$xdg/alias"
assert "MISE_CONFIG_DIR=$xdg/real/mise mise set --file $xdg/alias/mise/config.toml OUTSIDE=1"
assert_contains "cat $xdg/real/mise/config.toml" 'OUTSIDE = "1"'

echo "=== also when the global config directory links into a dotfiles checkout ==="
# The link to the home directory is judged against where global config is
# spelled, not against where the dotfiles checkout puts the file.
mv "$HOME/.config/mise" "$top/dotfiles-mise"
ln -s "$top/dotfiles-mise" "$HOME/.config/mise"
ln -s "$HOME" "$HOME/h"
assert "mise set --file $HOME/h/.config/mise/config.toml DOTFILES=1"
assert_contains "cat $top/dotfiles-mise/config.toml" 'DOTFILES = "1"'
assert "mise set --file $linkhome/.config/mise/config.toml VIALINK2=1"
assert_contains "cat $top/dotfiles-mise/config.toml" 'VIALINK2 = "1"'

echo "=== a project's link to the home directory is not followed to global config ==="
mkdir -p ../home-link
cd ../home-link || exit 1
for name in home h; do
  ln -s "$HOME" "$name"
  assert_fail_contains "mise set --file $name/.config/mise/config.toml PROJLINK=1 2>&1" "Write global config with"
  assert_not_contains "cat $HOME/.config/mise/config.toml" "PROJLINK"
done
cd "$back" || exit 1

echo "=== tasks rm removes nothing when one file links out ==="
mkdir -p ../rm-two
cat <<'TOML' >../outside/rm.toml
[tasks.b]
run = "echo b"
TOML
cd ../rm-two || exit 1
cat <<'TOML' >mise.toml
[tasks.a]
run = "echo a"
TOML
ln -s ../outside/rm.toml mise.local.toml
assert_fail_contains "MISE_YES=1 mise tasks rm a b 2>&1" "refusing to write"
assert_contains "cat mise.toml" "[tasks.a]"
assert_contains "cat ../outside/rm.toml" "[tasks.b]"

echo "=== a dry run previews a dangling link's import without writing ==="
mkdir -p ../preview
cd ../preview || exit 1
echo "tiny 1.0.0" >.tool-versions
ln -s ../outside/preview.toml mise.toml
assert_contains "mise edit --dry-run --tool-versions .tool-versions 2>&1" 'tiny = "1.0.0"'
assert_fail "test -e ../outside/preview.toml"
assert_fail_contains "mise edit --tool-versions .tool-versions 2>&1" "refusing to write"
assert_fail "test -e ../outside/preview.toml"
