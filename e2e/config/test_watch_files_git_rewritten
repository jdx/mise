#!/usr/bin/env bash

# A watch_files command sees MISE_WATCH_FILES_GIT_REWRITTEN=1 when git moved HEAD
# when every changed file was written before git last moved HEAD.

git init -q
git config user.email test@example.com
git config user.name test

cat <<EOT >mise.toml
[[watch_files]]
patterns = ["watched.txt"]
run = 'echo "GIT_REWRITTEN=[\$MISE_WATCH_FILES_GIT_REWRITTEN]"'
EOT

echo one >watched.txt
git add mise.toml watched.txt
git commit -q -m one

eval "$(mise hook-env -s bash)"
sleep 1
echo edit >>watched.txt
assert_contains "mise hook-env -s bash 2>&1" "GIT_REWRITTEN=[]"

eval "$(mise hook-env -s bash)"
sleep 1
git checkout -q -b other
echo two >watched.txt
git commit -q -am two
# an edit that was committed before the next prompt is still the user's edit
assert_contains "mise hook-env -s bash 2>&1" "GIT_REWRITTEN=[]"

eval "$(mise hook-env -s bash)"
sleep 1
git checkout -q -
assert_contains "mise hook-env -s bash 2>&1" "GIT_REWRITTEN=[1]"

# a later real edit is not mistaken for a git rewrite
eval "$(mise hook-env -s bash)"
sleep 1
echo three >>watched.txt
assert_contains "mise hook-env -s bash 2>&1" "GIT_REWRITTEN=[]"

# a HEAD move that stays on the same commit leaves an earlier edit as the user's
eval "$(mise hook-env -s bash)"
sleep 1
echo four >>watched.txt
sleep 1
git checkout -q -b another
assert_contains "mise hook-env -s bash 2>&1" "GIT_REWRITTEN=[]"

eval "$(mise hook-env -s bash)"
sleep 1
echo five >>watched.txt
sleep 1
git add watched.txt
git reset -q
assert_contains "mise hook-env -s bash 2>&1" "GIT_REWRITTEN=[]"

# a checkout followed by a branch on the same commit still reports the checkout
git checkout -q -- watched.txt
eval "$(mise hook-env -s bash)"
sleep 1
git checkout -q other
git checkout -q -b feature
assert_contains "mise hook-env -s bash 2>&1" "GIT_REWRITTEN=[1]"

eval "$(mise hook-env -s bash)"
sleep 1
echo six >>watched.txt
sleep 1
git branch -m feature feature2
assert_contains "mise hook-env -s bash 2>&1" "GIT_REWRITTEN=[]"
