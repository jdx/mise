#!/usr/bin/env bash

# A tool name can be the URL mise or git fetches: an npm tarball or a git
# source. git sends the user's credential-helper and ~/.netrc logins to that
# URL's host, so safe mode does not fetch one that project config chooses, and
# refuses before contacting the host.

refused="a tool URL that global config does not request, is disabled in safe mode (MISE_SAFE=1)"

for tool in \
  "npm:git+https://git.example.invalid/o/r.git" \
  "npm:https://pkg.example.invalid/tool.tgz" \
  "pipx:git+https://git.example.invalid/o/r.git"; do
  cat <<EOF >mise.toml
[tools]
"$tool" = "latest"
EOF
  rm -f mise.lock
  assert_fail "MISE_SAFE=1 mise lock --platform linux-x64" "$refused"
  assert_fail "MISE_SAFE=1 mise install" "$refused"
  # Looking up versions fetches the URL too, also for a name that only the
  # command line gives.
  rm mise.toml
  assert_fail "MISE_SAFE=1 mise latest '$tool'" "$refused"
  assert_fail "MISE_SAFE=1 mise ls-remote '$tool'" "$refused"
done

# A version already installed needs no fetch, so safe mode uses it; one that
# is not installed is still refused.
digest=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
installed="$MISE_DATA_DIR/installs/npm-https-pkg-example-invalid-tool-tgz/$digest"
mkdir -p "$installed/bin"
printf '#!/bin/sh\necho tool ran\n' >"$installed/bin/url-tool"
chmod +x "$installed/bin/url-tool"
cat <<EOF >mise.toml
[tools]
"npm:https://pkg.example.invalid/tool.tgz" = "$digest"
EOF
assert "MISE_SAFE=1 mise where npm:https://pkg.example.invalid/tool.tgz" "$installed"
assert "MISE_SAFE=1 mise exec -- url-tool" "tool ran"
assert "MISE_SAFE=1 mise latest --installed npm:https://pkg.example.invalid/tool.tgz" "$digest"
# Looking for an installed version does not ask the host, even for an alias
# that stands for the latest version.
cat <<EOF >mise.toml
[tool_alias."npm:https://pkg.example.invalid/tool.tgz".versions]
newest = "latest"

[tools]
"npm:https://pkg.example.invalid/tool.tgz" = "sub-1:newest"
EOF
assert_fail "MISE_SAFE=1 mise where npm:https://pkg.example.invalid/tool.tgz" "$refused"
assert_not_contains "MISE_SAFE=1 MISE_DEBUG=1 mise where npm:https://pkg.example.invalid/tool.tgz 2>&1 || true" "GET https://pkg.example.invalid"
cat <<EOF >mise.toml
[tools]
"npm:https://pkg.example.invalid/tool.tgz" = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
EOF
assert_fail "MISE_SAFE=1 mise install" "$refused"

# A tool that only a task declares is a project tool too.
cat <<EOF >mise.toml
[tasks.build]
run = "true"
tools = { "npm:git+https://git.example.invalid/o/r.git" = "latest" }
EOF
rm -f mise.lock
assert_fail "MISE_SAFE=1 mise lock --platform linux-x64" "$refused"
assert_fail "MISE_SAFE=1 mise install --include-task-tools" "$refused"
