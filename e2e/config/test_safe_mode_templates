#!/usr/bin/env bash

# Safe mode renders project config templates, and what they render reaches the
# URLs mise requests, mise.lock and command output. So project templates must
# not see the environment of the process that runs mise, or read files.

safe_template_tool() {
  echo "tools.\"http:safe-template\" = { version = \"$1\", url = \"https://example.invalid/archive.tar.gz\" }"
}

echo "=== project templates see an empty env ==="
safe_template_tool "{{ env.SAFE_TEMPLATE | default(value='1.0.0') }}" >mise.toml
assert_contains "SAFE_TEMPLATE=2.0.0 mise ls --json" '"requested_version": "2.0.0"'
assert_contains "SAFE_TEMPLATE=2.0.0 MISE_SAFE=1 mise ls --json" '"requested_version": "1.0.0"'

cat <<'EOF' >mise.toml
[tasks.build]
run = "echo build"
description = "token={{ env.SAFE_TEMPLATE | default(value='none') }}"
EOF
assert_contains "SAFE_TEMPLATE=secret mise tasks ls" "token=secret"
assert_contains "SAFE_TEMPLATE=secret MISE_SAFE=1 mise tasks ls" "token=none"
assert_not_contains "SAFE_TEMPLATE=secret MISE_SAFE=1 mise tasks ls" "secret"

echo "=== project templates do not see the operator's vars ==="
cat <<'EOF' >"$MISE_CONFIG_DIR/config.toml"
[vars]
mirror_token = "operator-secret"

[tasks.global-task]
run = "echo {{ arg(name='mirror', default=vars.mirror_token) }}"
description = "global={{ vars.mirror_token }}"
EOF
cat <<'EOF' >mise.toml
[tasks.build]
run = "echo {{ arg(name='mirror', default=vars.mirror_token | default(value='none')) }}"
description = "token={{ vars | json_encode }}"
EOF
assert_contains "mise tasks ls" "operator-secret"
assert_not_contains "MISE_SAFE=1 mise tasks ls" 'token={"mirror_token"'
assert_contains "MISE_SAFE=1 mise tasks ls" "token={}"
# a task global config declares is the operator's and keeps them, in the run
# script its usage is read from too
assert_contains "MISE_SAFE=1 mise tasks ls" "global=operator-secret"
assert_contains "MISE_SAFE=1 mise tasks info global-task" "arg <mirror> default=operator-secret"
assert_contains "MISE_SAFE=1 mise tasks info build" "arg <mirror> default=none"
# so is a file task in the global task directory, which keeps env too
mkdir -p "$MISE_CONFIG_DIR/tasks"
cat <<'EOF' >"$MISE_CONFIG_DIR/tasks/gfile"
#!/usr/bin/env bash
#MISE description="file={{ env.SAFE_TEMPLATE | default(value='none') }}/{{ vars.mirror_token | default(value='none') }}"
echo gfile
EOF
chmod +x "$MISE_CONFIG_DIR/tasks/gfile"
assert_contains "SAFE_TEMPLATE=from-env MISE_SAFE=1 mise tasks ls" "file=from-env/operator-secret"
rm -r "$MISE_CONFIG_DIR/tasks" "$MISE_CONFIG_DIR/config.toml"

echo "=== get_env() and the file filters are refused ==="
for template in "get_env(name='HOME')" "'/etc/hostname' | hash_file" "'/etc/hostname' | file_size" "'/etc/hostname' | last_modified"; do
  safe_template_tool "{{ $template }}" >mise.toml
  assert_fail "MISE_SAFE=1 mise ls" "disabled in safe mode (MISE_SAFE=1)"
done

echo "=== a project .miserc.toml sees no env, in any mode ==="
# its env list becomes MISE_ENV, which project templates can read
echo 'env = ["{{ env.SAFE_TEMPLATE }}"]' >.miserc.toml
safe_template_tool "{{ mise_env | default(value=[]) | join(sep='-') }}" >mise.toml
assert_not_contains "SAFE_TEMPLATE=2.0.0 mise ls --json 2>&1" "2.0.0"
assert_not_contains "SAFE_TEMPLATE=2.0.0 MISE_SAFE=1 mise ls --json 2>&1" "2.0.0"
rm .miserc.toml mise.toml

echo "=== global config is the operator's, so its templates see the env ==="
cat <<EOF >"$MISE_CONFIG_DIR/config.toml"
$(safe_template_tool "{{ env.SAFE_TEMPLATE }}")

[env]
FROM_GLOBAL = "{{ env.SAFE_TEMPLATE }}"
EOF
assert_contains "SAFE_TEMPLATE=2.0.0 MISE_SAFE=1 mise ls --json" '"requested_version": "2.0.0"'
assert_contains "SAFE_TEMPLATE=2.0.0 MISE_SAFE=1 mise env" "FROM_GLOBAL=2.0.0"

# so do global dotfile templates, which mise-system renders
mkdir -p dots
echo 'value={{ env.SAFE_TEMPLATE }}' >dots/safe.tmpl
cat <<EOF >"$MISE_CONFIG_DIR/config.toml"
[dotfiles]
"~/.safe-dot" = { source = "$PWD/dots/safe.tmpl", mode = "template" }
EOF
assert_succeed "SAFE_TEMPLATE=from-env MISE_SAFE=1 mise dotfiles apply ~/.safe-dot --yes"
assert "cat ~/.safe-dot" "value=from-env"

# and so do the options of a global [tool_alias], which the backend renders
# only when it downloads
mkdir -p stable
printf '#!/bin/sh\necho alias-tool\n' >stable/galias-1.0.0
cat <<EOF >"$MISE_CONFIG_DIR/config.toml"
[tool_alias]
galias = "http:galias[url=file://$PWD/{{env.SAFE_CHANNEL}}/galias-{{version}}]"

[tools]
galias = "1.0.0"
EOF
assert_succeed "SAFE_CHANNEL=stable MISE_SAFE=1 mise install galias"
assert_succeed "test -d '$MISE_DATA_DIR/installs/galias/1.0.0'"
# a project alias does not get the environment
rm "$MISE_CONFIG_DIR/config.toml"
cat <<EOF >mise.toml
[tool_alias]
palias = "http:palias[url=file://$PWD/{{env.SAFE_CHANNEL}}/galias-{{version}}]"

[tools]
palias = "1.0.0"
EOF
assert_fail "SAFE_CHANNEL=stable MISE_SAFE=1 mise install palias"
assert_succeed "SAFE_CHANNEL=stable mise install palias"
rm mise.toml
