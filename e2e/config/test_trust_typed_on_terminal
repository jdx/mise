#!/usr/bin/env bash

# A mise command typed on a terminal in an untrusted project trusts it without
# the "Trust them?" prompt and says so. Anything that does not look like a person
# typing it there keeps the prompt: stdout captured by a command substitution,
# paranoid mode, an ignored directory, the shell's command-not-found handler.

require_cmd script

# script(1) gives mise a pty on stdin, stdout and stderr. macOS's script(1) also
# wants a terminal on its own stdin, which the harness does not have.
if ! script -qec true /dev/null >/dev/null 2>&1; then
  echo "skipping: script(1) cannot allocate a pty here" >&2
  exit 0
fi

export MISE_TRUSTED_CONFIG_PATHS=""
unset CI GITHUB_ACTIONS GITHUB_ACTION 2>/dev/null || true

cat <<'EOF' >mise.toml
[env]
TYPED_TRUST_TEST = "1"
EOF

notice="because you ran a mise command there"
# This directory as mise prints it, with the home directory as `~`.
# shellcheck disable=SC2088
case $PWD in
  "$HOME"/*) shown="~${PWD#"$HOME"}" ;;
  *) shown=$PWD ;;
esac

# Runs $1 on a pty and answers "No" if the trust prompt appears, so a run that
# would prompt finishes instead of waiting for a key.
on_pty() {
  printf 'n' | timeout 10 script -qec "MISE_YES=0 $1" /dev/null 2>&1
}

assert_untrusted() {
  assert_contains "mise trust --show" "$(basename "$PWD"): untrusted"
}

# Forgets the answers the cases below gave, so each case starts untrusted.
forget_trust() {
  rm -rf "$MISE_STATE_DIR/trusted-configs" "$MISE_STATE_DIR/ignored-configs"
}

# stdout captured: stdin and stderr are the terminal, but nobody typed this here.
output="$(on_pty 'mise env | cat')" || true
assert_contains_text "$output" "Trust them?"
assert_not_contains_text "$output" "$notice"
assert_untrusted
forget_trust
ok "[trust] a command whose stdout is captured still asks"

# Paranoid mode keeps the prompt.
output="$(on_pty 'MISE_PARANOID=1 mise env')" || true
assert_contains_text "$output" "Trust them?"
assert_not_contains_text "$output" "$notice"
assert_untrusted
forget_trust
ok "[trust] paranoid mode still asks"

# An ignored directory stays ignored.
mise trust --ignore
output="$(on_pty 'mise env')" || true
assert_not_contains_text "$output" "$notice"
assert_not_contains_text "$output" "TYPED_TRUST_TEST"
assert_untrusted
forget_trust
ok "[trust] an ignored directory is not trusted"

# The shell's command-not-found handler runs mise on the terminal after a
# mistyped command; nobody typed a mise command. A global option before the
# command does not hide it.
for cmd in 'mise hook-not-found -s bash -- nosuchbin' 'mise -q hook-not-found -s bash -- nosuchbin'; do
  output="$(on_pty "$cmd")" || true
  # The prompt shows the handler reached the trust decision and did not take it.
  assert_contains_text "$output" "Trust them?"
  assert_not_contains_text "$output" "$notice"
  assert_untrusted
  forget_trust
done
ok "[trust] the command-not-found handler does not trust the project"

# The prompt hook runs before every prompt on the terminal: it neither asks nor
# trusts, with or without a global option before the command.
for cmd in 'mise hook-env -s bash' 'mise -q hook-env -s bash'; do
  # script -e exits with the status of the command it ran.
  output="$(on_pty "$cmd")" || fail "$cmd failed: $output"
  # The warning shows the hook reached the untrusted config and did not trust it.
  assert_contains_text "$output" 'mise.toml is not trusted, run `mise trust` to enable it'
  assert_not_contains_text "$output" "Trust them?"
  assert_not_contains_text "$output" "$notice"
  assert_untrusted
  forget_trust
done
ok "[trust] the prompt hook does not trust the project"

# Without a terminal nothing is trusted either.
assert_fail "MISE_YES=0 mise env </dev/null" "not trusted"
assert_untrusted

# The trust record names the directory, so it admits every config file there.
# `.config/mise.toml` loads after `mise.toml`; when it belongs to another
# account, the user's own `mise.toml` must not trust the directory for it.
if [ "$(id -u)" != 0 ]; then
  mkdir .config
  ln -s /etc/passwd .config/mise.toml
  output="$(on_pty 'mise env')" || true
  assert_contains_text "$output" "Trust them?"
  assert_not_contains_text "$output" "$notice"
  assert_untrusted
  rm -r .config
  forget_trust
  ok "[trust] another account's config file in the directory still asks"

  # The record also admits config for an environment this command did not
  # select, which would load as soon as that environment is.
  ln -s /etc/passwd mise.prod.toml
  output="$(on_pty 'mise env')" || true
  assert_contains_text "$output" "Trust them?"
  assert_not_contains_text "$output" "$notice"
  assert_untrusted
  rm mise.prod.toml
  forget_trust
  ok "[trust] another account's config for another environment still asks"

  # A conf.d folder is a trust root of its own, which the project's record
  # does not admit, so another account's fragment there does not matter.
  mkdir -p .mise/conf.d/git
  ln -s /etc/passwd .mise/conf.d/git/mise.prod.toml
  output="$(on_pty 'mise env')"
  assert_contains_text "$output" "$notice"
  assert_not_contains_text "$output" "Trust them?"
  rm -r .mise
  forget_trust
  ok "[trust] another account's conf.d fragment does not keep the prompt"
fi

# Typed on a terminal: trusted, with a notice, and the config applies. The
# undo hint is quoted for the shell `mise activate` named.
output="$(on_pty 'MISE_SHELL=bash mise env')"
assert_contains_text "$output" "$notice"
assert_contains_text "$output" "Undo with \`mise untrust $shown/mise.toml\`"
assert_contains_text "$output" "TYPED_TRUST_TEST"
assert_not_contains_text "$output" "Trust them?"
assert_contains "mise trust --show" "$(basename "$PWD"): trusted"
forget_trust
ok "[trust] a command typed on a terminal trusts the project"

# One command can trust a parent project too. Each notice names the file whose
# directory it trusted, so running every hint it printed undoes all of them.
# With no shell named, the hint gives the full path.
mkdir sub
cat <<'EOF' >sub/mise.toml
[env]
TYPED_TRUST_SUB = "1"
EOF
output="$(cd sub && on_pty 'mise env')"
assert_contains_text "$output" "TYPED_TRUST_SUB"
assert_contains_text "$output" "mise untrust $PWD/mise.toml"
assert_contains_text "$output" "mise untrust $PWD/sub/mise.toml"
(cd sub && mise untrust "$PWD/../mise.toml" && mise untrust "$PWD/mise.toml")
assert_untrusted
assert_contains "cd sub && mise trust --show" "sub: untrusted"
forget_trust
ok "[trust] the notice for each trusted directory says how to undo it"

# A project whose settings fail to load once trusted keeps no record: every
# command, `mise untrust` too, would fail on that setting.
cat <<'EOF' >sub/mise.toml
[settings]
versions_host_exclude = ["["]
EOF
output="$(cd sub && on_pty 'mise env')" || true
assert_contains_text "$output" "versions_host_exclude"
assert_not_contains_text "$output" "mise untrust $shown/sub/mise.toml"
assert_not_contains "ls $MISE_STATE_DIR/trusted-configs 2>/dev/null || true" "sub-"
ok "[trust] a project whose settings fail to load is not left trusted"
