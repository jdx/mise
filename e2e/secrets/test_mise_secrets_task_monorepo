#!/usr/bin/env bash

# A monorepo task's secrets source runs with its own subproject's [env], never the task's env.

export MISE_EXPERIMENTAL=1
mkdir -p "$HOME/bin"
printf '#!/usr/bin/env bash\nexec python3 "%s" "$@"\n' "$TEST_ROOT/helpers/scripts/fnox_stub.py" >"$HOME/bin/fnox"
chmod +x "$HOME/bin/fnox"
export PATH="$HOME/bin:$PATH"
export FNOX_STUB_LOG="$PWD/fnox-calls.jsonl"

cat >mise.toml <<'TOML'
monorepo_root = true

[monorepo]
config_roots = ["projects/*"]

[env]
ROOT_ONLY = "1"
TOML
mkdir -p projects/api
cat >projects/api/mise.toml <<'TOML'
[secrets.fnox]

[env]
SUB_ENV_VAR = "staging"

[tasks.deploy]
secrets = ["DEPLOY_KEY"]
env = { TASK_ONLY = "1" }
run = 'printf %s "$DEPLOY_KEY" >deploy.out'
TOML

mise run //projects/api:deploy </dev/null >/dev/null 2>&1 || fail "the monorepo task did not run"
assert "jq -e 'select(.argv|index(\"--keys\"))|(.env_keys|index(\"SUB_ENV_VAR\")) != null and (.env_keys|index(\"TASK_ONLY\")) == null' fnox-calls.jsonl"
assert "jq -e 'select(.argv|index(\"--describe\"))|(.env_keys|index(\"SUB_ENV_VAR\")) != null' fnox-calls.jsonl"
assert "cat projects/api/deploy.out" "deploy-s3cr3t-0001"
