#!/usr/bin/env bash

# `mise x` gets secrets only when asked, and never as files.

mkdir -p "$HOME/bin"
printf '#!/usr/bin/env bash\nexec python3 "%s" "$@"\n' "$TEST_ROOT/helpers/scripts/fnox_stub.py" >"$HOME/bin/fnox"
chmod +x "$HOME/bin/fnox"
export PATH="$HOME/bin:$PATH"
export FNOX_STUB_LOG="$PWD/fnox-calls.jsonl"

cat >mise.toml <<'TOML'
[secrets.fnox]
TOML

assert_succeed "mise x --secrets DEPLOY_KEY -- sh -c 'test \"\$DEPLOY_KEY\" = deploy-s3cr3t-0001'"
assert "jq -r 'select(.argv|index(\"--keys\"))|.argv[-1]' fnox-calls.jsonl" "DEPLOY_KEY"

# by default nothing, and fnox never runs
rm -f fnox-calls.jsonl
assert "mise x -- sh -c 'echo \${DEPLOY_KEY:-unset}'" "unset"
[[ ! -e fnox-calls.jsonl ]] || fail "mise x without a flag must not run fnox"
# no environment variable or setting turns it on
assert "MISE_SECRETS=DEPLOY_KEY mise x -- sh -c 'echo \${DEPLOY_KEY:-unset}'" "unset"
[[ ! -e fnox-calls.jsonl ]] || fail "an environment variable must not grant secrets"

# a file secret cannot be given
assert_fail_contains "mise x --secrets GCP_SA_JSON -- true" "GCP_SA_JSON is a file secret (as_file = true)"
assert_fail_contains "mise x --secrets NOPE -- true" "mise x: unknown secret NOPE"
assert_fail_contains "mise x --secrets NOPE -- true" "Granted by: --secrets"
assert_fail_contains "mise x --secrets SIGNING_KEY -- true" "mise x: SIGNING_KEY cannot be injected"

# --secrets-all names every injectable key except files
rm -f fnox-calls.jsonl
assert_contains "mise x --secrets-all -- true </dev/null 2>&1" "skipping file secrets GCP_SA_JSON"
keys="$(jq -r 'select(.argv|index("--keys"))|.argv[-1]' fnox-calls.jsonl)"
assert_not_contains "echo $keys" "GCP_SA_JSON"
assert_not_contains "echo $keys" "SIGNING_KEY"
assert_contains "echo $keys" "STRIPE_KEY"
assert "mise x --secrets-all -- sh -c 'echo \${STRIPE_KEY:-unset}' </dev/null 2>/dev/null" "stripe-s3cr3t-0003"
assert "mise x --secrets-all -- sh -c 'echo \${GCP_SA_JSON:-unset}' </dev/null 2>/dev/null" "unset"
assert_fail "mise x --secrets-all --secrets A -- true"

# safe mode refuses
assert_fail_contains "MISE_SAFE=1 mise x --secrets DEPLOY_KEY -- true" "safe"
assert_fail_contains "MISE_EXPERIMENTAL=0 mise x --secrets DEPLOY_KEY -- true" "experimental"

# a source is required
printf '' >mise.toml
assert_fail_contains "mise x --secrets DEPLOY_KEY -- true" "mise x --secrets needs a secrets source"
printf '[secrets.fnox]\n' >mise.toml

# the marker names what the command was given, and what it already held
assert "mise x --secrets DEPLOY_KEY -- sh -c 'printf %s \"\$__MISE_SECRET_KEYS\"'" "DEPLOY_KEY"
assert "__MISE_SECRET_KEYS=FOO FOO=x mise x --secrets DEPLOY_KEY -- sh -c 'printf %s \"\$__MISE_SECRET_KEYS\"'" "DEPLOY_KEY,FOO"
# without a grant an inherited marker passes through untouched
assert "__MISE_SECRET_KEYS=FOO FOO=x mise x -- sh -c 'printf %s \"\$__MISE_SECRET_KEYS\"'" "FOO"

# mise secrets ls shows where each key can go
assert "mise secrets ls -J | jq -c '.keys[] | select(.key==\"DEPLOY_KEY\") | .scopes'" '["run","exec"]'
assert "mise secrets ls -J | jq -c '.keys[] | select(.key==\"GCP_SA_JSON\") | .scopes'" '["run"]'
assert "mise secrets ls -J | jq -c '.keys[] | select(.key==\"SIGNING_KEY\") | .scopes'" '[]'
assert_contains "mise secrets ls" "run, exec"
assert_contains "mise secrets ls --complete" "DEPLOY_KEY"
assert_not_contains "mise secrets ls --complete" "SIGNING_KEY"

# a failed exec does not leave values for anything mise runs afterwards, and prints none
mise x --secrets DEPLOY_KEY -- /nonexistent-binary >failed.out 2>&1 </dev/null && fail "exec of a missing binary succeeded"
assert_not_contains "cat failed.out" "s3cr3t"
assert_contains "cat failed.out" "nonexistent-binary"

# fish gets the values from its environment, never from argv
if command -v fish >/dev/null; then
  assert "mise x --secrets DEPLOY_KEY -- fish -c 'echo \$DEPLOY_KEY'" "deploy-s3cr3t-0001"
  cat >"$HOME/bin/argv-dump" <<'SH'
#!/usr/bin/env bash
if [ -r /proc/self/cmdline ]; then tr '\0' ' ' </proc/self/cmdline >"$ARGV_OUT"; else : >"$ARGV_OUT"; fi
SH
  chmod +x "$HOME/bin/argv-dump"
  ARGV_OUT="$PWD/argv.out" mise x --secrets DEPLOY_KEY -- "$HOME/bin/argv-dump" >/dev/null 2>&1
  assert_not_contains "cat argv.out" "s3cr3t"
fi

# a pitchfork-style probe passes no flag, so it gets nothing
assert "mise x -- sh -c 'echo \${DEPLOY_KEY:-unset}'" "unset"

# a key mise sets for the command is a collision even when its value equals the shell's
cat >mise.toml <<'TOML'
[secrets.fnox]

[env]
DATABASE_URL = "default"
TOML
export DATABASE_URL=default
assert_fail_contains "mise x --secrets DATABASE_URL -- true" "mise x: DATABASE_URL is both a secret and a mise env var"
assert_contains "mise x --secrets-all -- env </dev/null 2>&1" "not granting DATABASE_URL to mise x: mise sets it for this command"
assert "mise x --secrets-all -- sh -c 'printf %s \"\$DATABASE_URL\"' </dev/null 2>/dev/null" "default"
